PORT=3000
NODE_ENV=development
APP_NAME="JPS Almoxarifado"
SESSION_SECRET="almoxarifado_secreto_super_seguro_2026"

# =============================================================================
# BANCO DE DADOS ATUAL
# Valores: 'sqlite' ou 'supabase'
# =============================================================================
DB_DRIVER=sqlite

# =============================================================================
# SUPABASE CREDENCIAIS
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# =============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-secret-key-aqui

# =============================================================================
# SUPABASE POSTGRESQL CONNECTION STRING (Pooler Transaction Mode - Porta 6543)
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# =============================================================================
DATABASE_URL=postgres://postgres.[ref-do-projeto]:[sua-senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true
