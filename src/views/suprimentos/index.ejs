<%- include('../layouts/header') %>

<%
  const nivelUserSup = (typeof usuarioLogado !== 'undefined' && usuarioLogado) ? usuarioLogado.nivel_acesso : '';
  const podeGerenciarSup = ['ADMIN', 'ALMOXARIFE'].includes(nivelUserSup);
  const podeDarSaidaSup = ['ADMIN', 'ALMOXARIFE', 'OPERADOR_FICHAS'].includes(nivelUserSup);
%>

<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho da Página -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Suprimentos do Canteiro</h2>
    <p>Controle de consumo contínuo no canteiro (galões de água, tintas de impressora, copa, limpeza e insumos etiquetados como <strong>Suprimentos</strong>) com média de saída e previsão de compra.</p>
  </div>

  <div class="page-actions-group" style="flex-wrap: wrap;">
    <a href="/relatorios?tipo_relatorio=inventario&categoria=Suprimentos" class="btn btn-outline" title="Abrir relatório completo com projeção e exportação em PDF/Excel">
      <i class="fa-solid fa-chart-column" style="color: var(--primary);"></i> Relatório (PDF / Excel)
    </a>
    <% if (podeGerenciarSup) { %>
      <button type="button" class="btn btn-primary" onclick="abrirModalNovoSuprimento()">
        <i class="fa-solid fa-plus"></i> Novo Suprimento
      </button>
    <% } %>
  </div>
</div>

<!-- Cards de Indicadores de Suprimentos -->
<div class="balcao-kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 1.25rem;">
  <div class="table-card" style="padding: 1.05rem 1.2rem; display: flex; align-items: center; gap: 0.9rem; border-left: 4px solid #0D9488;">
    <div style="width: 42px; height: 42px; border-radius: 10px; background: #CCFBF1; color: #0F766E; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">
      <i class="fa-solid fa-droplet"></i>
    </div>
    <div>
      <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Itens de Suprimento</div>
      <div style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
        <%= estatisticas.totalItens %> <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">(<%= estatisticas.totalUnidades %> un.)</span>
      </div>
    </div>
  </div>

  <div class="table-card" style="padding: 1.05rem 1.2rem; display: flex; align-items: center; gap: 0.9rem; border-left: 4px solid #EF4444;">
    <div style="width: 42px; height: 42px; border-radius: 10px; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">
      <i class="fa-solid fa-fire-flame-curved"></i>
    </div>
    <div>
      <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Consumo (7d / 30d)</div>
      <div style="font-size: 1.35rem; font-weight: 800; color: #B91C1C; line-height: 1.2;">
        <%= estatisticas.consumo7d %> <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">/ <%= estatisticas.consumo30d %> un.</span>
      </div>
    </div>
  </div>

  <div class="table-card" style="padding: 1.05rem 1.2rem; display: flex; align-items: center; gap: 0.9rem; border-left: 4px solid #F59E0B;">
    <div style="width: 42px; height: 42px; border-radius: 10px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <div>
      <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Zerados / Estoque Baixo</div>
      <div style="font-size: 1.35rem; font-weight: 800; color: #B45309; line-height: 1.2;">
        <%= estatisticas.zerados + estatisticas.baixos %> <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">(<%= estatisticas.zerados %> zer.)</span>
      </div>
    </div>
  </div>

  <div class="table-card" style="padding: 1.05rem 1.2rem; display: flex; align-items: center; gap: 0.9rem; border-left: 4px solid #6366F1;">
    <div style="width: 42px; height: 42px; border-radius: 10px; background: #EEF2FF; color: #4F46E5; display: flex; align-items: center; justify-content: center; font-size: 1.15rem;">
      <i class="fa-solid fa-hourglass-half"></i>
    </div>
    <div>
      <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Cobertura ≤ 7 dias</div>
      <div style="font-size: 1.35rem; font-weight: 800; color: #4338CA; line-height: 1.2;">
        <%= estatisticas.emRiscoCobertura %> <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">item(ns)</span>
      </div>
    </div>
  </div>
</div>

<!-- Barra de Busca e Filtro -->
<div class="table-card" style="padding: 0.95rem 1.2rem; margin-bottom: 1.25rem;">
  <form action="/suprimentos" method="GET" style="display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; margin: 0;">
    <div style="flex: 1; min-width: 220px; position: relative;">
      <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 0.95rem; top: 50%; transform: translateY(-50%); color: var(--text-dim);"></i>
      <input
        type="text"
        name="busca"
        class="form-control"
        placeholder="Buscar suprimento (ex: galão de água, tinta, papel, café, localização)..."
        value="<%= filtros.busca %>"
        style="padding-left: 2.4rem; height: 40px;"
      >
    </div>

    <div style="min-width: 175px;">
      <select name="status" class="form-control" style="height: 40px;" onchange="this.form.submit()">
        <option value="">Todos os Status</option>
        <option value="NORMAL" <%= filtros.status === 'NORMAL' ? 'selected' : '' %>>Em Estoque</option>
        <option value="BAIXO" <%= filtros.status === 'BAIXO' ? 'selected' : '' %>>Estoque Baixo</option>
        <option value="CRITICO" <%= filtros.status === 'CRITICO' ? 'selected' : '' %>>Zerado</option>
      </select>
    </div>

    <button type="submit" class="btn btn-primary" style="height: 40px;">
      <i class="fa-solid fa-filter"></i> Filtrar
    </button>

    <% if (filtros.busca || filtros.status) { %>
      <a href="/suprimentos" class="btn btn-outline" style="height: 40px;" title="Limpar Filtros">
        <i class="fa-solid fa-xmark"></i>
      </a>
    <% } %>
  </form>
</div>

<!-- Lista Principal de Suprimentos -->
<div class="table-card" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
  <div class="table-responsive desktop-only">
    <table class="clean-table">
      <thead>
        <tr>
          <th>Suprimento / Etiqueta</th>
          <th style="text-align: center;">Saldo Atual</th>
          <th style="text-align: center;">Mínimo</th>
          <th style="text-align: center;">Média de Saída</th>
          <th style="text-align: center;">Projeção (30d)</th>
          <th style="text-align: center;">Cobertura Estimada</th>
          <th style="text-align: right;">Ações Rápidas</th>
        </tr>
      </thead>
      <tbody>
        <% if (suprimentos && suprimentos.length > 0) { %>
          <% suprimentos.forEach(p => { %>
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
                  <strong style="font-size: 0.9rem; color: var(--text-main);"><%= p.nome %></strong>
                  <span style="font-size: 0.68rem; font-weight: 700; background: #CCFBF1; color: #0F766E; border: 1px solid #99F6E4; padding: 1px 6px; border-radius: 9999px;">
                    <i class="fa-solid fa-tag" style="font-size: 0.6rem;"></i> <%= p.tag || 'SUPRIMENTO' %>
                  </span>
                </div>
                <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 3px; display: flex; gap: 0.55rem; flex-wrap: wrap;">
                  <span style="font-family: var(--font-mono); font-weight: 600;"><%= p.sku %></span>
                  <% if (p.marca) { %><span>• <%= p.marca %></span><% } %>
                  <% if (p.localizacao) { %><span>• <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> <%= p.localizacao %></span><% } %>
                </div>
              </td>

              <td style="text-align: center;">
                <div style="font-size: 1rem; font-weight: 800; color: <%= p.quantidade === 0 ? 'var(--danger)' : (p.status_estoque === 'BAIXO' ? '#D97706' : 'var(--text-main)') %>;">
                  <%= p.quantidade %> <small style="font-size: 0.74rem; font-weight: 600; color: var(--text-dim);"><%= p.unidade_medida || 'UN' %></small>
                </div>
              </td>

              <td style="text-align: center; color: var(--text-muted); font-size: 0.85rem;">
                <%= p.estoque_minimo %> <%= p.unidade_medida || 'UN' %>
              </td>

              <td style="text-align: center;">
                <% if (p.mediaDiaria > 0) { %>
                  <div style="font-weight: 700; color: #B91C1C; font-size: 0.86rem;">
                    <%= p.mediaDiaria.toFixed(1).replace('.', ',') %>/dia
                  </div>
                  <div style="font-size: 0.71rem; color: var(--text-dim);">
                    ~<%= p.mediaSemanal.toFixed(1).replace('.', ',') %>/sem
                  </div>
                <% } else { %>
                  <span style="color: var(--text-dim); font-size: 0.8rem;">Sem saídas</span>
                <% } %>
              </td>

              <td style="text-align: center;">
                <% if (p.projecao30d > 0) { %>
                  <span style="font-weight: 800; color: var(--primary); font-size: 0.88rem;"><%= p.projecao30d %> <%= p.unidade_medida || 'UN' %></span>
                <% } else { %>
                  <span style="color: var(--text-dim);">-</span>
                <% } %>
              </td>

              <td style="text-align: center;">
                <% if (p.quantidade === 0) { %>
                  <span class="status-pill out-of-stock" style="font-size: 0.72rem;">Zerado</span>
                <% } else if (p.diasCobertura !== null) { %>
                  <% if (p.diasCobertura <= 7) { %>
                    <span class="status-pill out-of-stock" style="font-size: 0.72rem;" title="Antecipe a compra!">
                      ~<%= p.diasCobertura %> dia(s)
                    </span>
                  <% } else if (p.diasCobertura <= 15) { %>
                    <span class="status-pill low-stock" style="font-size: 0.72rem;">
                      ~<%= p.diasCobertura %> dias
                    </span>
                  <% } else { %>
                    <span class="status-pill in-stock" style="font-size: 0.72rem;">
                      ~<%= p.diasCobertura %> dias
                    </span>
                  <% } %>
                <% } else { %>
                  <span class="status-pill in-stock" style="font-size: 0.72rem;">Estável</span>
                <% } %>
              </td>

              <td style="text-align: right; white-space: nowrap;">
                <div style="display: inline-flex; gap: 0.35rem; align-items: center;">
                  <% if (podeDarSaidaSup) { %>
                    <button
                      type="button"
                      class="btn btn-outline btn-sm"
                      style="color: #DC2626; border-color: #FECACA; font-weight: 700;"
                      onclick="abrirModalMovSuprimento(<%= p.id %>, '<%= p.nome.replace(/'/g, "\\'") %>', '<%= p.unidade_medida || 'UN' %>', <%= p.quantidade %>, 'SAIDA')"
                      <%= p.quantidade <= 0 ? 'disabled title="Saldo zerado"' : 'title="Registrar consumo / abastecimento no canteiro"' %>
                    >
                      <i class="fa-solid fa-minus"></i> Consumo
                    </button>
                  <% } %>
                  <% if (podeGerenciarSup) { %>
                    <button
                      type="button"
                      class="btn btn-outline btn-sm"
                      style="color: #059669; border-color: #A7F3D0; font-weight: 700;"
                      onclick="abrirModalMovSuprimento(<%= p.id %>, '<%= p.nome.replace(/'/g, "\\'") %>', '<%= p.unidade_medida || 'UN' %>', <%= p.quantidade %>, 'ENTRADA')"
                      title="Registrar reposição / compra"
                    >
                      <i class="fa-solid fa-plus"></i> Repor
                    </button>
                    <a href="/produtos/<%= p.id %>/editar" class="action-more-btn" title="Editar Suprimento">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              <i class="fa-solid fa-droplet" style="font-size: 2.2rem; color: #99F6E4; display: block; margin-bottom: 0.65rem;"></i>
              <strong style="color: var(--text-main); display: block; margin-bottom: 0.35rem;">Nenhum suprimento cadastrado ainda</strong>
              <span style="font-size: 0.84rem;">Cadastre itens de consumo contínuo do canteiro (ex.: Galão de Água 20L, Tinta de Impressora, Café, Copos, Papel A4).</span>
              <% if (podeGerenciarSup) { %>
                <div style="margin-top: 1rem;">
                  <button type="button" class="btn btn-primary btn-sm" onclick="abrirModalNovoSuprimento()">
                    <i class="fa-solid fa-plus"></i> Cadastrar Primeiro Suprimento
                  </button>
                </div>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Cards Mobile -->
  <div class="mobile-only" style="flex-direction: column; gap: 0.7rem; padding: 0.85rem;">
    <% if (suprimentos && suprimentos.length > 0) { %>
      <% suprimentos.forEach(p => { %>
        <div class="inventory-mobile-card">
          <div class="inventory-mobile-card-header">
            <div>
              <div class="inventory-mobile-title"><%= p.nome %></div>
              <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;">
                <span style="font-family: var(--font-mono);"><%= p.sku %></span> • <%= p.localizacao || 'Canteiro' %>
              </div>
            </div>
            <span class="status-pill <%= p.quantidade === 0 ? 'out-of-stock' : (p.status_estoque === 'BAIXO' ? 'low-stock' : 'in-stock') %>" style="font-size: 0.7rem;">
              <%= p.quantidade %> <%= p.unidade_medida || 'UN' %>
            </span>
          </div>

          <div style="display: flex; justify-content: space-between; font-size: 0.76rem; color: var(--text-muted); background: var(--bg-surface); padding: 0.45rem 0.65rem; border-radius: 6px;">
            <span>Média: <strong style="color: #B91C1C;"><%= p.mediaDiaria > 0 ? p.mediaDiaria.toFixed(1).replace('.', ',') + '/dia' : '0' %></strong></span>
            <span>Proj. 30d: <strong style="color: var(--primary);"><%= p.projecao30d %></strong></span>
            <span>Dura: <strong><%= p.diasCobertura !== null ? `~${p.diasCobertura}d` : 'Estável' %></strong></span>
          </div>

          <div style="display: flex; gap: 0.45rem;">
            <% if (podeDarSaidaSup) { %>
              <button
                type="button"
                class="btn btn-outline btn-sm"
                style="flex: 1; color: #DC2626; border-color: #FECACA; font-weight: 700;"
                onclick="abrirModalMovSuprimento(<%= p.id %>, '<%= p.nome.replace(/'/g, "\\'") %>', '<%= p.unidade_medida || 'UN' %>', <%= p.quantidade %>, 'SAIDA')"
                <%= p.quantidade <= 0 ? 'disabled' : '' %>
              >
                <i class="fa-solid fa-minus"></i> Consumo
              </button>
            <% } %>
            <% if (podeGerenciarSup) { %>
              <button
                type="button"
                class="btn btn-outline btn-sm"
                style="flex: 1; color: #059669; border-color: #A7F3D0; font-weight: 700;"
                onclick="abrirModalMovSuprimento(<%= p.id %>, '<%= p.nome.replace(/'/g, "\\'") %>', '<%= p.unidade_medida || 'UN' %>', <%= p.quantidade %>, 'ENTRADA')"
              >
                <i class="fa-solid fa-plus"></i> Repor
              </button>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted);">
        Nenhum suprimento cadastrado ainda.
      </div>
    <% } %>
  </div>
</div>

<!-- Histórico Recente de Abastecimentos e Entradas de Suprimentos -->
<% if (ultimasMovimentacoes && ultimasMovimentacoes.length > 0) { %>
  <div class="table-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 0.95rem 1.25rem; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
      <h3 style="font-size: 0.96rem; font-weight: 800; margin: 0;">
        <i class="fa-solid fa-clock-rotate-left" style="color: var(--primary); margin-right: 6px;"></i>
        Últimos Registros de Suprimentos
      </h3>
      <a href="/relatorios?tipo_relatorio=movimentacoes&categoria=Suprimentos" style="font-size: 0.78rem; font-weight: 700; color: var(--primary); text-decoration: none;">
        Ver Relatório Completo →
      </a>
    </div>
    <div class="table-responsive">
      <table class="clean-table">
        <thead>
          <tr>
            <th>Data / Hora</th>
            <th>Operação</th>
            <th>Suprimento</th>
            <th style="text-align: center;">Qtd</th>
            <th>Local / Destino</th>
            <th>Responsável</th>
          </tr>
        </thead>
        <tbody>
          <% ultimasMovimentacoes.forEach(m => { %>
            <tr>
              <td style="font-size: 0.78rem; color: var(--text-muted);"><%= formatDate(m.criado_em) %></td>
              <td>
                <span class="status-pill <%= m.tipo === 'ENTRADA' ? 'in-stock' : 'out-of-stock' %>" style="font-size: 0.7rem;">
                  <%= m.tipo === 'ENTRADA' ? 'Reposição' : 'Consumo' %>
                </span>
              </td>
              <td style="font-weight: 700; font-size: 0.84rem;"><%= m.produto_nome %></td>
              <td style="text-align: center; font-weight: 800; color: <%= m.tipo === 'ENTRADA' ? '#047857' : '#B91C1C' %>;">
                <%= m.tipo === 'ENTRADA' ? '+' : '-' %><%= m.quantidade %> <small style="color: var(--text-dim);"><%= m.produto_unidade %></small>
              </td>
              <td style="font-size: 0.82rem;">
                <div><%= m.colaborador || 'Canteiro' %></div>
                <% if (m.motivo) { %><div style="font-size: 0.71rem; color: var(--text-dim);"><%= m.motivo %></div><% } %>
              </td>
              <td style="font-size: 0.8rem; color: var(--text-muted);"><%= m.responsavel || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- MODAL: NOVO SUPRIMENTO -->
<% if (podeGerenciarSup) { %>
<div class="modal-overlay" id="modal-novo-suprimento">
  <div class="modal-container" style="max-width: 560px;">
    <div class="modal-header">
      <h3 style="font-size: 1.08rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-droplet" style="color: #0D9488;"></i> Cadastrar Novo Suprimento
      </h3>
      <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-novo-suprimento')">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/suprimentos" method="POST">
      <div class="modal-body" style="display: flex; flex-direction: column; gap: 0.9rem;">
        <div class="form-group" style="margin: 0;">
          <label class="form-label" for="sup-nome">Descrição do Suprimento <span style="color: var(--danger);">*</span></label>
          <input type="text" id="sup-nome" name="nome" class="form-control" placeholder="Ex: Galão de Água Mineral 20L, Tinta Epson Preta 664..." required>
        </div>

        <div class="form-row-responsive" style="margin: 0;">
          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="sup-sku">Código SKU</label>
            <input type="text" id="sup-sku" name="sku" class="form-control" value="<%= skuSugerido %>" style="text-transform: uppercase; font-family: var(--font-mono);">
          </div>
          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="sup-marca">Marca / Fabricante</label>
            <input type="text" id="sup-marca" name="marca" class="form-control" placeholder="Ex: Epson, Indaiá, Chamex...">
          </div>
        </div>

        <div class="form-row-responsive" style="margin: 0;">
          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="sup-qtd">Saldo Inicial</label>
            <input type="number" id="sup-qtd" name="quantidade" class="form-control" min="0" value="0">
          </div>
          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="sup-min">Estoque Mínimo (Alerta)</label>
            <input type="number" id="sup-min" name="estoque_minimo" class="form-control" min="0" value="5">
          </div>
          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="sup-un">Unidade</label>
            <select id="sup-un" name="unidade_medida" class="form-control">
              <option value="UN">UN - Unidade</option>
              <option value="GL">GL - Galão</option>
              <option value="CX">CX - Caixa</option>
              <option value="PCT">PCT - Pacote</option>
              <option value="FD">FD - Fardo</option>
              <option value="FR">FR - Frasco</option>
              <option value="RL">RL - Rolo</option>
              <option value="L">L - Litro</option>
              <option value="KG">KG - Kg</option>
            </select>
          </div>
        </div>

        <div class="form-row-responsive" style="margin: 0;">
          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="sup-loc">Localização no Canteiro</label>
            <input type="text" id="sup-loc" name="localizacao" class="form-control" placeholder="Ex: Copa, Escritório, Depósito...">
          </div>
          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="sup-tag">Etiqueta / TAG</label>
            <input type="text" id="sup-tag" name="tag" class="form-control" value="SUPRIMENTO" style="text-transform: uppercase;">
          </div>
        </div>

        <div class="form-group" style="margin: 0;">
          <label class="form-label" for="sup-obs">Observações (Opcional)</label>
          <input type="text" id="sup-obs" name="observacao" class="form-control" placeholder="Ex: Abastecimento dos 3 bebedouros da obra...">
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.fecharModal('modal-novo-suprimento')">Cancelar</button>
        <button type="submit" class="btn btn-primary">
          <i class="fa-solid fa-check"></i> Salvar Suprimento
        </button>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- MODAL: MOVIMENTAÇÃO RÁPIDA DE SUPRIMENTO (CONSUMO OU REPOSIÇÃO) -->
<% if (podeDarSaidaSup) { %>
<div class="modal-overlay" id="modal-mov-suprimento">
  <div class="modal-container" style="max-width: 480px;">
    <div class="modal-header">
      <h3 id="mov-sup-titulo" style="font-size: 1.05rem; font-weight: 800; margin: 0;">Registrar Suprimento</h3>
      <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-mov-suprimento')">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/suprimentos/movimentar" method="POST">
      <input type="hidden" name="produto_id" id="mov-sup-produto-id">
      <input type="hidden" name="tipo" id="mov-sup-tipo">

      <div class="modal-body" style="display: flex; flex-direction: column; gap: 0.9rem;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: 8px; padding: 0.75rem 0.9rem;">
          <div id="mov-sup-nome" style="font-weight: 800; color: var(--text-main); font-size: 0.94rem;">-</div>
          <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
            Saldo atual em estoque: <strong id="mov-sup-saldo" style="color: var(--primary);">0</strong>
          </div>
        </div>

        <div class="form-group" style="margin: 0;">
          <label class="form-label" for="mov-sup-qtd">Quantidade <span style="color: var(--danger);">*</span></label>
          <input type="number" id="mov-sup-qtd" name="quantidade" class="form-control" min="1" value="1" required>
        </div>

        <div class="form-group" style="margin: 0;">
          <label class="form-label" for="mov-sup-destino" id="mov-sup-label-destino">Local / Setor de Abastecimento</label>
          <input type="text" id="mov-sup-destino" name="local_destino" class="form-control" list="lista-locais-canteiro" placeholder="Ex: Bebedouro Canteiro, Escritório, Refeitório...">
          <datalist id="lista-locais-canteiro">
            <option value="Bebedouro Canteiro">
            <option value="Bebedouro Escritório">
            <option value="Impressora Escritório">
            <option value="Refeitório / Copa">
            <option value="Almoxarifado">
            <option value="Segurança do Trabalho">
            <option value="Frente de Obra">
          </datalist>
        </div>

        <div class="form-group" style="margin: 0;">
          <label class="form-label" for="mov-sup-motivo">Observação / NF (Opcional)</label>
          <input type="text" id="mov-sup-motivo" name="motivo" class="form-control" placeholder="Ex: Troca de galão vazio, reposição de tinta...">
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.fecharModal('modal-mov-suprimento')">Cancelar</button>
        <button type="submit" id="mov-sup-btn-submit" class="btn btn-primary">Confirmar</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
  function abrirModalNovoSuprimento() {
    if (window.abrirModal) window.abrirModal('modal-novo-suprimento');
  }

  function abrirModalMovSuprimento(id, nome, unidade, saldo, tipo) {
    document.getElementById('mov-sup-produto-id').value = id;
    document.getElementById('mov-sup-tipo').value = tipo;
    document.getElementById('mov-sup-nome').textContent = nome;
    document.getElementById('mov-sup-saldo').textContent = `${saldo} ${unidade}`;
    const inputQtd = document.getElementById('mov-sup-qtd');
    inputQtd.value = 1;
    inputQtd.max = tipo === 'SAIDA' ? saldo : '';

    const titulo = document.getElementById('mov-sup-titulo');
    const lblDestino = document.getElementById('mov-sup-label-destino');
    const inputDestino = document.getElementById('mov-sup-destino');
    const btnSubmit = document.getElementById('mov-sup-btn-submit');

    if (tipo === 'ENTRADA') {
      titulo.innerHTML = '<i class="fa-solid fa-arrow-down" style="color: #059669;"></i> Repor Suprimento (Entrada)';
      lblDestino.textContent = 'Origem / Fornecedor';
      inputDestino.value = '';
      inputDestino.placeholder = 'Ex: Fornecedor de Água, Papelaria, Compra NF...';
      btnSubmit.style.background = '#059669';
      btnSubmit.style.borderColor = '#059669';
      btnSubmit.innerHTML = '<i class="fa-solid fa-check"></i> Confirmar Reposição';
    } else {
      titulo.innerHTML = '<i class="fa-solid fa-arrow-up" style="color: #DC2626;"></i> Baixar Consumo no Canteiro (Saída)';
      lblDestino.textContent = 'Local / Ponto de Abastecimento';
      inputDestino.value = '';
      inputDestino.placeholder = 'Ex: Bebedouro Canteiro, Impressora Escritório...';
      btnSubmit.style.background = '#DC2626';
      btnSubmit.style.borderColor = '#DC2626';
      btnSubmit.innerHTML = '<i class="fa-solid fa-check"></i> Confirmar Consumo';
    }

    if (window.abrirModal) window.abrirModal('modal-mov-suprimento');
  }
</script>

<%- include('../layouts/footer') %>
