<%- include('../layouts/header') %>

<!-- Mensagens de Alerta (Sucesso ou Erro) -->
<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho da Página -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Canteiros & Almoxarifados de Obras</h2>
    <p>Gerencie estoques distribuídos entre matriz, canteiros de construção e frentes de serviço.</p>
  </div>

  <div class="page-actions-group">
    <a href="/transferencias/nova" class="btn btn-outline" id="btn-nova-transf-almox">
      <i class="fa-solid fa-arrow-right-arrow-left"></i> Transferir Material
    </a>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal('modal-novo-almoxarifado')" id="btn-add-almoxarifado">
      <i class="fa-solid fa-plus"></i> Novo Canteiro / Almoxarifado
    </button>
  </div>
</div>

<!-- Storaxe KPI Grid para Almoxarifados -->
<%
  let totalItensGlobal = 0;
  let valorGlobalObras = 0;
  almoxarifados.forEach(a => {
    totalItensGlobal += Number(a.total_itens || 0);
    valorGlobalObras += Number(a.valor_patrimonio || 0);
  });
%>
<div class="storaxe-kpi-grid">
  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot teal"></span>
      <span>Total de Unidades Operacionais</span>
    </div>
    <div class="kpi-big-number"><%= almoxarifados.length %> <small style="font-size: 0.85rem; color: var(--text-muted);">unidades</small></div>
    <span class="kpi-comparison-text">Matriz central e canteiros ativos</span>
  </div>

  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot purple"></span>
      <span>Patrimônio Alocado em Obras</span>
    </div>
    <div class="kpi-big-number"><%= formatMoney(valorGlobalObras) %></div>
    <span class="kpi-comparison-text">Em suprimentos distribuídos</span>
  </div>

  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot blue"></span>
      <span>Linhas de Itens Distribuídas</span>
    </div>
    <div class="kpi-big-number"><%= totalItensGlobal %> <small style="font-size: 0.85rem; color: var(--text-muted);">materiais</small></div>
    <span class="kpi-comparison-text">Variedade de insumos em uso</span>
  </div>

  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot <%= requisicoesPendentes && requisicoesPendentes.length > 0 ? 'yellow' : 'cyan' %>"></span>
      <span>Requisições Inter-Obras</span>
    </div>
    <div class="kpi-big-number"><%= requisicoesPendentes ? requisicoesPendentes.length : 0 %> <small style="font-size: 0.85rem; color: var(--text-muted);">pendentes</small></div>
    <span class="kpi-comparison-text"><%= requisicoesPendentes && requisicoesPendentes.length > 0 ? 'Aguardando despacho' : 'Todas as obras atendidas' %></span>
  </div>
</div>

<!-- GRID DE CARDS DOS CANTEIROS & ALMOXARIFADOS -->
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
  <% almoxarifados.forEach(alm => { %>
    <div class="table-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 1.5rem; border-top: 4px solid <%= alm.tipo === 'CENTRAL' ? 'var(--primary)' : 'var(--teal)' %>;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.65rem;">
            <div style="width: 42px; height: 42px; border-radius: var(--radius-md); background: <%= alm.tipo === 'CENTRAL' ? 'var(--primary-light)' : 'var(--teal-bg)' %>; color: <%= alm.tipo === 'CENTRAL' ? 'var(--primary)' : 'var(--teal)' %>; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
              <i class="fa-solid <%= alm.tipo === 'CENTRAL' ? 'fa-building-columns' : 'fa-helmet-safety' %>"></i>
            </div>
            <div>
              <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-main);"><%= alm.nome %></div>
              <span class="report-table-tag"><%= alm.codigo %></span>
            </div>
          </div>
          <span class="status-pill <%= alm.status === 'ATIVO' ? 'in-stock' : 'out-of-stock' %>">
            <span class="status-dot-sm"></span> <%= alm.status %>
          </span>
        </div>

        <div style="font-size: 0.85rem; color: var(--text-body); margin-bottom: 1rem; line-height: 1.5;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
            <i class="fa-solid fa-location-dot" style="color: var(--text-dim); width: 14px;"></i>
            <span><%= alm.endereco || 'Endereço não informado' %></span>
          </div>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
            <i class="fa-solid fa-user-shield" style="color: var(--text-dim); width: 14px;"></i>
            <span>Responsável: <strong><%= alm.responsavel || 'Não designado' %></strong></span>
          </div>
          <% if (alm.telefone) { %>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <i class="fa-solid fa-phone" style="color: var(--text-dim); width: 14px;"></i>
              <span><%= alm.telefone %></span>
            </div>
          <% } %>
        </div>

        <!-- Indicadores rápidos do Almoxarifado -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem 1rem; display: flex; justify-content: space-around; text-align: center; margin-bottom: 1.25rem;">
          <div>
            <div style="font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Itens Distintos</div>
            <div style="font-size: 1.15rem; font-weight: 800; color: var(--text-main);"><%= alm.total_itens || 0 %></div>
          </div>
          <div style="width: 1px; background: var(--border-color);"></div>
          <div>
            <div style="font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Saldo em Peças</div>
            <div style="font-size: 1.15rem; font-weight: 800; color: var(--teal);"><%= alm.total_unidades || 0 %></div>
          </div>
          <div style="width: 1px; background: var(--border-color);"></div>
          <div>
            <div style="font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Patrimônio</div>
            <div style="font-size: 1.05rem; font-weight: 800; color: var(--primary);"><%= formatMoney(alm.valor_patrimonio || 0) %></div>
          </div>
        </div>
      </div>

      <!-- Ações do Canteiro -->
      <div style="display: flex; gap: 0.5rem; border-top: 1px solid var(--border-light); padding-top: 1rem;">
        <a href="/almoxarifados/<%= alm.id %>" class="btn btn-outline btn-sm" style="flex: 1; justify-content: center;" title="Ver Ficha e Inventário do Canteiro">
          <i class="fa-solid fa-boxes-stacked"></i> Ver Inventário
        </a>
        <a href="/transferencias/nova?origem_id=<%= alm.id %>" class="btn btn-outline btn-sm" style="flex: 1; justify-content: center;" title="Transferir a partir deste canteiro">
          <i class="fa-solid fa-arrow-right-arrow-left"></i> Transferir
        </a>
      </div>
    </div>
  <% }) %>
</div>

<!-- TABELA DE REQUISIÇÕES PENDENTES ENTRE OBRAS -->
<div class="table-card">
  <div class="storaxe-card-header">
    <div class="storaxe-card-title">
      <i class="fa-solid fa-list-check" style="color: var(--primary);"></i>
      <span>Requisições de Materiais Aguardando Envio</span>
    </div>
    <a href="/transferencias" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-clock-rotate-left"></i> Painel Geral de Transferências
    </a>
  </div>

  <div class="table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>DATA</th>
          <th>SOLICITANTE</th>
          <th>ESTOQUE DESTINO</th>
          <th>ESTOQUE ORIGEM</th>
          <th>MATERIAL</th>
          <th>QUANTIDADE</th>
          <th>STATUS</th>
          <th style="text-align: right;">AÇÃO</th>
        </tr>
      </thead>
      <tbody>
        <% if (requisicoesPendentes && requisicoesPendentes.length > 0) { %>
          <% requisicoesPendentes.forEach(req => { %>
            <tr>
              <td>
                <span style="font-size: 0.82rem; font-weight: 600;"><%= formatDate(req.criado_em) %></span>
              </td>
              <td>
                <strong style="color: var(--text-main); font-size: 0.85rem;"><%= req.solicitante %></strong>
              </td>
              <td>
                <strong style="font-weight: 600; color: var(--text-main);"><%= req.almoxarifado_destino_nome %></strong>
              </td>
              <td>
                <span style="color: var(--text-body);"><%= req.almoxarifado_origem_nome %></span>
              </td>
              <td>
                <div style="font-weight: 600; color: var(--text-main);"><%= req.produto_nome %></div>
                <span class="report-table-tag"><%= req.produto_sku %></span>
              </td>
              <td>
                <strong style="color: var(--teal); font-size: 0.95rem;"><%= req.quantidade %></strong>
                <span style="font-size: 0.75rem; color: var(--text-dim);"><%= req.produto_unidade %></span>
              </td>
              <td>
                <span class="status-pill low-stock"><span class="status-dot-sm"></span> <%= req.status %></span>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <form action="/requisicoes/<%= req.id %>/atender" method="POST" style="display: inline;">
                  <input type="hidden" name="responsavel" value="Almoxarife Geral">
                  <button type="submit" class="btn btn-primary btn-sm" title="Aprovar e transferir material imediatamente">
                    <i class="fa-solid fa-check"></i> Atender Requisição
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
              Nenhuma requisição de material pendente entre canteiros no momento.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- MODAL CADASTRAR NOVO ALMOXARIFADO / CANTEIRO -->
<div class="modal-overlay" id="modal-novo-almoxarifado">
  <div class="modal-card" style="max-width: 600px;">
    <div class="modal-header">
      <div style="display: flex; align-items: center; gap: 0.65rem;">
        <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center;">
          <i class="fa-solid fa-helmet-safety"></i>
        </div>
        <h3>Cadastrar Canteiro ou Almoxarifado</h3>
      </div>
      <button type="button" class="modal-close" onclick="window.fecharModal('modal-novo-almoxarifado')">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/almoxarifados" method="POST">
      <div class="modal-body">
        <div class="form-grid">
          <!-- Nome da Obra -->
          <div class="form-group full-width">
            <label class="form-label" for="alm-nome">Nome da Obra / Unidade</label>
            <input type="text" id="alm-nome" name="nome" class="form-control" placeholder="Ex: Canteiro Residencial Aurora II" required>
          </div>

          <!-- Código Interno -->
          <div class="form-group">
            <label class="form-label" for="alm-codigo">Código / Sigla</label>
            <input type="text" id="alm-codigo" name="codigo" class="form-control" placeholder="Ex: OBRA-AURORA" style="text-transform: uppercase;" required>
          </div>

          <!-- Tipo -->
          <div class="form-group">
            <label class="form-label" for="alm-tipo">Tipo de Instalação</label>
            <select id="alm-tipo" name="tipo" class="form-select">
              <option value="OBRA" selected>Canteiro de Obras (Frente de Serviço)</option>
              <option value="CENTRAL">Almoxarifado Central (Matriz / Depósito)</option>
              <option value="AVANCADO">Almoxarifado Avançado / Apoio</option>
            </select>
          </div>

          <!-- Responsável -->
          <div class="form-group">
            <label class="form-label" for="alm-responsavel">Encarregado / Responsável</label>
            <input type="text" id="alm-responsavel" name="responsavel" class="form-control" placeholder="Ex: Eng. Carlos Santana">
          </div>

          <!-- Telefone -->
          <div class="form-group">
            <label class="form-label" for="alm-telefone">Telefone / Rádio</label>
            <input type="text" id="alm-telefone" name="telefone" class="form-control" placeholder="(11) 98765-4321">
          </div>

          <!-- Endereço -->
          <div class="form-group full-width">
            <label class="form-label" for="alm-endereco">Endereço da Obra</label>
            <input type="text" id="alm-endereco" name="endereco" class="form-control" placeholder="Ex: Av. das Palmeiras, 1400 - Setor Sul">
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="window.fecharModal('modal-novo-almoxarifado')">Cancelar</button>
        <button type="submit" class="btn btn-primary">
          <i class="fa-solid fa-check"></i> Cadastrar Canteiro
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
