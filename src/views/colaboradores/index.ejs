    document.getElementById('form-colab-nome').value = '';
    document.getElementById('form-colab-matricula').value = '';
    document.getElementById('form-colab-cargo').value = '';
    document.getElementById('form-colab-depto').value = '';
    document.getElementById('form-colab-telefone').value = '';
    document.getElementById('form-colab-email').value = '';
    document.getElementById('form-colab-status').value = 'ATIVO';
    document.getElementById('form-colab-obs').value = '';
