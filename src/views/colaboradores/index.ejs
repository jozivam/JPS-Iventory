<%- include('../layouts/header') %>

<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho da Página -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Gestão de Colaboradores e Usuários</h2>
    <p>Cadastre a equipe técnica para requisições no balcão e gerencie os níveis de acesso dos operadores do sistema.</p>
  </div>

  <% const podeCadastrarColab = typeof usuarioLogado !== 'undefined' && usuarioLogado && ['ADMIN', 'ALMOXARIFE', 'OPERADOR_FICHAS'].includes(usuarioLogado.nivel_acesso); %>
  <% const isAdminLogado = typeof usuarioLogado !== 'undefined' && usuarioLogado && usuarioLogado.nivel_acesso === 'ADMIN'; %>
  <% if (podeCadastrarColab) { %>
    <div class="page-actions-group">
      <button type="button" class="btn btn-primary" onclick="abrirModalNovoColaborador()">
        <i class="fa-solid fa-user-plus"></i> <%= isAdminLogado ? 'Novo Colaborador / Usuário' : 'Novo Colaborador' %>
      </button>
    </div>
  <% } %>
</div>

<!-- Cards de Indicadores (KPIs) -->
<div class="balcao-kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));">
  
  <!-- Total de Pessoas Cadastradas -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid var(--primary);">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #EEF2FF; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-users"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Total Cadastrado</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
        <%= estatisticas.total %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">pessoa(s)</span>
      </div>
    </div>
  </div>

  <!-- Usuários do Sistema -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #8B5CF6;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #F5F3FF; color: #7C3AED; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-id-card-clip"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Usuários do Sistema</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #6D28D9; line-height: 1.2;">
        <%= estatisticas.sistema %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">operador(es)</span>
      </div>
    </div>
  </div>

  <!-- Técnicos de Campo (Apenas Balcão) -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #F59E0B;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-wrench"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Técnicos (Balcão)</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #B45309; line-height: 1.2;">
        <%= estatisticas.tecnicos %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">solicitante(s)</span>
      </div>
    </div>
  </div>

  <!-- Colaboradores Ativos -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #10B981;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #D1FAE5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-user-check"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Equipe Ativa</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #047857; line-height: 1.2;">
        <%= estatisticas.ativos %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">ativo(s)</span>
      </div>
    </div>
  </div>

</div>

<!-- Barra de Filtros e Busca -->
<div class="table-card" style="padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
  <form action="/colaboradores" method="GET" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin: 0;">
    
    <!-- Campo de Busca com Dropdown Inteligente e Autocomplete Desabilitado -->
    <div style="flex: 1; min-width: 240px; position: relative;" id="colab-busca-wrapper">
      <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-dim); z-index: 2; pointer-events: none;"></i>
      <input 
        type="text" 
        id="colab-busca-input"
        name="busca" 
        class="form-control" 
        placeholder="Buscar por nome, cargo, matrícula, departamento ou e-mail..." 
        value="<%= filtros.busca %>"
        autocomplete="off"
        style="padding-left: 2.5rem; padding-right: 2.4rem; height: 40px; font-weight: 500;"
      >
      <button 
        type="button" 
        id="btn-limpar-colab-busca" 
        title="Limpar busca"
        onclick="limparBuscaColaboradorTela()"
        style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--text-dim); cursor: pointer; display: <%= filtros.busca ? 'flex' : 'none' %>; width: 28px; height: 28px; align-items: center; justify-content: center; border-radius: 50%; z-index: 2;"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>

      <!-- Dropdown Flutuante de Sugestões -->
      <div id="colab-busca-dropdown" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #ffffff; border: 1.5px solid var(--border-color); border-radius: 8px; box-shadow: 0 12px 28px rgba(0,0,0,0.12); max-height: 320px; overflow-y: auto; z-index: 1050; padding: 0.35rem 0;">
        <!-- Sugestões injetadas via JS -->
      </div>
    </div>

    <!-- Filtro Tipo de Perfil -->
    <div style="min-width: 170px;">
      <select name="tipo_perfil" class="form-control" style="height: 40px;" onchange="this.form.submit()">
        <option value="">Todos os Perfis</option>
        <option value="TECNICO" <%= filtros.tipo_perfil === 'TECNICO' ? 'selected' : '' %>>Técnicos (Apenas Balcão)</option>
        <option value="SISTEMA" <%= filtros.tipo_perfil === 'SISTEMA' ? 'selected' : '' %>>Usuários do Sistema</option>
      </select>
    </div>

    <!-- Filtro Nível de Acesso -->
    <div style="min-width: 170px;">
      <select name="nivel_acesso" class="form-control" style="height: 40px;" onchange="this.form.submit()">
        <option value="">Todos os Níveis</option>
        <option value="SOLICITANTE" <%= filtros.nivel_acesso === 'SOLICITANTE' ? 'selected' : '' %>>Solicitante de Balcão</option>
        <option value="ADMIN" <%= filtros.nivel_acesso === 'ADMIN' ? 'selected' : '' %>>Administrador</option>
        <option value="ALMOXARIFE" <%= filtros.nivel_acesso === 'ALMOXARIFE' ? 'selected' : '' %>>Almoxarife / Atendente</option>
        <option value="OPERADOR_FICHAS" <%= filtros.nivel_acesso === 'OPERADOR_FICHAS' ? 'selected' : '' %>>Operador de Fichas</option>
        <option value="VISUALIZADOR" <%= filtros.nivel_acesso === 'VISUALIZADOR' ? 'selected' : '' %>>Visualizador</option>
      </select>
    </div>

    <!-- Filtro Status -->
    <div style="min-width: 130px;">
      <select name="status" class="form-control" style="height: 40px;" onchange="this.form.submit()">
        <option value="">Todos Status</option>
        <option value="ATIVO" <%= filtros.status === 'ATIVO' ? 'selected' : '' %>>Ativo</option>
        <option value="INATIVO" <%= filtros.status === 'INATIVO' ? 'selected' : '' %>>Inativo</option>
      </select>
    </div>

    <!-- Botões -->
    <button type="submit" class="btn btn-primary" style="height: 40px; padding: 0 1.1rem;">
      <i class="fa-solid fa-filter"></i> Filtrar
    </button>

    <% if (filtros.busca || filtros.tipo_perfil || filtros.nivel_acesso || filtros.status) { %>
      <a href="/colaboradores" class="btn btn-outline" style="height: 40px; padding: 0 0.9rem;" title="Limpar Filtros">
        <i class="fa-solid fa-xmark"></i>
      </a>
    <% } %>

  </form>
</div>

<!-- Tabela de Colaboradores e Usuários (Desktop e Tablets) -->
<div class="table-card" style="padding: 0; overflow: hidden;">
  <div class="table-responsive desktop-only">
    <table class="data-table">
      <thead>
        <tr>
          <th>COLABORADOR / IDENTIFICAÇÃO</th>
          <th>CARGO & DEPARTAMENTO</th>
          <th>PERFIL & NÍVEL DE ACESSO</th>
          <th>CONTATO (WHATSAPP / E-MAIL)</th>
          <th>STATUS</th>
          <th style="text-align: right; width: 140px;">AÇÕES</th>
        </tr>
      </thead>
      <tbody>
        <% if (colaboradores && colaboradores.length > 0) { %>
          <% colaboradores.forEach(c => { %>
            <tr style="cursor: pointer;" onclick="abrirModalDetalhesColaborador('<%= c.id %>')">
              
              <!-- Nome e Matrícula -->
              <td>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                  <div style="width: 38px; height: 38px; border-radius: 50%; background: <%= c.tipo_perfil === 'SISTEMA' ? '#EDE9FE' : '#FEF3C7' %>; color: <%= c.tipo_perfil === 'SISTEMA' ? '#6D28D9' : '#B45309' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">
                    <%= c.nome.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
                  </div>
                  <div>
                    <div style="font-weight: 700; color: var(--text-main); font-size: 0.92rem;">
                      <%= c.nome %>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1px;">
                      <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim);">
                        <%= c.matricula || 'SEM MATRÍCULA' %>
                      </span>
                      <% if (c.tipo_perfil === 'SISTEMA' && c.login) { %>
                        <span style="font-size: 0.72rem; color: #6D28D9; font-weight: 700; background: #F5F3FF; padding: 1px 6px; border-radius: 4px; border: 1px solid #DDD6FE;">
                          <i class="fa-solid fa-at" style="font-size: 0.65rem;"></i><%= c.login %>
                        </span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Cargo e Departamento -->
              <td>
                <div style="font-weight: 600; color: var(--text-body);">
                  <%= c.cargo || 'Função não especificada' %>
                </div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                  <%= c.departamento || 'Geral' %>
                </div>
              </td>

              <!-- Perfil e Nível de Acesso -->
              <td>
                <% if (c.tipo_perfil === 'SISTEMA') { %>
                  <% if (c.nivel_acesso === 'ADMIN') { %>
                    <span class="status-pill" style="background: #EDE9FE; color: #6D28D9; border: 1px solid #DDD6FE;">
                      <i class="fa-solid fa-crown" style="font-size: 0.7rem;"></i> Administrador
                    </span>
                  <% } else if (c.nivel_acesso === 'ALMOXARIFE') { %>
                    <span class="status-pill in-stock">
                      <i class="fa-solid fa-boxes-packing" style="font-size: 0.7rem;"></i> Almoxarife (Operador)
                    </span>
                  <% } else if (c.nivel_acesso === 'OPERADOR_FICHAS') { %>
                    <span class="status-pill" style="background: #CCFBF1; color: #0F766E; border: 1px solid #99F6E4;">
                      <i class="fa-solid fa-clipboard-check" style="font-size: 0.7rem;"></i> Operador de Fichas
                    </span>
                  <% } else { %>
                    <span class="status-pill" style="background: #E0F2FE; color: #0369A1; border: 1px solid #BAE6FD;">
                      <i class="fa-solid fa-eye" style="font-size: 0.7rem;"></i> Visualizador
                    </span>
                  <% } %>
                <% } else { %>
                  <span class="status-pill" style="background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D;">
                    <i class="fa-solid fa-wrench" style="font-size: 0.7rem;"></i> Técnico (Apenas Balcão)
                  </span>
                <% } %>
              </td>

              <!-- Contato -->
              <td>
                <div style="display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.82rem;">
                  <% if (c.telefone) { %>
                    <span style="color: var(--text-body); display: inline-flex; align-items: center; gap: 0.35rem;">
                      <i class="fa-brands fa-whatsapp" style="color: #10B981;"></i> <%= c.telefone %>
                    </span>
                  <% } %>
                  <% if (c.email) { %>
                    <span style="color: var(--text-muted); font-size: 0.78rem; display: inline-flex; align-items: center; gap: 0.35rem;">
                      <i class="fa-regular fa-envelope"></i> <%= c.email %>
                    </span>
                  <% } %>
                  <% if (!c.telefone && !c.email) { %>
                    <span style="color: var(--text-dim);">-</span>
                  <% } %>
                </div>
              </td>

              <!-- Status -->
              <td>
                <% if (c.status === 'ATIVO') { %>
                  <span class="status-pill in-stock">
                    <span class="status-dot-sm"></span> Ativo
                  </span>
                <% } else { %>
                  <span class="status-pill" style="background: #F1F5F9; color: #64748B; border: 1px solid #CBD5E1;">
                    <span class="status-dot-sm" style="background: #94A3B8;"></span> Inativo
                  </span>
                <% } %>
              </td>

              <!-- Ações -->
              <td style="text-align: right;" onclick="event.stopPropagation()">
                <div style="display: inline-flex; gap: 0.35rem;">
                  <a href="/fichas?colaborador_id=<%= c.id %>" class="btn btn-outline btn-sm" title="Ver Ficha Individual de Movimentações" style="color: #4F46E5; border-color: #C7D2FE; font-weight: 700;">
                    <i class="fa-solid fa-file-invoice"></i> Ficha
                  </a>
                  <% if (isAdminLogado) { %>
                    <button type="button" class="btn btn-outline btn-sm" title="Ver Detalhes e Nível de Acesso" onclick="abrirModalDetalhesColaborador('<%= c.id %>')">
                      <i class="fa-solid fa-shield-halved" style="color: var(--primary);"></i>
                    </button>
                  <% } %>
                  <% if (podeCadastrarColab && (isAdminLogado || c.tipo_perfil !== 'SISTEMA')) { %>
                    <button type="button" class="btn btn-outline btn-sm" title="Editar Cadastro" onclick="abrirModalEditarColaborador('<%= c.id %>')">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </button>
                  <% } %>
                  <% if (isAdminLogado) { %>
                    <form action="/colaboradores/<%= c.id %>/excluir" method="POST" style="display: inline;" onsubmit="return confirm('Tem certeza de que deseja remover o cadastro de <%= c.nome %>?')">
                      <button type="submit" class="btn btn-outline btn-sm" title="Excluir Colaborador" style="color: var(--danger); border-color: #FECACA;">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>

            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
              <i class="fa-solid fa-users-slash" style="font-size: 2rem; color: var(--border-color); margin-bottom: 0.75rem; display: block;"></i>
              Nenhum colaborador ou usuário encontrado com os filtros selecionados.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Cards Otimizados para Celular (Mobile) -->
  <div class="mobile-only" style="flex-direction: column; gap: 0.65rem; padding: 0.85rem;">
    <% if (colaboradores && colaboradores.length > 0) { %>
      <% colaboradores.forEach(c => { %>
        <div class="inventory-mobile-card" onclick="abrirModalDetalhesColaborador('<%= c.id %>')">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem;">
            <div style="display: flex; align-items: center; gap: 0.65rem;">
              <div style="width: 34px; height: 34px; border-radius: 50%; background: <%= c.tipo_perfil === 'SISTEMA' ? '#EDE9FE' : '#FEF3C7' %>; color: <%= c.tipo_perfil === 'SISTEMA' ? '#6D28D9' : '#B45309' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem; flex-shrink: 0;">
                <%= c.nome.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
              </div>
              <div>
                <div style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;">
                  <%= c.nome %>
                </div>
                <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim);">
                  <%= c.matricula || 'Sem matrícula' %>
                </div>
              </div>
            </div>

            <div>
              <% if (c.status === 'ATIVO') { %>
                <span class="status-pill in-stock" style="font-size: 0.7rem; padding: 2px 7px;"><span class="status-dot-sm"></span> Ativo</span>
              <% } else { %>
                <span class="status-pill" style="font-size: 0.7rem; padding: 2px 7px; background: #F1F5F9; color: #64748B;"><span class="status-dot-sm" style="background: #94A3B8;"></span> Inativo</span>
              <% } %>
            </div>
          </div>

          <div style="font-size: 0.82rem; color: var(--text-body); margin-bottom: 0.5rem;">
            <strong><%= c.cargo || 'Técnico' %></strong> • <%= c.departamento || 'Geral' %>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.5rem; border-top: 1px solid var(--border-light); font-size: 0.78rem;">
            <div>
              <% if (c.tipo_perfil === 'SISTEMA') { %>
                <% if (c.nivel_acesso === 'OPERADOR_FICHAS') { %>
                  <span class="status-pill" style="background: #CCFBF1; color: #0F766E; border: 1px solid #99F6E4; font-size: 0.72rem;">
                    <i class="fa-solid fa-clipboard-check"></i> Operador de Fichas
                  </span>
                <% } else { %>
                  <span class="status-pill" style="background: #EDE9FE; color: #6D28D9; border: 1px solid #DDD6FE; font-size: 0.72rem;">
                    <i class="fa-solid fa-id-card-clip"></i> <%= c.nivel_acesso %>
                  </span>
                <% } %>
              <% } else { %>
                <span class="status-pill" style="background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D; font-size: 0.72rem;">
                  <i class="fa-solid fa-wrench"></i> Técnico (Balcão)
                </span>
              <% } %>
            </div>

            <div style="display: flex; gap: 0.4rem;" onclick="event.stopPropagation()">
              <a href="/fichas?colaborador_id=<%= c.id %>" class="btn btn-outline btn-sm" style="color: #4F46E5; border-color: #C7D2FE; font-weight: 700;">
                <i class="fa-solid fa-file-invoice"></i> Ficha
              </a>
              <% if (isAdminLogado) { %>
                <button type="button" class="btn btn-outline btn-sm" onclick="abrirModalDetalhesColaborador('<%= c.id %>')">
                  <i class="fa-solid fa-shield-halved"></i> Acesso
                </button>
              <% } %>
              <% if (podeCadastrarColab && (isAdminLogado || c.tipo_perfil !== 'SISTEMA')) { %>
                <button type="button" class="btn btn-outline btn-sm" onclick="abrirModalEditarColaborador('<%= c.id %>')">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: 0.85rem;">
        Nenhum colaborador encontrado.
      </div>
    <% } %>
  </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL DE DETALHES & GESTÃO DE NÍVEL DE ACESSO DO COLABORADOR              -->
<!-- ========================================================================= -->
<div class="modal-overlay" id="modal-detalhes-colaborador">
  <div class="modal-container" style="max-width: 620px;">
    
    <!-- Cabeçalho do Modal -->
    <div class="modal-header" style="border-bottom: 1px solid var(--border-light); padding-bottom: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.85rem;">
        <div id="modal-view-avatar" style="width: 46px; height: 46px; border-radius: 50%; background: #EEF2FF; color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; flex-shrink: 0;">
          JS
        </div>
        <div>
          <h3 id="modal-view-nome" style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); margin: 0;">
            Nome do Colaborador
          </h3>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 3px;">
            <span id="modal-view-matricula" class="badge" style="background: var(--bg-surface); font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem;">
              MAT-001
            </span>
            <span id="modal-view-status-pill" class="status-pill in-stock" style="font-size: 0.72rem; padding: 1px 7px;">
              Ativo
            </span>
          </div>
        </div>
      </div>

      <button type="button" class="btn btn-secondary btn-icon" onclick="fecharModalDetalhesColaborador()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="modal-body" style="padding: 1.25rem; max-height: calc(85vh - 140px); overflow-y: auto;">
      
      <!-- SEÇÃO 1: DEFINIÇÃO DE NÍVEL DE ACESSO (O PONTO CHAVE DA SOLICITAÇÃO) -->
      <div style="background: #F8FAFC; border: 1.5px solid var(--border-color); border-radius: 10px; padding: 1.15rem; margin-bottom: 1.25rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
          <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.4rem;">
            <i class="fa-solid fa-shield-halved" style="color: var(--primary);"></i> Nível de Acesso no Sistema
          </h4>
          <span id="modal-view-badge-perfil" class="status-pill" style="font-size: 0.72rem;">
            Técnico (Balcão)
          </span>
        </div>

        <form id="form-alterar-nivel-acesso" action="" method="POST" style="<%= isAdminLogado ? '' : 'display: none;' %>">
          <input type="hidden" name="colaborador_id" id="modal-acesso-colab-id">
          
          <!-- Escolha entre Técnico (Apenas Balcão) e Usuário do Sistema -->
          <div style="margin-bottom: 1rem;">
            <label class="form-label" style="font-weight: 700; margin-bottom: 0.45rem;">
              Tipo de Perfil de Atuação:
            </label>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem;">
              
              <!-- Opção Técnico de Campo -->
              <label class="btn-tipo-op" style="padding: 0.75rem 0.5rem; text-align: left; cursor: pointer; display: flex; flex-direction: row; align-items: center; gap: 0.5rem;">
                <input type="radio" name="tipo_perfil" value="TECNICO" id="radio-perfil-tecnico" onchange="alternarCamposNivelAcesso(this.value)">
                <div>
                  <div style="font-weight: 700; color: var(--text-main); font-size: 0.85rem;">Técnico de Campo</div>
                  <div style="font-size: 0.72rem; color: var(--text-muted);">Apenas solicitações no Balcão</div>
                </div>
              </label>

              <!-- Opção Usuário do Sistema -->
              <label class="btn-tipo-op" style="padding: 0.75rem 0.5rem; text-align: left; cursor: pointer; display: flex; flex-direction: row; align-items: center; gap: 0.5rem;">
                <input type="radio" name="tipo_perfil" value="SISTEMA" id="radio-perfil-sistema" onchange="alternarCamposNivelAcesso(this.value)">
                <div>
                  <div style="font-weight: 700; color: var(--text-main); font-size: 0.85rem;">Usuário do Sistema</div>
                  <div style="font-size: 0.72rem; color: var(--text-muted);">Acesso à plataforma</div>
                </div>
              </label>
            </div>
          </div>

          <!-- Banner Informativo para Técnico -->
          <div id="banner-info-tecnico" style="display: block; padding: 0.75rem 0.85rem; background: #FEF3C7; border: 1px solid #FCD34D; border-radius: 8px; font-size: 0.82rem; color: #92400E; margin-bottom: 1rem; line-height: 1.4;">
            <i class="fa-solid fa-circle-info" style="margin-right: 4px;"></i>
            <strong>Perfil Técnico:</strong> Este colaborador tem permissão <strong>exclusiva para solicitações e retiradas de materiais no Balcão</strong> do almoxarifado. Não possui permissão de login ou gestão do sistema.
          </div>

          <!-- Seleção de Nível de Acesso (Exclusivo para Usuários do Sistema) -->
          <div id="box-nivel-acesso-sistema" style="display: none; margin-bottom: 1rem; background: #ffffff; padding: 0.85rem; border-radius: 8px; border: 1px solid var(--border-light);">
            <label class="form-label" for="select-nivel-acesso" style="font-weight: 700; margin-bottom: 0.4rem;">
              Defina o Nível de Acesso Operacional:
            </label>
            <select name="nivel_acesso" id="select-nivel-acesso" class="form-control" style="font-weight: 600;">
              <option value="ALMOXARIFE">📦 Almoxarife / Atendente (Lança no Balcão, Movimentações e Inventário)</option>
              <option value="ADMIN">👑 Administrador Geral (Controle total de configurações, dados e equipe)</option>
              <option value="OPERADOR_FICHAS">📋 Operador de Fichas (Visualização e Lançamento em Fichas de Colaboradores)</option>
              <option value="VISUALIZADOR">👁️ Visualizador / Auditor (Apenas consulta de estoque e relatórios)</option>
            </select>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">
              O nível selecionado determina as ações e permissões permitidas a este usuário na plataforma.
            </div>

            <!-- Login e Senha no Modal de Nível de Acesso -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--border-light);">
              <div>
                <label class="form-label" for="modal-acesso-login" style="font-size: 0.78rem; font-weight: 700; margin-bottom: 0.25rem;">
                  Login / Usuário:
                </label>
                <div style="position: relative;">
                  <span style="position: absolute; left: 8px; top: 50%; transform: translateY(-50%); color: var(--text-dim); font-size: 0.8rem; font-weight: 700;">@</span>
                  <input type="text" name="login" id="modal-acesso-login" class="form-control" style="height: 36px; padding-left: 1.6rem; font-size: 0.85rem;" placeholder="ex: jozivam">
                </div>
              </div>

              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.35rem; margin-bottom: 0.25rem;">
                  <label class="form-label" for="modal-acesso-senha" style="font-size: 0.78rem; font-weight: 700; margin: 0;">
                    Alterar Senha:
                  </label>
                  <span id="modal-acesso-badge-senha" style="display: none; font-size: 0.68rem; font-weight: 700; color: #047857; background: #ECFDF5; border: 1px solid #A7F3D0; padding: 1px 6px; border-radius: 9999px;">
                    <i class="fa-solid fa-lock"></i> Senha ativa
                  </span>
                </div>
                <div style="position: relative; display: flex;">
                  <input type="password" name="senha" id="modal-acesso-senha" class="form-control" style="height: 36px; font-size: 0.85rem; padding-right: 2rem;" placeholder="Nova senha (ou vazio p/ manter)" autocomplete="new-password">
                  <button
                    type="button"
                    onclick="toggleMostrarSenha('modal-acesso-senha', this)"
                    style="position: absolute; right: 6px; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: var(--text-muted); cursor: pointer; padding: 4px;"
                    title="Mostrar/Ocultar Senha"
                  >
                    <i class="fa-solid fa-eye"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div style="text-align: right;">
            <button type="submit" class="btn btn-primary btn-sm" style="font-weight: 700; padding: 0.5rem 1rem;">
              <i class="fa-solid fa-floppy-disk"></i> Salvar Nível de Acesso
            </button>
          </div>
        </form>
      </div>

      <!-- SEÇÃO 2: FERRAMENTAS EMPRESTADAS EM ABERTO COM ESTE COLABORADOR -->
      <div style="margin-bottom: 1.25rem;">
        <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.65rem; display: flex; align-items: center; justify-content: space-between;">
          <span><i class="fa-solid fa-hand-holding-hand" style="color: #F59E0B;"></i> Ferramentas com o Colaborador</span>
          <span id="badge-total-emprestimos-abertos" class="badge" style="background: #FEF3C7; color: #B45309; font-size: 0.75rem;">
            0 em aberto
          </span>
        </h4>

        <div id="lista-emprestimos-colaborador" style="display: flex; flex-direction: column; gap: 0.5rem;">
          <!-- Injetado dinamicamente via JS -->
        </div>
      </div>

      <!-- SEÇÃO 3: DADOS CADASTRAIS E CONTATO -->
      <div>
        <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.65rem; display: flex; align-items: center; gap: 0.4rem;">
          <i class="fa-solid fa-address-card" style="color: var(--text-dim);"></i> Dados Cadastrais & Contato
        </h4>

        <div class="grid-form-2col" style="gap: 0.75rem; font-size: 0.85rem;">
          <div style="background: var(--bg-main); padding: 0.65rem 0.85rem; border-radius: 6px;">
            <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">Cargo / Função</div>
            <div id="modal-view-cargo" style="font-weight: 700; color: var(--text-body); margin-top: 2px;">-</div>
          </div>

          <div style="background: var(--bg-main); padding: 0.65rem 0.85rem; border-radius: 6px;">
            <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">Departamento / Setor</div>
            <div id="modal-view-depto" style="font-weight: 700; color: var(--text-body); margin-top: 2px;">-</div>
          </div>

          <div style="background: var(--bg-main); padding: 0.65rem 0.85rem; border-radius: 6px;">
            <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">Telefone / WhatsApp</div>
            <div id="modal-view-telefone" style="font-weight: 700; color: var(--text-body); margin-top: 2px;">-</div>
          </div>

          <div style="background: var(--bg-main); padding: 0.65rem 0.85rem; border-radius: 6px;">
            <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">E-mail Corporativo</div>
            <div id="modal-view-email" style="font-weight: 700; color: var(--text-body); margin-top: 2px;">-</div>
          </div>
        </div>

        <div id="box-observacoes-wrapper" style="margin-top: 0.75rem; background: var(--bg-main); padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.82rem; display: none;">
          <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">Observações</div>
          <div id="modal-view-obs" style="color: var(--text-muted); margin-top: 2px;">-</div>
        </div>
      </div>

    </div>

    <!-- Rodapé do Modal de Detalhes -->
    <div class="modal-footer" style="border-top: 1px solid var(--border-light); padding: 0.85rem 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
        <a href="#" id="link-modal-ver-ficha" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700;">
          <i class="fa-solid fa-file-invoice"></i> Acessar Ficha Completa
        </a>
        <button type="button" class="btn btn-outline" id="btn-modal-editar-dados" onclick="fecharModalDetalhesColaborador(); abrirModalEditarColaborador(colaboradorAtualId);">
          <i class="fa-solid fa-pen-to-square"></i> Editar Dados
        </button>
      </div>

      <button type="button" class="btn btn-secondary" onclick="fecharModalDetalhesColaborador()">
        Fechar
      </button>
    </div>

  </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL DE CADASTRO / EDIÇÃO DE COLABORADOR E USUÁRIO                       -->
<!-- ========================================================================= -->
<div class="modal-overlay" id="modal-form-colaborador">
  <div class="modal-container" style="max-width: 650px;">
    
    <div class="modal-header">
      <h3 id="modal-form-titulo" style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem; margin: 0;">
        <i class="fa-solid fa-user-plus" style="color: var(--primary);"></i> Novo Colaborador / Usuário
      </h3>
      <button type="button" class="btn btn-secondary btn-icon" onclick="fecharModalFormColaborador()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="form-salvar-colaborador" action="/colaboradores" method="POST">
      <input type="hidden" name="colaborador_id" id="form-colab-id" value="">

      <div class="modal-body" style="padding: 1.25rem; max-height: calc(85vh - 140px); overflow-y: auto;">
        
        <!-- Tipo de Cadastro: Técnico vs Usuário -->
        <div style="margin-bottom: 1.25rem; background: #F8FAFC; padding: 0.95rem; border-radius: 8px; border: 1px solid var(--border-color);">
          <label class="form-label" style="font-weight: 700; margin-bottom: 0.5rem;">
            Finalidade do Cadastro:
          </label>
          <div style="display: grid; grid-template-columns: <%= isAdminLogado ? '1fr 1fr' : '1fr' %>; gap: 0.75rem;">
            <label style="background: #ffffff; border: 1.5px solid var(--border-light); border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: flex-start; gap: 0.5rem;">
              <input type="radio" name="tipo_perfil" value="TECNICO" id="form-radio-tecnico" checked onchange="toggleFormNivelAcesso(this.value)" style="margin-top: 3px;">
              <div>
                <strong style="display: block; font-size: 0.88rem; color: var(--text-main);">Colaborador Técnico</strong>
                <span style="font-size: 0.75rem; color: var(--text-muted); line-height: 1.3; display: block; margin-top: 2px;">
                  Solicitante de balcão e ficha individual (retiradas, EPIs, ferramentas e devoluções).
                </span>
              </div>
            </label>

            <% if (isAdminLogado) { %>
              <label style="background: #ffffff; border: 1.5px solid var(--border-light); border-radius: 8px; padding: 0.75rem; cursor: pointer; display: flex; align-items: flex-start; gap: 0.5rem;">
                <input type="radio" name="tipo_perfil" value="SISTEMA" id="form-radio-sistema" onchange="toggleFormNivelAcesso(this.value)" style="margin-top: 3px;">
                <div>
                  <strong style="display: block; font-size: 0.88rem; color: var(--text-main);">Usuário do Sistema</strong>
                  <span style="font-size: 0.75rem; color: var(--text-muted); line-height: 1.3; display: block; margin-top: 2px;">
                    Operador da plataforma (administrador, almoxarife, operador de fichas ou visualizador).
                  </span>
                </div>
              </label>
            <% } %>
          </div>
        </div>

        <!-- Dados Principais -->
        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" for="form-colab-nome">
            Nome Completo <span style="color: var(--danger);">*</span>
          </label>
          <input 
            type="text" 
            id="form-colab-nome" 
            name="nome" 
            class="form-control" 
            placeholder="Ex: Carlos Eduardo Pereira" 
            required
          >
        </div>

        <div class="form-row-responsive" style="margin-bottom: 1rem;">
          <div class="form-group">
            <label class="form-label" for="form-colab-matricula">
              Matrícula / Código
            </label>
            <div style="display: flex; gap: 0.4rem;">
              <input 
                type="text" 
                id="form-colab-matricula" 
                name="matricula" 
                class="form-control" 
                placeholder="Ex: TEC-104"
                style="text-transform: uppercase; font-family: var(--font-mono);"
              >
              <button type="button" class="btn btn-outline btn-sm" onclick="gerarMatriculaAuto()" title="Gerar código automático">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="form-colab-status">
              Status do Cadastro
            </label>
            <select name="status" id="form-colab-status" class="form-control">
              <option value="ATIVO" selected>Ativo (Apto para solicitações)</option>
              <option value="INATIVO">Inativo (Bloqueado no balcão)</option>
            </select>
          </div>
        </div>

        <!-- Cargo e Departamento -->
        <div class="form-row-responsive" style="margin-bottom: 1rem;">
          <div class="form-group">
            <label class="form-label" for="form-colab-cargo">
              Cargo / Função
            </label>
            <input 
              type="text" 
              id="form-colab-cargo" 
              name="cargo" 
              class="form-control" 
              placeholder="Ex: Eletricista de Manutenção"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="form-colab-depto">
              Departamento / Setor
            </label>
            <input 
              type="text" 
              id="form-colab-depto" 
              name="departamento" 
              class="form-control" 
              placeholder="Ex: Manutenção Elétrica / Obras"
            >
          </div>
        </div>

        <!-- Contato: Telefone e Email -->
        <div class="form-row-responsive" style="margin-bottom: 1rem;">
          <div class="form-group">
            <label class="form-label" for="form-colab-telefone">
              Telefone / WhatsApp
            </label>
            <input 
              type="text" 
              id="form-colab-telefone" 
              name="telefone" 
              class="form-control" 
              placeholder="Ex: (11) 98765-4321"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="form-colab-email">
              E-mail
            </label>
            <input 
              type="email" 
              id="form-colab-email" 
              name="email" 
              class="form-control" 
              placeholder="Ex: carlos.pereira@empresa.com"
            >
          </div>
        </div>

        <!-- Seção Nível de Acesso e Credenciais de Login -->
        <div id="form-box-nivel-acesso" style="display: none; background: #EEF2FF; border: 1.5px solid #C7D2FE; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
          <label class="form-label" for="form-colab-nivel-acesso" style="font-weight: 700; color: var(--primary); margin-bottom: 0.35rem;">
            <i class="fa-solid fa-key"></i> Nível de Acesso do Usuário:
          </label>
          <select name="nivel_acesso" id="form-colab-nivel-acesso" class="form-control" style="margin-bottom: 0.85rem;">
            <option value="ALMOXARIFE" selected>Almoxarife / Atendente (Balcão, Movimentações e Itens)</option>
            <option value="ADMIN">Administrador (Controle Total do Sistema)</option>
            <option value="OPERADOR_FICHAS">Operador de Fichas (Visualização e Lançamento em Fichas)</option>
            <option value="VISUALIZADOR">Visualizador (Apenas Leitura e Relatórios)</option>
          </select>

          <!-- Credenciais de Acesso (Login e Senha) -->
          <div style="background: #ffffff; border: 1px solid #C7D2FE; border-radius: 6px; padding: 0.85rem;">
            <div style="font-size: 0.82rem; font-weight: 700; color: #4338CA; margin-bottom: 0.65rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem;">
              <span style="display: inline-flex; align-items: center; gap: 0.35rem;">
                <i class="fa-solid fa-lock"></i> Credenciais de Acesso à Plataforma
              </span>
              <span id="form-badge-status-senha" style="display: none; font-size: 0.72rem; font-weight: 700; color: #047857; background: #ECFDF5; border: 1px solid #A7F3D0; padding: 2px 8px; border-radius: 9999px;">
                <i class="fa-solid fa-shield-check"></i> Senha salva e criptografada
              </span>
            </div>
            
            <div class="form-row-responsive" style="margin-bottom: 0;">
              <!-- Login / Usuário -->
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="form-colab-login" style="font-weight: 700; font-size: 0.8rem;">
                  Login / Usuário <span style="color: var(--danger);">*</span>
                </label>
                <div style="position: relative;">
                  <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-dim); font-weight: 700; font-size: 0.85rem;">@</span>
                  <input 
                    type="text" 
                    id="form-colab-login" 
                    name="login" 
                    class="form-control" 
                    placeholder="ex: jozivam" 
                    style="padding-left: 1.8rem; text-transform: lowercase; height: 38px;"
                    autocomplete="username"
                  >
                </div>
                <span class="form-help" style="font-size: 0.72rem;">Identificador para acessar a tela de login.</span>
              </div>

              <!-- Senha -->
              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" for="form-colab-senha" id="form-label-senha" style="font-weight: 700; font-size: 0.8rem;">
                  Senha de Acesso
                </label>
                <div style="position: relative; display: flex;">
                  <input 
                    type="password" 
                    id="form-colab-senha" 
                    name="senha" 
                    class="form-control" 
                    placeholder="Definir senha..." 
                    style="padding-right: 2.2rem; height: 38px;"
                    autocomplete="new-password"
                  >
                  <button 
                    type="button" 
                    id="btn-olho-form-senha"
                    onclick="toggleMostrarSenha('form-colab-senha', this)" 
                    style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: var(--text-muted); cursor: pointer; padding: 4px;"
                    title="Mostrar/Ocultar Senha"
                  >
                    <i class="fa-solid fa-eye"></i>
                  </button>
                </div>
                <span class="form-help" id="form-help-senha" style="font-size: 0.72rem;">Padrão: <code>123456</code> (ou vazio para manter).</span>
                <div style="display: flex; gap: 0.4rem; margin-top: 0.4rem; flex-wrap: wrap;">
                  <button type="button" class="btn btn-outline btn-sm" onclick="gerarSenhaRapida('form-colab-senha', 'btn-olho-form-senha')" style="font-size: 0.72rem; padding: 0.2rem 0.55rem;">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Gerar Nova Senha
                  </button>
                  <button type="button" class="btn btn-outline btn-sm" id="btn-copiar-credenciais" onclick="copiarCredenciaisForm()" style="font-size: 0.72rem; padding: 0.2rem 0.55rem; color: #4338CA; border-color: #C7D2FE;">
                    <i class="fa-regular fa-copy"></i> Copiar Acesso
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Observações -->
        <div class="form-group">
          <label class="form-label" for="form-colab-obs">
            Observações Gerais (Opcional)
          </label>
          <textarea 
            id="form-colab-obs" 
            name="observacoes" 
            class="form-control" 
            rows="2" 
            placeholder="Anotações internas sobre o colaborador..."
          ></textarea>
        </div>

      </div>

      <div class="modal-footer" style="border-top: 1px solid var(--border-light); padding: 0.85rem 1.25rem;">
        <button type="button" class="btn btn-secondary" onclick="fecharModalFormColaborador()">
          Cancelar
        </button>
        <button type="submit" class="btn btn-primary" id="btn-submit-form-colab">
          <i class="fa-solid fa-check"></i> Salvar Colaborador
        </button>
      </div>

    </form>
  </div>
</div>

<script>
  let colaboradorAtualId = null;
  const IS_ADMIN_LOGADO = <%= isAdminLogado ? 'true' : 'false' %>;
  const PODE_CADASTRAR_COLAB = <%= podeCadastrarColab ? 'true' : 'false' %>;
  const LISTA_COLABORADORES = <%- JSON.stringify(colaboradores || []) %>;

  // Funções Seguras para Abertura e Fechamento de Modais
  function abrirModalSeguro(modalId) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    modal.classList.add('active');
    modal.style.setProperty('display', 'flex', 'important');
    modal.style.setProperty('opacity', '1', 'important');
    modal.style.setProperty('pointer-events', 'auto', 'important');
    modal.style.setProperty('z-index', '99999', 'important');
  }

  function fecharModalSeguro(modalId) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    modal.classList.remove('active');
    modal.style.setProperty('display', 'none', 'important');
    modal.style.removeProperty('opacity');
    modal.style.removeProperty('pointer-events');
  }

  // =========================================================================
  // MODAL DE DETALHES E NÍVEL DE ACESSO
  // =========================================================================
  function abrirModalDetalhesColaborador(id) {
    colaboradorAtualId = id;
    const c = LISTA_COLABORADORES.find(item => String(item.id) === String(id));

    if (!c) {
      alert('Colaborador não encontrado na lista.');
      return;
    }

    // 1. Preenche cabeçalho
    document.getElementById('modal-view-nome').textContent = c.nome;
    document.getElementById('modal-view-matricula').textContent = c.matricula || 'SEM MATRÍCULA';
    document.getElementById('modal-view-avatar').textContent = (c.nome || 'JS').split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
    
    const linkFicha = document.getElementById('link-modal-ver-ficha');
    if (linkFicha) linkFicha.href = `/fichas?colaborador_id=${c.id}`;
    const btnModalEditar = document.getElementById('btn-modal-editar-dados');
    if (btnModalEditar) {
      const podeEditarEste = PODE_CADASTRAR_COLAB && (IS_ADMIN_LOGADO || c.tipo_perfil !== 'SISTEMA');
      btnModalEditar.style.display = podeEditarEste ? 'inline-flex' : 'none';
    }
    
    const statusPill = document.getElementById('modal-view-status-pill');
    if (c.status === 'ATIVO') {
      statusPill.className = 'status-pill in-stock';
      statusPill.innerHTML = '<span class="status-dot-sm"></span> Ativo';
    } else {
      statusPill.className = 'status-pill';
      statusPill.style.background = '#F1F5F9';
      statusPill.style.color = '#64748B';
      statusPill.innerHTML = '<span class="status-dot-sm" style="background: #94A3B8;"></span> Inativo';
    }

    // 2. Preenche Seção de Nível de Acesso
    document.getElementById('modal-acesso-colab-id').value = c.id;
    document.getElementById('form-alterar-nivel-acesso').action = `/colaboradores/${c.id}/nivel-acesso`;

    const badgePerfil = document.getElementById('modal-view-badge-perfil');
    const radioTecnico = document.getElementById('radio-perfil-tecnico');
    const radioSistema = document.getElementById('radio-perfil-sistema');
    const selectNivel = document.getElementById('select-nivel-acesso');

    if (c.tipo_perfil === 'SISTEMA') {
      radioSistema.checked = true;
      badgePerfil.className = 'status-pill';
      const nomesNivel = {
        ADMIN: 'Administrador',
        ALMOXARIFE: 'Almoxarife',
        OPERADOR_FICHAS: 'Operador de Fichas',
        VISUALIZADOR: 'Visualizador'
      };
      if (c.nivel_acesso === 'OPERADOR_FICHAS') {
        badgePerfil.style.background = '#CCFBF1';
        badgePerfil.style.color = '#0F766E';
        badgePerfil.innerHTML = `<i class="fa-solid fa-clipboard-check"></i> ${nomesNivel[c.nivel_acesso]}`;
      } else {
        badgePerfil.style.background = '#EDE9FE';
        badgePerfil.style.color = '#6D28D9';
        badgePerfil.innerHTML = `<i class="fa-solid fa-id-card-clip"></i> ${nomesNivel[c.nivel_acesso] || c.nivel_acesso || 'SISTEMA'}`;
      }
      alternarCamposNivelAcesso('SISTEMA');
      if (selectNivel) selectNivel.value = c.nivel_acesso || 'ALMOXARIFE';
      if (document.getElementById('modal-acesso-login')) document.getElementById('modal-acesso-login').value = c.login || '';
      const inputAcessoSenha = document.getElementById('modal-acesso-senha');
      if (inputAcessoSenha) {
        inputAcessoSenha.value = '';
        inputAcessoSenha.type = 'password';
        inputAcessoSenha.placeholder = c.tem_senha ? 'Digite nova senha para alterar' : 'Definir senha (padrão 123456)';
      }
      const badgeAcessoSenha = document.getElementById('modal-acesso-badge-senha');
      if (badgeAcessoSenha) {
        badgeAcessoSenha.style.display = c.tem_senha ? 'inline-flex' : 'none';
      }
    } else {
      radioTecnico.checked = true;
      badgePerfil.className = 'status-pill';
      badgePerfil.style.background = '#FEF3C7';
      badgePerfil.style.color = '#B45309';
      badgePerfil.innerHTML = `<i class="fa-solid fa-wrench"></i> Técnico (Apenas Balcão)`;
      alternarCamposNivelAcesso('TECNICO');
    }

    // 3. Preenche Dados Cadastrais
    document.getElementById('modal-view-cargo').textContent = c.cargo || 'Não especificado';
    document.getElementById('modal-view-depto').textContent = c.departamento || 'Não especificado';
    document.getElementById('modal-view-telefone').textContent = c.telefone || 'Não cadastrado';
    document.getElementById('modal-view-email').textContent = c.email || 'Não cadastrado';

    const obsWrap = document.getElementById('box-observacoes-wrapper');
    if (c.observacoes && c.observacoes.trim()) {
      document.getElementById('modal-view-obs').textContent = c.observacoes;
      obsWrap.style.display = 'block';
    } else {
      obsWrap.style.display = 'none';
    }

    // 4. Inicializa visual de empréstimos
    const badgeEmp = document.getElementById('badge-total-emprestimos-abertos');
    badgeEmp.textContent = 'consultando...';
    const listaEmp = document.getElementById('lista-emprestimos-colaborador');
    listaEmp.innerHTML = '<div style="font-size: 0.8rem; color: var(--text-muted);"><i class="fa-solid fa-spinner fa-spin"></i> Consultando ferramentas com o colaborador...</div>';

    // 5. ABRE O MODAL IMEDIATAMENTE (0ms de atraso)
    abrirModalSeguro('modal-detalhes-colaborador');

    // 6. Atualiza empréstimos em segundo plano sem bloquear a abertura do modal
    fetch(`/colaboradores/${id}/detalhes`)
      .then(resp => resp.json())
      .then(dados => {
        if (dados && dados.sucesso) {
          const emprestimos = dados.emprestimosAtivos || [];
          badgeEmp.textContent = `${emprestimos.length} em aberto`;

          if (emprestimos.length === 0) {
            listaEmp.innerHTML = `
              <div style="background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 8px; padding: 0.75rem 0.85rem; color: #065F46; font-size: 0.82rem; display: flex; align-items: center; gap: 0.5rem;">
                <i class="fa-solid fa-circle-check" style="color: #10B981; font-size: 1rem;"></i>
                Nenhuma ferramenta emprestada em aberto com este colaborador no momento.
              </div>
            `;
          } else {
            listaEmp.innerHTML = emprestimos.map(e => `
              <div style="background: #ffffff; border: 1.5px solid #FDE68A; border-radius: 8px; padding: 0.65rem 0.85rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                <div>
                  <div style="font-weight: 700; color: var(--text-main); font-size: 0.88rem;">
                    ${e.produto_nome}
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 1px;">
                    <span style="font-family: var(--font-mono); font-weight: 700;">${e.produto_sku}</span> • Qtd: <strong>${e.quantidade} ${e.produto_unidade}</strong>
                  </div>
                </div>
                <a href="/balcao?tipo=DEVOLUCAO" class="btn btn-outline btn-sm" style="color: #0891B2; border-color: #A5F3FC; font-weight: 700; font-size: 0.75rem;" title="Devolver no Balcão">
                  <i class="fa-solid fa-rotate-left"></i> Devolver
                </a>
              </div>
            `).join('');
          }
        }
      })
      .catch(err => {
        console.warn('Erro ao atualizar empréstimos:', err);
        badgeEmp.textContent = '0 em aberto';
        listaEmp.innerHTML = `
          <div style="background: #F8FAFC; border: 1px solid var(--border-light); border-radius: 8px; padding: 0.65rem 0.85rem; color: var(--text-muted); font-size: 0.82rem;">
            Nenhuma ferramenta pendente registrada.
          </div>
        `;
      });
  }

  function fecharModalDetalhesColaborador() {
    fecharModalSeguro('modal-detalhes-colaborador');
  }

  function alternarCamposNivelAcesso(perfil) {
    const bannerTecnico = document.getElementById('banner-info-tecnico');
    const boxSistema = document.getElementById('box-nivel-acesso-sistema');

    if (perfil === 'SISTEMA') {
      if (bannerTecnico) bannerTecnico.style.display = 'none';
      if (boxSistema) boxSistema.style.display = 'block';
    } else {
      if (bannerTecnico) bannerTecnico.style.display = 'block';
      if (boxSistema) boxSistema.style.display = 'none';
    }
  }

