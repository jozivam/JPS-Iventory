  function abrirModalEditarColaborador(id) {
    const c = LISTA_COLABORADORES.find(item => String(item.id) === String(id));
    if (!c) {
      alert('Colaborador não localizado.');
      return;
    }

    document.getElementById('form-salvar-colaborador').action = `/colaboradores/${c.id}/editar`;
    document.getElementById('modal-form-titulo').innerHTML = '<i class="fa-solid fa-user-pen" style="color: var(--primary);"></i> Editar Colaborador';
    document.getElementById('form-colab-id').value = c.id;
    document.getElementById('form-colab-nome').value = c.nome || '';
    document.getElementById('form-colab-matricula').value = c.matricula || '';
    document.getElementById('form-colab-cargo').value = c.cargo || '';
    document.getElementById('form-colab-depto').value = c.departamento || '';
    document.getElementById('form-colab-telefone').value = c.telefone || '';
    document.getElementById('form-colab-email').value = c.email || '';
    document.getElementById('form-colab-status').value = c.status || 'ATIVO';
    document.getElementById('form-colab-obs').value = c.observacoes || '';
    if (document.getElementById('form-colab-login')) document.getElementById('form-colab-login').value = c.login || '';
    const inputSenhaEdit = document.getElementById('form-colab-senha');
    if (inputSenhaEdit) {
      inputSenhaEdit.value = '';
      inputSenhaEdit.type = 'password';
      inputSenhaEdit.placeholder = c.tem_senha ? 'Digite nova senha para alterar...' : 'Definir senha inicial...';
    }
    if (document.getElementById('form-label-senha')) {
      document.getElementById('form-label-senha').textContent = c.tem_senha ? 'Nova Senha (para alterar)' : 'Senha de Acesso';
    }
    if (document.getElementById('form-badge-status-senha')) {
      document.getElementById('form-badge-status-senha').style.display = c.tem_senha ? 'inline-flex' : 'none';
    }
    if (document.getElementById('form-help-senha')) {
      document.getElementById('form-help-senha').innerHTML = c.tem_senha
        ? 'Por segurança, senhas criptografadas não podem ser exibidas. Digite acima apenas se quiser <strong>trocar a senha</strong>.'
        : 'Padrão inicial: <code>123456</code> (ou defina uma personalizada).';
    }
    document.getElementById('btn-submit-form-colab').innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Atualizar Dados';

    if (c.tipo_perfil === 'SISTEMA' && document.getElementById('form-radio-sistema')) {
      document.getElementById('form-radio-sistema').checked = true;
      toggleFormNivelAcesso('SISTEMA');
      document.getElementById('form-colab-nivel-acesso').value = c.nivel_acesso || 'ALMOXARIFE';
    } else {
      if (document.getElementById('form-radio-tecnico')) document.getElementById('form-radio-tecnico').checked = true;
      toggleFormNivelAcesso('TECNICO');
    }

    abrirModalSeguro('modal-form-colaborador');
  }

  function fecharModalFormColaborador() {
    fecharModalSeguro('modal-form-colaborador');
  }

  function toggleFormNivelAcesso(perfil) {
    const boxAcesso = document.getElementById('form-box-nivel-acesso');
    if (boxAcesso) {
      if (perfil === 'SISTEMA') {
        boxAcesso.style.display = 'block';
      } else {
        boxAcesso.style.display = 'none';
      }
    }
  }

  function toggleMostrarSenha(inputId, btn) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const icone = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      if (icone) {
        icone.className = 'fa-solid fa-eye-slash';
      }
    } else {
      input.type = 'password';
      if (icone) {
        icone.className = 'fa-solid fa-eye';
      }
    }
  }

  function gerarSenhaRapida(inputId, olhoBtnId) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
    let nova = '';
    for (let i = 0; i < 6; i++) {
      nova += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    input.value = nova;
    input.type = 'text';
    const btnOlho = document.getElementById(olhoBtnId);
    if (btnOlho) {
      const icone = btnOlho.querySelector('i');
      if (icone) icone.className = 'fa-solid fa-eye-slash';
    }
    input.focus();
  }

  function copiarCredenciaisForm() {
    const login = (document.getElementById('form-colab-login')?.value || '').trim();
    const senha = (document.getElementById('form-colab-senha')?.value || '').trim();
    if (!login) {
      alert('Preencha o campo Login / Usuário primeiro.');
      return;
    }
    const texto = senha
      ? `Acesso JPS Almoxarifado\nUsuário: ${login}\nSenha: ${senha}`
      : `Acesso JPS Almoxarifado\nUsuário: ${login}`;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(texto).then(() => {
        const btn = document.getElementById('btn-copiar-credenciais');
        if (btn) {
          const original = btn.innerHTML;
          btn.innerHTML = '<i class="fa-solid fa-check"></i> Copiado!';
          setTimeout(() => { btn.innerHTML = original; }, 2000);
        }
      });
    } else {
      prompt('Copie os dados de acesso:', texto);
    }
  }

  function gerarMatriculaAuto() {
    const isSistema = document.getElementById('form-radio-sistema')?.checked;
    const prefixo = isSistema ? 'ALM' : 'TEC';
    const num = Math.floor(100 + Math.random() * 900);
    const input = document.getElementById('form-colab-matricula');
    if (input) input.value = `${prefixo}-${num}`;
  }

  // Fechamento de modais com clique fora ou tecla ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      fecharModalDetalhesColaborador();
      fecharModalFormColaborador();
    }
  });

  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        fecharModalSeguro(overlay.id);
      }
    });
  });

  // =========================================================================
  // DROPDOWN INTELIGENTE DE BUSCA DE COLABORADORES
  // =========================================================================
  const LISTA_COLABORADORES_TELA = <%- JSON.stringify(colaboradores || []) %>;
  const inputBuscaTela = document.getElementById('colab-busca-input');
  const dropdownBuscaTela = document.getElementById('colab-busca-dropdown');
  const btnLimparBuscaTela = document.getElementById('btn-limpar-colab-busca');
  let colabTelaFocadoIndex = -1;
  let colabsTelaFiltrados = [];

  function renderizarDropdownBuscaTela(termo = '') {
    const q = termo.trim().toLowerCase();
    if (!q) {
      dropdownBuscaTela.style.display = 'none';
      return;
    }

    colabsTelaFiltrados = LISTA_COLABORADORES_TELA.filter(c => {
      const nome = (c.nome || '').toLowerCase();
      const mat = (c.matricula || '').toLowerCase();
      const cargo = (c.cargo || '').toLowerCase();
      const dep = (c.departamento || '').toLowerCase();
      const email = (c.email || '').toLowerCase();
      return nome.includes(q) || mat.includes(q) || cargo.includes(q) || dep.includes(q) || email.includes(q);
    });

    colabTelaFocadoIndex = -1;

    if (colabsTelaFiltrados.length === 0) {
      dropdownBuscaTela.innerHTML = `
        <div style="padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.82rem;">
          <i class="fa-solid fa-user-slash" style="margin-bottom: 0.35rem; display: block; font-size: 1.2rem; color: var(--border-color);"></i>
          Nenhum colaborador encontrado para "<strong>${termo}</strong>"
        </div>
      `;
      dropdownBuscaTela.style.display = 'block';
      return;
    }

    const html = colabsTelaFiltrados.map((c, idx) => {
      const iniciais = (c.nome || 'C').split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
      const isSistema = c.tipo_perfil === 'SISTEMA';

      return `
        <div class="colab-busca-item" data-index="${idx}" data-id="${c.id}" onclick="selecionarColaboradorTela('${c.nome.replace(/'/g, "\\'")}')" style="padding: 0.65rem 0.95rem; border-bottom: 1px solid var(--border-light); cursor: pointer; transition: background 0.12s ease; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.65rem; min-width: 0;">
            <div style="width: 34px; height: 34px; border-radius: 50%; background: ${isSistema ? '#EDE9FE' : '#FEF3C7'}; color: ${isSistema ? '#6D28D9' : '#B45309'}; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.78rem; flex-shrink: 0;">
              ${iniciais}
            </div>
            <div style="min-width: 0;">
              <div style="font-weight: 700; color: var(--text-main); font-size: 0.88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                ${c.nome}
              </div>
              <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;">
                <span style="font-family: var(--font-mono); font-weight: 700; color: var(--text-body); background: var(--bg-surface); padding: 1px 4px; border-radius: 3px; border: 1px solid var(--border-color);">${c.matricula || 'S/ MAT'}</span>
                <span>• ${c.cargo || 'Função não inf.'}</span>
                ${c.departamento ? `<span>(${c.departamento})</span>` : ''}
              </div>
            </div>
          </div>
          
          <div style="display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0;" onclick="event.stopPropagation()">
            <a href="/fichas?colaborador_id=${c.id}" class="btn btn-sm btn-outline" title="Abrir Ficha de Material e Cautela" style="font-size: 0.72rem; padding: 0.25rem 0.55rem; border-color: #C7D2FE; color: #4338CA; background: #EEF2FF;">
              <i class="fa-solid fa-file-invoice"></i> Ficha
            </a>
            <button type="button" class="btn btn-sm btn-outline" onclick="abrirModalDetalhesColaborador(${c.id})" title="Ver Cadastro Completo" style="font-size: 0.72rem; padding: 0.25rem 0.55rem;">
              <i class="fa-solid fa-eye"></i>
            </button>
          </div>
        </div>
      `;
    }).join('');

    dropdownBuscaTela.innerHTML = html;
    dropdownBuscaTela.style.display = 'block';
  }

  function selecionarColaboradorTela(nome) {
    if (inputBuscaTela) {
      inputBuscaTela.value = nome;
      dropdownBuscaTela.style.display = 'none';
      inputBuscaTela.form.submit();
    }
  }

  function limparBuscaColaboradorTela() {
    if (inputBuscaTela) {
      inputBuscaTela.value = '';
      btnLimparBuscaTela.style.display = 'none';
      dropdownBuscaTela.style.display = 'none';
      window.location.href = '/colaboradores';
    }
  }

  if (inputBuscaTela) {
    inputBuscaTela.addEventListener('input', (e) => {
      const val = e.target.value;
      btnLimparBuscaTela.style.display = val ? 'flex' : 'none';
      renderizarDropdownBuscaTela(val);
    });

    inputBuscaTela.addEventListener('focus', () => {
      if (inputBuscaTela.value.trim()) {
        renderizarDropdownBuscaTela(inputBuscaTela.value);
      }
    });

    inputBuscaTela.addEventListener('keydown', (e) => {
      const items = dropdownBuscaTela.querySelectorAll('.colab-busca-item');
      if (dropdownBuscaTela.style.display === 'none') return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (items.length === 0) return;
        colabTelaFocadoIndex = (colabTelaFocadoIndex + 1) % items.length;
        atualizarFocoTela(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (items.length === 0) return;
        colabTelaFocadoIndex = (colabTelaFocadoIndex - 1 + items.length) % items.length;
        atualizarFocoTela(items);
      } else if (e.key === 'Enter') {
        if (colabTelaFocadoIndex >= 0 && items[colabTelaFocadoIndex]) {
          e.preventDefault();
          const colab = colabsTelaFiltrados[colabTelaFocadoIndex];
          if (colab) selecionarColaboradorTela(colab.nome);
        }
      } else if (e.key === 'Escape') {
        dropdownBuscaTela.style.display = 'none';
      }
    });
  }

  function atualizarFocoTela(items) {
    items.forEach((it, idx) => {
      if (idx === colabTelaFocadoIndex) {
        it.style.background = '#f1f5f9';
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.style.background = '#ffffff';
      }
    });
  }

  // Fecha dropdown de busca de colaborador ao clicar fora
  document.addEventListener('click', (e) => {
    const wrapper = document.getElementById('colab-busca-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
      if (dropdownBuscaTela) dropdownBuscaTela.style.display = 'none';
    }
  });
</script>

