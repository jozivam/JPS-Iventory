<%- include('../layouts/header') %>

<!-- Mensagens de Alerta (Sucesso ou Erro) -->
<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho da Página -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Transferências & Requisições entre Obras</h2>
    <p>Rastreie movimentações de materiais entre canteiros, depósitos e frentes de trabalho.</p>
  </div>

  <div class="page-actions-group">
    <a href="/almoxarifados" class="btn btn-outline" id="btn-ver-obras-transf">
      <i class="fa-solid fa-helmet-safety"></i> Ver Canteiros
    </a>
    <a href="/transferencias/nova" class="btn btn-primary" id="btn-nova-transf">
      <i class="fa-solid fa-arrow-right-arrow-left"></i> Nova Transferência / Requisição
    </a>
  </div>
</div>

<!-- Storaxe KPI Cards de Transferência -->
<%
  const reqPendentesCount = requisicoes ? requisicoes.filter(r => r.status === 'PENDENTE').length : 0;
  const reqAtendidasCount = requisicoes ? requisicoes.filter(r => r.status === 'ATENDIDA').length : 0;
  const transfCount = transferencias ? transferencias.length : 0;
%>
<div class="storaxe-kpi-grid">
  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot yellow"></span>
      <span>Requisições Pendentes</span>
    </div>
    <div class="kpi-big-number"><%= reqPendentesCount %> <small style="font-size: 0.85rem; color: var(--text-muted);">pedidos</small></div>
    <span class="kpi-comparison-text">Aguardando atendimento e envio</span>
  </div>

  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot teal"></span>
      <span>Requisições Atendidas</span>
    </div>
    <div class="kpi-big-number"><%= reqAtendidasCount %> <small style="font-size: 0.85rem; color: var(--text-muted);">concluídas</small></div>
    <span class="kpi-comparison-text">Materiais entregues nos canteiros</span>
  </div>

  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot purple"></span>
      <span>Remessas Realizadas</span>
    </div>
    <div class="kpi-big-number"><%= transfCount %> <small style="font-size: 0.85rem; color: var(--text-muted);">transferências</small></div>
    <span class="kpi-comparison-text">Histórico completo de circulação</span>
  </div>

  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot blue"></span>
      <span>Canteiros Integrados</span>
    </div>
    <div class="kpi-big-number"><%= almoxarifados ? almoxarifados.length : 0 %> <small style="font-size: 0.85rem; color: var(--text-muted);">obras</small></div>
    <span class="kpi-comparison-text">Rede logística ativa</span>
  </div>
</div>

<!-- TABELA 1: REQUISIÇÕES DE MATERIAIS AGUARDANDO ATENDIMENTO -->
<div class="table-card" style="margin-bottom: 2rem;">
  <div class="storaxe-card-header">
    <div class="storaxe-card-title">
      <i class="fa-solid fa-list-check" style="color: var(--primary);"></i>
      <span>Requisições de Materiais</span>
    </div>
    <a href="/transferencias/nova?modo=REQUISICAO" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-plus"></i> Abrir Requisição
    </a>
  </div>

  <div class="table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>DATA</th>
          <th>SOLICITANTE</th>
          <th>ESTOQUE ORIGEM</th>
          <th>ESTOQUE DESTINO</th>
          <th>MATERIAL</th>
          <th>QTD</th>
          <th>MOTIVO</th>
          <th>STATUS</th>
          <th style="text-align: right;">AÇÃO</th>
        </tr>
      </thead>
      <tbody>
        <% if (requisicoes && requisicoes.length > 0) { %>
          <% requisicoes.forEach(r => { %>
            <tr>
              <td><span style="font-size: 0.82rem; font-weight: 600;"><%= formatDate(r.criado_em) %></span></td>
              <td><strong style="color: var(--text-main); font-size: 0.85rem;"><%= r.solicitante %></strong></td>
              <td><span style="color: var(--text-body); font-weight: 500;"><%= r.almoxarifado_origem_nome %></span></td>
              <td><strong style="color: var(--text-main); font-weight: 600;"><%= r.almoxarifado_destino_nome %></strong></td>
              <td>
                <a href="/produtos/<%= r.produto_id %>" style="color: inherit; text-decoration: none; font-weight: 600;">
                  <%= r.produto_nome %>
                </a>
                <span class="report-table-tag"><%= r.produto_sku %></span>
              </td>
              <td>
                <strong style="color: var(--teal); font-size: 0.95rem;"><%= r.quantidade %></strong>
                <small style="color: var(--text-dim);"><%= r.produto_unidade %></small>
              </td>
              <td><span style="font-size: 0.82rem;"><%= r.motivo %></span></td>
              <td>
                <% if (r.status === 'PENDENTE') { %>
                  <span class="status-pill low-stock"><span class="status-dot-sm"></span> Pendente</span>
                <% } else if (r.status === 'ATENDIDA') { %>
                  <span class="status-pill in-stock"><span class="status-dot-sm"></span> Atendida</span>
                <% } else { %>
                  <span class="status-pill out-of-stock"><span class="status-dot-sm"></span> Cancelada</span>
                <% } %>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <% if (r.status === 'PENDENTE') { %>
                  <div style="display: inline-flex; gap: 0.35rem;">
                    <form action="/requisicoes/<%= r.id %>/atender" method="POST" style="display: inline;">
                      <input type="hidden" name="responsavel" value="Almoxarife Responsável">
                      <button type="submit" class="btn btn-primary btn-sm" title="Aprovar transferência e despachar material">
                        <i class="fa-solid fa-check"></i> Atender Requisição
                      </button>
                    </form>
                    <form action="/requisicoes/<%= r.id %>/cancelar" method="POST" style="display: inline;">
                      <button type="submit" class="btn btn-outline btn-sm" title="Recusar requisição" onclick="return confirm('Deseja realmente cancelar esta solicitação?')">
                        <i class="fa-solid fa-xmark" style="color: var(--danger);"></i>
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <span style="font-size: 0.78rem; color: var(--text-dim); font-style: italic;">Concluída</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="9" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
              Nenhuma requisição de material aberta.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- TABELA 2: HISTÓRICO DE TRANSFERÊNCIAS REALIZADAS -->
<div class="table-card">
  <div class="storaxe-card-header">
    <div class="storaxe-card-title">
      <i class="fa-solid fa-clock-rotate-left" style="color: var(--primary);"></i>
      <span>Histórico de Transferências entre Estoques</span>
    </div>
  </div>

  <div class="table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>DATA & HORA</th>
          <th>GUIA / REF</th>
          <th>ESTOQUE ORIGEM ➔ DESTINO</th>
          <th>MATERIAL</th>
          <th>QUANTIDADE</th>
          <th>VALOR ESTIMADO</th>
          <th>RESPONSÁVEL</th>
          <th>MOTIVO</th>
        </tr>
      </thead>
      <tbody>
        <% if (transferencias && transferencias.length > 0) { %>
          <% transferencias.forEach(t => { %>
            <tr>
              <td><span style="font-size: 0.82rem; font-weight: 600;"><%= formatDate(t.criado_em) %></span></td>
              <td>
                <span style="font-family: var(--font-mono); font-size: 0.78rem; background: var(--bg-surface); padding: 0.15rem 0.45rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                  <%= t.documento_ref || 'TRANSF' %>
                </span>
              </td>
              <td>
                <div style="font-size: 0.82rem; font-weight: 600; color: var(--text-main);">
                  <%= t.almoxarifado_origem_nome || 'Matriz Central' %> ➔ <%= t.almoxarifado_destino_nome || 'Obra' %>
                </div>
              </td>
              <td>
                <a href="/produtos/<%= t.produto_id %>" style="color: inherit; text-decoration: none; font-weight: 600;">
                  <%= t.produto_nome %>
                </a>
                <span class="report-table-tag"><%= t.produto_sku %></span>
              </td>
              <td>
                <strong style="color: var(--primary); font-size: 0.95rem;"><%= t.quantidade %></strong>
                <small style="color: var(--text-dim);"><%= t.produto_unidade %></small>
              </td>
              <td>
                <strong style="font-size: 0.85rem; color: var(--text-main);"><%= formatMoney(t.valor_movimentado) %></strong>
              </td>
              <td><span style="font-size: 0.82rem;"><%= t.responsavel %></span></td>
              <td><span style="font-size: 0.82rem; color: var(--text-muted);"><%= t.motivo %></span></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
              Nenhuma transferência executada até o momento.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>
