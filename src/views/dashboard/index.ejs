<%- include('../layouts/header') %>

<!-- Cabeçalho do Overview (Storaxe UI) -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Visão Geral</h2>
    <p>Panorama do desempenho e estoque do almoxarifado em tempo real.</p>
  </div>
  
  <div class="page-actions-group">
    <!-- Pílulas de Período -->
    <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 3px; display: flex; gap: 2px;">
      <button type="button" class="btn btn-sm" style="background: transparent; color: var(--text-muted); border: none; font-weight: 500;">Hoje</button>
      <button type="button" class="btn btn-sm" style="background: var(--bg-hover); color: var(--text-main); border: none; font-weight: 700;">Esta Semana</button>
      <button type="button" class="btn btn-sm" style="background: transparent; color: var(--text-muted); border: none; font-weight: 500;">Este Mês</button>
    </div>

    <!-- Botão Exportar -->
    <a href="/relatorios" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-arrow-up-from-bracket"></i> Exportar Dados
    </a>
  </div>
</div>

<!-- 4 Cards de Métricas Principais (Storaxe UI) -->
<div class="storaxe-kpi-grid">
  <!-- Card 1: Total Stock -->
  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot blue"></span>
      <span>Total em Estoque</span>
    </div>
    <div class="kpi-big-number"><%= Number(estatisticas.total_unidades).toLocaleString('pt-BR') %></div>
    <div>
      <span class="kpi-badge-comparison badge-positive">
        <i class="fa-solid fa-arrow-trend-up"></i> +4%
      </span>
      <span class="kpi-comparison-text">vs semana anterior</span>
    </div>
  </div>

  <!-- Card 2: Outbound Orders (Saídas / Baixas) -->
  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot teal"></span>
      <span>Baixas / Saídas</span>
    </div>
    <div class="kpi-big-number"><%= Number(estatisticas.totalSaidasVolume).toLocaleString('pt-BR') %></div>
    <div>
      <span class="kpi-badge-comparison badge-negative">
        <i class="fa-solid fa-arrow-trend-down"></i> -3.2%
      </span>
      <span class="kpi-comparison-text">vs semana anterior</span>
    </div>
  </div>

  <!-- Card 3: Inbound Shipments (Entradas / Reposição) -->
  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot purple"></span>
      <span>Entradas / Cargas</span>
    </div>
    <div class="kpi-big-number"><%= Number(estatisticas.totalEntradasVolume).toLocaleString('pt-BR') %></div>
    <div>
      <span class="kpi-badge-comparison badge-positive">
        <i class="fa-solid fa-arrow-trend-up"></i> +2.3%
      </span>
      <span class="kpi-comparison-text">vs semana anterior</span>
    </div>
  </div>

  <!-- Card 4: Warehouse Efficiency -->
  <div class="storaxe-kpi-card">
    <div class="kpi-title-row">
      <span class="kpi-dot cyan"></span>
      <span>Eficiência de Atendimento</span>
    </div>
    <div class="kpi-big-number"><%= estatisticas.taxaEficiencia %>%</div>
    <div>
      <span class="kpi-badge-comparison badge-positive">
        <i class="fa-solid fa-arrow-trend-up"></i> +2%
      </span>
      <span class="kpi-comparison-text">vs semana anterior</span>
    </div>
  </div>
</div>

<!-- Grid Superior: Stock Flow Analysis (Gráfico) + Stocks Alert -->
<div class="storaxe-dashboard-grid">
  <!-- Stock Flow Analysis Card -->
  <div class="storaxe-card">
    <div class="storaxe-card-header">
      <div>
        <div class="storaxe-card-title">Análise de Fluxo de Estoque (Stock Flow)</div>
        <div style="font-size: 0.75rem; color: var(--text-dim); margin-top: 0.2rem;">Mostrando os últimos 7 dias</div>
      </div>
      <div style="font-size: 0.8rem; color: var(--text-muted); background: var(--bg-surface); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
        Semanal <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i>
      </div>
    </div>
    <div class="storaxe-card-body">
      <div style="position: relative; height: 280px; width: 100%;">
        <canvas id="stockFlowChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Stocks Alert Card -->
  <div class="storaxe-card">
    <div class="storaxe-card-header">
      <div class="storaxe-card-title">Alertas de Estoque</div>
      <a href="/produtos?status=BAIXO" style="font-size: 0.78rem; color: var(--primary); text-decoration: none; font-weight: 600;">Ver Todos</a>
    </div>
    <div class="storaxe-card-body">
      <div class="stock-alert-list">
        <% if (itensCriticos && itensCriticos.length > 0) { %>
          <% itensCriticos.slice(0, 5).forEach((item, index) => { 
            const emojis = ['🦺', '🧤', '👓', '🔧', '📦', '⚡'];
            const emoji = emojis[index % emojis.length];
            const pct = item.estoque_minimo > 0 ? Math.min(100, Math.round((item.quantidade / item.estoque_minimo) * 100)) : 0;
          %>
            <div class="stock-alert-item">
              <div class="alert-item-info">
                <div class="alert-icon-wrap"><%= emoji %></div>
                <div>
                  <div class="alert-item-name"><%= item.nome %></div>
                  <div style="font-size: 0.72rem; color: var(--text-dim); font-family: var(--font-mono);"><%= item.sku %></div>
                </div>
              </div>
              <div class="alert-item-bar-wrap">
                <div class="mini-bar">
                  <div class="mini-bar-fill" style="width: <%= Math.max(10, pct) %>%; background: <%= item.quantidade <= 0 ? 'var(--danger)' : 'var(--warning)' %>;"></div>
                </div>
              </div>
              <div class="alert-item-qty">
                <strong style="color: <%= item.quantidade <= 0 ? 'var(--danger)' : 'var(--text-main)' %>;"><%= item.quantidade %></strong> <%= item.unidade_medida %> restando
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div style="text-align: center; padding: 2rem; color: var(--text-muted); font-size: 0.85rem;">
            <i class="fa-solid fa-circle-check" style="color: var(--success); font-size: 1.5rem; display: block; margin-bottom: 0.5rem;"></i>
            Nenhum item com estoque crítico no momento!
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Grid Inferior: Shipments Timeline + Warehouse Utilization -->
<div class="storaxe-dashboard-grid">
  <!-- Shipments Timeline (Histórico de Movimentações) -->
  <div class="storaxe-card">
    <div class="storaxe-card-header">
      <div class="storaxe-card-title">Linha do Tempo de Movimentações</div>
      <a href="/movimentacoes" style="font-size: 0.78rem; color: var(--primary); text-decoration: none; font-weight: 600;">
        Ver Detalhes <i class="fa-solid fa-arrow-right" style="font-size: 0.7rem;"></i>
      </a>
    </div>
    <div class="storaxe-card-body" style="padding: 0;">
      <div class="table-responsive">
        <table class="clean-table">
          <thead>
            <tr>
              <th>ID MOV</th>
              <th>TIPO</th>
              <th>ORIGEM / DESTINO</th>
              <th>DATA / HORA</th>
              <th>STATUS</th>
            </tr>
          </thead>
          <tbody>
            <% if (movimentacoesRecentes && movimentacoesRecentes.length > 0) { %>
              <% movimentacoesRecentes.forEach(mov => { %>
                <tr>
                  <td>
                    <div style="display: flex; align-items: center;">
                      <span class="direction-circle <%= mov.tipo === 'ENTRADA' ? 'inbound' : 'outbound' %>">
                        <i class="fa-solid <%= mov.tipo === 'ENTRADA' ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i>
                      </span>
                      <strong style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-main);">
                        MOV-<%= String(mov.id).padStart(4, '0') %>
                      </strong>
                    </div>
                  </td>
                  <td>
                    <span style="font-size: 0.82rem; font-weight: 600; color: <%= mov.tipo === 'ENTRADA' ? 'var(--teal)' : 'var(--primary)' %>;">
                      <%= mov.tipo === 'ENTRADA' ? 'Inbound' : 'Outbound' %>
                    </span>
                  </td>
                  <td>
                    <div style="font-weight: 600; font-size: 0.85rem;"><%= mov.produto_nome %></div>
                    <div style="font-size: 0.72rem; color: var(--text-muted);"><%= mov.responsavel %></div>
                  </td>
                  <td>
                    <span style="font-size: 0.8rem; color: var(--text-muted);"><%= formatDate(mov.criado_em) %></span>
                  </td>
                  <td>
                    <span class="status-pill in-stock">
                      <span class="status-dot-sm"></span> Concluído
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                  Nenhuma movimentação registrada recentemente.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Warehouse Utilization (Ocupação do Almoxarifado) -->
  <div class="storaxe-card">
    <div class="storaxe-card-header">
      <div class="storaxe-card-title">Ocupação do Almoxarifado</div>
    </div>
    <div class="storaxe-card-body">
      <!-- Indicadores Setoriais -->
      <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.5rem;">
        <div>
          <span style="color: var(--text-dim); font-size: 0.75rem;">Setor A (Segurança)</span>
          <div style="font-size: 1.15rem; font-weight: 800; color: #0d9488;">38%</div>
        </div>
        <div>
          <span style="color: var(--text-dim); font-size: 0.75rem;">Setor B (Ferramentas)</span>
          <div style="font-size: 1.15rem; font-weight: 800; color: #8b5cf6;">34%</div>
        </div>
        <div>
          <span style="color: var(--text-dim); font-size: 0.75rem;">Setor C (Materiais)</span>
          <div style="font-size: 1.15rem; font-weight: 800; color: #f59e0b;">28%</div>
        </div>
      </div>

      <!-- Barra Segmentada com Estilo Storaxe -->
      <div class="utilization-sectors-bar">
        <div class="sector-fill sector-a" style="width: 38%;">38%</div>
        <div class="sector-fill sector-b" style="width: 34%;">34%</div>
        <div class="sector-fill sector-c" style="width: 28%;">28%</div>
      </div>

      <!-- Detalhamento dos Setores -->
      <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between;">
          <span style="display: flex; align-items: center; gap: 0.35rem;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #0d9488;"></span> Setor A - EPI e Segurança
          </span>
          <strong>12.589 un</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="display: flex; align-items: center; gap: 0.35rem;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #8b5cf6;"></span> Setor B - Elétrica e Ferramental
          </span>
          <strong>8.292 un</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="display: flex; align-items: center; gap: 0.35rem;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></span> Setor C - Insumos Gerais
          </span>
          <strong>6.675 un</strong>
        </div>
      </div>

      <!-- Barra de Utilização Total -->
      <div style="padding-top: 1rem; border-top: 1px solid var(--border-light);">
        <div style="display: flex; justify-content: space-between; font-size: 0.78rem; margin-bottom: 0.35rem;">
          <span style="color: var(--text-muted); font-weight: 600;">Capacidade de Estocagem:</span>
          <span><strong><%= Number(estatisticas.total_unidades).toLocaleString('pt-BR') %></strong> / 30.000 un</span>
        </div>
        <div class="mini-bar" style="height: 6px;">
          <div class="mini-bar-fill" style="width: <%= Math.min(100, Math.round((estatisticas.total_unidades / 30000) * 100)) %>%; background: #6366f1;"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Script Chart.js com Estética Storaxe (Barras Teal e Roxo Claro) -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dadosFluxo = <%- dadosGraficoJson %>;
    const labels = dadosFluxo.map(d => {
      const parts = d.dia.split('-');
      return `${parts[2]}/${parts[1]}`;
    });
    const entradas = dadosFluxo.map(d => d.total_entradas);
    const saidas = dadosFluxo.map(d => d.total_saidas);

    const ctx = document.getElementById('stockFlowChart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Entradas (Inbound)',
            data: entradas,
            backgroundColor: '#0d9488',
            borderRadius: 6,
            barPercentage: 0.6,
            categoryPercentage: 0.7
          },
          {
            label: 'Saídas (Outbound)',
            data: saidas,
            backgroundColor: '#c4b5fd',
            borderRadius: 6,
            barPercentage: 0.6,
            categoryPercentage: 0.7
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'top',
            align: 'end',
            labels: {
              boxWidth: 10,
              usePointStyle: true,
              pointStyle: 'circle',
              color: '#64748b',
              font: { family: 'Plus Jakarta Sans', size: 12 }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 11 } }
          },
          y: {
            beginAtZero: true,
            grid: { color: '#f1f5f9' },
            ticks: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans', size: 11 }, stepSize: 5 }
          }
        }
      }
    });
  });
</script>

<%- include('../layouts/footer') %>
