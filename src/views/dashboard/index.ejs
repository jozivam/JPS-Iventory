<!-- MODAL: RECUSAR REQUISIÇÃO (ALMOXARIFE)                                    -->
<!-- ========================================================================= -->
<div class="modal-overlay" id="modal-recusar-requisicao">
  <div class="modal-container" style="max-width: 500px; width: 95%;">
    <div class="modal-header">
      <h3 style="font-size: 1.05rem; color: var(--danger); display: flex; align-items: center; gap: 0.5rem; margin: 0;">
        <i class="fa-solid fa-circle-xmark"></i>
        Recusar Requisição
      </h3>
      <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-recusar-requisicao')">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="form-recusar-requisicao" method="POST">
      <input type="hidden" name="origem" value="dashboard">

      <div class="modal-body" style="padding: 1.25rem;">
        <p style="font-size: 0.88rem; color: var(--text-body); margin-bottom: 1rem;">
          Informe a justificativa para recusar a requisição <strong id="modal-recusa-codigo" style="color: var(--danger);">-</strong> (<span id="modal-recusa-produto">-</span>):
        </p>

        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" for="recusa-motivo">Justificativa da Recusa <span class="required">*</span></label>
          <textarea id="recusa-motivo" name="motivo_recusa" class="form-control" rows="3" placeholder="Ex: Produto sem estoque disponível, aguardando pedido de compra, item não autorizado para esta função..." required></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="recusa-almoxarife">Almoxarife Responsável</label>
          <input type="text" id="recusa-almoxarife" name="almoxarife_responsavel" class="form-control" value="Jozivam Silva">
        </div>
      </div>

      <div class="modal-footer" style="background: var(--bg-surface);">
        <button type="button" class="btn btn-outline" onclick="window.fecharModal('modal-recusar-requisicao')">Voltar</button>
        <button type="submit" class="btn btn-danger" style="font-weight: 700;">
          <i class="fa-solid fa-xmark"></i> Confirmar Recusa
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const LISTA_PRODUTOS_DASH = <%- JSON.stringify(produtos || []) %>;
  const LISTA_COLABORADORES_DASH = <%- JSON.stringify(colaboradores || []) %>;

  // =========================================================================
  // LISTA INTELIGENTE: DESTINATÁRIO (COLABORADORES OU BALCÃO) NO DASHBOARD
  // =========================================================================
  const dashInputColab = document.getElementById('dash-req-colaborador-busca');
  const dashDropdownColab = document.getElementById('dash-req-colaborador-dropdown');
  const dashHiddenColabId = document.getElementById('dash-req-colaborador-id');
  const dashHiddenColabNome = document.getElementById('dash-req-colaborador-nome');
  const dashBtnLimparColab = document.getElementById('dash-btn-limpar-colab');
  const dashBoxDestinatario = document.getElementById('dash-box-destinatario-selecionado');
  const dashBoxDestinatarioConteudo = document.getElementById('dash-box-destinatario-conteudo');
  const dashIconeDestinatario = document.getElementById('dash-req-icone-destinatario');

  function renderizarDropdownColaboradorDash(filtro = '') {
    if (!dashDropdownColab) return;
    const termo = (filtro || '').trim().toLowerCase();

    let html = `
      <!-- OPÇÃO FIXA DESTACADA: BALCÃO (USO GERAL) -->
      <div 
        class="combobox-item-dash-colab" 
        data-id="" 
        data-nome="Balcão"
        onclick="selecionarDestinatarioBalcaoDash()"
        style="padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--border-light); cursor: pointer; display: flex; align-items: center; justify-content: space-between; background: #F8FAFC;"
      >
        <div style="display: flex; align-items: center; gap: 0.65rem;">
          <div style="width: 32px; height: 32px; border-radius: 6px; background: #EEF2FF; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 0.95rem; font-weight: 700;">
            <i class="fa-solid fa-store"></i>
          </div>
          <div>
            <div style="font-weight: 700; color: var(--primary); font-size: 0.86rem;">
              Balcão (Uso Geral / Sem Ficha)
            </div>
            <div style="font-size: 0.73rem; color: var(--text-dim);">
              Saída avulsa atribuída ao almoxarifado sem vínculo individual
            </div>
          </div>
        </div>
        <span class="badge" style="background: #E0E7FF; color: var(--primary); font-size: 0.68rem; font-weight: 700;">
          Sem Ficha
        </span>
      </div>
    `;

    const filtrados = LISTA_COLABORADORES_DASH.filter(c => {
      if (!termo) return true;
      return (c.nome && c.nome.toLowerCase().includes(termo)) ||
             (c.matricula && c.matricula.toLowerCase().includes(termo)) ||
             (c.cargo && c.cargo.toLowerCase().includes(termo));
    });

    if (filtrados.length === 0 && termo) {
      html += `
        <div style="padding: 0.85rem; text-align: center; color: var(--text-muted); font-size: 0.8rem;">
          Nenhum colaborador encontrado com "${filtro}".
        </div>
      `;
    } else {
      filtrados.forEach(c => {
        const iniciais = c.nome ? c.nome.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase() : 'CO';
        html += `
          <div 
            class="combobox-item-dash-colab" 
            data-id="${c.id}" 
            data-nome="${c.nome.replace(/"/g, '&quot;')}"
            data-cargo="${(c.cargo || '').replace(/"/g, '&quot;')}"
            data-mat="${(c.matricula || '').replace(/"/g, '&quot;')}"
            onclick="selecionarColaboradorDash('${c.id}', '${c.nome.replace(/'/g, "\\'")}', '${(c.cargo || '').replace(/'/g, "\\'")}', '${(c.matricula || '').replace(/'/g, "\\'")}')"
            style="padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--border-light); cursor: pointer; display: flex; align-items: center; justify-content: space-between;"
          >
            <div style="display: flex; align-items: center; gap: 0.65rem;">
              <div style="width: 30px; height: 30px; border-radius: 50%; background: var(--bg-surface); color: var(--text-main); display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; border: 1px solid var(--border-light);">
                ${iniciais}
              </div>
              <div>
                <div style="font-weight: 700; color: var(--text-main); font-size: 0.84rem;">
                  ${c.nome}
                </div>
                <div style="font-size: 0.73rem; color: var(--text-dim);">
                  ${c.cargo || 'Colaborador'} ${c.matricula ? '• Mat: ' + c.matricula : ''}
                </div>
              </div>
            </div>
            <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem; color: var(--border-medium);"></i>
          </div>
        `;
      });
    }

    dashDropdownColab.innerHTML = html;
    dashDropdownColab.style.display = 'block';

    dashDropdownColab.querySelectorAll('.combobox-item-dash-colab').forEach(el => {
      el.addEventListener('mouseenter', () => el.style.background = '#F1F5F9');
      el.addEventListener('mouseleave', () => {
        if (!el.getAttribute('data-nome') || el.getAttribute('data-nome') !== 'Balcão') {
          el.style.background = '#ffffff';
        } else {
          el.style.background = '#F8FAFC';
        }
      });
    });
  }

  function selecionarColaboradorDash(id, nome, cargo, matricula) {
    dashHiddenColabId.value = id;
    dashHiddenColabNome.value = nome;
    dashInputColab.value = `${nome} ${matricula ? '(' + matricula + ')' : ''}`;
    dashBtnLimparColab.style.display = 'flex';
    dashDropdownColab.style.display = 'none';

    dashIconeDestinatario.className = 'fa-solid fa-user-check';
    dashIconeDestinatario.style.color = 'var(--primary)';

    dashBoxDestinatario.style.display = 'block';
    dashBoxDestinatario.style.background = 'var(--bg-surface)';
    dashBoxDestinatario.style.borderColor = 'var(--border-light)';
    dashBoxDestinatarioConteudo.innerHTML = `
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-id-badge" style="color: var(--primary);"></i>
        <span>Colaborador: <strong>${nome}</strong> ${cargo ? '— ' + cargo : ''} ${matricula ? '(Matrícula: ' + matricula + ')' : ''}</span>
      </div>
    `;
  }

  function selecionarDestinatarioBalcaoDash() {
    dashHiddenColabId.value = '';
    dashHiddenColabNome.value = 'Balcão';
    dashInputColab.value = '🏪 Balcão (Uso Geral / Sem Ficha)';
    dashBtnLimparColab.style.display = 'flex';
    dashDropdownColab.style.display = 'none';

    dashIconeDestinatario.className = 'fa-solid fa-store';
    dashIconeDestinatario.style.color = '#059669';

    dashBoxDestinatario.style.display = 'block';
    dashBoxDestinatario.style.background = '#ECFDF5';
    dashBoxDestinatario.style.borderColor = '#A7F3D0';
    dashBoxDestinatarioConteudo.innerHTML = `
      <div style="display: flex; align-items: center; gap: 0.5rem; color: #065F46;">
        <i class="fa-solid fa-circle-check" style="color: #059669;"></i>
        <span><strong>Atribuído ao Balcão:</strong> A saída não será cobrada nem vinculada à ficha individual de nenhum colaborador.</span>
      </div>
    `;
  }

  function limparColaboradorDash() {
    dashHiddenColabId.value = '';
    dashHiddenColabNome.value = '';
    dashInputColab.value = '';
    dashBtnLimparColab.style.display = 'none';
    dashBoxDestinatario.style.display = 'none';
    dashIconeDestinatario.className = 'fa-solid fa-user';
    dashIconeDestinatario.style.color = 'var(--text-dim)';
    dashInputColab.focus();
    renderizarDropdownColaboradorDash('');
  }

  if (dashInputColab) {
    dashInputColab.addEventListener('focus', () => {
      renderizarDropdownColaboradorDash(dashInputColab.value);
    });

    dashInputColab.addEventListener('input', () => {
      dashHiddenColabId.value = '';
      dashHiddenColabNome.value = dashInputColab.value;
      dashBtnLimparColab.style.display = dashInputColab.value ? 'flex' : 'none';
      dashBoxDestinatario.style.display = 'none';
      renderizarDropdownColaboradorDash(dashInputColab.value);
    });
  }

  // =========================================================================
  // LISTA INTELIGENTE: PRODUTO / MATERIAL NO DASHBOARD
  // =========================================================================
  const dashInputProd = document.getElementById('dash-req-produto-busca');
  const dashDropdownProd = document.getElementById('dash-req-produto-dropdown');
  const dashHiddenProdId = document.getElementById('dash-req-produto-id');
  const dashBtnLimparProd = document.getElementById('dash-btn-limpar-prod');
  const dashBoxDetalheProd = document.getElementById('dash-req-produto-detalhe-box');
  const dashDetalheSku = document.getElementById('dash-req-detalhe-sku');
  const dashDetalheCat = document.getElementById('dash-req-detalhe-cat');
  const dashDetalheSaldo = document.getElementById('dash-req-detalhe-saldo');

  function renderizarDropdownProdutoDash(filtro = '') {
    if (!dashDropdownProd) return;
    const termo = (filtro || '').trim().toLowerCase();

    const filtrados = LISTA_PRODUTOS_DASH.filter(p => {
      if (!termo) return true;
      return (p.nome && p.nome.toLowerCase().includes(termo)) ||
             (p.sku && p.sku.toLowerCase().includes(termo)) ||
             (p.categoria && p.categoria.toLowerCase().includes(termo)) ||
             (p.marca && p.marca.toLowerCase().includes(termo));
    });

    if (filtrados.length === 0) {
      dashDropdownProd.innerHTML = `
        <div style="padding: 0.85rem; text-align: center; color: var(--text-muted); font-size: 0.8rem;">
          Nenhum item encontrado com "${filtro}".
        </div>
      `;
      dashDropdownProd.style.display = 'block';
      return;
    }

    let html = '';
    filtrados.slice(0, 50).forEach(p => {
      const qtd = Number(p.quantidade) || 0;
      const un = p.unidade_medida || 'UN';
      const isZerado = qtd <= 0;
      const isBaixo = !isZerado && qtd <= (p.estoque_minimo || 0);

      const corSaldo = isZerado ? '#DC2626' : (isBaixo ? '#D97706' : '#059669');
      const bgSaldo = isZerado ? '#FEE2E2' : (isBaixo ? '#FEF3C7' : '#D1FAE5');

      html += `
        <div 
          class="combobox-item-dash-prod" 
          data-id="${p.id}"
          onclick="selecionarProdutoDash('${p.id}')"
          style="padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--border-light); cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;"
        >
          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
              <span class="badge" style="background: var(--bg-surface); border: 1px solid var(--border-light); font-size: 0.7rem; font-family: var(--font-mono); font-weight: 700;">
                ${p.sku || 'SEM SKU'}
              </span>
              <strong style="color: var(--text-main); font-size: 0.86rem;">
                ${p.nome}
              </strong>
            </div>
            <div style="font-size: 0.74rem; color: var(--text-dim); margin-top: 2px;">
              ${p.categoria || 'Geral'} ${p.marca ? '• ' + p.marca : ''}
            </div>
          </div>

          <div style="text-align: right; flex-shrink: 0;">
            <span class="badge" style="background: ${bgSaldo}; color: ${corSaldo}; font-size: 0.74rem; font-weight: 800; border: 1px solid ${corSaldo}30;">
              ${isZerado ? 'ZERADO' : qtd + ' ' + un}
            </span>
          </div>
        </div>
      `;
    });

    dashDropdownProd.innerHTML = html;
    dashDropdownProd.style.display = 'block';

    dashDropdownProd.querySelectorAll('.combobox-item-dash-prod').forEach(el => {
      el.addEventListener('mouseenter', () => el.style.background = '#F1F5F9');
      el.addEventListener('mouseleave', () => el.style.background = '#ffffff');
    });
  }

  function selecionarProdutoDash(prodId) {
    const p = LISTA_PRODUTOS_DASH.find(item => String(item.id) === String(prodId));
    if (!p) return;

    dashHiddenProdId.value = p.id;
    dashInputProd.value = `[${p.sku}] ${p.nome}`;
    dashBtnLimparProd.style.display = 'flex';
    dashDropdownProd.style.display = 'none';

    dashDetalheSku.textContent = p.sku || 'SEM SKU';
    dashDetalheCat.textContent = `${p.categoria || 'Geral'}${p.marca ? ' • ' + p.marca : ''}`;

    const qtd = Number(p.quantidade) || 0;
    const un = p.unidade_medida || 'UN';
    dashDetalheSaldo.textContent = `${qtd} ${un}`;
    dashDetalheSaldo.style.color = qtd <= 0 ? 'var(--danger)' : '#059669';

    dashBoxDetalheProd.style.display = 'flex';
  }

  function limparProdutoDash() {
    dashHiddenProdId.value = '';
    dashInputProd.value = '';
    dashBtnLimparProd.style.display = 'none';
    dashBoxDetalheProd.style.display = 'none';
    dashInputProd.focus();
    renderizarDropdownProdutoDash('');
  }

  if (dashInputProd) {
    dashInputProd.addEventListener('focus', () => {
      renderizarDropdownProdutoDash(dashInputProd.value);
    });

    dashInputProd.addEventListener('input', () => {
      dashHiddenProdId.value = '';
      dashBtnLimparProd.style.display = dashInputProd.value ? 'flex' : 'none';
      dashBoxDetalheProd.style.display = 'none';
      renderizarDropdownProdutoDash(dashInputProd.value);
    });
  }

  // Fecha dropdowns ao clicar fora
  document.addEventListener('click', (e) => {
    const wrapColab = document.getElementById('dash-req-colaborador-wrapper');
    if (wrapColab && !wrapColab.contains(e.target)) {
      if (dashDropdownColab) dashDropdownColab.style.display = 'none';
    }

    const wrapProd = document.getElementById('dash-req-produto-wrapper');
    if (wrapProd && !wrapProd.contains(e.target)) {
      if (dashDropdownProd) dashDropdownProd.style.display = 'none';
    }
  });

  // Funções de Aprovar / Recusar
  function prepararModalAprovar(id, codigo, produto, qtd, un, colab) {
    const form = document.getElementById('form-aprovar-requisicao');
    if (form) form.action = `/requisicoes/${id}/aprovar`;
    document.getElementById('modal-aprov-codigo').textContent = codigo;
    document.getElementById('modal-aprov-produto').textContent = produto;
    document.getElementById('modal-aprov-qtd').textContent = `${qtd} ${un}`;
    document.getElementById('modal-aprov-colab').textContent = colab;
    window.abrirModal('modal-aprovar-requisicao');
  }

  function prepararModalRecusar(id, codigo, produto) {
    const form = document.getElementById('form-recusar-requisicao');
    if (form) form.action = `/requisicoes/${id}/recusar`;
    document.getElementById('modal-recusa-codigo').textContent = codigo;
    document.getElementById('modal-recusa-produto').textContent = produto;
    document.getElementById('recusa-motivo').value = '';
    window.abrirModal('modal-recusar-requisicao');
  }
</script>

<%- include('../layouts/footer') %>
