        <i class="fa-solid fa-circle-check" style="color: #10B981;"></i>
        Confirmar Entrega de Material
      </h3>
      <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-aprovar-requisicao')">
