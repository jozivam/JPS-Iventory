      <div class="modal-footer" style="background: var(--bg-surface);">
        <button type="button" class="btn btn-outline" onclick="window.fecharModal('modal-aprovar-requisicao')">Cancelar</button>
        <button type="submit" class="btn btn-primary" style="background: #10B981; border-color: #10B981; font-weight: 700;">
          <i class="fa-solid fa-check"></i> Aceitar & Dar Baixa no Estoque
        </button>
      </div>
    </form>
  </div>
</div>

