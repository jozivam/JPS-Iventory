<%- include('../layouts/header') %>

<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Fornecedores & Parceiros</h2>
    <p>Empresas homologadas para fornecimento de insumos e matérias-primas.</p>
  </div>

  <button type="button" class="btn btn-primary" onclick="window.abrirModal('modal-novo-fornecedor')">
    <i class="fa-solid fa-plus"></i> Novo Fornecedor
  </button>
</div>

<!-- Tabela Clean de Fornecedores -->
<div class="table-card">
  <div class="table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>RAZÃO SOCIAL / EMPRESA</th>
          <th>CNPJ</th>
          <th>CONTATO</th>
          <th>E-MAIL</th>
          <th>TELEFONE</th>
          <th>ITENS FORNECIDOS</th>
          <th style="text-align: right;">AÇÕES</th>
        </tr>
      </thead>
      <tbody>
        <% if (fornecedores && fornecedores.length > 0) { %>
          <% fornecedores.forEach(f => { %>
            <tr>
              <td>
                <strong style="color: var(--text-main); font-size: 0.88rem;"><%= f.nome %></strong>
                <div style="font-size: 0.72rem; color: var(--text-dim);">Cadastrado em <%= formatShortDate(f.criado_em) %></div>
              </td>
              <td>
                <span style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-body);"><%= f.cnpj || '-' %></span>
              </td>
              <td>
                <span style="font-size: 0.85rem;"><%= f.contato || '-' %></span>
              </td>
              <td>
                <% if (f.email) { %>
                  <a href="mailto:<%= f.email %>" style="color: var(--primary); text-decoration: none; font-size: 0.85rem; font-weight: 500;">
                    <%= f.email %>
                  </a>
                <% } else { %>
                  <span style="color: var(--text-dim);">-</span>
                <% } %>
              </td>
              <td>
                <span style="font-size: 0.85rem;"><%= f.telefone || '-' %></span>
              </td>
              <td>
                <span class="status-pill in-stock" style="background: var(--bg-surface); color: var(--text-body); border: 1px solid var(--border-color);">
                  <i class="fa-solid fa-box" style="color: var(--primary); font-size: 0.7rem;"></i> <%= f.total_produtos_fornecidos %> produto(s)
                </span>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <form id="form-delete-forn-<%= f.id %>" action="/fornecedores/<%= f.id %>/excluir" method="POST" style="display: inline;">
                  <button type="button" class="action-more-btn" title="Excluir fornecedor" onclick="window.confirmarExclusao('form-delete-forn-<%= f.id %>', '<%= f.nome %>')">
                    <i class="fa-solid fa-trash-can" style="color: var(--danger);"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
              Nenhum fornecedor registrado no sistema.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modal para Cadastro de Fornecedor -->
<div class="modal-overlay" id="modal-novo-fornecedor">
  <div class="modal-container">
    <div class="modal-header">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-regular fa-building" style="color: var(--primary);"></i> Cadastrar Fornecedor
      </h3>
      <button type="button" class="action-more-btn" onclick="window.fecharModal('modal-novo-fornecedor')">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form action="/fornecedores" method="POST">
      <div class="modal-body">
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="form-group">
            <label class="form-label" for="forn-nome">Razão Social / Nome <span class="required">*</span></label>
            <input type="text" id="forn-nome" name="nome" class="form-control" placeholder="Ex: Schneider Distribuição" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="forn-cnpj">CNPJ</label>
            <input type="text" id="forn-cnpj" name="cnpj" class="form-control" placeholder="00.000.000/0001-00">
          </div>
          <div class="form-group">
            <label class="form-label" for="forn-contato">Pessoa de Contato</label>
            <input type="text" id="forn-contato" name="contato" class="form-control" placeholder="Ex: Carlos Mendes">
          </div>
          <div class="form-group">
            <label class="form-label" for="forn-email">E-mail Comercial</label>
            <input type="email" id="forn-email" name="email" class="form-control" placeholder="vendas@fornecedor.com.br">
          </div>
          <div class="form-group">
            <label class="form-label" for="forn-telefone">Telefone</label>
            <input type="text" id="forn-telefone" name="telefone" class="form-control" placeholder="(11) 3456-7890">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="window.fecharModal('modal-novo-fornecedor')">Cancelar</button>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Salvar Fornecedor</button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
