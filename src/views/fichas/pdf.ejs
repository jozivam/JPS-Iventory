<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    @page {
      size: A4 portrait;
      margin: 12mm 11mm;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #e2e8f0;
      color: #0f172a;
      line-height: 1.45;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Barra flutuante de ações (oculta na impressão/PDF) */
    .pdf-toolbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: #0f172a;
      color: #ffffff;
      padding: 0.75rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    }

    .pdf-toolbar-title {
      font-size: 0.9rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .pdf-toolbar-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .pdf-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.5rem 0.95rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      text-decoration: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
    }

    .pdf-btn-red { background: #dc2626; color: #fff; }
    .pdf-btn-green { background: #059669; color: #fff; }
    .pdf-btn-indigo { background: #4f46e5; color: #fff; }
    .pdf-btn-light { background: rgba(255,255,255,0.12); color: #fff; border: 1px solid rgba(255,255,255,0.2); }

    /* Folha A4 na tela */
    .pdf-sheet {
      max-width: 210mm;
      min-height: 297mm;
      margin: 1.25rem auto 2.5rem;
      background: #ffffff;
      padding: 13mm 12mm;
      box-shadow: 0 12px 35px rgba(15, 23, 42, 0.16);
      border-radius: 6px;
    }

    /* Cabeçalho Oficial */
    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      padding-bottom: 10px;
      border-bottom: 2.5px solid #0f172a;
      margin-bottom: 14px;
    }

    .doc-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .doc-brand-icon {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background: #0f172a;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
    }

    .doc-brand-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.02em;
    }

    .doc-brand-sub {
      font-size: 0.73rem;
      color: #475569;
      font-weight: 600;
    }

    .doc-meta {
      text-align: right;
      font-size: 0.72rem;
      color: #475569;
      line-height: 1.5;
    }

    .doc-meta strong {
      color: #0f172a;
    }

    /* Cartão de Dados do Colaborador */
    .colab-box {
      border: 1.5px solid #cbd5e1;
      border-left: 4px solid #0f172a;
      border-radius: 6px;
      padding: 10px 12px;
      margin-bottom: 12px;
      background: #f8fafc;
    }

    .colab-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 8px 14px;
      font-size: 0.78rem;
    }

    .colab-field-label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #64748b;
      font-weight: 700;
    }

    .colab-field-val {
      font-weight: 700;
      color: #0f172a;
      margin-top: 1px;
    }

    /* Faixa de KPIs */
    .kpi-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    .kpi-item {
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 8px 10px;
      background: #ffffff;
    }

    .kpi-label {
      font-size: 0.63rem;
      text-transform: uppercase;
      font-weight: 700;
      color: #64748b;
    }

    .kpi-val {
      font-size: 1.05rem;
      font-weight: 800;
      color: #0f172a;
      margin-top: 2px;
    }

    .section-title {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #0f172a;
      margin: 12px 0 6px;
      padding-bottom: 4px;
      border-bottom: 1.5px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    table.doc-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.74rem;
      margin-bottom: 12px;
    }

    table.doc-table thead {
      display: table-header-group;
    }

    table.doc-table th {
      background: #f1f5f9;
      color: #334155;
      font-weight: 800;
      text-align: left;
      padding: 6px 7px;
      border: 1px solid #cbd5e1;
      font-size: 0.67rem;
      text-transform: uppercase;
    }

    table.doc-table td {
      padding: 5.5px 7px;
      border: 1px solid #e2e8f0;
      vertical-align: top;
      color: #1e293b;
    }

    table.doc-table tr {
      page-break-inside: avoid;
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      font-weight: 600;
    }

    .pill {
      display: inline-block;
      padding: 1.5px 6px;
      border-radius: 4px;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .pill-saida { background: #fee2e2; color: #b91c1c; }
    .pill-emp { background: #fef3c7; color: #b45309; }
    .pill-dev { background: #d1fae5; color: #047857; }
    .pill-troca { background: #e0e7ff; color: #4338ca; }

    /* Termo e Assinaturas */
    .termo-box {
      margin-top: 16px;
      border: 1.5px solid #cbd5e1;
      border-radius: 8px;
      padding: 12px 14px 16px;
      page-break-inside: avoid;
    }

    .termo-title {
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      color: #0f172a;
      margin-bottom: 6px;
    }

    .termo-text {
      font-size: 0.74rem;
      color: #334155;
      text-align: justify;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .assinaturas-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 10px;
    }

    .assinatura-col {
      text-align: center;
    }

    .assinatura-linha {
      border-top: 1.5px solid #0f172a;
      width: 90%;
      margin: 0 auto 5px;
    }

    .assinatura-nome {
      font-size: 0.8rem;
      font-weight: 800;
      color: #0f172a;
    }

    .assinatura-cargo {
      font-size: 0.7rem;
      color: #475569;
    }

    .assinatura-doc {
      font-size: 0.68rem;
      color: #64748b;
      margin-top: 2px;
    }

    .doc-footer {
      margin-top: 14px;
      padding-top: 8px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      font-size: 0.67rem;
      color: #64748b;
    }

    @media (max-width: 720px) {
      .pdf-sheet {
        margin: 0.5rem;
        padding: 1rem;
        min-height: auto;
      }
      .colab-grid {
        grid-template-columns: 1fr 1fr;
      }
      .kpi-strip {
        grid-template-columns: 1fr 1fr;
      }
      .assinaturas-grid {
        grid-template-columns: 1fr;
      }
    }

    @media print {
      body {
        background: #ffffff !important;
      }
      .pdf-toolbar, .hide-on-print {
        display: none !important;
      }
      .pdf-sheet {
        margin: 0 !important;
        padding: 0 !important;
        max-width: 100% !important;
        min-height: auto !important;
        box-shadow: none !important;
        border-radius: 0 !important;
      }
    }
  </style>
</head>
<body>

  <%
    const qsParams = new URLSearchParams();
    if (filtros && filtros.busca) qsParams.set('busca', filtros.busca);
    if (filtros && filtros.tipo) qsParams.set('tipo', filtros.tipo);
    const qsSuffix = qsParams.toString() ? '?' + qsParams.toString() : '';
  %>

  <!-- Barra de Ações Superior (não aparece no PDF impresso) -->
  <div class="pdf-toolbar hide-on-print">
    <div class="pdf-toolbar-title">
      <i class="fa-solid fa-file-pdf" style="color: #f87171;"></i>
      <span>Ficha Individual (A4) — <%= colaborador.nome %></span>
    </div>

    <div class="pdf-toolbar-actions">
      <% if (podeAssinar) { %>
        <button type="button" class="pdf-btn pdf-btn-indigo" onclick="window.abrirAssinaturaFicha && window.abrirAssinaturaFicha('COLABORADOR')">
          <i class="fa-solid fa-signature"></i> Assinar no App
        </button>
      <% } %>
      <a href="/fichas/<%= colaborador.id %>/exportar/excel<%= qsSuffix %>" class="pdf-btn pdf-btn-green">
        <i class="fa-solid fa-file-excel"></i> Exportar Planilha
      </a>
      <button type="button" class="pdf-btn pdf-btn-red" onclick="window.print()">
        <i class="fa-solid fa-print"></i> Salvar PDF / Imprimir
      </button>
      <a href="/fichas?colaborador_id=<%= colaborador.id %><%= filtros.busca ? '&busca=' + encodeURIComponent(filtros.busca) : '' %><%= filtros.tipo ? '&tipo=' + encodeURIComponent(filtros.tipo) : '' %>" class="pdf-btn pdf-btn-light">
        <i class="fa-solid fa-arrow-left"></i> Voltar à Ficha
      </a>
    </div>
  </div>

  <!-- Folha Oficial A4 -->
  <div class="pdf-sheet">

    <!-- Cabeçalho -->
    <div class="doc-header">
      <div class="doc-brand">
        <div class="doc-brand-icon">
          <i class="fa-solid fa-boxes-stacked"></i>
        </div>
        <div>
          <div class="doc-brand-title">JPS Almoxarifado</div>
          <div class="doc-brand-sub">Ficha Individual de Cautela, Ferramentas e Entrega de EPIs</div>
        </div>
      </div>

      <div class="doc-meta">
        <div><strong>Documento:</strong> <span class="mono">FICHA-<%= String(colaborador.id).padStart(4, '0') %></span></div>
        <div><strong>Emissão:</strong> <%= emitidoEm %></div>
        <div><strong>Emitido por:</strong> <%= emitidoPor %></div>
      </div>
    </div>

    <!-- Identificação do Colaborador -->
    <div class="colab-box">
      <div class="colab-grid">
        <div>
          <div class="colab-field-label">Colaborador</div>
          <div class="colab-field-val" style="font-size: 0.92rem;"><%= colaborador.nome %></div>
        </div>
        <div>
          <div class="colab-field-label">Matrícula</div>
          <div class="colab-field-val mono"><%= colaborador.matricula || 'SEM MATRÍCULA' %></div>
        </div>
        <div>
          <div class="colab-field-label">Status</div>
          <div class="colab-field-val"><%= colaborador.status || 'ATIVO' %></div>
        </div>
        <div>
          <div class="colab-field-label">Cargo / Função</div>
          <div class="colab-field-val"><%= colaborador.cargo || 'Não informado' %></div>
        </div>
        <div>
          <div class="colab-field-label">Departamento / Setor</div>
          <div class="colab-field-val"><%= colaborador.departamento || 'Geral' %></div>
        </div>
        <div>
          <div class="colab-field-label">Contato</div>
          <div class="colab-field-val"><%= colaborador.telefone || colaborador.email || '-' %></div>
        </div>
      </div>
    </div>

    <!-- Indicadores Resumidos -->
    <div class="kpi-strip">
      <div class="kpi-item">
        <div class="kpi-label">Ferramentas em Posse</div>
        <div class="kpi-val"><%= estatisticasFicha ? estatisticasFicha.totalEmprestimosAtivosQtd : 0 %> un.</div>
      </div>
      <div class="kpi-item">
        <div class="kpi-label">Baixas / EPIs Entregues</div>
        <div class="kpi-val"><%= estatisticasFicha ? estatisticasFicha.totalSaidasQtd : 0 %> itens</div>
      </div>
      <div class="kpi-item">
        <div class="kpi-label">Devoluções Feitas</div>
        <div class="kpi-val"><%= estatisticasFicha ? estatisticasFicha.totalDevolucoesQtd : 0 %> itens</div>
      </div>
      <div class="kpi-item">
        <div class="kpi-label">Registros na Ficha</div>
        <div class="kpi-val"><%= movimentacoes.length %> reg.</div>
      </div>
    </div>

    <!-- Cautelas Ativas (se houver) -->
    <% if (emprestimosAtivos && emprestimosAtivos.length > 0) { %>
      <div class="section-title">
        <span><i class="fa-solid fa-hand-holding-hand"></i> Ferramentas em Posse (Cautela Ativa)</span>
        <span><%= emprestimosAtivos.length %> em aberto</span>
      </div>
      <table class="doc-table">
        <thead>
          <tr>
            <th style="width: 15%;">Data Retirada</th>
            <th style="width: 14%;">SKU</th>
            <th>Ferramenta / Equipamento</th>
            <th style="width: 10%; text-align: center;">Qtd.</th>
            <th style="width: 18%;">Atendente</th>
          </tr>
        </thead>
        <tbody>
          <% emprestimosAtivos.forEach(emp => { %>
            <tr>
              <td class="mono"><%= formatDate(emp.criado_em) %></td>
              <td class="mono"><%= emp.produto_sku %></td>
              <td><strong><%= emp.produto_nome %></strong></td>
              <td style="text-align: center; font-weight: 800;"><%= emp.quantidade %> <%= emp.produto_unidade %></td>
              <td><%= emp.responsavel || 'Almoxarife' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <!-- Extrato Completo de Movimentações -->
    <div class="section-title">
      <span><i class="fa-solid fa-list-check"></i> Extrato de Materiais, Ferramentas e EPIs</span>
      <span><%= movimentacoes.length %> lançamento(s)<%= (filtros.busca || filtros.tipo) ? ' (filtrado)' : '' %></span>
    </div>

    <table class="doc-table">
      <thead>
        <tr>
          <th style="width: 14%;">Data & Hora</th>
          <th style="width: 11%;">Tipo</th>
          <th>Produto / Item Retirado</th>
          <th style="width: 9%; text-align: center;">Qtd.</th>
          <th style="width: 14%;">Atendente</th>
          <th style="width: 19%;">Motivo / Doc.</th>
          <th style="width: 12%;">Situação</th>
        </tr>
      </thead>
      <tbody>
        <% if (movimentacoes && movimentacoes.length > 0) { %>
          <% movimentacoes.forEach(m => { %>
            <tr>
              <td class="mono"><%= formatDate(m.criado_em) %></td>
              <td>
                <% if (m.tipo === 'SAIDA') { %>
                  <span class="pill pill-saida">Saída</span>
                <% } else if (m.tipo === 'EMPRESTIMO') { %>
                  <span class="pill pill-emp">Empréstimo</span>
                <% } else if (m.tipo === 'DEVOLUCAO') { %>
                  <span class="pill pill-dev">Devolução</span>
                <% } else { %>
                  <span class="pill pill-troca"><%= m.tipo %></span>
                <% } %>
              </td>
              <td>
                <strong><%= m.produto_nome %></strong>
                <div style="font-size: 0.66rem; color: #64748b;">
                  <span class="mono"><%= m.produto_sku %></span><% if (m.produto_categoria) { %> • <%= m.produto_categoria %><% } %>
                </div>
              </td>
              <td style="text-align: center; font-weight: 800;">
                <%= m.tipo === 'SAIDA' || m.tipo === 'EMPRESTIMO' ? '-' : '+' %><%= m.quantidade %> <%= m.produto_unidade %>
              </td>
              <td><%= m.responsavel || 'Almoxarife' %></td>
              <td>
                <%= m.motivo || 'Atendimento de rotina' %>
                <% if (m.documento_ref) { %><div style="font-size: 0.65rem; color: #64748b;">Doc: <%= m.documento_ref %></div><% } %>
              </td>
              <td>
                <% if (m.tipo === 'EMPRESTIMO') { %>
                  <%= m.status_emprestimo === 'PENDENTE' ? 'Em Posse' : 'Devolvido' %>
                <% } else if (m.tipo === 'SAIDA') { %>
                  Consumido
                <% } else if (m.tipo === 'DEVOLUCAO') { %>
                  Retornado
                <% } else { %>
                  Concluído
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 18px; color: #64748b;">
              Nenhuma movimentação registrada nesta ficha.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- Termo de Responsabilidade + Assinaturas (Digital ou Caneta no Papel) -->
    <div class="termo-box">
      <div class="termo-title">Termo de Responsabilidade e Cautela de Materiais / EPIs</div>
      <p class="termo-text">
        Declaro para os devidos fins que recebi do <strong>Almoxarifado Central</strong> os materiais, equipamentos de proteção individual (EPIs) e ferramentas constantes nesta Ficha Individual em perfeitas condições de uso, conservação e funcionamento. Comprometo-me a zelar pela integridade dos itens emprestados, utilizá-los exclusivamente no desempenho de minhas atividades profissionais, cumprir as normas de segurança (NR-6) quanto ao uso dos EPIs recebidos e devolver as ferramentas cauteladas imediatamente ao almoxarifado após o término dos serviços ou mediante solicitação.
      </p>

      <div class="assinaturas-grid">
        <div class="assinatura-col">
          <div class="sig-box-interactive" data-assinatura-box="COLABORADOR" title="Clique ou toque para assinar digitalmente"></div>
          <div class="assinatura-linha"></div>
          <div class="assinatura-nome"><%= colaborador.nome %></div>
          <div class="assinatura-cargo">Assinatura do Colaborador Solicitante</div>
          <div class="assinatura-doc">Matrícula: <%= colaborador.matricula || '-' %> • CPF/RG: <span id="ficha-cpf-rg-texto"><%= colaborador.cpf_rg || '___________________' %></span></div>
          <div class="sig-meta-signed" id="sig-meta-COLABORADOR"></div>
        </div>

        <div class="assinatura-col">
          <div class="sig-box-interactive" data-assinatura-box="RESPONSAVEL" title="Clique ou toque para assinar digitalmente"></div>
          <div class="assinatura-linha"></div>
          <div class="assinatura-nome" id="ficha-responsavel-nome"><%= colaborador.assinatura_responsavel_nome || emitidoPor || 'Gestão de Almoxarifado' %></div>
          <div class="assinatura-cargo">Assinatura do Responsável pela Entrega / Cautela</div>
          <div class="assinatura-doc">Data da Emissão: <%= emitidoEm %></div>
          <div class="sig-meta-signed" id="sig-meta-RESPONSAVEL"></div>
        </div>
      </div>
    </div>

    <div class="doc-footer">
      <span>JPS Almoxarifado • Controle de Cautela e EPIs</span>
      <span>Ficha Nº FICHA-<%= String(colaborador.id).padStart(4, '0') %> • Gerado em <%= emitidoEm %></span>
    </div>
  </div>

  <script src="/js/assinatura-pad.js"></script>
  <script>
    window.initFichaAssinatura({
      colaboradorId: <%- JSON.stringify(colaborador.id) %>,
      colaboradorNome: <%- JSON.stringify(colaborador.nome || '') %>,
      cpfRg: <%- JSON.stringify(colaborador.cpf_rg || '') %>,
      assinaturaColaborador: <%- JSON.stringify(colaborador.assinatura_colaborador || null) %>,
      assinaturaColaboradorEm: <%- JSON.stringify(colaborador.assinatura_colaborador_em ? formatDate(colaborador.assinatura_colaborador_em) : null) %>,
      assinaturaResponsavel: <%- JSON.stringify(colaborador.assinatura_responsavel || null) %>,
      assinaturaResponsavelEm: <%- JSON.stringify(colaborador.assinatura_responsavel_em ? formatDate(colaborador.assinatura_responsavel_em) : null) %>,
      assinaturaResponsavelNome: <%- JSON.stringify(colaborador.assinatura_responsavel_nome || '') %>,
      responsavelPadrao: <%- JSON.stringify(emitidoPor || 'Gestão de Almoxarifado') %>,
      podeAssinar: <%= podeAssinar ? 'true' : 'false' %>
    });

    <% if (autoPrint) { %>
      window.addEventListener('load', () => {
        setTimeout(() => window.print(), 350);
      });
    <% } %>
  </script>
</body>
</html>
