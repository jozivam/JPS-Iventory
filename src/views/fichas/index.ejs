<%- include('../layouts/header') %>

<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- ========================================================================= -->
<!-- CABEÇALHO DA PÁGINA (DINÂMICO CONFORME A VISÃO ATUAL)                    -->
<!-- ========================================================================= -->
<div class="page-header-flex hide-on-print">
  <div class="page-title-wrap">
    <% if (colaboradorAtual) { %>
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
        <a href="/fichas" class="btn btn-outline btn-sm" style="font-weight: 700; color: var(--primary); border-color: #C7D2FE;" title="Retornar para a Lista de Colaboradores">
          <i class="fa-solid fa-arrow-left"></i> Voltar à Lista
        </a>
        <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">/ Ficha Individual</span>
      </div>
      <h2>Ficha de <%= colaboradorAtual.nome %></h2>
      <p>Acompanhamento de cautela de ferramentas, retiradas de consumo e termo de responsabilidade individual.</p>
    <% } else { %>
      <h2>Controle de Ficha de Colaboradores</h2>
      <p>Gerencie a cautela de ferramentas e o histórico de materiais da equipe técnica. Clique em qualquer colaborador na lista para abrir sua ficha completa.</p>
    <% } %>
  </div>

  <div class="page-actions-group">
    <% if (colaboradorAtual) { %>
      <a href="/balcao?colaborador_id=<%= colaboradorAtual.id %>&colaborador_nome=<%= encodeURIComponent(colaboradorAtual.nome) %>" class="btn btn-primary" title="Fazer novo lançamento no balcão para este colaborador">
        <i class="fa-solid fa-cart-plus"></i> Novo Lançamento no Balcão
      </a>

      <button type="button" class="btn btn-outline" onclick="window.print()" title="Imprimir Ficha de Cautela do Colaborador Selecionado">
        <i class="fa-solid fa-print"></i> Imprimir Ficha
      </button>
    <% } else { %>
      <a href="/balcao" class="btn btn-primary" title="Ir para o Balcão de Atendimento">
        <i class="fa-solid fa-store"></i> Balcão de Atendimento
      </a>
      <a href="/colaboradores" class="btn btn-outline" title="Gerenciar cadastro de equipe">
        <i class="fa-solid fa-users-gear"></i> Gerenciar Cadastros
      </a>
    <% } %>
  </div>
</div>

<!-- ========================================================================= -->
<!-- CARDS DE INDICADORES GERAIS (ESTATÍSTICAS CONSOLIDADAS DO ALMOXARIFADO)   -->
<!-- ========================================================================= -->
<div class="balcao-kpi-grid hide-on-print" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 1.25rem;">
  
  <!-- Colaboradores Ativos -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid var(--primary);">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #EEF2FF; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-address-book"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Colaboradores Ativos</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
        <%= estatisticasGerais.totalColaboradores %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">pessoa(s)</span>
      </div>
    </div>
  </div>

  <!-- Colaboradores com Cautela Aberta -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #F59E0B;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-hand-holding-hand"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Com Cautela Aberta</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #B45309; line-height: 1.2;">
        <%= estatisticasGerais.comPendencia %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">técnico(s)</span>
      </div>
    </div>
  </div>

  <!-- Ferramentas em Campo -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #8B5CF6;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #F5F3FF; color: #7C3AED; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-wrench"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Ferramentas em Campo</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #6D28D9; line-height: 1.2;">
        <%= estatisticasGerais.totalFerramentasCauteladas %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">unidade(s)</span>
      </div>
    </div>
  </div>

  <!-- Total de Saídas / Consumo -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #EF4444;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-arrow-up"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Baixas / Consumo</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #B91C1C; line-height: 1.2;">
        <%= estatisticasGerais.totalSaidasRegistradas %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">itens</span>
      </div>
    </div>
  </div>

</div>

<% if (!colaboradorAtual) { %>

  <!-- ========================================================================= -->
  <!-- VISÃO 1: LISTA PRINCIPAL DE FICHAS DE COLABORADORES (OTIMIZADA)           -->
  <!-- ========================================================================= -->
  <div class="table-card hide-on-print" style="padding: 1.15rem 1.25rem; margin-bottom: 1.25rem;">
    <div style="display: flex; gap: 0.85rem; align-items: center; justify-content: space-between; flex-wrap: wrap;">
      
      <!-- Campo de Busca em Tempo Real com Dropdown Inteligente -->
      <div style="flex: 1; min-width: 280px; position: relative;" id="busca-ficha-wrapper">
        <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-dim); z-index: 2; pointer-events: none;"></i>
        <input 
          type="text" 
          id="busca-ficha-colaborador" 
          class="form-control" 
          placeholder="Buscar colaborador por nome, cargo, matrícula ou departamento..." 
          autocomplete="off"
          style="padding-left: 2.5rem; padding-right: 2.4rem; height: 42px; font-weight: 500;"
        >
        <button 
          type="button" 
          id="btn-limpar-busca-ficha" 
          title="Limpar busca"
          onclick="limparBuscaFicha()"
          style="position: absolute; right: 0.6rem; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--text-dim); cursor: pointer; display: none; width: 28px; height: 28px; align-items: center; justify-content: center; border-radius: 50%; z-index: 2;"
        >
          <i class="fa-solid fa-xmark"></i>
        </button>

        <!-- Dropdown Flutuante de Fichas de Colaboradores -->
        <div id="busca-ficha-dropdown" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #ffffff; border: 1.5px solid var(--border-color); border-radius: 8px; box-shadow: 0 12px 28px rgba(0,0,0,0.12); max-height: 320px; overflow-y: auto; z-index: 1050; padding: 0.35rem 0;">
          <!-- Sugestões injetadas via JS -->
        </div>
      </div>

      <!-- Filtros Rápidos (Pills / Abas) -->
      <div class="filter-pills-wrap" style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
        <button type="button" class="btn btn-sm btn-filter-ficha ativo" data-filtro="TODOS" onclick="aplicarFiltroFicha('TODOS', this)">
          Todos (<%= estatisticasGerais.totalColaboradores %>)
        </button>
        <button type="button" class="btn btn-sm btn-filter-ficha" data-filtro="PENDENTES" onclick="aplicarFiltroFicha('PENDENTES', this)" style="border-color: #FCD34D;">
          ⚠️ Com Cautela (<%= estatisticasGerais.comPendencia %>)
        </button>
        <button type="button" class="btn btn-sm btn-filter-ficha" data-filtro="REGULARES" onclick="aplicarFiltroFicha('REGULARES', this)" style="border-color: #A7F3D0;">
          ✅ Regulares (<%= estatisticasGerais.totalColaboradores - estatisticasGerais.comPendencia %>)
        </button>
      </div>

    </div>
  </div>

  <!-- Tabela de Colaboradores (Desktop e Tablets) -->
  <div class="table-card" style="padding: 0; overflow: hidden; margin-bottom: 2rem;">
    <div class="table-responsive desktop-only">
      <table class="data-table" id="tabela-fichas-colaboradores">
        <thead>
          <tr>
            <th>COLABORADOR / IDENTIFICAÇÃO</th>
            <th>CARGO & DEPARTAMENTO</th>
            <th>SITUAÇÃO DA CAUTELA</th>
            <th>CONSUMO / SAÍDAS</th>
            <th>HISTÓRICO NA FICHA</th>
            <th style="text-align: right; width: 140px;">AÇÃO</th>
          </tr>
        </thead>
        <tbody>
          <% if (colaboradores && colaboradores.length > 0) { %>
            <% colaboradores.forEach(col => { %>
              <tr 
                class="colaborador-ficha-row" 
                data-pendencia="<%= col.temPendencia ? 'true' : 'false' %>"
                data-busca="<%= (col.nome + ' ' + (col.matricula || '') + ' ' + (col.cargo || '') + ' ' + (col.departamento || '')).toLowerCase() %>"
                onclick="window.location.href='/fichas?colaborador_id=<%= col.id %>'"
                style="cursor: pointer; transition: background 0.15s ease;"
              >
                <!-- Colaborador -->
                <td>
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="width: 38px; height: 38px; border-radius: 50%; background: <%= col.tipo_perfil === 'SISTEMA' ? '#EDE9FE' : '#FEF3C7' %>; color: <%= col.tipo_perfil === 'SISTEMA' ? '#6D28D9' : '#B45309' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">
                      <%= col.nome.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
                    </div>
                    <div>
                      <div style="font-weight: 700; color: var(--text-main); font-size: 0.92rem;">
                        <%= col.nome %>
                      </div>
                      <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim); margin-top: 1px;">
                        <%= col.matricula || 'SEM MATRÍCULA' %>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Cargo e Setor -->
                <td>
                  <div style="font-weight: 600; color: var(--text-body);">
                    <%= col.cargo || 'Técnico' %>
                  </div>
                  <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                    <%= col.departamento || 'Geral' %>
                  </div>
                </td>

                <!-- Situação da Cautela -->
                <td>
                  <% if (col.temPendencia) { %>
                    <span class="status-pill low-stock" style="font-size: 0.78rem; font-weight: 700; padding: 4px 10px;">
                      <i class="fa-solid fa-triangle-exclamation"></i> <%= col.ferramentasEmAberto %> ferramenta(s) em posse
                    </span>
                  <% } else { %>
                    <span class="status-pill in-stock" style="font-size: 0.78rem; font-weight: 700; padding: 4px 10px;">
                      <i class="fa-solid fa-circle-check"></i> Regular (0 pendências)
                    </span>
                  <% } %>
                </td>

                <!-- Consumo / Saídas -->
                <td>
                  <span style="font-weight: 800; font-size: 0.92rem; color: #B91C1C;">
                    <%= col.totalSaidas %>
                  </span>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">item(ns) recebido(s)</span>
                </td>

                <!-- Histórico na Ficha -->
                <td>
                  <span style="font-weight: 700; color: var(--text-main);">
                    <%= col.totalLancamentos %>
                  </span>
                  <span style="font-size: 0.75rem; color: var(--text-muted);">movimentações</span>
                </td>

                <!-- Botão de Ação -->
                <td style="text-align: right;" onclick="event.stopPropagation()">
                  <a href="/fichas?colaborador_id=<%= col.id %>" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; font-size: 0.78rem;">
                    <i class="fa-solid fa-file-invoice"></i> Ver Ficha <i class="fa-solid fa-arrow-right" style="font-size: 0.7rem;"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                <i class="fa-solid fa-users-slash" style="font-size: 2.2rem; color: var(--border-color); margin-bottom: 0.75rem; display: block;"></i>
                Nenhum colaborador encontrado no almoxarifado.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Cards Otimizados para Celular (Mobile) -->
    <div class="mobile-only" style="flex-direction: column; gap: 0.65rem; padding: 0.85rem;" id="lista-fichas-mobile">
      <% if (colaboradores && colaboradores.length > 0) { %>
        <% colaboradores.forEach(col => { %>
          <div 
            class="inventory-mobile-card colaborador-ficha-card-mobile" 
            data-pendencia="<%= col.temPendencia ? 'true' : 'false' %>"
            data-busca="<%= (col.nome + ' ' + (col.matricula || '') + ' ' + (col.cargo || '') + ' ' + (col.departamento || '')).toLowerCase() %>"
            onclick="window.location.href='/fichas?colaborador_id=<%= col.id %>'"
          >
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.4rem;">
              <div style="display: flex; align-items: center; gap: 0.65rem;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: <%= col.tipo_perfil === 'SISTEMA' ? '#EDE9FE' : '#FEF3C7' %>; color: <%= col.tipo_perfil === 'SISTEMA' ? '#6D28D9' : '#B45309' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.82rem; flex-shrink: 0;">
                  <%= col.nome.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
                </div>
                <div>
                  <div style="font-weight: 700; color: var(--text-main); font-size: 0.95rem;">
                    <%= col.nome %>
                  </div>
                  <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim);">
                    <%= col.matricula || 'Sem matrícula' %>
                  </div>
                </div>
              </div>

              <div>
                <% if (col.temPendencia) { %>
                  <span class="status-pill low-stock" style="font-size: 0.7rem; padding: 2px 7px;">
                    ⚠️ <%= col.ferramentasEmAberto %> em posse
                  </span>
                <% } else { %>
                  <span class="status-pill in-stock" style="font-size: 0.7rem; padding: 2px 7px;">
                    ✅ Regular
                  </span>
                <% } %>
              </div>
            </div>

            <div style="font-size: 0.82rem; color: var(--text-body); margin-bottom: 0.5rem;">
              <strong><%= col.cargo || 'Técnico' %></strong> • <%= col.departamento || 'Geral' %>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.5rem; border-top: 1px solid var(--border-light); font-size: 0.78rem;">
              <div style="color: var(--text-muted);">
                Saídas: <strong style="color: #B91C1C;"><%= col.totalSaidas %></strong> • Ficha: <strong><%= col.totalLancamentos %> reg.</strong>
              </div>
              <div onclick="event.stopPropagation()">
                <a href="/fichas?colaborador_id=<%= col.id %>" class="btn btn-primary btn-sm" style="font-weight: 700; font-size: 0.75rem;">
                  Acessar Ficha →
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: 0.85rem;">
          Nenhum colaborador encontrado.
        </div>
      <% } %>
    </div>
  </div>

<% } else { %>

  <!-- ========================================================================= -->
  <!-- VISÃO 2: FICHA DETALHADA E ISOLADA DO COLABORADOR SELECIONADO             -->
  <!-- ========================================================================= -->

  <!-- Barra de Troca Rápida de Colaborador (Discreta e Opcional) -->
  <div class="table-card hide-on-print" style="padding: 0.85rem 1.25rem; margin-bottom: 1.25rem; background: #F8FAFC; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
    <div style="display: flex; align-items: center; gap: 0.6rem;">
      <a href="/fichas" class="btn btn-outline btn-sm" style="font-weight: 700;">
        <i class="fa-solid fa-arrow-left"></i> Voltar à Lista de Colaboradores
      </a>
      <span style="font-size: 0.82rem; color: var(--text-muted);">| Trocar colaborador:</span>
    </div>

    <div style="min-width: 250px;">
      <select class="form-control" style="font-weight: 700; height: 38px; font-size: 0.85rem;" onchange="window.location.href='/fichas?colaborador_id=' + this.value">
        <% if (colaboradores && colaboradores.length > 0) { %>
          <% colaboradores.forEach(col => { %>
            <option value="<%= col.id %>" <%= (colaboradorAtual && String(colaboradorAtual.id) === String(col.id)) ? 'selected' : '' %>>
              <%= col.nome %> (<%= col.matricula || 'Sem matrícula' %>) <%= col.temPendencia ? `• ⚠️ ${col.ferramentasEmAberto} em aberto` : '• ✅ Regular' %>
            </option>
          <% }) %>
        <% } %>
      </select>
    </div>
  </div>

  <!-- Cartão de Identificação do Colaborador -->
  <div class="table-card ficha-header-card" style="padding: 1.35rem 1.5rem; margin-bottom: 1.25rem; border-left: 5px solid var(--primary);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
      
      <!-- Dados Principais -->
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: <%= colaboradorAtual.tipo_perfil === 'SISTEMA' ? '#EDE9FE' : '#FEF3C7' %>; color: <%= colaboradorAtual.tipo_perfil === 'SISTEMA' ? '#6D28D9' : '#B45309' %>; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.35rem; flex-shrink: 0; border: 2px solid #ffffff; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
          <%= colaboradorAtual.nome.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
        </div>

        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin: 0;">
              <%= colaboradorAtual.nome %>
            </h3>
            <span class="badge" style="background: var(--bg-surface); font-family: var(--font-mono); font-weight: 700; font-size: 0.78rem;">
              <%= colaboradorAtual.matricula || 'SEM MATRÍCULA' %>
            </span>
            <% if (colaboradorAtual.status === 'ATIVO') { %>
              <span class="status-pill in-stock" style="font-size: 0.72rem; padding: 2px 8px;">
                <span class="status-dot-sm"></span> Ativo
              </span>
            <% } else { %>
              <span class="status-pill" style="font-size: 0.72rem; padding: 2px 8px; background: #F1F5F9; color: #64748B;">
                <span class="status-dot-sm" style="background: #94A3B8;"></span> Inativo
              </span>
            <% } %>
          </div>

          <div style="font-size: 0.88rem; color: var(--text-body); margin-top: 4px;">
            <strong><%= colaboradorAtual.cargo || 'Função não informada' %></strong> • <%= colaboradorAtual.departamento || 'Setor Geral' %>
          </div>
        </div>
      </div>

      <!-- Perfil e Contatos -->
      <div style="display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.82rem; text-align: right;">
        <div>
          <% if (colaboradorAtual.tipo_perfil === 'SISTEMA') { %>
            <span class="status-pill" style="background: #EDE9FE; color: #6D28D9; border: 1px solid #DDD6FE; font-weight: 700;">
              <i class="fa-solid fa-id-card-clip"></i> Usuário do Sistema (<%= colaboradorAtual.nivel_acesso %>)
            </span>
          <% } else { %>
            <span class="status-pill" style="background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D; font-weight: 700;">
              <i class="fa-solid fa-wrench"></i> Técnico (Apenas Balcão)
            </span>
          <% } %>
        </div>

        <% if (colaboradorAtual.telefone) { %>
          <div style="color: var(--text-body); display: inline-flex; align-items: center; justify-content: flex-end; gap: 0.4rem;">
            <i class="fa-brands fa-whatsapp" style="color: #10B981;"></i> <%= colaboradorAtual.telefone %>
          </div>
        <% } %>

        <% if (colaboradorAtual.email) { %>
          <div style="color: var(--text-muted); display: inline-flex; align-items: center; justify-content: flex-end; gap: 0.4rem;">
            <i class="fa-regular fa-envelope"></i> <%= colaboradorAtual.email %>
          </div>
        <% } %>
      </div>

    </div>

    <% if (colaboradorAtual.observacoes) { %>
      <div style="margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light); font-size: 0.82rem; color: var(--text-muted);">
        <strong style="color: var(--text-main);">Observações:</strong> <%= colaboradorAtual.observacoes %>
      </div>
    <% } %>
  </div>

  <!-- Cards de Resumo da Ficha do Colaborador -->
  <div class="balcao-kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 1.25rem;">
    
    <!-- Ferramentas Cauteladas (Empréstimos em Aberto) -->
    <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #F59E0B;">
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
        <i class="fa-solid fa-hand-holding-hand"></i>
      </div>
      <div>
        <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Ferramentas em Posse</div>
        <div style="font-size: 1.4rem; font-weight: 800; color: #B45309; line-height: 1.2;">
          <%= estatisticasFicha ? estatisticasFicha.totalEmprestimosAtivosQtd : 0 %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">unidade(s)</span>
        </div>
        <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">
          <%= estatisticasFicha ? estatisticasFicha.totalEmprestimosPendentesCount : 0 %> cautela(s) pendente(s)
        </div>
      </div>
    </div>

    <!-- Baixas / Saídas (Consumo / EPI) -->
    <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #EF4444;">
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
        <i class="fa-solid fa-arrow-up"></i>
      </div>
      <div>
        <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Baixas / Consumo</div>
        <div style="font-size: 1.4rem; font-weight: 800; color: #B91C1C; line-height: 1.2;">
          <%= estatisticasFicha ? estatisticasFicha.totalSaidasQtd : 0 %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">itens</span>
        </div>
        <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">
          EPIs e materiais entregues
        </div>
      </div>
    </div>

    <!-- Devoluções Realizadas -->
    <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #10B981;">
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #D1FAE5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
        <i class="fa-solid fa-rotate-left"></i>
      </div>
      <div>
        <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Devoluções Feitas</div>
        <div style="font-size: 1.4rem; font-weight: 800; color: #047857; line-height: 1.2;">
          <%= estatisticasFicha ? estatisticasFicha.totalDevolucoesQtd : 0 %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">itens</span>
        </div>
        <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">
          Retornados ao estoque
        </div>
      </div>
    </div>

    <!-- Total de Movimentações na Ficha -->
    <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid var(--primary);">
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #EEF2FF; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
        <i class="fa-solid fa-file-invoice"></i>
      </div>
      <div>
        <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Lançamentos na Ficha</div>
        <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
          <%= estatisticasFicha ? estatisticasFicha.totalLancamentos : 0 %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">registros</span>
        </div>
        <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">
          Extrato isolado do colaborador
        </div>
      </div>
    </div>

  </div>

  <!-- Ferramentas Atualmente em Posse (Cautela Ativa) -->
  <div class="table-card" style="margin-bottom: 1.25rem; padding: 1.25rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem;">
      <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-hand-holding-hand" style="color: #F59E0B;"></i> Ferramentas em Posse deste Colaborador (Cautela Ativa)
      </h3>
      <span class="badge" style="background: <%= emprestimosAtivos.length > 0 ? '#FEF3C7' : '#D1FAE5' %>; color: <%= emprestimosAtivos.length > 0 ? '#B45309' : '#047857' %>; font-weight: 700;">
        <%= emprestimosAtivos.length %> em aberto
      </span>
    </div>

    <% if (emprestimosAtivos && emprestimosAtivos.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.75rem;">
        <% emprestimosAtivos.forEach(emp => { %>
          <div style="background: #ffffff; border: 1.5px solid #FDE68A; border-radius: 8px; padding: 0.85rem 1rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;">
            <div>
              <div style="font-weight: 700; color: var(--text-main); font-size: 0.92rem;">
                <%= emp.produto_nome %>
              </div>
              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                <span style="font-family: var(--font-mono); font-weight: 700;"><%= emp.produto_sku %></span> • Retirado: <strong><%= emp.quantidade %> <%= emp.produto_unidade %></strong>
              </div>
              <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 3px;">
                <i class="fa-regular fa-calendar"></i> <%= new Date(emp.criado_em).toLocaleDateString('pt-BR') %> às <%= new Date(emp.criado_em).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
                <% if (emp.responsavel) { %> • Por: <%= emp.responsavel %><% } %>
              </div>
            </div>

            <div class="hide-on-print">
              <form action="/balcao/devolver/<%= emp.id %>" method="POST" onsubmit="return confirm('Confirmar devolução desta ferramenta ao estoque físico?')">
                <button type="submit" class="btn btn-outline btn-sm" style="color: #0891B2; border-color: #A5F3FC; font-weight: 700; font-size: 0.75rem; white-space: nowrap;">
                  <i class="fa-solid fa-rotate-left"></i> Devolver
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="background: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 8px; padding: 0.95rem 1.15rem; color: #065F46; font-size: 0.88rem; display: flex; align-items: center; gap: 0.65rem;">
        <i class="fa-solid fa-circle-check" style="color: #10B981; font-size: 1.25rem;"></i>
        <div>
          <strong>Situação Regular:</strong> Nenhuma ferramenta ou equipamento emprestado em aberto com este colaborador.
        </div>
      </div>
    <% } %>
  </div>

  <!-- Barra de Filtros do Extrato da Ficha -->
  <div class="table-card hide-on-print" style="padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
    <form action="/fichas" method="GET" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin: 0;">
      <input type="hidden" name="colaborador_id" value="<%= colaboradorAtual.id %>">

      <!-- Busca Rápida -->
      <div style="flex: 1; min-width: 220px; position: relative;">
        <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-dim);"></i>
        <input 
          type="text" 
          name="busca" 
          class="form-control" 
          placeholder="Filtrar histórico por produto, SKU, motivo ou atendente..." 
          value="<%= filtros.busca %>"
          style="padding-left: 2.5rem; height: 40px;"
        >
      </div>

      <!-- Filtro de Tipo -->
      <div style="min-width: 170px;">
        <select name="tipo" class="form-control" style="height: 40px;" onchange="this.form.submit()">
          <option value="">Todas as Operações</option>
          <option value="EMPRESTIMO" <%= filtros.tipo === 'EMPRESTIMO' ? 'selected' : '' %>>Empréstimos de Ferramenta</option>
          <option value="SAIDA" <%= filtros.tipo === 'SAIDA' ? 'selected' : '' %>>Saídas de Consumo / EPI</option>
          <option value="DEVOLUCAO" <%= filtros.tipo === 'DEVOLUCAO' ? 'selected' : '' %>>Devoluções</option>
          <option value="TROCA" <%= filtros.tipo === 'TROCA' ? 'selected' : '' %>>Trocas</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary" style="height: 40px; padding: 0 1.1rem;">
        <i class="fa-solid fa-filter"></i> Filtrar
      </button>

      <% if (filtros.busca || filtros.tipo) { %>
        <a href="/fichas?colaborador_id=<%= colaboradorAtual.id %>" class="btn btn-outline" style="height: 40px; padding: 0 0.9rem;" title="Limpar Filtros">
          <i class="fa-solid fa-xmark"></i>
        </a>
      <% } %>

    </form>
  </div>

  <!-- Tabela do Extrato Cronológico da Ficha -->
  <div class="table-card" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
    <div style="padding: 1.1rem 1.25rem; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
      <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-list-check" style="color: var(--primary);"></i> Extrato de Movimentações da Ficha
      </h3>
      <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">
        <%= movimentacoes.length %> registro(s) listado(s)
      </span>
    </div>

    <div class="table-responsive desktop-only">
      <table class="data-table">
        <thead>
          <tr>
            <th>DATA & HORA</th>
            <th>TIPO</th>
            <th>PRODUTO / ITEM RETIRADO</th>
            <th>QUANTIDADE</th>
            <th>ATENDENTE</th>
            <th>MOTIVO / FINALIDADE</th>
            <th>SITUAÇÃO / CAUTELA</th>
          </tr>
        </thead>
        <tbody>
          <% if (movimentacoes && movimentacoes.length > 0) { %>
            <% movimentacoes.forEach(m => { %>
              <tr>
                <!-- Data e Hora -->
                <td style="white-space: nowrap; font-size: 0.82rem;">
                  <div style="font-weight: 700; color: var(--text-main);">
                    <%= new Date(m.criado_em).toLocaleDateString('pt-BR') %>
                  </div>
                  <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 1px;">
                    <%= new Date(m.criado_em).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
                  </div>
                </td>

                <!-- Tipo -->
                <td>
                  <% if (m.tipo === 'SAIDA') { %>
                    <span class="status-pill out-of-stock" style="font-size: 0.75rem;">
                      <i class="fa-solid fa-arrow-up"></i> Saída
                    </span>
                  <% } else if (m.tipo === 'EMPRESTIMO') { %>
                    <span class="status-pill low-stock" style="font-size: 0.75rem;">
                      <i class="fa-solid fa-hand-holding-hand"></i> Empréstimo
                    </span>
                  <% } else if (m.tipo === 'DEVOLUCAO') { %>
                    <span class="status-pill in-stock" style="font-size: 0.75rem;">
                      <i class="fa-solid fa-rotate-left"></i> Devolução
                    </span>
                  <% } else if (m.tipo === 'ENTRADA') { %>
                    <span class="status-pill in-stock" style="font-size: 0.75rem;">
                      <i class="fa-solid fa-arrow-down"></i> Entrada
                    </span>
                  <% } else { %>
                    <span class="status-pill" style="font-size: 0.75rem; background: #E0E7FF; color: #4338CA;">
                      <i class="fa-solid fa-repeat"></i> Troca
                    </span>
                  <% } %>
                </td>

                <!-- Produto -->
                <td>
                  <div style="font-weight: 700; color: var(--text-main); font-size: 0.92rem;">
                    <%= m.produto_nome %>
                  </div>
                  <div style="font-size: 0.76rem; color: var(--text-muted); margin-top: 2px;">
                    <span style="font-family: var(--font-mono); font-weight: 700;"><%= m.produto_sku %></span>
                    <% if (m.produto_categoria) { %> • <%= m.produto_categoria %><% } %>
                    <% if (m.produto_marca) { %> • <%= m.produto_marca %><% } %>
                  </div>
                </td>

                <!-- Quantidade -->
                <td>
                  <span style="font-weight: 800; font-size: 0.95rem; color: <%= m.tipo === 'SAIDA' || m.tipo === 'EMPRESTIMO' ? '#DC2626' : '#059669' %>;">
                    <%= m.tipo === 'SAIDA' || m.tipo === 'EMPRESTIMO' ? '-' : '+' %><%= m.quantidade %>
                  </span>
                  <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">
                    <%= m.produto_unidade %>
                  </span>
                </td>

                <!-- Atendente -->
                <td style="font-size: 0.85rem; color: var(--text-body);">
                  <%= m.responsavel || 'Almoxarife' %>
                </td>

                <!-- Motivo e Documento -->
                <td style="font-size: 0.82rem;">
                  <div style="color: var(--text-body); max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <%= m.motivo || 'Atendimento de rotina' %>
                  </div>
                  <% if (m.documento_ref) { %>
                    <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">
                      Doc: <strong><%= m.documento_ref %></strong>
                    </div>
                  <% } %>
                </td>

                <!-- Situação da Cautela -->
                <td>
                  <% if (m.tipo === 'EMPRESTIMO') { %>
                    <% if (m.status_emprestimo === 'PENDENTE') { %>
                      <span class="status-pill low-stock" style="font-size: 0.72rem; font-weight: 700;">
                        <i class="fa-solid fa-hourglass-half"></i> Em Posse
                      </span>
                    <% } else { %>
                      <span class="status-pill in-stock" style="font-size: 0.72rem; font-weight: 700;">
                        <i class="fa-solid fa-check"></i> Devolvido
                      </span>
                    <% } %>
                  <% } else if (m.tipo === 'SAIDA') { %>
                    <span class="badge" style="background: #F1F5F9; color: #475569; font-size: 0.72rem;">
                      Consumido / Baixado
                    </span>
                  <% } else if (m.tipo === 'DEVOLUCAO') { %>
                    <span class="badge" style="background: #D1FAE5; color: #047857; font-size: 0.72rem;">
                      Retorno ao Estoque
                    </span>
                  <% } else { %>
                    <span class="badge" style="background: #F1F5F9; color: #64748B; font-size: 0.72rem;">
                      Concluído
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
                <i class="fa-solid fa-clipboard-question" style="font-size: 2.2rem; color: var(--border-color); margin-bottom: 0.75rem; display: block;"></i>
                Nenhuma movimentação registrada na ficha deste colaborador até o momento.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Cards de Ficha para Celular (Mobile) -->
    <div class="mobile-only" style="flex-direction: column; gap: 0.65rem; padding: 0.85rem;">
      <% if (movimentacoes && movimentacoes.length > 0) { %>
        <% movimentacoes.forEach(m => { %>
          <div class="inventory-mobile-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.4rem;">
              <div>
                <div style="font-weight: 700; color: var(--text-main); font-size: 0.92rem;">
                  <%= m.produto_nome %>
                </div>
                <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim); margin-top: 1px;">
                  <%= m.produto_sku %>
                </div>
              </div>

              <div>
                <% if (m.tipo === 'SAIDA') { %>
                  <span class="status-pill out-of-stock" style="font-size: 0.7rem; padding: 2px 7px;">Saída</span>
                <% } else if (m.tipo === 'EMPRESTIMO') { %>
                  <span class="status-pill low-stock" style="font-size: 0.7rem; padding: 2px 7px;">Empréstimo</span>
                <% } else if (m.tipo === 'DEVOLUCAO') { %>
                  <span class="status-pill in-stock" style="font-size: 0.7rem; padding: 2px 7px;">Devolução</span>
                <% } else { %>
                  <span class="status-pill" style="font-size: 0.7rem; padding: 2px 7px;"><%= m.tipo %></span>
                <% } %>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; margin-bottom: 0.35rem;">
              <span style="color: var(--text-muted);">Quantidade:</span>
              <span style="font-weight: 800; color: <%= m.tipo === 'SAIDA' || m.tipo === 'EMPRESTIMO' ? '#DC2626' : '#059669' %>;">
                <%= m.tipo === 'SAIDA' || m.tipo === 'EMPRESTIMO' ? '-' : '+' %><%= m.quantidade %> <%= m.produto_unidade %>
              </span>
            </div>

            <div style="font-size: 0.78rem; color: var(--text-body); margin-bottom: 0.4rem;">
              <%= m.motivo || 'Atendimento no Balcão' %>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.45rem; border-top: 1px solid var(--border-light); font-size: 0.72rem; color: var(--text-dim);">
              <span><%= new Date(m.criado_em).toLocaleDateString('pt-BR') %> às <%= new Date(m.criado_em).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %></span>
              <span>Atendente: <%= m.responsavel || 'Almoxarife' %></span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: 0.85rem;">
          Nenhuma movimentação registrada na ficha deste colaborador.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Termo de Responsabilidade & Cautela A4 (Pronto para Impressão) -->
  <div class="table-card termo-cautela-box" style="padding: 1.5rem; margin-bottom: 2rem;">
    <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px;">
      Termo de Responsabilidade e Cautela de Materiais / EPIs
    </h4>

    <p style="font-size: 0.84rem; color: var(--text-body); line-height: 1.55; margin-bottom: 2rem;">
      Declaro para os devidos fins que recebi do <strong>Almoxarifado Central</strong> os materiais, equipamentos e ferramentas constantes nesta Ficha Individual em perfeitas condições de uso, conservação e funcionamento. Comprometo-me a zelar pela integridade dos itens emprestados, utilizá-los exclusivamente no desempenho de minhas atividades profissionais e devolvê-los imediatamente ao almoxarifado após o término dos serviços ou mediante solicitação.
    </p>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 2rem; padding-top: 1rem;">
      <div style="text-align: center;">
        <div style="border-top: 1.5px solid #000000; width: 85%; margin: 0 auto 0.4rem auto;"></div>
        <div style="font-weight: 800; font-size: 0.88rem; color: var(--text-main);"><%= colaboradorAtual.nome %></div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">Assinatura do Colaborador Solicitante</div>
        <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">Matrícula: <%= colaboradorAtual.matricula || '-' %> • CPF/RG: ___________________</div>
      </div>

      <div style="text-align: center;">
        <div style="border-top: 1.5px solid #000000; width: 85%; margin: 0 auto 0.4rem auto;"></div>
        <div style="font-weight: 800; font-size: 0.88rem; color: var(--text-main);">Gestão de Almoxarifado</div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">Assinatura do Responsável pela Entrega / Cautela</div>
        <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">Data da Emissão: <%= new Date().toLocaleDateString('pt-BR') %></div>
      </div>
    </div>
  </div>

<% } %>

<style>
/* Estilo das abas/pills de filtro da lista */
.btn-filter-ficha {
  background: #ffffff;
  border: 1px solid var(--border-color);
  color: var(--text-body);
  font-weight: 600;
  font-size: 0.8rem;
  padding: 0.45rem 0.85rem;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s ease;
}
.btn-filter-ficha:hover {
  background: var(--bg-surface);
  color: var(--text-main);
}
.btn-filter-ficha.ativo {
  background: var(--primary);
  color: #ffffff !important;
  border-color: var(--primary) !important;
  box-shadow: 0 2px 6px rgba(79, 70, 229, 0.3);
}

/* Hover na linha da tabela */
.colaborador-ficha-row:hover {
  background: #F8FAFC !important;
}

/* Otimização de Impressão */
@media print {
  body {
    background: #ffffff !important;
    font-size: 11pt !important;
    color: #000000 !important;
  }
  .app-sidebar, .app-header, .mobile-bottom-nav, .hide-on-print, .btn, .alert {
    display: none !important;
  }
  .app-main, .main-content {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
  }
  .table-card {
    border: 1px solid #d1d5db !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    page-break-inside: avoid;
  }
  .termo-cautela-box {
    display: block !important;
    page-break-inside: avoid;
  }
  .ficha-header-card {
    border-left: 4px solid #000000 !important;
  }
}
</style>

<script>
// Filtro e Busca em Tempo Real na Lista de Colaboradores
let filtroAtual = 'TODOS';

function aplicarFiltroFicha(tipo, botao) {
  filtroAtual = tipo;
  
  // Atualiza classe ativa dos botões
  document.querySelectorAll('.btn-filter-ficha').forEach(b => b.classList.remove('ativo'));
  if (botao) botao.classList.add('ativo');

  filtrarListaColaboradores();
}

function filtrarListaColaboradores() {
  const inputBusca = document.getElementById('busca-ficha-colaborador');
  const termo = inputBusca ? inputBusca.value.toLowerCase().trim() : '';

  // Filtra linhas da tabela desktop
  const rows = document.querySelectorAll('.colaborador-ficha-row');
  rows.forEach(row => {
    const textoBusca = row.getAttribute('data-busca') || '';
    const temPendencia = row.getAttribute('data-pendencia') === 'true';

    let matchFiltro = true;
    if (filtroAtual === 'PENDENTES') matchFiltro = temPendencia;
    if (filtroAtual === 'REGULARES') matchFiltro = !temPendencia;

    const matchBusca = !termo || textoBusca.includes(termo);

    row.style.display = (matchFiltro && matchBusca) ? '' : 'none';
  });

  // Filtra cards mobile
  const cards = document.querySelectorAll('.colaborador-ficha-card-mobile');
  cards.forEach(card => {
    const textoBusca = card.getAttribute('data-busca') || '';
    const temPendencia = card.getAttribute('data-pendencia') === 'true';

    let matchFiltro = true;
    if (filtroAtual === 'PENDENTES') matchFiltro = temPendencia;
    if (filtroAtual === 'REGULARES') matchFiltro = !temPendencia;

    const matchBusca = !termo || textoBusca.includes(termo);

    card.style.display = (matchFiltro && matchBusca) ? 'flex' : 'none';
  });
}

const inputBuscaColab = document.getElementById('busca-ficha-colaborador');
const dropdownFicha = document.getElementById('busca-ficha-dropdown');
const btnLimparFicha = document.getElementById('btn-limpar-busca-ficha');
const LISTA_COLABORADORES_FICHAS = <%- JSON.stringify(colaboradores || []) %>;
let fichaFocadoIndex = -1;
let fichasFiltradas = [];

function renderizarDropdownFicha(termo = '') {
  const q = termo.trim().toLowerCase();
  if (!dropdownFicha) return;

  if (!q) {
    dropdownFicha.style.display = 'none';
    return;
  }

  fichasFiltradas = LISTA_COLABORADORES_FICHAS.filter(c => {
    const nome = (c.nome || '').toLowerCase();
    const mat = (c.matricula || '').toLowerCase();
    const cargo = (c.cargo || '').toLowerCase();
    const dep = (c.departamento || '').toLowerCase();
    return nome.includes(q) || mat.includes(q) || cargo.includes(q) || dep.includes(q);
  });

  fichaFocadoIndex = -1;

  if (fichasFiltradas.length === 0) {
    dropdownFicha.innerHTML = `
      <div style="padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.82rem;">
        <i class="fa-solid fa-user-slash" style="margin-bottom: 0.35rem; display: block; font-size: 1.2rem; color: var(--border-color);"></i>
        Nenhum colaborador encontrado para "<strong>${termo}</strong>"
      </div>
    `;
    dropdownFicha.style.display = 'block';
    return;
  }

  const html = fichasFiltradas.map((c, idx) => {
    const iniciais = (c.nome || 'C').split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
    const temPendencia = c.temPendencia || (c.ferramentasEmAberto && c.ferramentasEmAberto > 0);
    const qtdPend = c.ferramentasEmAberto || 0;
    const isSistema = c.tipo_perfil === 'SISTEMA';

    return `
      <div class="ficha-busca-item" data-index="${idx}" data-id="${c.id}" onclick="window.location.href='/fichas?colaborador_id=${c.id}'" style="padding: 0.65rem 0.95rem; border-bottom: 1px solid var(--border-light); cursor: pointer; transition: background 0.12s ease; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
        <div style="display: flex; align-items: center; gap: 0.65rem; min-width: 0;">
          <div style="width: 34px; height: 34px; border-radius: 50%; background: ${isSistema ? '#EDE9FE' : '#FEF3C7'}; color: ${isSistema ? '#6D28D9' : '#B45309'}; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.78rem; flex-shrink: 0;">
            ${iniciais}
          </div>
          <div style="min-width: 0;">
            <div style="font-weight: 700; color: var(--text-main); font-size: 0.88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              ${c.nome}
            </div>
            <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;">
              <span style="font-family: var(--font-mono); font-weight: 700; color: var(--text-body); background: var(--bg-surface); padding: 1px 4px; border-radius: 3px; border: 1px solid var(--border-color);">${c.matricula || 'S/ MAT'}</span>
              <span>• ${c.cargo || 'Função não inf.'}</span>
              ${c.departamento ? `<span>(${c.departamento})</span>` : ''}
            </div>
          </div>
        </div>
        
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0;">
          <span class="badge" style="background: ${temPendencia ? '#FEF3C7' : '#D1FAE5'}; color: ${temPendencia ? '#92400E' : '#065F46'}; font-weight: 700; font-size: 0.72rem;">
            ${temPendencia ? `⚠️ ${qtdPend} com ele` : '✅ Regular'}
          </span>
          <span style="color: var(--primary); font-weight: 700; font-size: 0.76rem; display: flex; align-items: center; gap: 4px;">
            Ver Ficha <i class="fa-solid fa-arrow-right"></i>
          </span>
        </div>
      </div>
    `;
  }).join('');

  dropdownFicha.innerHTML = html;
  dropdownFicha.style.display = 'block';
}

function limparBuscaFicha() {
  if (inputBuscaColab) {
    inputBuscaColab.value = '';
    if (btnLimparFicha) btnLimparFicha.style.display = 'none';
    if (dropdownFicha) dropdownFicha.style.display = 'none';
    filtrarListaColaboradores();
    inputBuscaColab.focus();
  }
}

if (inputBuscaColab) {
  inputBuscaColab.addEventListener('input', (e) => {
    const val = e.target.value;
    if (btnLimparFicha) btnLimparFicha.style.display = val ? 'flex' : 'none';
    filtrarListaColaboradores();
    renderizarDropdownFicha(val);
  });

  inputBuscaColab.addEventListener('focus', () => {
    if (inputBuscaColab.value.trim()) {
      renderizarDropdownFicha(inputBuscaColab.value);
    }
  });

  inputBuscaColab.addEventListener('keydown', (e) => {
    if (!dropdownFicha || dropdownFicha.style.display === 'none') return;
    const items = dropdownFicha.querySelectorAll('.ficha-busca-item');

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (items.length === 0) return;
      fichaFocadoIndex = (fichaFocadoIndex + 1) % items.length;
      atualizarFocoFicha(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (items.length === 0) return;
      fichaFocadoIndex = (fichaFocadoIndex - 1 + items.length) % items.length;
      atualizarFocoFicha(items);
    } else if (e.key === 'Enter') {
      if (fichaFocadoIndex >= 0 && items[fichaFocadoIndex]) {
        e.preventDefault();
        const id = items[fichaFocadoIndex].getAttribute('data-id');
        if (id) window.location.href = `/fichas?colaborador_id=${id}`;
      } else if (fichasFiltradas.length > 0) {
        e.preventDefault();
        window.location.href = `/fichas?colaborador_id=${fichasFiltradas[0].id}`;
      }
    } else if (e.key === 'Escape') {
      dropdownFicha.style.display = 'none';
    }
  });
}

function atualizarFocoFicha(items) {
  items.forEach((it, idx) => {
    if (idx === fichaFocadoIndex) {
      it.style.background = '#f1f5f9';
      it.scrollIntoView({ block: 'nearest' });
    } else {
      it.style.background = '#ffffff';
    }
  });
}

// Fecha dropdown de fichas ao clicar fora
document.addEventListener('click', (e) => {
  const wrapper = document.getElementById('busca-ficha-wrapper');
  if (wrapper && !wrapper.contains(e.target)) {
    if (dropdownFicha) dropdownFicha.style.display = 'none';
  }
});
</script>

<%- include('../layouts/footer') %>
