<%- include('../layouts/header') %>

<!-- Mensagens de Alerta (Sucesso ou Erro) -->
<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho da Página -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Inventário</h2>
  </div>

  <div class="page-actions-group">
    <!-- Importar Excel -->
    <button type="button" class="btn btn-outline" onclick="window.abrirModal('modal-importar-excel')" title="Importar ou atualizar produtos via planilha Excel">
      <i class="fa-solid fa-file-import"></i> Importar Excel
    </button>

    <!-- Exportar Excel -->
    <a href="/produtos/exportar/excel?busca=<%= encodeURIComponent(filtros.busca || '') %>&categoria=<%= encodeURIComponent(filtros.categoria || '') %>&status=<%= encodeURIComponent(filtros.status || '') %>" class="btn btn-outline" title="Baixar planilha Excel do Inventário">
      <i class="fa-solid fa-file-excel" style="color: var(--teal);"></i> Exportar Excel
    </a>

    <!-- Imprimir / Salvar PDF -->
    <button type="button" class="btn btn-outline" onclick="window.print()" title="Imprimir ou salvar lista em PDF">
      <i class="fa-solid fa-print"></i> Imprimir / PDF
    </button>

    <!-- Adicionar Produto -->
    <a href="/produtos/novo" class="btn btn-primary" id="btn-add-product">
      <i class="fa-solid fa-plus"></i> Adicionar Produto
    </a>
  </div>
</div>

<!-- Card de Resumo do Inventário (Sem valores monetários) -->
<div class="fixoria-summary-card">
  <!-- Total de Itens Físicos -->
  <div class="summary-asset-box">
    <div class="summary-label">Total de Itens Cadastrados</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--text-main); letter-spacing: -0.02em;">
      <%= estatisticas.total_itens %> <span style="font-size: 1rem; font-weight: 500; color: var(--text-muted);">produtos</span>
    </div>
    <div style="font-size: 0.8rem; color: var(--text-dim); margin-top: 0.2rem;">
      <%= estatisticas.total_unidades %> unidades físicas em estoque
    </div>
  </div>

  <!-- Barra Segmentada de Nível de Estoque -->
  <div class="summary-stock-box">
    <div class="summary-stock-header">
      <div class="summary-stock-count" style="font-size: 1.1rem; font-weight: 700; color: var(--text-main);">
        Situação do Estoque
      </div>
    </div>

    <% 
      const totalSeg = Math.max(1, estatisticas.total_itens);
      const pctIn = Math.round((estatisticas.inStockCount / totalSeg) * 100);
      const pctLow = Math.round((estatisticas.lowStockCount / totalSeg) * 100);
      const pctOut = Math.round((estatisticas.outOfStockCount / totalSeg) * 100);
    %>

    <!-- Barra Multi-Segmento Colorida -->
    <div class="segmented-progress-bar">
      <div class="segment-in" style="width: <%= pctIn %>%;" title="Em Estoque: <%= estatisticas.inStockCount %>"></div>
      <div class="segment-low" style="width: <%= pctLow %>%;" title="Estoque Baixo: <%= estatisticas.lowStockCount %>"></div>
      <div class="segment-out" style="width: <%= pctOut %>%;" title="Sem Estoque: <%= estatisticas.outOfStockCount %>"></div>
    </div>

    <!-- Legenda com Bolinhas Coloridas -->
    <div class="segmented-legend">
      <div class="legend-item">
        <span class="legend-dot in"></span>
        <span>Em estoque: <strong><%= estatisticas.inStockCount %></strong></span>
      </div>
      <div class="legend-item">
        <span class="legend-dot low"></span>
        <span>Estoque baixo: <strong><%= estatisticas.lowStockCount %></strong></span>
      </div>
      <div class="legend-item">
        <span class="legend-dot out"></span>
        <span>Sem estoque: <strong><%= estatisticas.outOfStockCount %></strong></span>
      </div>
    </div>
  </div>
</div>

<!-- Barra de Filtros e Pesquisa Especializada no Inventário -->
<div class="fixoria-filter-bar">
  <form action="/produtos" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; width: 100%;">
    <!-- Campo de Busca Especializado no Inventário -->
    <div class="filter-search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input 
        type="text" 
        name="busca" 
        id="quick-table-search" 
        placeholder="Buscar no inventário (item, SKU, TAG, Patrimônio, C.A ou localização)..." 
        value="<%= filtros.busca || '' %>"
      >
    </div>

    <!-- Pílulas de Seleção -->
    <div class="filter-pills-group">
      <!-- Filtro Categoria -->
      <select name="categoria" class="filter-select-pill" onchange="this.form.submit()">
        <option value="">Todas as Categorias</option>
        <% categorias.forEach(cat => { %>
          <option value="<%= cat %>" <%= filtros.categoria === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>

      <!-- Filtro Status -->
      <select name="status" class="filter-select-pill" onchange="this.form.submit()">
        <option value="">Status do Estoque</option>
        <option value="NORMAL" <%= filtros.status === 'NORMAL' ? 'selected' : '' %>>Em Estoque</option>
        <option value="BAIXO" <%= filtros.status === 'BAIXO' ? 'selected' : '' %>>Estoque Baixo</option>
        <option value="CRITICO" <%= filtros.status === 'CRITICO' ? 'selected' : '' %>>Sem Estoque</option>
      </select>

      <button type="submit" class="btn btn-outline btn-sm">
        <i class="fa-solid fa-sliders"></i> Filtrar
      </button>

      <% if (filtros.busca || filtros.categoria || filtros.status) { %>
        <a href="/produtos" class="btn btn-outline btn-sm" title="Limpar Filtros">
          <i class="fa-solid fa-rotate-left"></i>
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela Clean de Produtos (Desktop & Tablets Largos) -->
<div class="table-card">
  <div class="desktop-only table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>Nome do Produto / Detalhes</th>
          <th>Categoria</th>
          <th>SKU</th>
          <th>Estoque</th>
          <th>Mínimo</th>
          <th>Status</th>
          <th style="text-align: right;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (produtos && produtos.length > 0) { %>
          <% produtos.forEach((p) => { %>
            <tr style="cursor: pointer;" onclick="abrirModalProduto(<%= p.id %>)" title="Clique para ver os detalhes completos de <%= p.nome %>">
              <!-- Nome e Detalhes / Badges -->
              <td>
                <div class="product-name-text" style="font-weight: 600; color: var(--text-main); font-size: 0.92rem;">
                  <%= p.nome %>
                  <% if (p.marca) { %>
                    <span style="font-size: 0.75rem; font-weight: 500; color: var(--primary); margin-left: 0.4rem; background: var(--primary-light); padding: 1px 6px; border-radius: 4px;">
                      <%= p.marca %>
                    </span>
                  <% } %>
                </div>
                <div class="product-sku-text" style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;">
                  <% if (p.localizacao) { %>
                    <span><i class="fa-solid fa-location-dot" style="font-size: 0.7rem; color: var(--text-dim);"></i> <%= p.localizacao %></span>
                  <% } %>
                  <% if (p.tag) { %>
                    <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 6px; border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--primary); font-weight: 600;">TAG: <%= p.tag %></span>
                  <% } %>
                  <% if (p.patrimonio) { %>
                    <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 6px; border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-body); font-weight: 600;">PAT: <%= p.patrimonio %></span>
                  <% } %>
                  <% if (p.ca) { %>
                    <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 6px; border-radius: 4px; font-size: 0.72rem; color: var(--teal); font-weight: 600;">C.A: <%= p.ca %></span>
                  <% } %>
                  <% if (p.tamanho) { %>
                    <span style="font-size: 0.72rem; color: var(--text-dim);">Tam: <%= p.tamanho %></span>
                  <% } %>
                  <% if (p.cor) { %>
                    <span style="font-size: 0.72rem; color: var(--text-dim);">Cor: <%= p.cor %></span>
                  <% } %>
                  <span style="color: var(--primary); font-size: 0.72rem; font-weight: 600; margin-left: 0.2rem;">
                    • Ver detalhes ➔
                  </span>
                </div>
              </td>

              <!-- Categoria -->
              <td>
                <span style="color: var(--text-body); font-weight: 500;"><%= p.categoria %></span>
              </td>

              <!-- SKU -->
              <td>
                <span style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-body); font-weight: 600;">
                  <%= p.sku %>
                </span>
              </td>

              <!-- Saldo Físico -->
              <td>
                <strong style="color: var(--text-main); font-size: 0.95rem;"><%= p.quantidade %></strong>
                <span style="font-size: 0.75rem; color: var(--text-dim);"><%= p.unidade_medida %></span>
              </td>

              <!-- Estoque Mínimo -->
              <td>
                <span style="font-size: 0.85rem; color: var(--text-muted);"><%= p.estoque_minimo %> <%= p.unidade_medida %></span>
              </td>

              <!-- Status Pill -->
              <td>
                <% if (p.status_estoque === 'NORMAL') { %>
                  <span class="status-pill in-stock">
                    <span class="status-dot-sm"></span> Em estoque
                  </span>
                <% } else if (p.status_estoque === 'BAIXO') { %>
                  <span class="status-pill low-stock">
                    <span class="status-dot-sm"></span> Estoque baixo
                  </span>
                <% } else { %>
                  <span class="status-pill out-of-stock">
                    <span class="status-dot-sm"></span> Sem estoque
                  </span>
                <% } %>
              </td>

              <!-- Ações -->
              <td style="text-align: right; white-space: nowrap;" onclick="event.stopPropagation()">
                <div style="display: inline-flex; align-items: center; gap: 0.35rem;">
                  <!-- Baixa no Balcão -->
                  <a href="/balcao?produto_id=<%= p.id %>&tipo=SAIDA" class="action-more-btn" title="Baixa no Balcão">
                    <i class="fa-solid fa-arrow-up" style="color: var(--danger);"></i>
                  </a>
                  <!-- Entrada no Balcão -->
                  <a href="/balcao?produto_id=<%= p.id %>&tipo=ENTRADA" class="action-more-btn" title="Entrada no Balcão">
                    <i class="fa-solid fa-arrow-down" style="color: var(--teal);"></i>
                  </a>
                  <!-- Editar -->
                  <a href="/produtos/<%= p.id %>/editar" class="action-more-btn" title="Editar Produto">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>
                  <!-- Excluir -->
                  <form id="form-delete-prod-<%= p.id %>" action="/produtos/<%= p.id %>/excluir" method="POST" style="display: inline;">
                    <button type="button" class="action-more-btn" title="Excluir Produto" onclick="window.confirmarExclusao('form-delete-prod-<%= p.id %>', '<%= p.nome %>')">
                      <i class="fa-solid fa-trash-can" style="color: var(--danger);"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
              Nenhum produto encontrado com os filtros selecionados.
              <div style="margin-top: 1rem;">
                <a href="/produtos/novo" class="btn btn-primary btn-sm">Adicionar Novo Produto</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Cartões Otimizados para Celular (Mobile Cards View) -->
  <div class="mobile-only" style="flex-direction: column; gap: 0.85rem; padding: 0.85rem;">
    <% if (produtos && produtos.length > 0) { %>
      <% produtos.forEach((p) => { %>
        <div class="inventory-mobile-card" onclick="abrirModalProduto(<%= p.id %>)">
          <!-- Cabeçalho do Card: Nome, Marca e Status -->
          <div class="inventory-mobile-card-header">
            <div style="flex: 1;">
              <div class="inventory-mobile-title">
                <%= p.nome %>
                <% if (p.marca) { %>
                  <span style="font-size: 0.72rem; font-weight: 600; color: var(--primary); background: var(--primary-light); padding: 1px 6px; border-radius: 4px; display: inline-block; margin-top: 2px;">
                    <%= p.marca %>
                  </span>
                <% } %>
              </div>
            </div>
            <div>
              <% if (p.status_estoque === 'NORMAL') { %>
                <span class="status-pill in-stock" style="font-size: 0.72rem; padding: 0.2rem 0.55rem;">
                  <span class="status-dot-sm"></span> Normal
                </span>
              <% } else if (p.status_estoque === 'BAIXO') { %>
                <span class="status-pill low-stock" style="font-size: 0.72rem; padding: 0.2rem 0.55rem;">
                  <span class="status-dot-sm"></span> Baixo
                </span>
              <% } else { %>
                <span class="status-pill out-of-stock" style="font-size: 0.72rem; padding: 0.2rem 0.55rem;">
                  <span class="status-dot-sm"></span> Zerado
                </span>
              <% } %>
            </div>
          </div>

          <!-- Metadados: SKU, Localização, Categoria -->
          <div class="inventory-mobile-meta">
            <span style="font-family: var(--font-mono); font-weight: 700; color: var(--text-main);">
              <i class="fa-solid fa-barcode"></i> <%= p.sku %>
            </span>
            <span><i class="fa-solid fa-folder"></i> <%= p.categoria %></span>
            <% if (p.localizacao) { %>
              <span><i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> <%= p.localizacao %></span>
            <% } %>
            <% if (p.tag) { %>
              <span style="font-family: var(--font-mono); color: var(--primary);">TAG: <%= p.tag %></span>
            <% } %>
          </div>

          <!-- Barra de Saldo Atual -->
          <div class="inventory-mobile-stock-row">
            <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">
              Saldo em Estoque:
            </div>
            <div>
              <span class="inventory-mobile-stock-val" style="color: <%= p.quantidade <= 0 ? 'var(--danger)' : (p.quantidade <= p.estoque_minimo ? '#D97706' : 'var(--teal)') %>;">
                <%= p.quantidade %>
              </span>
              <small style="font-size: 0.75rem; color: var(--text-dim);"><%= p.unidade_medida %></small>
              <span style="font-size: 0.72rem; color: var(--text-muted); margin-left: 0.4rem;">
                (Mín: <%= p.estoque_minimo %>)
              </span>
            </div>
          </div>

          <!-- Botões de Ação Rápidos com Toque Confortável -->
          <div class="inventory-mobile-actions" onclick="event.stopPropagation()">
            <!-- Entrada Rápida no Balcão -->
            <a href="/balcao?produto_id=<%= p.id %>&tipo=ENTRADA" class="btn btn-outline" style="color: var(--teal); border-color: var(--teal); font-weight: 600;" title="Entrada no Balcão">
              <i class="fa-solid fa-plus"></i> Entrada
            </a>
            
            <!-- Baixa Rápida no Balcão -->
            <a href="/balcao?produto_id=<%= p.id %>&tipo=SAIDA" class="btn btn-outline" style="color: var(--danger); border-color: var(--danger); font-weight: 600;" title="Baixa no Balcão">
              <i class="fa-solid fa-minus"></i> Baixa
            </a>

            <!-- Editar -->
            <a href="/produtos/<%= p.id %>/editar" class="action-more-btn" title="Editar">
              <i class="fa-solid fa-pen-to-square"></i>
            </a>

            <!-- Excluir -->
            <form id="form-delete-prod-mob-<%= p.id %>" action="/produtos/<%= p.id %>/excluir" method="POST" style="margin: 0;">
              <button type="button" class="action-more-btn" style="color: var(--danger);" title="Excluir" onclick="window.confirmarExclusao('form-delete-prod-mob-<%= p.id %>', '<%= p.nome %>')">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
        <i class="fa-solid fa-boxes-stacked" style="font-size: 2rem; color: var(--border-color); margin-bottom: 0.5rem; display: block;"></i>
        Nenhum produto encontrado com os filtros selecionados.
        <div style="margin-top: 0.75rem;">
          <a href="/produtos/novo" class="btn btn-primary btn-sm">Adicionar Novo Produto</a>
        </div>
      </div>
    <% } %>
  </div>
      </tbody>
    </table>
  </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL DE IMPORTAÇÃO DE PLANILHA EXCEL -->
<!-- ========================================================================= -->
<div class="modal-overlay" id="modal-importar-excel">
  <div class="modal-container" style="max-width: 620px; width: 95%;">
    <div class="modal-header">
      <h3 style="font-size: 1.1rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-file-excel" style="color: var(--teal);"></i> Importar Produtos via Excel
      </h3>
      <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-importar-excel')">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    
    <form action="/produtos/importar/excel" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem;">
          <h4 style="font-size: 0.9rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.4rem;">
            <i class="fa-solid fa-circle-question" style="color: var(--primary);"></i> Como funciona a importação:
          </h4>
          <ul style="font-size: 0.8rem; color: var(--text-body); margin: 0; padding-left: 1.25rem; line-height: 1.5;">
            <li><strong>Produtos Existentes:</strong> Se o código <code>SKU</code> da planilha já existir no sistema, os dados e a quantidade do item serão <strong>atualizados</strong>.</li>
            <li><strong>Novos Produtos:</strong> Linhas com novos SKUs (ou sem SKU) serão <strong>cadastradas automaticamente</strong>.</li>
            <li>Você pode clicar em <strong>"Exportar Excel"</strong> para baixar o inventário atual e usá-lo como planilha modelo!</li>
          </ul>
        </div>

        <div class="form-group">
          <label class="form-label" for="input-arquivo-excel">
            Selecione o arquivo da planilha (.xlsx, .xls ou .csv) <span class="required">*</span>
          </label>
          <input 
            type="file" 
            id="input-arquivo-excel" 
            name="planilha" 
            class="form-control" 
            accept=".xlsx, .xls, .csv" 
            required
            style="padding: 0.6rem;"
          >
          <span class="form-help">Formatos aceitos: Microsoft Excel (.xlsx, .xls) ou Valores Separados por Vírgula (.csv).</span>
        </div>

      </div>

      <div class="modal-footer" style="background: var(--bg-surface);">
        <a href="/produtos/modelo/excel" class="btn btn-outline btn-sm" style="margin-right: auto;" title="Baixar planilha modelo formatada para preenchimento">
          <i class="fa-solid fa-download"></i> Baixar Planilha Modelo
        </a>
        <button type="button" class="btn btn-outline" onclick="window.fecharModal('modal-importar-excel')">
          Cancelar
        </button>
        <button type="submit" class="btn btn-primary" id="btn-confirmar-importacao">
          <i class="fa-solid fa-upload"></i> Processar e Importar
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL DE DETALHES E EDIÇÃO RÁPIDA DO PRODUTO -->
<!-- ========================================================================= -->
<div class="modal-overlay" id="modal-detalhes-produto">
  <div class="modal-container" style="max-width: 780px; width: 95%; max-height: 92vh; display: flex; flex-direction: column;">
    
    <!-- Cabeçalho do Modal -->
    <div class="modal-header">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style="width: 38px; height: 38px; border-radius: 8px; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.1rem;">
          <i class="fa-solid fa-box"></i>
        </div>
        <div>
          <h3 id="modal-view-title" style="font-size: 1.1rem; font-weight: 700; color: var(--text-main); margin: 0;">Ficha do Item</h3>
          <span id="modal-view-subtitle" style="font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono);"></span>
        </div>
      </div>
      <button type="button" class="btn btn-secondary btn-icon" onclick="fecharModalProduto()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Corpo do Modal (com rolagem suave) -->
    <div class="modal-body" style="overflow-y: auto; padding: 1.5rem; flex: 1;">
      
      <!-- MODO VISUALIZAÇÃO -->
      <div id="secao-modo-visualizacao">
        
        <!-- Status & Destaques de Estoque -->
        <div style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; background: var(--bg-surface); padding: 1rem 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); margin-bottom: 1.5rem;">
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700;">Situação Atual</span>
            <div id="view-status-badge" style="margin-top: 0.25rem;"></div>
          </div>
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700;">Estoque Físico</span>
            <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main);">
              <span id="view-quantidade">0</span> <small id="view-unidade" style="font-size: 0.85rem; font-weight: 500; color: var(--text-muted);"></small>
            </div>
          </div>
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-dim); font-weight: 700;">Estoque Mínimo</span>
            <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-body);">
              <span id="view-estoque-minimo">0</span> <small id="view-unidade-min" style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted);"></small>
            </div>
          </div>
        </div>

        <!-- Grade de Detalhes -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
          
          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Marca / Fabricante</div>
            <div id="view-marca" style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Categoria</div>
            <div id="view-categoria" style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Status Estoque / Condição</div>
            <div id="view-condicao" style="font-size: 0.95rem; font-weight: 700; color: #4338CA; margin-top: 2px;">NOVO</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Localização no Almoxarifado</div>
            <div id="view-localizacao" style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">TAG / Plaqueta</div>
            <div id="view-tag" style="font-size: 0.95rem; font-family: var(--font-mono); font-weight: 600; color: var(--primary); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Nº de Patrimônio</div>
            <div id="view-patrimonio" style="font-size: 0.95rem; font-family: var(--font-mono); font-weight: 600; color: var(--text-main); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">C.A (Certificado de EPI)</div>
            <div id="view-ca" style="font-size: 0.95rem; font-weight: 600; color: var(--teal); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Número de Série</div>
            <div id="view-serie" style="font-size: 0.95rem; font-family: var(--font-mono); color: var(--text-body); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Tamanho / Dimensão</div>
            <div id="view-tamanho" style="font-size: 0.95rem; font-weight: 500; color: var(--text-body); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Cor</div>
            <div id="view-cor" style="font-size: 0.95rem; font-weight: 500; color: var(--text-body); margin-top: 2px;">-</div>
          </div>

          <div style="background: #fff; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md);">
            <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase;">Peso</div>
            <div id="view-peso" style="font-size: 0.95rem; font-weight: 500; color: var(--text-body); margin-top: 2px;">-</div>
          </div>

        </div>

        <!-- Bloco de Observações no Modal de Visualização -->
        <div id="view-observacao-box" style="background: #F8FAFC; border: 1px solid var(--border-light); padding: 0.85rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.25rem; display: none;">
          <div style="font-size: 0.72rem; color: var(--text-dim); font-weight: 700; text-transform: uppercase; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.35rem;">
            <i class="fa-solid fa-clipboard-list" style="color: var(--teal);"></i> Observações do Item
          </div>
          <div id="view-observacao" style="font-size: 0.88rem; color: var(--text-body); line-height: 1.5; white-space: pre-wrap;"></div>
        </div>

        <div style="font-size: 0.75rem; color: var(--text-dim); border-top: 1px solid var(--border-light); padding-top: 0.75rem; display: flex; justify-content: space-between;">
          <span>Cadastrado em: <strong id="view-criado-em">-</strong></span>
          <span>Última atualização: <strong id="view-atualizado-em">-</strong></span>
        </div>

      </div>

      <!-- MODO EDIÇÃO RÁPIDA DENTRO DO MODAL -->
      <div id="secao-modo-edicao" style="display: none;">
        <form id="form-modal-editar" method="POST">
          <div class="form-grid">
            
            <div class="form-group">
              <label class="form-label" for="modal-edit-sku">Código SKU</label>
              <input type="text" id="modal-edit-sku" name="sku" class="form-control" style="text-transform: uppercase;">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-categoria">Categoria</label>
              <select id="modal-edit-categoria" name="categoria" class="form-select">
                <% categorias.forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-marca">Marca / Fabricante</label>
              <input type="text" id="modal-edit-marca" name="marca" class="form-control" placeholder="Ex: 3M, Tramontina">
            </div>

            <div class="form-group full-width">
              <label class="form-label" for="modal-edit-nome">Nome do Produto / Descrição</label>
              <input type="text" id="modal-edit-nome" name="nome" class="form-control">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-quantidade">Quantidade em Estoque</label>
              <input type="number" id="modal-edit-quantidade" name="quantidade" class="form-control" min="0">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-unidade">Unidade de Medida</label>
              <select id="modal-edit-unidade" name="unidade_medida" class="form-select">
                <option value="UN">UN - Unidade</option>
                <option value="CX">CX - Caixa</option>
                <option value="PAR">PAR - Par</option>
                <option value="KG">KG - Quilograma</option>
                <option value="L">L - Litro</option>
                <option value="M">M - Metro</option>
                <option value="JG">JG - Jogo</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-minimo">Estoque Mínimo</label>
              <input type="number" id="modal-edit-minimo" name="estoque_minimo" class="form-control" min="0">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-localizacao">Localização</label>
              <input type="text" id="modal-edit-localizacao" name="localizacao" class="form-control">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-condicao">Status Estoque / Condição</label>
              <select id="modal-edit-condicao" name="condicao" class="form-select">
                <option value="NOVO">NOVO (Item Novo / Lacrado)</option>
                <option value="REUSO">REUSO (Item de Reúso / Seminovo)</option>
                <option value="BOM">BOM (Bom Estado de Conservação)</option>
                <option value="MANUTENÇÃO">MANUTENÇÃO (Em Revisão / Manutenção)</option>
                <option value="SUCATA">SUCATA (Inservível / Descarte)</option>
                <option value="OUTROS">OUTROS (Diversos)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-tag">TAG / Plaqueta</label>
              <input type="text" id="modal-edit-tag" name="tag" class="form-control" style="text-transform: uppercase;">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-patrimonio">Nº de Patrimônio</label>
              <input type="text" id="modal-edit-patrimonio" name="patrimonio" class="form-control" style="text-transform: uppercase;">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-ca">C.A (EPI)</label>
              <input type="text" id="modal-edit-ca" name="ca" class="form-control">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-serie">Número de Série</label>
              <input type="text" id="modal-edit-serie" name="numero_serie" class="form-control">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-tamanho">Tamanho / Dimensão</label>
              <input type="text" id="modal-edit-tamanho" name="tamanho" class="form-control">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-cor">Cor</label>
              <input type="text" id="modal-edit-cor" name="cor" class="form-control">
            </div>

            <div class="form-group">
              <label class="form-label" for="modal-edit-peso">Peso</label>
              <input type="text" id="modal-edit-peso" name="peso" class="form-control">
            </div>

            <div class="form-group" style="grid-column: 1 / -1;">
              <label class="form-label" for="modal-edit-observacao">Observações do Produto</label>
              <textarea id="modal-edit-observacao" name="observacao" class="form-control" rows="2" style="resize: vertical;"></textarea>
            </div>

          </div>
        </form>
      </div>

    </div>

    <!-- Rodapé do Modal -->
    <div class="modal-footer" style="background: var(--bg-surface); display: flex; align-items: center; justify-content: space-between;">
      
      <!-- Lado Esquerdo: Ações Rápidas no Balcão (Modo Visualização) -->
      <div id="modal-footer-acoes-mov" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <a id="modal-link-baixa" href="#" class="btn btn-outline btn-sm" style="color: var(--danger); border-color: var(--danger);" title="Lançar Baixa / Consumo no Balcão">
          <i class="fa-solid fa-arrow-up"></i> Baixa (Balcão)
        </a>
        <a id="modal-link-entrada" href="#" class="btn btn-outline btn-sm" style="color: var(--teal); border-color: var(--teal);" title="Lançar Entrada / Reposição no Balcão">
          <i class="fa-solid fa-arrow-down"></i> Entrada (Balcão)
        </a>
        <a id="modal-link-emprestimo" href="#" class="btn btn-outline btn-sm" style="color: #D97706; border-color: #FCD34D; background: #FFFBEB;" title="Lançar Empréstimo de Ferramenta no Balcão">
          <i class="fa-solid fa-hand-holding-hand"></i> Empréstimo
        </a>
      </div>

      <!-- Lado Direito: Botões de Alternância e Fechamento -->
      <div style="display: flex; gap: 0.5rem; margin-left: auto;">
        
        <!-- Botões do Modo Visualização -->
        <button type="button" class="btn btn-outline" id="btn-modal-fechar" onclick="fecharModalProduto()">
          Fechar
        </button>
        <button type="button" class="btn btn-primary" id="btn-ativar-edicao" onclick="ativarModoEdicaoModal()">
          <i class="fa-solid fa-pen-to-square"></i> Editar Produto
        </button>

        <!-- Botões do Modo Edição (Inicialmente Ocultos) -->
        <button type="button" class="btn btn-outline" id="btn-cancelar-edicao" style="display: none;" onclick="cancelarEdicaoModal()">
          Cancelar
        </button>
        <button type="submit" form="form-modal-editar" class="btn btn-primary" id="btn-salvar-edicao" style="display: none;">
          <i class="fa-solid fa-check"></i> Salvar Alterações
        </button>

      </div>

    </div>

  </div>
</div>

<!-- ========================================================================= -->
<!-- JAVASCRIPT DO MODAL INTERATIVO -->
<!-- ========================================================================= -->
<script>
  // Dicionário dos produtos carregados na página
  const PRODUTOS_MAP = <%- JSON.stringify(produtos.reduce((acc, p) => { acc[p.id] = p; return acc; }, {})) %>;
  let produtoAtualModal = null;

  function abrirModalProduto(id) {
    const p = PRODUTOS_MAP[id];
    if (!p) return;

    produtoAtualModal = p;

    // Preenche cabeçalho
    document.getElementById('modal-view-title').textContent = p.nome || 'Produto sem nome';
    document.getElementById('modal-view-subtitle').textContent = `SKU: ${p.sku} ${p.marca ? '• Marca: ' + p.marca : ''}`;

    // Preenche Situação
    const statusDiv = document.getElementById('view-status-badge');
    if (p.status_estoque === 'NORMAL') {
      statusDiv.innerHTML = '<span class="status-pill in-stock"><span class="status-dot-sm"></span> Em estoque</span>';
    } else if (p.status_estoque === 'BAIXO') {
      statusDiv.innerHTML = '<span class="status-pill low-stock"><span class="status-dot-sm"></span> Estoque baixo</span>';
    } else {
      statusDiv.innerHTML = '<span class="status-pill out-of-stock"><span class="status-dot-sm"></span> Sem estoque</span>';
    }

    document.getElementById('view-quantidade').textContent = p.quantidade;
    document.getElementById('view-unidade').textContent = p.unidade_medida || 'UN';
    document.getElementById('view-estoque-minimo').textContent = p.estoque_minimo;
    document.getElementById('view-unidade-min').textContent = p.unidade_medida || 'UN';

    // Preenche detalhes
    document.getElementById('view-marca').textContent = p.marca || 'Não informada';
    document.getElementById('view-categoria').textContent = p.categoria || 'Geral';
    if (document.getElementById('view-condicao')) {
      document.getElementById('view-condicao').textContent = p.condicao || 'NOVO';
    }
    document.getElementById('view-localizacao').textContent = p.localizacao || 'Almoxarifado Principal';
    document.getElementById('view-tag').textContent = p.tag || '-';
    document.getElementById('view-patrimonio').textContent = p.patrimonio || '-';
    document.getElementById('view-ca').textContent = p.ca ? `CA ${p.ca}` : '-';
    document.getElementById('view-serie').textContent = p.numero_serie || '-';
    document.getElementById('view-tamanho').textContent = p.tamanho || '-';
    document.getElementById('view-cor').textContent = p.cor || '-';
    document.getElementById('view-peso').textContent = p.peso || '-';
    document.getElementById('view-criado-em').textContent = p.criado_em || '-';
    document.getElementById('view-atualizado-em').textContent = p.atualizado_em || '-';

    // Observações
    const boxObs = document.getElementById('view-observacao-box');
    const textObs = document.getElementById('view-observacao');
    if (p.observacao && p.observacao.trim()) {
      textObs.textContent = p.observacao;
      boxObs.style.display = 'block';
    } else {
      boxObs.style.display = 'none';
    }

    // Links de movimentação rápida via Balcão com proteção para itens zerados
    const linkBaixa = document.getElementById('modal-link-baixa');
    const isZerado = Number(p.quantidade) <= 0;
    if (isZerado) {
      linkBaixa.href = `/balcao?produto_id=${p.id}&tipo=ENTRADA`;
      linkBaixa.title = 'Item com estoque zerado (0 UN) - Clique para repor estoque';
      linkBaixa.style.opacity = '0.65';
      linkBaixa.innerHTML = '<i class="fa-solid fa-ban"></i> Baixa (Zerado)';
    } else {
      linkBaixa.href = `/balcao?produto_id=${p.id}&tipo=SAIDA`;
      linkBaixa.title = 'Lançar Baixa / Consumo no Balcão';
      linkBaixa.style.opacity = '1';
      linkBaixa.innerHTML = '<i class="fa-solid fa-arrow-up"></i> Baixa (Balcão)';
    }

    document.getElementById('modal-link-entrada').href = `/balcao?produto_id=${p.id}&tipo=ENTRADA`;
    if (document.getElementById('modal-link-emprestimo')) {
      const linkEmp = document.getElementById('modal-link-emprestimo');
      if (isZerado) {
        linkEmp.href = `/balcao?produto_id=${p.id}&tipo=ENTRADA`;
        linkEmp.title = 'Item com estoque zerado (0 UN) - Não disponível para empréstimo';
        linkEmp.style.opacity = '0.65';
        linkEmp.innerHTML = '<i class="fa-solid fa-ban"></i> Empréstimo (Zerado)';
      } else {
        linkEmp.href = `/balcao?produto_id=${p.id}&tipo=EMPRESTIMO`;
        linkEmp.title = 'Lançar Empréstimo no Balcão';
        linkEmp.style.opacity = '1';
        linkEmp.innerHTML = '<i class="fa-solid fa-hand-holding-hand"></i> Emprestar (Balcão)';
      }
    }

    // Reseta para o modo de visualização
    cancelarEdicaoModal();

    // Abre o modal
    window.abrirModal('modal-detalhes-produto');
  }

  function fecharModalProduto() {
    window.fecharModal('modal-detalhes-produto');
  }

  function ativarModoEdicaoModal() {
    if (!produtoAtualModal) return;
    const p = produtoAtualModal;

    // Configura action do form
    const form = document.getElementById('form-modal-editar');
    form.action = `/produtos/${p.id}/editar`;

    // Popula campos de edição
    document.getElementById('modal-edit-sku').value = p.sku || '';
    document.getElementById('modal-edit-categoria').value = p.categoria || 'Outros';
    document.getElementById('modal-edit-marca').value = p.marca || '';
    document.getElementById('modal-edit-nome').value = p.nome || '';
    document.getElementById('modal-edit-quantidade').value = p.quantidade !== undefined ? p.quantidade : 0;
    document.getElementById('modal-edit-unidade').value = p.unidade_medida || 'UN';
    document.getElementById('modal-edit-minimo').value = p.estoque_minimo !== undefined ? p.estoque_minimo : 0;
    document.getElementById('modal-edit-localizacao').value = p.localizacao || '';
    if (document.getElementById('modal-edit-condicao')) {
      document.getElementById('modal-edit-condicao').value = p.condicao || 'NOVO';
    }
    document.getElementById('modal-edit-tag').value = p.tag || '';
    document.getElementById('modal-edit-patrimonio').value = p.patrimonio || '';
    document.getElementById('modal-edit-ca').value = p.ca || '';
    document.getElementById('modal-edit-serie').value = p.numero_serie || '';
    document.getElementById('modal-edit-tamanho').value = p.tamanho || '';
    document.getElementById('modal-edit-cor').value = p.cor || '';
    document.getElementById('modal-edit-peso').value = p.peso || '';
    document.getElementById('modal-edit-observacao').value = p.observacao || '';

    // Alterna visualizações
    document.getElementById('secao-modo-visualizacao').style.display = 'none';
    document.getElementById('secao-modo-edicao').style.display = 'block';

    // Alterna botões do rodapé
    document.getElementById('modal-footer-acoes-mov').style.display = 'none';
    document.getElementById('btn-modal-fechar').style.display = 'none';
    document.getElementById('btn-ativar-edicao').style.display = 'none';
    document.getElementById('btn-cancelar-edicao').style.display = 'inline-block';
    document.getElementById('btn-salvar-edicao').style.display = 'inline-block';
  }

  function cancelarEdicaoModal() {
    document.getElementById('secao-modo-visualizacao').style.display = 'block';
    document.getElementById('secao-modo-edicao').style.display = 'none';

    document.getElementById('modal-footer-acoes-mov').style.display = 'flex';
    document.getElementById('btn-modal-fechar').style.display = 'inline-block';
    document.getElementById('btn-ativar-edicao').style.display = 'inline-block';
    document.getElementById('btn-cancelar-edicao').style.display = 'none';
    document.getElementById('btn-salvar-edicao').style.display = 'none';
  }
</script>

<%- include('../layouts/footer') %>
