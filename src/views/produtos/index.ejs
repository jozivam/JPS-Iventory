<%- include('../layouts/header') %>

<!-- Mensagens de Alerta (Sucesso ou Erro) -->
<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho da Página -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Inventário</h2>
  </div>

  <div class="page-actions-group">
    <button type="button" class="btn btn-outline" onclick="window.print()" title="Imprimir / Exportar lista">
      <i class="fa-solid fa-print"></i> Imprimir
    </button>
    <a href="/produtos/novo" class="btn btn-primary" id="btn-add-product">
      <i class="fa-solid fa-plus"></i> Adicionar Produto
    </a>
  </div>
</div>

<!-- Card de Resumo do Inventário -->
<div class="fixoria-summary-card">
  <!-- Valor Patrimonial Total -->
  <div class="summary-asset-box">
    <div class="summary-label">Valor Total do Inventário</div>
    <div class="summary-asset-value"><%= formatMoney(estatisticas.valor_patrimonial) %></div>
  </div>

  <!-- Barra Segmentada Multi-Status com Legenda -->
  <div class="summary-stock-box">
    <div class="summary-stock-header">
      <div class="summary-stock-count"><%= estatisticas.total_itens %></div>
      <div class="summary-stock-sub">Produtos Cadastrados</div>
    </div>

    <% 
      const totalSeg = Math.max(1, estatisticas.total_itens);
      const pctIn = Math.round((estatisticas.inStockCount / totalSeg) * 100);
      const pctLow = Math.round((estatisticas.lowStockCount / totalSeg) * 100);
      const pctOut = Math.round((estatisticas.outOfStockCount / totalSeg) * 100);
    %>

    <!-- Barra Multi-Segmento Colorida -->
    <div class="segmented-progress-bar">
      <div class="segment-in" style="width: <%= pctIn %>%;" title="Em Estoque: <%= estatisticas.inStockCount %>"></div>
      <div class="segment-low" style="width: <%= pctLow %>%;" title="Estoque Baixo: <%= estatisticas.lowStockCount %>"></div>
      <div class="segment-out" style="width: <%= pctOut %>%;" title="Sem Estoque: <%= estatisticas.outOfStockCount %>"></div>
    </div>

    <!-- Legenda com Bolinhas Coloridas -->
    <div class="segmented-legend">
      <div class="legend-item">
        <span class="legend-dot in"></span>
        <span>Em estoque: <strong><%= estatisticas.inStockCount %></strong></span>
      </div>
      <div class="legend-item">
        <span class="legend-dot low"></span>
        <span>Estoque baixo: <strong><%= estatisticas.lowStockCount %></strong></span>
      </div>
      <div class="legend-item">
        <span class="legend-dot out"></span>
        <span>Sem estoque: <strong><%= estatisticas.outOfStockCount %></strong></span>
      </div>
    </div>
  </div>
</div>

<!-- Barra de Filtros e Pesquisa -->
<div class="fixoria-filter-bar">
  <form action="/produtos" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; width: 100%;">
    <!-- Campo de Busca -->
    <div class="filter-search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input 
        type="text" 
        name="busca" 
        id="quick-table-search" 
        placeholder="Buscar material, SKU, TAG, Patrimônio, C.A ou localização..." 
        value="<%= filtros.busca || '' %>"
      >
    </div>

    <!-- Pílulas de Seleção -->
    <div class="filter-pills-group">
      <!-- Filtro Categoria -->
      <select name="categoria" class="filter-select-pill" onchange="this.form.submit()">
        <option value="">Todas as Categorias</option>
        <% categorias.forEach(cat => { %>
          <option value="<%= cat %>" <%= filtros.categoria === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>

      <!-- Filtro Status -->
      <select name="status" class="filter-select-pill" onchange="this.form.submit()">
        <option value="">Status do Estoque</option>
        <option value="NORMAL" <%= filtros.status === 'NORMAL' ? 'selected' : '' %>>Em Estoque</option>
        <option value="BAIXO" <%= filtros.status === 'BAIXO' ? 'selected' : '' %>>Estoque Baixo</option>
        <option value="CRITICO" <%= filtros.status === 'CRITICO' ? 'selected' : '' %>>Sem Estoque</option>
      </select>

      <button type="submit" class="btn btn-outline btn-sm">
        <i class="fa-solid fa-sliders"></i> Filtrar
      </button>

      <% if (filtros.busca || filtros.categoria || filtros.status) { %>
        <a href="/produtos" class="btn btn-outline btn-sm" title="Limpar Filtros">
          <i class="fa-solid fa-rotate-left"></i>
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Tabela Clean de Produtos -->
<div class="table-card">
  <div class="table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>Nome do Produto / Detalhes</th>
          <th>Categoria</th>
          <th>SKU</th>
          <th>Estoque</th>
          <th>Mínimo</th>
          <th>Status</th>
          <th>Preço Unitário</th>
          <th style="text-align: right;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (produtos && produtos.length > 0) { %>
          <% produtos.forEach((p) => { %>
            <tr>
              <!-- Nome e Detalhes / Badges -->
              <td>
                <div class="product-name-text" style="font-weight: 600; color: var(--text-main); font-size: 0.92rem;"><%= p.nome %></div>
                <div class="product-sku-text" style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;">
                  <% if (p.localizacao) { %>
                    <span><i class="fa-solid fa-location-dot" style="font-size: 0.7rem; color: var(--text-dim);"></i> <%= p.localizacao %></span>
                  <% } %>
                  <% if (p.tag) { %>
                    <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 6px; border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--primary); font-weight: 600;">TAG: <%= p.tag %></span>
                  <% } %>
                  <% if (p.patrimonio) { %>
                    <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 6px; border-radius: 4px; font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-body); font-weight: 600;">PAT: <%= p.patrimonio %></span>
                  <% } %>
                  <% if (p.ca) { %>
                    <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 6px; border-radius: 4px; font-size: 0.72rem; color: var(--teal); font-weight: 600;">C.A: <%= p.ca %></span>
                  <% } %>
                  <% if (p.tamanho) { %>
                    <span style="font-size: 0.72rem; color: var(--text-dim);">Tam: <%= p.tamanho %></span>
                  <% } %>
                  <% if (p.cor) { %>
                    <span style="font-size: 0.72rem; color: var(--text-dim);">Cor: <%= p.cor %></span>
                  <% } %>
                </div>
              </td>

              <!-- Categoria -->
              <td>
                <span style="color: var(--text-body); font-weight: 500;"><%= p.categoria %></span>
              </td>

              <!-- SKU -->
              <td>
                <span style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-body); font-weight: 600;">
                  <%= p.sku %>
                </span>
              </td>

              <!-- Saldo Físico -->
              <td>
                <strong style="color: var(--text-main); font-size: 0.95rem;"><%= p.quantidade %></strong>
                <span style="font-size: 0.75rem; color: var(--text-dim);"><%= p.unidade_medida %></span>
              </td>

              <!-- Estoque Mínimo -->
              <td>
                <span style="font-size: 0.85rem; color: var(--text-muted);"><%= p.estoque_minimo %> <%= p.unidade_medida %></span>
              </td>

              <!-- Status Pill -->
              <td>
                <% if (p.status_estoque === 'NORMAL') { %>
                  <span class="status-pill in-stock">
                    <span class="status-dot-sm"></span> Em estoque
                  </span>
                <% } else if (p.status_estoque === 'BAIXO') { %>
                  <span class="status-pill low-stock">
                    <span class="status-dot-sm"></span> Estoque baixo
                  </span>
                <% } else { %>
                  <span class="status-pill out-of-stock">
                    <span class="status-dot-sm"></span> Sem estoque
                  </span>
                <% } %>
              </td>

              <!-- Preço -->
              <td>
                <strong style="font-weight: 600; color: var(--text-main);"><%= formatMoney(p.preco_unitario) %></strong>
              </td>

              <!-- Ações -->
              <td style="text-align: right; white-space: nowrap;">
                <div style="display: inline-flex; align-items: center; gap: 0.35rem;">
                  <!-- Dar Baixa (Saída) -->
                  <a href="/movimentacoes/nova?produto_id=<%= p.id %>&tipo=SAIDA" class="action-more-btn" title="Dar Baixa (Saída)">
                    <i class="fa-solid fa-arrow-down" style="color: var(--danger);"></i>
                  </a>
                  <!-- Entrada de Mercadoria -->
                  <a href="/movimentacoes/nova?produto_id=<%= p.id %>&tipo=ENTRADA" class="action-more-btn" title="Nova Entrada">
                    <i class="fa-solid fa-arrow-up" style="color: var(--teal);"></i>
                  </a>
                  <!-- Editar -->
                  <a href="/produtos/<%= p.id %>/editar" class="action-more-btn" title="Editar Produto">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>
                  <!-- Excluir -->
                  <form id="form-delete-prod-<%= p.id %>" action="/produtos/<%= p.id %>/excluir" method="POST" style="display: inline;">
                    <button type="button" class="action-more-btn" title="Excluir Produto" onclick="window.confirmarExclusao('form-delete-prod-<%= p.id %>', '<%= p.nome %>')">
                      <i class="fa-solid fa-trash-can" style="color: var(--danger);"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 3rem; color: var(--text-muted);">
              Nenhum produto encontrado com os filtros selecionados.
              <div style="margin-top: 1rem;">
                <a href="/produtos/novo" class="btn btn-primary btn-sm">Adicionar Novo Produto</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>
