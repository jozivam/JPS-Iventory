<%- include('../layouts/header') %>

<div style="max-width: 900px; margin: 0 auto; padding-bottom: 2rem;">
  <% if (typeof erro !== 'undefined' && erro) { %>
    <div class="alert alert-danger">
      <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
      <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% } %>

  <div class="page-header-flex">
    <div class="page-title-wrap">
      <h2>Novo Produto</h2>
      <p>Cadastre um item no inventário com informações essenciais ou detalhadas. Nenhum campo é obrigatório.</p>
    </div>
    <a href="/produtos" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-arrow-left"></i> Voltar ao Inventário
    </a>
  </div>

  <div class="table-card" style="padding: 1.75rem;">
    <form action="/produtos" method="POST" id="form-produto">
      
      <!-- SEÇÃO 1: INFORMAÇÕES BÁSICAS -->
      <div style="margin-bottom: 1.75rem;">
        <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i class="fa-solid fa-box-open" style="color: var(--primary);"></i> Dados Principais
        </h3>

        <div class="form-grid">
          <!-- SKU -->
          <div class="form-group">
            <label class="form-label" for="produto-sku-input">
              Código SKU
            </label>
            <div style="display: flex; gap: 0.5rem;">
              <input 
                type="text" 
                id="produto-sku-input" 
                name="sku" 
                class="form-control" 
                placeholder="Ex: FER-1001" 
                value="<%= produto.sku || '' %>" 
                style="text-transform: uppercase;"
              >
              <button type="button" class="btn btn-outline btn-sm" id="btn-gerar-sku" title="Gerar código aleatório">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Gerar
              </button>
            </div>
            <span class="form-help">Código identificador único.</span>
          </div>

          <!-- Categoria -->
          <div class="form-group">
            <label class="form-label" for="produto-categoria-select">
              Categoria
            </label>
            <select id="produto-categoria-select" name="categoria" class="form-select">
              <% categorias.forEach(cat => { %>
                <option value="<%= cat %>" <%= (produto.categoria === cat || (!produto.categoria && cat === 'Outros')) ? 'selected' : '' %>>
                  <%= cat %>
                </option>
              <% }) %>
            </select>
            <div id="campo-outra-categoria" style="display: none; margin-top: 0.5rem;">
              <input 
                type="text" 
                id="categoria-personalizada" 
                name="categoria_personalizada" 
                class="form-control" 
                placeholder="Especifique a categoria (Opcional)..."
              >
            </div>
          </div>

          <!-- Marca -->
          <div class="form-group">
            <label class="form-label" for="produto-marca-input">
              Marca / Fabricante
            </label>
            <input 
              type="text" 
              id="produto-marca-input" 
              name="marca" 
              class="form-control" 
              placeholder="Ex: 3M, Tramontina, Bosch, Gedore" 
              value="<%= produto.marca || '' %>"
            >
          </div>

          <!-- Nome / Descrição com Autocomplete e Detecção Inteligente de Duplicidade -->
          <div class="form-group full-width" style="position: relative;">
            <label class="form-label" for="produto-nome-input">
              Nome do Produto / Descrição
            </label>
            <div style="position: relative;">
              <input 
                type="text" 
                id="produto-nome-input" 
                name="nome" 
                class="form-control" 
                placeholder="Ex: Alicate Universal 8 Polegadas Isolado" 
                value="<%= produto.nome || '' %>"
                autocomplete="off"
              >
              <div id="loading-sugestoes" style="display: none; position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.85rem;">
                <i class="fa-solid fa-spinner fa-spin"></i>
              </div>
            </div>

            <!-- Caixa de Alerta de Nome Idêntico (Bloqueio Automático) -->
            <div id="alerta-nome-identico" style="display: none; margin-top: 0.75rem; padding: 1rem; border-radius: 8px; background: #FEF2F2; border: 1.5px solid #F87171;">
              <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                <div style="color: #DC2626; font-size: 1.3rem; margin-top: 2px;">
                  <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div style="flex: 1;">
                  <div style="font-weight: 700; color: #991B1B; font-size: 0.95rem; margin-bottom: 0.25rem;">
                    Produto já cadastrado com este mesmo nome!
                  </div>
                  <p style="color: #7F1D1D; font-size: 0.85rem; margin: 0 0 0.75rem 0;" id="texto-alerta-identico">
                    Já existe um item com esse nome exato. Para evitar duplicidades, o cadastro direto está bloqueado.
                  </p>
                  <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center;">
                    <a id="link-editar-identico" href="#" class="btn btn-sm" style="background: #DC2626; color: #fff; text-decoration: none; font-weight: 600;">
                      <i class="fa-solid fa-pen-to-square"></i> Editar Produto Cadastrado
                    </a>
                    <span style="font-size: 0.8rem; color: #991B1B;">
                      <i class="fa-solid fa-circle-info"></i> Ou altere o nome no campo acima para cadastrar um produto diferente.
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Dropdown Flutuante de Itens Parecidos / Autocomplete -->
            <div id="dropdown-sugestoes" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #ffffff; border: 1px solid var(--border-light); border-radius: 8px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.12), 0 8px 10px -6px rgba(0,0,0,0.06); z-index: 1000; overflow: hidden; max-height: 290px; overflow-y: auto;">
              <div style="padding: 0.5rem 0.85rem; background: #F8FAFC; border-bottom: 1px solid var(--border-light); font-size: 0.78rem; font-weight: 600; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center;">
                <span><i class="fa-solid fa-lightbulb" style="color: #F59E0B;"></i> Itens com nome parecido no almoxarifado:</span>
                <span id="contador-similares" style="font-size: 0.72rem; color: var(--text-muted);"></span>
              </div>
              <div id="lista-similares"></div>
            </div>
          </div>

          <!-- Quantidade -->
          <div class="form-group">
            <label class="form-label" for="produto-quantidade-input">
              Quantidade
            </label>
            <input 
              type="number" 
              id="produto-quantidade-input" 
              name="quantidade" 
              class="form-control" 
              min="0" 
              value="<%= produto.quantidade !== undefined ? produto.quantidade : 0 %>"
            >
          </div>

          <!-- Unidade de Medida -->
          <div class="form-group">
            <label class="form-label" for="produto-unidade-select">
              Unidade de Medida
            </label>
            <select id="produto-unidade-select" name="unidade_medida" class="form-select">
              <option value="UN" <%= produto.unidade_medida === 'UN' ? 'selected' : '' %>>UN - Unidade</option>
              <option value="CX" <%= produto.unidade_medida === 'CX' ? 'selected' : '' %>>CX - Caixa</option>
              <option value="PAR" <%= produto.unidade_medida === 'PAR' ? 'selected' : '' %>>PAR - Par</option>
              <option value="KG" <%= produto.unidade_medida === 'KG' ? 'selected' : '' %>>KG - Quilograma</option>
              <option value="L" <%= produto.unidade_medida === 'L' ? 'selected' : '' %>>L - Litro</option>
              <option value="M" <%= produto.unidade_medida === 'M' ? 'selected' : '' %>>M - Metro</option>
              <option value="JG" <%= produto.unidade_medida === 'JG' ? 'selected' : '' %>>JG - Jogo</option>
            </select>
          </div>

          <!-- Estoque Mínimo -->
          <div class="form-group">
            <label class="form-label" for="produto-minimo-input">
              Estoque Mínimo (Alerta)
            </label>
            <input 
              type="number" 
              id="produto-minimo-input" 
              name="estoque_minimo" 
              class="form-control" 
              min="0" 
              value="<%= produto.estoque_minimo !== undefined ? produto.estoque_minimo : 0 %>"
            >
          </div>

          <!-- Localização -->
          <div class="form-group">
            <label class="form-label" for="produto-localizacao-input">
              Localização / Endereçamento Físico
            </label>
            <input 
              type="text" 
              id="produto-localizacao-input" 
              name="localizacao" 
              class="form-control" 
              placeholder="Ex: Prateleira B-03, Gaveta 4" 
              value="<%= produto.localizacao || '' %>"
            >
          </div>

          <!-- Status Estoque / Condição do Item (Igual à coluna da Planilha) -->
          <div class="form-group">
            <label class="form-label" for="produto-condicao-select">
              Status Estoque / Condição
            </label>
            <select id="produto-condicao-select" name="condicao" class="form-select">
              <option value="NOVO" <%= (!produto.condicao || produto.condicao === 'NOVO') ? 'selected' : '' %>>NOVO (Item Novo / Lacrado)</option>
              <option value="REUSO" <%= produto.condicao === 'REUSO' ? 'selected' : '' %>>REUSO (Item de Reúso / Seminovo)</option>
              <option value="BOM" <%= produto.condicao === 'BOM' ? 'selected' : '' %>>BOM (Bom Estado de Conservação)</option>
              <option value="MANUTENÇÃO" <%= produto.condicao === 'MANUTENÇÃO' ? 'selected' : '' %>>MANUTENÇÃO (Em Revisão / Manutenção)</option>
              <option value="SUCATA" <%= produto.condicao === 'SUCATA' ? 'selected' : '' %>>SUCATA (Inservível / Descarte)</option>
              <option value="OUTROS" <%= produto.condicao === 'OUTROS' ? 'selected' : '' %>>OUTROS (Diversos)</option>
            </select>
            <span class="form-help">Mesmo campo "Status Estoque" presente na planilha Excel.</span>
          </div>
        </div>
      </div>

      <!-- SEÇÃO 2: IDENTIFICAÇÃO E RASTREAMENTO -->
      <div style="margin-bottom: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-light);">
        <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i class="fa-solid fa-barcode" style="color: var(--teal);"></i> Identificação & Rastreamento
          <span style="font-size: 0.75rem; font-weight: 400; color: var(--text-muted);">(Opcional)</span>
        </h3>

        <div class="form-grid">
          <!-- TAG / Plaqueta -->
          <div class="form-group">
            <label class="form-label" for="produto-tag-input">
              TAG / Plaqueta
            </label>
            <input 
              type="text" 
              id="produto-tag-input" 
              name="tag" 
              class="form-control" 
              placeholder="Ex: TAG-1049" 
              value="<%= produto.tag || '' %>" 
              style="text-transform: uppercase;"
            >
          </div>

          <!-- Patrimônio -->
          <div class="form-group">
            <label class="form-label" for="produto-patrimonio-input">
              Nº de Patrimônio
            </label>
            <input 
              type="text" 
              id="produto-patrimonio-input" 
              name="patrimonio" 
              class="form-control" 
              placeholder="Ex: PAT-0082" 
              value="<%= produto.patrimonio || '' %>" 
              style="text-transform: uppercase;"
            >
          </div>

          <!-- Número de Série -->
          <div class="form-group">
            <label class="form-label" for="produto-serie-input">
              Número de Série
            </label>
            <input 
              type="text" 
              id="produto-serie-input" 
              name="numero_serie" 
              class="form-control" 
              placeholder="Ex: SN-987654321" 
              value="<%= produto.numero_serie || '' %>"
            >
          </div>

          <!-- C.A (Certificado de Aprovação) -->
          <div class="form-group">
            <label class="form-label" for="produto-ca-input">
              C.A (Certificado de Aprovação - EPI)
            </label>
            <input 
              type="text" 
              id="produto-ca-input" 
              name="ca" 
              class="form-control" 
              placeholder="Ex: 31469" 
              value="<%= produto.ca || '' %>"
            >
          </div>
        </div>
      </div>

      <!-- SEÇÃO 3: CARACTERÍSTICAS FÍSICAS -->
      <div style="margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-light);">
        <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i class="fa-solid fa-ruler-combined" style="color: var(--purple);"></i> Características Físicas
          <span style="font-size: 0.75rem; font-weight: 400; color: var(--text-muted);">(Opcional)</span>
        </h3>

        <div class="form-grid">
          <!-- Tamanho -->
          <div class="form-group">
            <label class="form-label" for="produto-tamanho-input">
              Tamanho / Dimensão
            </label>
            <input 
              type="text" 
              id="produto-tamanho-input" 
              name="tamanho" 
              class="form-control" 
              placeholder="Ex: G, 42, 8 Pol, 305m" 
              value="<%= produto.tamanho || '' %>"
            >
          </div>

          <!-- Cor -->
          <div class="form-group">
            <label class="form-label" for="produto-cor-input">
              Cor
            </label>
            <input 
              type="text" 
              id="produto-cor-input" 
              name="cor" 
              class="form-control" 
              placeholder="Ex: Azul, Preto, Amarelo" 
              value="<%= produto.cor || '' %>"
            >
          </div>

          <!-- Peso -->
          <div class="form-group">
            <label class="form-label" for="produto-peso-input">
              Peso
            </label>
            <input 
              type="text" 
              id="produto-peso-input" 
              name="peso" 
              class="form-control" 
              placeholder="Ex: 350g, 1.2kg" 
              value="<%= produto.peso || '' %>"
            >
          </div>
        </div>
      </div>

      <!-- SEÇÃO 4: OBSERVAÇÕES E NOTAS DO ITEM -->
      <div style="margin-bottom: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-light);">
        <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i class="fa-solid fa-clipboard-list" style="color: var(--teal);"></i> Observações e Notas Adicionais
          <span style="font-size: 0.75rem; font-weight: 400; color: var(--text-muted);">(Opcional)</span>
        </h3>

        <div class="form-group">
          <label class="form-label" for="produto-observacao-input">
            Observações Gerais do Produto
          </label>
          <textarea 
            id="produto-observacao-input" 
            name="observacao" 
            class="form-control" 
            rows="3" 
            placeholder="Informações adicionais, cuidados especiais, instruções de uso, fornecedor de referência, etc."
            style="resize: vertical;"
          ><%= produto.observacao || '' %></textarea>
        </div>
      </div>

      <!-- BOTÕES DE AÇÃO -->
      <div class="page-actions-group" style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border-light);">
        <a href="/produtos" class="btn btn-outline">Cancelar</a>
        <button type="submit" class="btn btn-primary" id="btn-salvar-produto">
          <i class="fa-solid fa-plus"></i> Salvar Produto
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Exibe campo de especificar outra categoria caso "Outros" esteja selecionado
  const selectCategoria = document.getElementById('produto-categoria-select');
  const campoOutraCategoria = document.getElementById('campo-outra-categoria');

  function verificarCategoriaOutros() {
    if (selectCategoria.value === 'Outros') {
      campoOutraCategoria.style.display = 'block';
    } else {
      campoOutraCategoria.style.display = 'none';
    }
  }

  selectCategoria.addEventListener('change', verificarCategoriaOutros);
  verificarCategoriaOutros();

  // Gerador automático de SKU
  document.getElementById('btn-gerar-sku')?.addEventListener('click', () => {
    const cat = selectCategoria.value || 'GER';
    const prefixo = cat.substring(0, 3).toUpperCase().replace(/[^A-Z]/g, 'ITM') || 'ITM';
    const num = Math.floor(1000 + Math.random() * 9000);
    document.getElementById('produto-sku-input').value = `${prefixo}-${num}`;
  });

  // --- AUTOCOMPLETE E DETECÇÃO INTELIGENTE DE PRODUTO DUPLICADO ---
  const inputNome = document.getElementById('produto-nome-input');
  const dropdownSugestoes = document.getElementById('dropdown-sugestoes');
  const listaSimilares = document.getElementById('lista-similares');
  const contadorSimilares = document.getElementById('contador-similares');
  const alertaIdentico = document.getElementById('alerta-nome-identico');
  const textoAlertaIdentico = document.getElementById('texto-alerta-identico');
  const linkEditarIdentico = document.getElementById('link-editar-identico');
  const loadingSugestoes = document.getElementById('loading-sugestoes');
  const btnSalvar = document.getElementById('btn-salvar-produto');
  const formProduto = document.getElementById('form-produto');

  let debounceTimer = null;
  let itemExatoAtual = null;

  async function verificarNome(termo) {
    const nomeLimpo = (termo || '').trim();

    if (nomeLimpo.length < 2) {
      ocultarSugestoes();
      return;
    }

    if (loadingSugestoes) loadingSugestoes.style.display = 'block';

    try {
      const res = await fetch('/produtos/sugestoes?nome=' + encodeURIComponent(nomeLimpo));
      const data = await res.json();

      if (loadingSugestoes) loadingSugestoes.style.display = 'none';

      // Verifica se o texto digitado ainda é o mesmo da requisição
      if (inputNome.value.trim().toLowerCase() !== nomeLimpo.toLowerCase()) {
        return;
      }

      // CASO 1: Nome IDÊNTICO (Bloqueia cadastro e alerta)
      if (data.exato && data.exato.nome.trim().toLowerCase() === nomeLimpo.toLowerCase()) {
        itemExatoAtual = data.exato;
        bloquearPorNomeIdentico(data.exato);
        ocultarDropdown();
        return;
      }

      // Se não for idêntico, libera o salvar e limpa alerta
      liberarSalvar();

      // CASO 2: Nomes PARECIDOS (Mostra dropdown de sugestões)
      if (data.similares && data.similares.length > 0) {
        renderizarSimilares(data.similares, nomeLimpo);
      } else {
        // CASO 3: Produto NOVO / Inédito (Some a lista e considera o digitado)
        ocultarDropdown();
      }
    } catch (e) {
      console.error('Erro ao verificar similaridade de nome:', e);
      if (loadingSugestoes) loadingSugestoes.style.display = 'none';
    }
  }

  function bloquearPorNomeIdentico(item) {
    const qtd = item.quantidade !== undefined ? item.quantidade : 0;
    const unid = item.unidade_medida || 'UN';
    const marcaInfo = item.marca ? ` • Marca: ${item.marca}` : '';

    textoAlertaIdentico.innerHTML = `O produto <strong>"${item.nome}"</strong> já está cadastrado com o código <strong>${item.sku}</strong> (${item.categoria}${marcaInfo}) e saldo atual de <strong>${qtd} ${unid}</strong>.`;
    linkEditarIdentico.href = `/produtos/${item.id}/editar`;
    
    alertaIdentico.style.display = 'block';
    inputNome.style.borderColor = '#DC2626';
    inputNome.style.boxShadow = '0 0 0 3px rgba(220, 38, 38, 0.15)';

    btnSalvar.disabled = true;
    btnSalvar.style.opacity = '0.45';
    btnSalvar.style.cursor = 'not-allowed';
    btnSalvar.title = 'Altere o nome para poder cadastrar este item.';
  }

  function liberarSalvar() {
    alertaIdentico.style.display = 'none';
    inputNome.style.borderColor = '';
    inputNome.style.boxShadow = '';

    btnSalvar.disabled = false;
    btnSalvar.style.opacity = '';
    btnSalvar.style.cursor = '';
    btnSalvar.title = '';
    itemExatoAtual = null;
  }

  function ocultarDropdown() {
    dropdownSugestoes.style.display = 'none';
    listaSimilares.innerHTML = '';
  }

  function ocultarSugestoes() {
    ocultarDropdown();
    liberarSalvar();
  }

  function renderizarSimilares(itens, termoBuscado) {
    contadorSimilares.textContent = `${itens.length} encontrado(s)`;
    listaSimilares.innerHTML = '';

    itens.forEach(item => {
      const divItem = document.createElement('div');
      divItem.className = 'sugestao-item';
      divItem.style.padding = '0.65rem 0.85rem';
      divItem.style.borderBottom = '1px solid var(--border-light)';
      divItem.style.cursor = 'pointer';
      divItem.style.display = 'flex';
      divItem.style.alignItems = 'center';
      divItem.style.justifyContent = 'space-between';
      divItem.style.transition = 'background 0.15s ease';

      divItem.onmouseenter = () => divItem.style.background = '#F1F5F9';
      divItem.onmouseleave = () => divItem.style.background = '#ffffff';

      const marcaTxt = item.marca ? ` • ${item.marca}` : '';
      const qtdTxt = `${item.quantidade || 0} ${item.unidade_medida || 'UN'}`;

      divItem.innerHTML = `
        <div style="flex: 1; min-width: 0; padding-right: 0.75rem;">
          <div style="font-weight: 600; font-size: 0.88rem; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            ${item.nome}
          </div>
          <div style="font-size: 0.76rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem; margin-top: 2px;">
            <span class="badge" style="background: var(--bg-main); font-weight: 600; border: 1px solid var(--border-light); font-size: 0.72rem; padding: 1px 6px;">
              ${item.sku}
            </span>
            <span>${item.categoria}${marcaTxt}</span>
            <span>• Saldo: <strong>${qtdTxt}</strong></span>
          </div>
        </div>
        <div>
          <a href="/produtos/${item.id}/editar" class="btn btn-sm btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; text-decoration: none;" title="Abrir edição deste produto">
            <i class="fa-solid fa-pen-to-square"></i> Editar
          </a>
        </div>
      `;

      // Ao clicar no item, preenche o nome e verifica
      divItem.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;
        inputNome.value = item.nome;
        verificarNome(item.nome);
      });

      listaSimilares.appendChild(divItem);
    });

    dropdownSugestoes.style.display = 'block';
  }

  inputNome.addEventListener('input', (e) => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      verificarNome(e.target.value);
    }, 200);
  });

  inputNome.addEventListener('focus', () => {
    if (inputNome.value.trim().length >= 2 && !itemExatoAtual && listaSimilares.children.length > 0) {
      dropdownSugestoes.style.display = 'block';
    }
  });

  // Fecha dropdown ao clicar fora
  document.addEventListener('click', (e) => {
    if (!dropdownSugestoes.contains(e.target) && e.target !== inputNome) {
      dropdownSugestoes.style.display = 'none';
    }
  });

  // Impede submit se o nome for idêntico
  formProduto.addEventListener('submit', (e) => {
    if (itemExatoAtual) {
      e.preventDefault();
      bloquearPorNomeIdentico(itemExatoAtual);
      inputNome.focus();
      return false;
    }
  });

  // Se já veio com erro de produto duplicado do servidor
  <% if (typeof produtoDuplicado !== 'undefined' && produtoDuplicado) { %>
    bloquearPorNomeIdentico({
      id: <%= produtoDuplicado.id %>,
      nome: "<%= produtoDuplicado.nome %>",
      sku: "<%= produtoDuplicado.sku %>",
      categoria: "<%= produtoDuplicado.categoria %>",
      marca: "<%= produtoDuplicado.marca || '' %>",
      quantidade: <%= produtoDuplicado.quantidade || 0 %>,
      unidade_medida: "<%= produtoDuplicado.unidade_medida || 'UN' %>"
    });
  <% } %>
</script>

<%- include('../layouts/footer') %>
