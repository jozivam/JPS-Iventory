<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#4F46E5">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="JPS Almoxarifado">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/png" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <title><%= title || 'Login — JPS Almoxarifado' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body.login-page-body {
      display: flex;
      min-height: 100vh;
      width: 100%;
      background: var(--bg-app);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .login-shell {
      display: grid;
      grid-template-columns: 1.08fr 1fr;
      width: 100%;
      min-height: 100vh;
    }

    /* Painel Esquerdo Institucional */
    .login-brand-panel {
      position: relative;
      background: linear-gradient(145deg, #0f172a 0%, #1e1b4b 55%, #312e81 100%);
      color: #ffffff;
      padding: 3.25rem 3.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .login-brand-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(circle at 18% 20%, rgba(99, 102, 241, 0.35), transparent 45%),
        radial-gradient(circle at 85% 82%, rgba(16, 185, 129, 0.18), transparent 40%),
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: auto, auto, 36px 36px, 36px 36px;
      pointer-events: none;
    }

    .login-brand-content {
      position: relative;
      z-index: 2;
      max-width: 480px;
    }

    .login-logo-row {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 3rem;
    }

    .login-logo-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      color: #ffffff;
      box-shadow: 0 10px 25px rgba(79, 70, 229, 0.45);
    }

    .login-logo-name {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }

    .login-logo-sub {
      font-size: 0.76rem;
      color: #a5b4fc;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .login-restricted-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.38rem 0.85rem;
      border-radius: 9999px;
      background: rgba(99, 102, 241, 0.2);
      border: 1px solid rgba(165, 180, 252, 0.3);
      color: #e0e7ff;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      margin-bottom: 1.35rem;
    }

    .login-hero-title {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.18;
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
      color: #ffffff;
    }

    .login-hero-desc {
      font-size: 0.96rem;
      color: #cbd5e1;
      line-height: 1.65;
      margin-bottom: 2.25rem;
    }

    .login-features {
      display: flex;
      flex-direction: column;
      gap: 0.95rem;
    }

    .login-feature-item {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 0.85rem 1rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(6px);
    }

    .login-feature-icon {
      width: 36px;
      height: 36px;
      border-radius: 9px;
      background: rgba(99, 102, 241, 0.25);
      color: #a5b4fc;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.95rem;
    }

    .login-feature-item strong {
      display: block;
      font-size: 0.88rem;
      font-weight: 700;
      color: #f8fafc;
      margin-bottom: 2px;
    }

    .login-feature-item span {
      display: block;
      font-size: 0.78rem;
      color: #94a3b8;
      line-height: 1.4;
    }

    .login-brand-footer {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.78rem;
      color: #94a3b8;
      padding-top: 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Painel Direito (Formulário) */
    .login-form-panel {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1.5rem;
      background: var(--bg-app);
    }

    .login-card {
      width: 100%;
      max-width: 430px;
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 18px;
      padding: 2.4rem 2.25rem;
      box-shadow: 0 20px 45px -15px rgba(15, 23, 42, 0.09);
    }

    .login-mobile-brand {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .login-card-header {
      margin-bottom: 1.65rem;
    }

    .login-card-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.73rem;
      font-weight: 700;
      color: var(--primary-hover);
      background: var(--primary-light);
      border: 1px solid var(--primary-border);
      padding: 0.28rem 0.7rem;
      border-radius: 9999px;
      margin-bottom: 0.75rem;
    }

    .login-card-header h1 {
      font-size: 1.55rem;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.025em;
      margin-bottom: 0.35rem;
    }

    .login-card-header p {
      font-size: 0.87rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .login-alert {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      font-size: 0.83rem;
      font-weight: 600;
      line-height: 1.45;
      margin-bottom: 1.25rem;
    }

    .login-alert-danger {
      background: var(--danger-bg);
      border: 1px solid var(--danger-border);
      color: var(--danger-text);
    }

    .login-alert-success {
      background: var(--success-bg);
      border: 1px solid var(--success-border);
      color: var(--success-text);
    }

    .login-field {
      margin-bottom: 1.15rem;
    }

    .login-field label {
      display: block;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.42rem;
    }

    .login-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .login-input-icon {
      position: absolute;
      left: 0.95rem;
      color: var(--text-dim);
      font-size: 0.92rem;
      pointer-events: none;
    }

    .login-input {
      width: 100%;
      height: 46px;
      padding: 0 2.75rem 0 2.6rem;
      border: 1.5px solid var(--border-color);
      border-radius: 10px;
      background: var(--bg-surface);
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 0.92rem;
      font-weight: 500;
      outline: none;
      transition: var(--transition);
    }

    .login-input:focus {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.14);
    }

    .login-toggle-pwd {
      position: absolute;
      right: 0.65rem;
      width: 34px;
      height: 34px;
      border: none;
      background: transparent;
      color: var(--text-muted);
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .login-toggle-pwd:hover {
      background: var(--bg-hover);
      color: var(--text-main);
    }

    .login-options-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 0.25rem 0 1.35rem;
      gap: 0.75rem;
    }

    .login-checkbox-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.83rem;
      color: var(--text-body);
      font-weight: 500;
      cursor: pointer;
      user-select: none;
    }

    .login-checkbox-label input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .login-submit-btn {
      width: 100%;
      height: 48px;
      border: none;
      border-radius: 11px;
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      box-shadow: 0 10px 22px -8px rgba(79, 70, 229, 0.6);
      transition: var(--transition);
    }

    .login-submit-btn:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 14px 26px -8px rgba(79, 70, 229, 0.7);
    }

    .login-submit-btn:active:not(:disabled) {
      transform: translateY(0);
    }

    .login-submit-btn:disabled {
      opacity: 0.75;
      cursor: not-allowed;
    }

    .login-security-note {
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border-light);
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.48;
    }

    .login-security-note i {
      color: var(--primary);
      margin-top: 2px;
      flex-shrink: 0;
    }

    @media (max-width: 960px) {
      .login-shell {
        grid-template-columns: 1fr;
      }

      .login-brand-panel {
        display: none;
      }

      .login-form-panel {
        background: linear-gradient(180deg, #eef2ff 0%, #f4f5f9 45%, #f4f5f9 100%);
        padding: 1.5rem 1rem;
      }

      .login-mobile-brand {
        display: flex;
      }

      .login-card {
        padding: 1.85rem 1.4rem;
      }
    }
  </style>
</head>
<body class="login-page-body">
  <div class="login-shell">

    <!-- Painel Institucional (Desktop) -->
    <section class="login-brand-panel" aria-label="Informações do Sistema">
      <div class="login-brand-content">
        <div class="login-logo-row">
          <div class="login-logo-icon">
            <i class="fa-solid fa-cube"></i>
          </div>
          <div>
            <div class="login-logo-name">JPS Almoxarifado</div>
            <div class="login-logo-sub">Gestão de Inventário & Obras</div>
          </div>
        </div>

        <div class="login-restricted-pill">
          <i class="fa-solid fa-shield-halved"></i>
          ACESSO RESTRITO • EQUIPE AUTORIZADA
        </div>

        <h2 class="login-hero-title">
          Controle total do seu estoque com segurança.
        </h2>
        <p class="login-hero-desc">
          Apenas operadores cadastrados e autorizados podem acessar o painel de inventário,
          realizar lançamentos no balcão e auditar fichas de colaboradores.
        </p>

        <div class="login-features">
          <div class="login-feature-item">
            <div class="login-feature-icon">
              <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div>
              <strong>Inventário & Rastreabilidade</strong>
              <span>Acompanhamento de saldo, estoque mínimo, TAGs, patrimônio e C.A. de EPIs.</span>
            </div>
          </div>

          <div class="login-feature-item">
            <div class="login-feature-icon">
              <i class="fa-solid fa-user-shield"></i>
            </div>
            <div>
              <strong>Permissões por Perfil</strong>
              <span>Acesso segmentado entre Administradores, Almoxarifes e Visualizadores.</span>
            </div>
          </div>

          <div class="login-feature-item">
            <div class="login-feature-icon">
              <i class="fa-solid fa-cloud-arrow-up"></i>
            </div>
            <div>
              <strong>Operação Pronta para Campo</strong>
              <span>Sessão segura no navegador e no aplicativo Android com sincronização em nuvem.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="login-brand-footer">
        <span><i class="fa-solid fa-lock" style="margin-right: 5px; color: #818cf8;"></i> Autenticação protegida</span>
        <span>JPS Inventory © <%= new Date().getFullYear() %></span>
      </div>
    </section>

    <!-- Painel do Formulário de Login -->
    <main class="login-form-panel">
      <div class="login-card">

        <!-- Cabeçalho de Marca no Mobile / APK -->
        <div class="login-mobile-brand">
          <div class="login-logo-icon" style="width: 40px; height: 40px; font-size: 1.1rem;">
            <i class="fa-solid fa-cube"></i>
          </div>
          <div style="text-align: left;">
            <div style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); line-height: 1.1;">JPS Almoxarifado</div>
            <div style="font-size: 0.7rem; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 0.04em;">Acesso Restrito</div>
          </div>
        </div>

        <div class="login-card-header">
          <div class="login-card-badge">
            <i class="fa-solid fa-key"></i> Área Autenticada
          </div>
          <h1>Entrar no sistema</h1>
          <p>Informe suas credenciais de operador autorizado para acessar o almoxarifado.</p>
        </div>

        <% if (typeof erro !== 'undefined' && erro) { %>
          <div class="login-alert login-alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation" style="margin-top: 2px; flex-shrink: 0;"></i>
            <span><%= erro %></span>
          </div>
        <% } %>

        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
          <div class="login-alert login-alert-success" role="status">
            <i class="fa-solid fa-circle-check" style="margin-top: 2px; flex-shrink: 0;"></i>
            <span><%= sucesso %></span>
          </div>
        <% } %>

        <form action="/login" method="POST" id="form-login" autocomplete="on">
          <% if (typeof nextUrl !== 'undefined' && nextUrl) { %>
            <input type="hidden" name="next" value="<%= nextUrl %>">
          <% } %>

          <div class="login-field">
            <label for="input-login">Usuário, E-mail ou Matrícula</label>
            <div class="login-input-wrap">
              <i class="fa-solid fa-user login-input-icon"></i>
              <input
                type="text"
                id="input-login"
                name="login"
                class="login-input"
                placeholder="ex: jozivam ou email@empresa.com"
                value="<%= typeof loginInformado !== 'undefined' ? loginInformado : '' %>"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                required
                autofocus
              >
            </div>
          </div>

          <div class="login-field">
            <label for="input-senha">Senha de Acesso</label>
            <div class="login-input-wrap">
              <i class="fa-solid fa-lock login-input-icon"></i>
              <input
                type="password"
                id="input-senha"
                name="senha"
                class="login-input"
                placeholder="Digite sua senha"
                autocomplete="current-password"
                required
              >
              <button
                type="button"
                class="login-toggle-pwd"
                id="btn-toggle-senha"
                aria-label="Mostrar ou ocultar senha"
                title="Mostrar/ocultar senha"
              >
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <div class="login-options-row">
            <label class="login-checkbox-label">
              <input type="checkbox" name="lembrar" value="on" checked>
              <span>Manter conectado neste dispositivo</span>
            </label>
          </div>

          <button type="submit" class="login-submit-btn" id="btn-entrar">
            <i class="fa-solid fa-right-to-bracket"></i>
            <span>Entrar no Sistema</span>
          </button>
        </form>

        <div class="login-security-note">
          <i class="fa-solid fa-shield-halved"></i>
          <span>
            Somente usuários habilitados com perfil <strong>Usuário do Sistema</strong> e status <strong>Ativo</strong> têm acesso. Caso precise de liberação ou redefinição de senha, fale com o Administrador.
          </span>
        </div>

      </div>
    </main>

  </div>

  <script>
    (function () {
      const btnToggle = document.getElementById('btn-toggle-senha');
      const inputSenha = document.getElementById('input-senha');
      const formLogin = document.getElementById('form-login');
      const btnEntrar = document.getElementById('btn-entrar');

      if (btnToggle && inputSenha) {
        btnToggle.addEventListener('click', function () {
          const isPwd = inputSenha.type === 'password';
          inputSenha.type = isPwd ? 'text' : 'password';
          const icon = btnToggle.querySelector('i');
          if (icon) {
            icon.className = isPwd ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
          }
          inputSenha.focus();
        });
      }

      if (formLogin && btnEntrar) {
        formLogin.addEventListener('submit', function () {
          btnEntrar.disabled = true;
          btnEntrar.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Validando acesso...</span>';
        });
      }

      // Ao sair da conta, limpa o cache de páginas protegidas no Service Worker
      <% if (typeof isLogout !== 'undefined' && isLogout) { %>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.ready
          .then(function (reg) {
            if (reg && reg.active) {
              reg.active.postMessage({ type: 'CLEAR_AUTH_CACHE' });
            }
          })
          .catch(function () {});
      }
      <% } %>
    })();
  </script>
</body>
</html>
