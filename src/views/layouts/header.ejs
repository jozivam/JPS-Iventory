<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#4F46E5">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="JPS Almoxarifado">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/png" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <title><%= title || 'Almoxarifado' %></title>
  
  <!-- Fontes do Google -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Ícones Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Estilos Customizados do Design Fixoria / Storaxe -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <!-- Sidebar de Navegação Lateral -->
    <%- include('./sidebar') %>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- Área de Conteúdo Principal -->
    <main class="app-main">
      <!-- Topbar com Busca Geral no Sistema -->
      <header class="topbar">
        <div style="display: flex; align-items: center; gap: 0.65rem; flex: 1; min-width: 0; max-width: 600px;">
          <button id="btn-toggle-sidebar" class="btn-topbar-icon d-md-none" aria-label="Abrir Menu">
            <i class="fa-solid fa-bars"></i>
          </button>
          
          <div class="topbar-search" style="width: 100%;">
            <i class="fa-solid fa-magnifying-glass"></i>
            <form action="/busca" method="GET" style="margin: 0; width: 100%;">
              <input 
                type="text" 
                name="q" 
                placeholder="Busca geral no sistema (itens, movimentações, tags, docs)..." 
                value="<%= (typeof queryBuscaGeral !== 'undefined' && queryBuscaGeral) ? queryBuscaGeral : '' %>"
              >
            </form>
          </div>
        </div>

        <div class="topbar-actions">
          <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado && usuarioLogado.nivel_acesso === 'VISUALIZADOR') { %>
            <span class="status-pill" title="Perfil somente consulta" style="background: #E0F2FE; color: #0369A1; border: 1px solid #BAE6FD; font-size: 0.73rem; padding: 0.25rem 0.65rem; display: inline-flex; align-items: center; gap: 0.35rem;">
              <i class="fa-solid fa-eye"></i> Somente Leitura
            </span>
          <% } else if (typeof usuarioLogado !== 'undefined' && usuarioLogado && usuarioLogado.nivel_acesso === 'OPERADOR_FICHAS') { %>
            <span class="status-pill" title="Visualização e lançamentos em fichas de colaboradores" style="background: #CCFBF1; color: #0F766E; border: 1px solid #99F6E4; font-size: 0.73rem; padding: 0.25rem 0.65rem; display: inline-flex; align-items: center; gap: 0.35rem;">
              <i class="fa-solid fa-clipboard-check"></i> Operador de Fichas
            </span>
          <% } %>
          <a href="/movimentacoes" class="btn-topbar-icon" title="Movimentações">
            <i class="fa-regular fa-envelope"></i>
          </a>
          <a href="/produtos?status=BAIXO" class="btn-topbar-icon" title="Alertas de Estoque Baixo">
            <i class="fa-regular fa-bell"></i>
            <span class="topbar-badge-dot"></span>
          </a>
          <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
            <form action="/logout" method="POST" style="margin: 0; display: inline-flex;">
              <button type="submit" class="btn-topbar-icon" title="Sair da conta (<%= usuarioLogado.nome %>)" aria-label="Sair" style="color: var(--danger-text);">
                <i class="fa-solid fa-right-from-bracket"></i>
              </button>
            </form>
          <% } %>
        </div>
      </header>
      
      <div class="page-content">
