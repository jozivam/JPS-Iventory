<%- include('./header') %>

<div class="content-card" style="max-width: 600px; margin: 3rem auto; text-align: center;">
  <div class="card-body" style="padding: 3rem 2rem;">
    <div style="font-size: 3.5rem; color: var(--danger); margin-bottom: 1rem;">
      <i class="fa-solid fa-circle-exclamation"></i>
    </div>
    <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.75rem;"><%= mensagem %></h2>
    <% if (typeof detalhes !== 'undefined' && detalhes) { %>
      <div style="background: var(--bg-input); padding: 1rem; border-radius: var(--radius-md); font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1.5rem; text-align: left; word-break: break-word;">
        <%= detalhes %>
      </div>
    <% } %>
    <div style="display: flex; justify-content: center; gap: 1rem;">
      <a href="/" class="btn btn-primary">
        <i class="fa-solid fa-house"></i> Voltar ao Painel
      </a>
      <a href="javascript:history.back()" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Página Anterior
      </a>
    </div>
  </div>
</div>

<%- include('./footer') %>
