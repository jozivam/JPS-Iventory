      </div><!-- /.page-content -->
    </main>
  </div><!-- /.app-container -->

  <!-- Modal Global de Confirmação de Exclusão -->
  <div class="modal-overlay" id="modal-confirmar-exclusao">
    <div class="modal-container">
      <div class="modal-header">
        <h3 style="color: var(--danger); font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i class="fa-solid fa-triangle-exclamation"></i> Confirmar Exclusão
        </h3>
        <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-confirmar-exclusao')">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="modal-body">
        <p>Tem certeza de que deseja remover <strong id="modal-excluir-item-nome">este item</strong>?</p>
        <p style="font-size: 0.8rem; color: var(--text-dim); margin-top: 0.5rem;">
          Esta ação removerá o registro do sistema. Itens com histórico de movimentações vinculadas não poderão ser excluídos para garantir a conformidade de inventário.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.fecharModal('modal-confirmar-exclusao')">
          Cancelar
        </button>
        <button type="button" class="btn btn-danger" id="btn-confirmar-exclusao-acao">
          <i class="fa-solid fa-trash-can"></i> Sim, Excluir
        </button>
      </div>
    </div>
  </div>

  <!-- Barra de Navegação Inferior Móvel (Fixa para Celulares) -->
  <nav class="mobile-bottom-nav">
    <a href="/produtos" class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'produtos') ? 'active' : '' %>">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span>Inventário</span>
    </a>
    
    <a href="/balcao" class="mobile-nav-item mobile-nav-highlight <%= (typeof currentPage !== 'undefined' && currentPage === 'balcao') ? 'active' : '' %>">
      <div class="mobile-nav-circle">
        <i class="fa-solid fa-store"></i>
      </div>
      <span>Balcão</span>
    </a>
    
    <a href="/movimentacoes" class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'movimentacoes') ? 'active' : '' %>">
      <i class="fa-solid fa-clock-rotate-left"></i>
      <span>Histórico</span>
    </a>
    
    <a href="/produtos/novo" class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'novo-produto') ? 'active' : '' %>">
      <i class="fa-solid fa-circle-plus"></i>
      <span>Novo Item</span>
    </a>
  </nav>

  <!-- JavaScript Global -->
  <script src="/js/main.js"></script>
</body>
</html>
