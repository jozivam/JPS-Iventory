      </div><!-- /.page-content -->
    </main>
  </div><!-- /.app-container -->

  <!-- Modal Global de Confirmação de Exclusão -->
  <div class="modal-overlay" id="modal-confirmar-exclusao">
    <div class="modal-container">
      <div class="modal-header">
        <h3 style="color: var(--danger); font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;">
          <i class="fa-solid fa-triangle-exclamation"></i> Confirmar Exclusão
        </h3>
        <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-confirmar-exclusao')">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="modal-body">
        <p>Tem certeza de que deseja remover <strong id="modal-excluir-item-nome">este item</strong>?</p>
        <p style="font-size: 0.8rem; color: var(--text-dim); margin-top: 0.5rem;">
          Esta ação removerá o registro do sistema. Itens com histórico de movimentações vinculadas não poderão ser excluídos para garantir a conformidade de inventário.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="window.fecharModal('modal-confirmar-exclusao')">
          Cancelar
        </button>
        <button type="button" class="btn btn-danger" id="btn-confirmar-exclusao-acao">
          <i class="fa-solid fa-trash-can"></i> Sim, Excluir
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Global: Alterar Minha Senha -->
  <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
  <div class="modal-overlay" id="modal-alterar-senha">
    <div class="modal-container" style="max-width: 440px;">
      <div class="modal-header">
        <h3 style="font-size: 1.05rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem; margin: 0;">
          <i class="fa-solid fa-key" style="color: var(--primary);"></i> Alterar Minha Senha
        </h3>
        <button type="button" class="btn btn-secondary btn-icon" onclick="window.fecharModal('modal-alterar-senha')">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <form action="/minha-conta/senha" method="POST">
        <div class="modal-body" style="display: flex; flex-direction: column; gap: 0.85rem;">
          <div style="font-size: 0.82rem; color: var(--text-muted); background: var(--bg-surface); padding: 0.65rem 0.85rem; border-radius: 8px; border: 1px solid var(--border-light);">
            Conta conectada: <strong style="color: var(--text-main);"><%= usuarioLogado.nome %></strong>
            <% if (usuarioLogado.login) { %>
              (<code style="color: var(--primary-hover);">@<%= usuarioLogado.login %></code>)
            <% } %>
          </div>

          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="input-senha-atual">Senha Atual <span style="color: var(--danger);">*</span></label>
            <input type="password" id="input-senha-atual" name="senha_atual" class="form-control" autocomplete="current-password" required>
          </div>

          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="input-nova-senha">Nova Senha <span style="color: var(--danger);">*</span></label>
            <input type="password" id="input-nova-senha" name="nova_senha" class="form-control" minlength="4" placeholder="Mínimo de 4 caracteres" autocomplete="new-password" required>
          </div>

          <div class="form-group" style="margin: 0;">
            <label class="form-label" for="input-confirmar-senha">Confirmar Nova Senha <span style="color: var(--danger);">*</span></label>
            <input type="password" id="input-confirmar-senha" name="confirmar_senha" class="form-control" minlength="4" autocomplete="new-password" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="window.fecharModal('modal-alterar-senha')">
            Cancelar
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Salvar Nova Senha
          </button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Barra de Navegação Inferior Móvel (Fixa para Celulares) -->
  <nav class="mobile-bottom-nav">
    <a href="/" class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'dashboard') ? 'active' : '' %>">
      <i class="fa-solid fa-chart-pie"></i>
      <span>Início</span>
    </a>

    <a href="/produtos" class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'produtos') ? 'active' : '' %>">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span>Itens</span>
    </a>
    
    <a href="/balcao" class="mobile-nav-item mobile-nav-highlight <%= (typeof currentPage !== 'undefined' && currentPage === 'balcao') ? 'active' : '' %>">
      <div class="mobile-nav-circle">
        <i class="fa-solid fa-store"></i>
      </div>
      <span>Balcão</span>
    </a>
    
    <a href="/requisicoes" class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'requisicoes') ? 'active' : '' %>" style="position: relative;">
      <i class="fa-solid fa-clipboard-list"></i>
      <% if (typeof totalRequisicoesPendentes !== 'undefined' && totalRequisicoesPendentes > 0) { %>
        <span style="position: absolute; top: 4px; right: calc(50% - 16px); background: #EF4444; color: #fff; font-size: 0.65rem; font-weight: 800; border-radius: 10px; padding: 1px 5px; line-height: 1;">
          <%= totalRequisicoesPendentes %>
        </span>
      <% } %>
      <span>Requisições</span>
    </a>
    
    <a href="/fichas" class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'fichas') ? 'active' : '' %>">
      <i class="fa-solid fa-file-invoice"></i>
      <span>Fichas</span>
    </a>
  </nav>

  <!-- JavaScript Global & Motor Offline-First (Obra / APK) -->
  <script src="/js/main.js"></script>
  <script src="/js/offline-manager.js"></script>
</body>
</html>
