<aside class="app-sidebar">
  <!-- Brand Logo & Botão Fechar no Mobile -->
  <div style="display: flex; align-items: center; justify-content: space-between; padding-right: 0.75rem;">
    <a href="/produtos" class="sidebar-brand" style="margin-right: 0;">
      <div class="brand-icon">
        <i class="fa-solid fa-cube"></i>
      </div>
      <div class="brand-text">
        <h1>JPS Almoxarifado</h1>
      </div>
    </a>
    <button type="button" class="btn-topbar-icon d-md-none" id="btn-close-sidebar" onclick="document.getElementById('sidebar-backdrop').click()" title="Fechar Menu" style="width: 32px; height: 32px; border: none; background: transparent; color: var(--text-muted); cursor: pointer;">
      <i class="fa-solid fa-xmark" style="font-size: 1.15rem;"></i>
    </button>
  </div>

  <!-- Menu de Navegação -->
  <nav class="sidebar-nav">
    <div class="nav-section-title">MENU PRINCIPAL</div>

    <a href="/produtos" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'produtos') ? 'active' : '' %>" id="nav-produtos">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span>Inventário (Itens)</span>
    </a>

    <a href="/balcao" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'balcao') ? 'active' : '' %>" id="nav-balcao">
      <i class="fa-solid fa-store"></i>
      <span>Balcão</span>
    </a>

    <a href="/movimentacoes" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'movimentacoes') ? 'active' : '' %>" id="nav-movimentacoes">
      <i class="fa-solid fa-clock-rotate-left"></i>
      <span>Movimentações</span>
    </a>

    <a href="/colaboradores" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'colaboradores') ? 'active' : '' %>" id="nav-colaboradores">
      <i class="fa-solid fa-users"></i>
      <span>Colaboradores</span>
    </a>

    <a href="/fichas" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'fichas') ? 'active' : '' %>" id="nav-fichas">
      <i class="fa-solid fa-file-invoice"></i>
      <span>Ficha de Colaboradores</span>
    </a>
  </nav>

  <!-- Perfil do Usuário Autenticado na Base -->
  <%
    const userObj = (typeof usuarioLogado !== 'undefined' && usuarioLogado) ? usuarioLogado : null;
    const nomeUsuario = userObj ? userObj.nome : 'Visitante';
    const iniciaisUsuario = userObj && userObj.nome
      ? userObj.nome.trim().split(/\s+/).map(p => p[0]).slice(0, 2).join('').toUpperCase()
      : 'US';
    const nomesNivelSidebar = {
      ADMIN: 'Administrador',
      ALMOXARIFE: 'Almoxarife',
      OPERADOR_FICHAS: 'Operador de Fichas',
      VISUALIZADOR: 'Visualizador'
    };
    const nivelLabel = userObj
      ? (nomesNivelSidebar[userObj.nivel_acesso] || userObj.nivel_acesso || 'Operador')
      : 'Não autenticado';
    const subtituloUsuario = (userObj && userObj.cargo) ? `${userObj.cargo} • ${nivelLabel}` : nivelLabel;
  %>
  <div class="sidebar-user" style="flex-direction: column; align-items: stretch; gap: 0.65rem; padding: 0.9rem 1rem;">
    <div style="display: flex; align-items: center; gap: 0.7rem; min-width: 0;">
      <div class="user-avatar" style="background: var(--primary-light); color: var(--primary-hover); border: 1px solid var(--primary-border); flex-shrink: 0;">
        <%= iniciaisUsuario %>
      </div>
      <div class="user-info">
        <div class="user-name" title="<%= nomeUsuario %>"><%= nomeUsuario %></div>
        <div class="user-role" title="<%= subtituloUsuario %>"><%= subtituloUsuario %></div>
      </div>
      <i class="fa-solid fa-circle" title="Sessão ativa" style="font-size: 0.5rem; color: var(--success); margin-left: auto; flex-shrink: 0;"></i>
    </div>

    <% if (userObj) { %>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem;">
        <button
          type="button"
          class="btn btn-outline btn-sm"
          onclick="window.abrirModal && window.abrirModal('modal-alterar-senha')"
          title="Alterar minha senha de acesso"
          style="padding: 0.35rem 0.5rem; font-size: 0.74rem; justify-content: center;"
        >
          <i class="fa-solid fa-key"></i> Senha
        </button>
        <form action="/logout" method="POST" style="margin: 0;">
          <button
            type="submit"
            class="btn btn-outline btn-sm"
            title="Sair do sistema"
            style="width: 100%; padding: 0.35rem 0.5rem; font-size: 0.74rem; justify-content: center; color: var(--danger-text); border-color: var(--danger-border);"
          >
            <i class="fa-solid fa-right-from-bracket"></i> Sair
          </button>
        </form>
      </div>
    <% } %>
  </div>
</aside>
