<aside class="app-sidebar">
  <!-- Brand Logo & Botão Fechar no Mobile -->
  <div style="display: flex; align-items: center; justify-content: space-between; padding-right: 0.75rem;">
    <a href="/produtos" class="sidebar-brand" style="margin-right: 0;">
      <div class="brand-icon">
        <i class="fa-solid fa-cube"></i>
      </div>
      <div class="brand-text">
        <h1>JPS Almoxarifado</h1>
      </div>
    </a>
    <button type="button" class="btn-topbar-icon d-md-none" id="btn-close-sidebar" onclick="document.getElementById('sidebar-backdrop').click()" title="Fechar Menu" style="width: 32px; height: 32px; border: none; background: transparent; color: var(--text-muted); cursor: pointer;">
      <i class="fa-solid fa-xmark" style="font-size: 1.15rem;"></i>
    </button>
  </div>

  <!-- Menu de Navegação - Apenas os 2 módulos essenciais -->
  <nav class="sidebar-nav">
    <div class="nav-section-title">MENU PRINCIPAL</div>

    <a href="/produtos" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'produtos') ? 'active' : '' %>" id="nav-produtos">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span>Inventário (Itens)</span>
    </a>

    <a href="/balcao" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'balcao') ? 'active' : '' %>" id="nav-balcao">
      <i class="fa-solid fa-store"></i>
      <span>Balcão</span>
    </a>

    <a href="/movimentacoes" class="nav-link <%= (typeof currentPage !== 'undefined' && currentPage === 'movimentacoes') ? 'active' : '' %>" id="nav-movimentacoes">
      <i class="fa-solid fa-clock-rotate-left"></i>
      <span>Movimentações</span>
    </a>
  </nav>

  <!-- Perfil do Usuário na Base -->
  <div class="sidebar-user">
    <div class="user-avatar">
      <i class="fa-solid fa-user-tie"></i>
    </div>
    <div class="user-info">
      <div class="user-name">Jozivam Silva</div>
      <div class="user-role">Gestor de Almoxarifado</div>
    </div>
    <i class="fa-solid fa-circle" style="font-size: 0.5rem; color: var(--success); margin-left: auto;"></i>
  </div>
</aside>
