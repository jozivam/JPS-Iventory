<%- include('../layouts/header') %>

<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho do Balcão -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Balcão de Atendimento</h2>
    <p>Lançamentos operacionais rápidos de entradas, saídas, trocas e controle de empréstimo de ferramentas.</p>
  </div>

  <div class="page-actions-group">
    <a href="/movimentacoes" class="btn btn-outline" title="Ver histórico completo de movimentações">
      <i class="fa-solid fa-clock-rotate-left"></i> Histórico Completo
    </a>
  </div>
</div>

<!-- Cards de Indicadores do Balcão -->
<div class="balcao-kpi-grid">
  
  <!-- Empréstimos Ativos -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #F59E0B;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-hand-holding-hand"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Empréstimos Ativos</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #B45309; line-height: 1.2;">
        <%= estatisticas.emprestimosAtivos %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">ferramenta(s)</span>
      </div>
    </div>
  </div>

  <!-- Atendimentos Hoje -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid var(--primary);">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #EEF2FF; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-bolt"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Atendimentos Hoje</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
        <%= estatisticas.totalAtendimentosHoje %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">registro(s)</span>
      </div>
    </div>
  </div>

  <!-- Entradas / Reposições Hoje -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #10B981;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #D1FAE5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-arrow-down"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Entradas Hoje</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #047857; line-height: 1.2;">
        +<%= estatisticas.entradasHoje %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">unidades</span>
      </div>
    </div>
  </div>

  <!-- Saídas / Empréstimos Hoje -->
  <div class="table-card" style="padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; border-left: 4px solid #EF4444;">
    <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
      <i class="fa-solid fa-arrow-up"></i>
    </div>
    <div>
      <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Saídas / Baixas Hoje</div>
      <div style="font-size: 1.4rem; font-weight: 800; color: #B91C1C; line-height: 1.2;">
        -<%= estatisticas.saidasHoje %> <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">unidades</span>
      </div>
    </div>
  </div>

</div>

<!-- Grade Principal: Formulário de Lançamento (Esquerda) vs Empréstimos Ativos (Direita) -->
<div class="balcao-layout-grid">
  
  <!-- COLUNA 1: FORMULÁRIO DE ATENDIMENTO E LANÇAMENTO -->
  <div class="table-card" style="padding: 1.5rem;">
    <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
      <i class="fa-solid fa-cash-register" style="color: var(--primary);"></i> Novo Lançamento no Balcão
    </h3>

<%
  const nivelBalcao = (typeof usuarioLogado !== 'undefined' && usuarioLogado) ? usuarioLogado.nivel_acesso : '';
  const isOperadorFichasBalcao = nivelBalcao === 'OPERADOR_FICHAS';
  const podeEntradaEstoqueBalcao = ['ADMIN', 'ALMOXARIFE'].includes(nivelBalcao);
  const tipoEfetivoBalcao = (isOperadorFichasBalcao && tipoPreSelecionado === 'ENTRADA') ? 'SAIDA' : tipoPreSelecionado;
%>
    <form action="/balcao/registrar" method="POST" id="form-balcao">
      
      <!-- Seletor Interativo dos Tipos de Operação -->
      <div style="margin-bottom: 1.25rem;">
        <label class="form-label" style="margin-bottom: 0.5rem; display: block;">
          Natureza da Operação:
        </label>
        
        <input type="hidden" name="tipo" id="input-tipo-operacao" value="<%= tipoEfetivoBalcao %>">
        
        <div class="balcao-types-grid" id="grid-tipos-operacao">
          
          <!-- Saída -->
          <button type="button" class="btn-tipo-op <%= tipoEfetivoBalcao === 'SAIDA' ? 'ativo' : '' %>" data-tipo="SAIDA" data-cor="#EF4444" data-titulo="Saída de Consumo" onclick="selecionarTipo('SAIDA', this)">
            <i class="fa-solid fa-arrow-up"></i>
            <span>Saída</span>
          </button>

          <!-- Empréstimo -->
          <button type="button" class="btn-tipo-op <%= tipoEfetivoBalcao === 'EMPRESTIMO' ? 'ativo' : '' %>" data-tipo="EMPRESTIMO" data-cor="#F59E0B" data-titulo="Empréstimo de Ferramenta" onclick="selecionarTipo('EMPRESTIMO', this)">
            <i class="fa-solid fa-hand-holding-hand"></i>
            <span>Empréstimo</span>
          </button>

          <!-- Devolução -->
          <button type="button" class="btn-tipo-op <%= tipoEfetivoBalcao === 'DEVOLUCAO' ? 'ativo' : '' %>" data-tipo="DEVOLUCAO" data-cor="#06B6D4" data-titulo="Devolução de Ferramenta" onclick="selecionarTipo('DEVOLUCAO', this)">
            <i class="fa-solid fa-rotate-left"></i>
            <span>Devolução</span>
          </button>

          <% if (podeEntradaEstoqueBalcao) { %>
            <!-- Entrada -->
            <button type="button" class="btn-tipo-op <%= tipoEfetivoBalcao === 'ENTRADA' ? 'ativo' : '' %>" data-tipo="ENTRADA" data-cor="#10B981" data-titulo="Entrada / Reposição" onclick="selecionarTipo('ENTRADA', this)">
              <i class="fa-solid fa-arrow-down"></i>
              <span>Entrada</span>
            </button>
          <% } %>

          <!-- Troca -->
          <button type="button" class="btn-tipo-op <%= tipoEfetivoBalcao === 'TROCA' ? 'ativo' : '' %>" data-tipo="TROCA" data-cor="#8B5CF6" data-titulo="Troca de Produto" onclick="selecionarTipo('TROCA', this)">
            <i class="fa-solid fa-repeat"></i>
            <span>Troca</span>
          </button>

        </div>
      </div>

      <!-- Banner Informativo da Operação Selecionada -->
      <div id="banner-tipo-info" style="padding: 0.65rem 0.85rem; border-radius: 6px; font-size: 0.8rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem; background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA;">
        <i class="fa-solid fa-circle-info" id="icone-banner-info"></i>
        <span id="texto-banner-info">Saída de material do almoxarifado (consumo, requisição de obra ou descarte).</span>
      </div>

      <!-- Atalho Rápido para Devolução de Empréstimos Ativos -->
      <div id="box-atalho-devolucao" style="display: <%= tipoPreSelecionado === 'DEVOLUCAO' ? 'block' : 'none' %>; margin-bottom: 1.25rem; padding: 0.85rem; background: #ECFEFF; border: 1px solid #A5F3FC; border-radius: 8px;">
        <label class="form-label" style="color: #0E7490; font-weight: 700; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.35rem;">
          <i class="fa-solid fa-list-check"></i> Selecione o Empréstimo Ativo a ser Devolvido (Opcional):
        </label>
        <% if (emprestimosPendentes && emprestimosPendentes.length > 0) { %>
          <select id="select-emprestimo-origem" class="form-select" onchange="preencherDevolucao(this.value)">
            <option value="">-- Selecione para preencher automaticamente --</option>
            <% emprestimosPendentes.forEach(emp => { %>
              <option value="<%= emp.id %>" data-prodid="<%= emp.produto_id %>" data-qtd="<%= emp.quantidade %>" data-colab="<%= emp.colaborador || emp.responsavel %>" data-doc="DEV-MOV-<%= String(emp.id).padStart(4, '0') %>">
                [MOV-<%= String(emp.id).padStart(4, '0') %>] <%= emp.produto_nome %> • <%= emp.quantidade %> UN com <%= emp.colaborador || emp.responsavel %>
              </option>
            <% }) %>
          </select>
        <% } else { %>
          <div style="font-size: 0.8rem; color: #0E7490;">
            Não há ferramentas emprestadas em aberto no momento. Você pode registrar uma devolução manual avulsa abaixo.
          </div>
        <% } %>
      </div>

      <!-- Seleção do Produto com Campo de Busca e Digitação Rápida -->
      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label class="form-label" for="balcao-produto-busca">
          Produto / Ferramenta <span style="color: var(--danger);">*</span>
          <small style="color: var(--text-muted); font-weight: normal; margin-left: 0.25rem;">(Digite para autocompletar e filtrar)</small>
        </label>
        
        <div style="position: relative;" id="balcao-combobox-wrapper">
          <div style="position: relative; display: flex; align-items: center;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 1rem; color: var(--text-dim); pointer-events: none; z-index: 2;"></i>
            
            <input 
              type="text" 
              id="balcao-produto-busca" 
              class="form-control" 
              placeholder="Digite o nome, código SKU ou marca para buscar..." 
              autocomplete="off"
              style="padding-left: 2.5rem; padding-right: 2.5rem; font-weight: 600; height: 46px;"
              value="<%= produtoPreSelecionado ? `[${produtoPreSelecionado.sku}] ${produtoPreSelecionado.nome}${produtoPreSelecionado.marca ? ' (' + produtoPreSelecionado.marca + ')' : ''}` : '' %>"
              required
            >

            <button 
              type="button" 
              id="btn-limpar-produto-busca" 
              title="Limpar seleção e buscar outro item"
              onclick="limparProdutoSelecionado()"
              style="position: absolute; right: 0.6rem; background: transparent; border: none; color: var(--text-dim); cursor: pointer; display: <%= produtoPreSelecionado ? 'flex' : 'none' %>; width: 32px; height: 32px; align-items: center; justify-content: center; border-radius: 50%;"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <!-- Dropdown Flutuante de Resultados -->
          <div id="balcao-produto-dropdown" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #ffffff; border: 1.5px solid var(--border-color); border-radius: 8px; box-shadow: 0 12px 28px rgba(0,0,0,0.12); max-height: 290px; overflow-y: auto; z-index: 1050; padding: 0.35rem 0;">
            <!-- Itens filtrados serão injetados aqui -->
          </div>

          <!-- Input oculto com o produto_id selecionado -->
          <input type="hidden" name="produto_id" id="balcao-produto-id" value="<%= produtoPreSelecionado ? produtoPreSelecionado.id : '' %>" required>
        </div>

        <!-- Detalhe do Produto Selecionado -->
        <div id="detalhe-produto-box" style="display: <%= produtoPreSelecionado ? 'flex' : 'none' %>; align-items: center; justify-content: space-between; margin-top: 0.5rem; padding: 0.65rem 0.85rem; background: var(--bg-main); border-radius: 6px; border: 1px solid var(--border-light); font-size: 0.82rem;">
          <div style="display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;">
            <span id="detalhe-produto-sku" class="badge" style="background: var(--bg-surface); border: 1px solid var(--border-light); font-weight: 700; font-family: var(--font-mono);">
              <%= produtoPreSelecionado ? produtoPreSelecionado.sku : '' %>
            </span>
            <span id="detalhe-produto-cat" style="color: var(--text-muted);">
              <%= produtoPreSelecionado ? produtoPreSelecionado.categoria : '' %><%= (produtoPreSelecionado && produtoPreSelecionado.marca) ? ` • ${produtoPreSelecionado.marca}` : '' %>
            </span>
            <% if (produtoPreSelecionado && produtoPreSelecionado.localizacao) { %>
              <span id="detalhe-produto-loc" style="color: var(--text-dim); font-size: 0.78rem;">
                <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> <%= produtoPreSelecionado.localizacao %>
              </span>
            <% } else { %>
              <span id="detalhe-produto-loc" style="color: var(--text-dim); font-size: 0.78rem; display: none;"></span>
            <% } %>
          </div>
          <div>
            Saldo Atual: <strong id="detalhe-produto-saldo" style="color: <%= (produtoPreSelecionado && produtoPreSelecionado.quantidade <= 0) ? 'var(--danger)' : 'var(--primary)' %>; font-size: 1rem;">
              <%= produtoPreSelecionado ? produtoPreSelecionado.quantidade : 0 %> <%= produtoPreSelecionado ? (produtoPreSelecionado.unidade_medida || 'UN') : '' %>
            </strong>
          </div>
        </div>

        <!-- Banner de Alerta: Produto com Estoque ZERADO -->
        <div id="alerta-estoque-zerado" style="display: none; margin-top: 0.65rem; padding: 0.85rem 1rem; background: #FEF2F2; border: 1.5px solid #F87171; border-radius: 8px; color: #991B1B; font-size: 0.84rem; line-height: 1.45;">
          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.35rem; color: #DC2626; margin-top: 2px; flex-shrink: 0;"></i>
            <div style="flex: 1;">
              <div style="font-weight: 800; font-size: 0.92rem; color: #B91C1C; margin-bottom: 3px; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                <span>PRODUTO COM ESTOQUE ZERADO</span>
                <span class="badge" style="background: #DC2626; color: #ffffff; font-size: 0.72rem; padding: 2px 7px;">0 DISPONÍVEL</span>
              </div>
              <div style="color: #7F1D1D;" id="texto-alerta-zerado">
                Não é permitido registrar <strong>Saída</strong>, <strong>Empréstimo</strong> ou <strong>Troca</strong> deste item porque não há unidades físicas em estoque.
              </div>
              <% if (podeEntradaEstoqueBalcao) { %>
              <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed #FECACA; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-size: 0.8rem; color: #64748B;">
                  Precisa abastecer o almoxarifado?
                </span>
                <button type="button" class="btn btn-sm" onclick="alternarParaEntrada()" style="background: #10B981; color: #ffffff; border: none; font-weight: 700; font-size: 0.78rem; padding: 0.35rem 0.75rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer;">
                  <i class="fa-solid fa-arrow-down"></i> Mudar para Entrada / Reposição
                </button>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Banner de Alerta: Quantidade Solicitada Maior que Estoque -->
        <div id="alerta-saldo-insuficiente" style="display: none; margin-top: 0.65rem; padding: 0.85rem 1rem; background: #FFFBEB; border: 1.5px solid #FBBF24; border-radius: 8px; color: #92400E; font-size: 0.84rem; line-height: 1.45;">
          <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <i class="fa-solid fa-circle-exclamation" style="font-size: 1.35rem; color: #D97706; margin-top: 2px; flex-shrink: 0;"></i>
            <div style="flex: 1;">
              <strong style="display: block; font-size: 0.92rem; color: #B45309; margin-bottom: 2px;">
                Quantidade Solicitada Excede o Estoque Disponível!
              </strong>
              <div id="texto-alerta-saldo-insuficiente" style="color: #78350F;">
                O saldo atual é menor do que a quantidade solicitada.
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quantidade e Botões Rápidos -->
      <div class="form-group" style="margin-bottom: 1rem;">
        <label class="form-label" for="balcao-quantidade-input">
          Quantidade a Movimentar <span style="color: var(--danger);">*</span>
        </label>
        <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap;">
          <!-- Stepper Fácil de Tocar no Mobile -->
          <div class="stepper-box">
            <button type="button" class="stepper-btn" onclick="ajustarQtdRelativo(-1)" title="Diminuir 1">-</button>
            <input 
              type="number" 
              id="balcao-quantidade-input" 
              name="quantidade" 
              class="stepper-input" 
              min="1" 
              value="1" 
              required
            >
            <button type="button" class="stepper-btn" onclick="ajustarQtdRelativo(1)" title="Aumentar 1">+</button>
          </div>

          <!-- Botões Rápidos -->
          <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
            <button type="button" class="btn btn-outline btn-sm" onclick="ajustarQtd(1)">+1</button>
            <button type="button" class="btn btn-outline btn-sm" onclick="ajustarQtd(2)">+2</button>
            <button type="button" class="btn btn-outline btn-sm" onclick="ajustarQtd(5)">+5</button>
            <button type="button" class="btn btn-outline btn-sm" onclick="ajustarQtd(10)">+10</button>
          </div>
        </div>
      </div>

      <!-- Colaborador e Responsável -->
      <div class="form-row-responsive">
        <!-- Seleção de Colaborador com Campo de Busca e Dropdown Inteligente -->
        <div class="form-group" style="position: relative;" id="balcao-colaborador-wrapper">
          <label class="form-label" for="balcao-colaborador-busca" id="label-colaborador">
            Colaborador / Solicitante <% if (isOperadorFichasBalcao) { %><span style="color: var(--danger);">*</span><% } %> <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">(Digite para autocompletar e filtrar)</span>
          </label>
          
          <div style="position: relative; display: flex; align-items: center;">
            <i class="fa-solid fa-user" style="position: absolute; left: 1rem; color: var(--text-dim); pointer-events: none; z-index: 2;"></i>
            
            <input 
              type="text" 
              id="balcao-colaborador-busca" 
              class="form-control" 
              placeholder="Digite o nome, matrícula ou cargo do colaborador..." 
              autocomplete="off"
              style="padding-left: 2.5rem; padding-right: 2.5rem; font-weight: 600; height: 46px;"
              value="<%= typeof colaboradorPreSelecionado !== 'undefined' && colaboradorPreSelecionado ? `${colaboradorPreSelecionado.nome}${colaboradorPreSelecionado.matricula ? ' (' + colaboradorPreSelecionado.matricula + ')' : ''}` : '' %>"
            >

            <button 
              type="button" 
              id="btn-limpar-colaborador-busca" 
              title="Limpar seleção e buscar outro colaborador"
              onclick="limparColaboradorSelecionado()"
              style="position: absolute; right: 0.6rem; background: transparent; border: none; color: var(--text-dim); cursor: pointer; display: <%= (typeof colaboradorPreSelecionado !== 'undefined' && colaboradorPreSelecionado) ? 'flex' : 'none' %>; width: 32px; height: 32px; align-items: center; justify-content: center; border-radius: 50%;"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <!-- Dropdown Flutuante de Colaboradores -->
          <div id="balcao-colaborador-dropdown" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #ffffff; border: 1.5px solid var(--border-color); border-radius: 8px; box-shadow: 0 12px 28px rgba(0,0,0,0.12); max-height: 290px; overflow-y: auto; z-index: 1050; padding: 0.35rem 0;">
            <!-- Itens de colaboradores filtrados serão injetados via JS -->
          </div>

          <!-- Inputs ocultos para submissão do formulário -->
          <input type="hidden" name="colaborador" id="balcao-colaborador-input" value="<%= typeof colaboradorPreSelecionado !== 'undefined' && colaboradorPreSelecionado ? colaboradorPreSelecionado.nome : '' %>">
          <input type="hidden" name="colaborador_id" id="balcao-colaborador-id" value="<%= typeof colaboradorPreSelecionado !== 'undefined' && colaboradorPreSelecionado ? colaboradorPreSelecionado.id : '' %>">

          <!-- Badge Interativo: Ficha Vinculada -->
          <div id="badge-ficha-vinculada" style="margin-top: 0.5rem; font-size: 0.8rem; display: <%= typeof colaboradorPreSelecionado !== 'undefined' && colaboradorPreSelecionado ? 'flex' : 'none' %>; align-items: center; justify-content: space-between; background: #EEF2FF; border: 1px solid #C7D2FE; padding: 0.45rem 0.75rem; border-radius: 6px; color: #3730A3;">
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <i class="fa-solid fa-file-invoice"></i>
              <span>Ficha vinculada: <strong><span id="nome-colaborador-ficha-badge"><%= typeof colaboradorPreSelecionado !== 'undefined' && colaboradorPreSelecionado ? colaboradorPreSelecionado.nome : '' %></span></strong></span>
            </div>
            <a href="<%= typeof colaboradorPreSelecionado !== 'undefined' && colaboradorPreSelecionado ? '/fichas?colaborador_id=' + colaboradorPreSelecionado.id : '#' %>" id="link-ver-ficha-balcao" target="_blank" style="font-weight: 700; color: #4F46E5; text-decoration: underline; font-size: 0.76rem;">
              Ver Ficha <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.7rem;"></i>
            </a>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="balcao-responsavel-input">
            Atendente do Almoxarifado
          </label>
          <input 
            type="text" 
            id="balcao-responsavel-input" 
            name="responsavel" 
            class="form-control" 
            list="lista-atendentes-sistema"
            value="<%= (typeof usuarioLogado !== 'undefined' && usuarioLogado) ? usuarioLogado.nome : '' %>"
            placeholder="Nome do almoxarife"
            autocomplete="off"
          >
          <datalist id="lista-atendentes-sistema">
            <% if (typeof colaboradores !== 'undefined' && colaboradores && colaboradores.length > 0) { %>
              <% colaboradores.filter(col => col.tipo_perfil === 'SISTEMA').forEach(col => { %>
                <option value="<%= col.nome %>"><%= col.cargo %> (<%= col.nivel_acesso %>)</option>
              <% }) %>
            <% } %>
          </datalist>
        </div>
      </div>

      <!-- Motivo e Documento de Referência -->
      <div class="form-row-responsive">
        <div class="form-group">
          <label class="form-label" for="balcao-motivo-input">
            Motivo / Justificativa / Finalidade
          </label>
          <input 
            type="text" 
            id="balcao-motivo-input" 
            name="motivo" 
            class="form-control" 
            placeholder="Ex: Manutenção no canteiro de obras, uso na sala técnica..."
          >
        </div>

        <div class="form-group">
          <label class="form-label" for="balcao-doc-input">
            Nº Documento / O.S / Requisição
          </label>
          <input 
            type="text" 
            id="balcao-doc-input" 
            name="documento_ref" 
            class="form-control" 
            placeholder="Ex: OS-2026-08, REQ-44..."
          >
        </div>
      </div>

      <input type="hidden" name="movimentacao_origem_id" id="balcao-origem-id" value="">

      <!-- Botão de Ação -->
      <button type="submit" class="btn btn-primary" id="btn-submit-balcao" style="width: 100%; padding: 0.75rem; font-size: 1rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
        <i class="fa-solid fa-check"></i> <span id="btn-submit-texto">Confirmar Saída no Balcão</span>
      </button>

    </form>
  </div>

  <!-- COLUNA 2: PAINEL DE FERRAMENTAS EMPRESTADAS (EM ABERTO) -->
  <div class="table-card" style="padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: #B45309; display: flex; align-items: center; gap: 0.5rem; margin: 0;">
        <i class="fa-solid fa-hand-holding-hand" style="color: #F59E0B;"></i> Empréstimos Ativos
      </h3>
      <span class="badge" style="background: #FEF3C7; color: #B45309; font-weight: 700; font-size: 0.75rem;">
        <%= emprestimosPendentes.length %> pendente(s)
      </span>
    </div>

    <% if (emprestimosPendentes && emprestimosPendentes.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 0.85rem; max-height: 580px; overflow-y: auto; padding-right: 0.25rem;">
        <% emprestimosPendentes.forEach(emp => { %>
          <div style="padding: 0.95rem; border: 1px solid #FDE68A; background: #FFFBEB; border-radius: 8px; transition: all 0.2s ease;">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.35rem;">
              <strong style="color: #92400E; font-size: 0.92rem; line-height: 1.3;">
                <%= emp.produto_nome %>
              </strong>
              <span class="badge" style="background: #ffffff; color: #B45309; border: 1px solid #FCD34D; font-size: 0.72rem; white-space: nowrap;">
                <%= emp.quantidade %> <%= emp.produto_unidade || 'UN' %>
              </span>
            </div>

            <div style="font-size: 0.78rem; color: #78350F; margin-bottom: 0.6rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
              <span><i class="fa-solid fa-barcode"></i> <%= emp.produto_sku %></span>
              <span><i class="fa-solid fa-user"></i> <strong><%= emp.colaborador || emp.responsavel %></strong></span>
              <span><i class="fa-regular fa-clock"></i> <span class="data-hora-local" data-timestamp="<%= emp.criado_em %>"><%= formatDate(emp.criado_em) %></span></span>
            </div>

            <% if (emp.motivo) { %>
              <div style="font-size: 0.75rem; color: #92400E; font-style: italic; margin-bottom: 0.65rem;">
                "<%= emp.motivo %>"
              </div>
            <% } %>

            <!-- Botão de Devolução Rápida -->
            <form action="/balcao/devolver/<%= emp.id %>" method="POST" onsubmit="return confirm('Confirmar a devolução de <%= emp.quantidade %>x <%= emp.produto_nome %> entregue por <%= emp.colaborador || emp.responsavel %>? O saldo será restaurado no inventário.')">
              <input type="hidden" name="responsavel" value="<%= (typeof usuarioLogado !== 'undefined' && usuarioLogado) ? usuarioLogado.nome : '' %>">
              <button type="submit" class="btn btn-sm" style="width: 100%; background: #059669; color: #ffffff; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.4rem; border: none; padding: 0.45rem;">
                <i class="fa-solid fa-rotate-left"></i> Dar Baixa (Devolver ao Estoque)
              </button>
            </form>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
        <div style="font-size: 2.5rem; color: #10B981; margin-bottom: 0.75rem;">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <strong style="color: var(--text-main); font-size: 0.95rem; display: block; margin-bottom: 0.25rem;">
          Nenhuma ferramenta emprestada em aberto!
        </strong>
        <p style="font-size: 0.8rem; margin: 0;">
          Todas as ferramentas estão guardadas e disponíveis no inventário físico do almoxarifado.
        </p>
      </div>
    <% } %>

  </div>

</div>

<!-- Histórico Recente de Atendimentos no Balcão -->
<div class="table-card">
  <div style="padding: 1.25rem; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
    <h3 style="font-size: 0.98rem; font-weight: 700; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
      <i class="fa-solid fa-clock-rotate-left" style="color: var(--primary);"></i> Últimos Atendimentos no Balcão
    </h3>
    <a href="/movimentacoes" class="btn btn-outline btn-sm">Ver Extrato Completo</a>
  </div>

  <!-- Tabela para Desktop -->
  <div class="desktop-only table-responsive">
    <table class="fixoria-table">
      <thead>
        <tr>
          <th>CÓDIGO</th>
          <th>TIPO DE OPERAÇÃO</th>
          <th>MATERIAL / ITEM</th>
          <th>QUANTIDADE</th>
          <th>COLABORADOR / RESPONSÁVEL</th>
          <th>DATA & HORA</th>
          <th>DOC / NOTA</th>
        </tr>
      </thead>
      <tbody>
        <% if (ultimosAtendimentos && ultimosAtendimentos.length > 0) { %>
          <% ultimosAtendimentos.forEach(m => { %>
            <tr>
              <td>
                <span style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: var(--text-main);">
                  MOV-<%= String(m.id).padStart(4, '0') %>
                </span>
              </td>
              <td>
                <% if (m.tipo === 'ENTRADA') { %>
                  <span class="status-pill in-stock"><span class="status-dot-sm"></span> Entrada</span>
                <% } else if (m.tipo === 'SAIDA') { %>
                  <span class="status-pill out-of-stock"><span class="status-dot-sm"></span> Saída</span>
                <% } else if (m.tipo === 'EMPRESTIMO') { %>
                  <span class="status-pill" style="background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D;">
                    <i class="fa-solid fa-hand-holding-hand" style="font-size: 0.7rem;"></i> Empréstimo
                  </span>
                <% } else if (m.tipo === 'DEVOLUCAO') { %>
                  <span class="status-pill" style="background: #CFFAFE; color: #0E7490; border: 1px solid #A5F3FC;">
                    <i class="fa-solid fa-rotate-left" style="font-size: 0.7rem;"></i> Devolução
                  </span>
                <% } else if (m.tipo === 'TROCA') { %>
                  <span class="status-pill" style="background: #EDE9FE; color: #6D28D9; border: 1px solid #DDD6FE;">
                    <i class="fa-solid fa-repeat" style="font-size: 0.7rem;"></i> Troca
                  </span>
                <% } else { %>
                  <span class="status-pill"><%= m.tipo %></span>
                <% } %>
              </td>
              <td>
                <div style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;"><%= m.produto_nome %></div>
                <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);"><%= m.produto_sku %></div>
              </td>
              <td>
                <% if (m.tipo === 'ENTRADA' || m.tipo === 'DEVOLUCAO') { %>
                  <strong style="color: #059669;">+<%= m.quantidade %></strong>
                <% } else if (m.tipo === 'SAIDA' || m.tipo === 'EMPRESTIMO') { %>
                  <strong style="color: #DC2626;">-<%= m.quantidade %></strong>
                <% } else { %>
                  <strong><%= m.quantidade %></strong>
                <% } %>
                <small style="color: var(--text-muted);"><%= m.produto_unidade %></small>
              </td>
              <td>
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-main);">
                  <%= m.colaborador || m.responsavel %>
                </div>
                <% if (m.colaborador && m.responsavel && m.colaborador !== m.responsavel) { %>
                  <div style="font-size: 0.72rem; color: var(--text-dim);">Atendido por: <%= m.responsavel %></div>
                <% } %>
              </td>
              <td>
                <span class="data-hora-local" data-timestamp="<%= m.criado_em %>" style="font-size: 0.82rem; color: var(--text-muted);"><%= formatDate(m.criado_em) %></span>
              </td>
              <td>
                <% if (m.documento_ref) { %>
                  <span style="font-family: var(--font-mono); font-size: 0.75rem; background: var(--bg-surface); padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid var(--border-light);">
                    <%= m.documento_ref %>
                  </span>
                <% } else { %>
                  <span style="color: var(--text-dim);">-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">
              Nenhum atendimento registrado recentemente no balcão.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Cartões Otimizados para Celular (Mobile) -->
  <div class="mobile-only" style="flex-direction: column; gap: 0.65rem; padding: 0.85rem;">
    <% if (ultimosAtendimentos && ultimosAtendimentos.length > 0) { %>
      <% ultimosAtendimentos.forEach(m => { %>
        <div class="movement-mobile-card">
          <div class="movement-mobile-top">
            <span style="font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; color: var(--text-muted);">
              MOV-<%= String(m.id).padStart(4, '0') %>
            </span>
            <div>
              <% if (m.tipo === 'ENTRADA') { %>
                <span class="status-pill in-stock"><span class="status-dot-sm"></span> Entrada</span>
              <% } else if (m.tipo === 'SAIDA') { %>
                <span class="status-pill out-of-stock"><span class="status-dot-sm"></span> Saída</span>
              <% } else if (m.tipo === 'EMPRESTIMO') { %>
                <span class="status-pill" style="background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D;">
                  <i class="fa-solid fa-hand-holding-hand" style="font-size: 0.7rem;"></i> Empréstimo
                </span>
              <% } else if (m.tipo === 'DEVOLUCAO') { %>
                <span class="status-pill" style="background: #CFFAFE; color: #0E7490; border: 1px solid #A5F3FC;">
                  <i class="fa-solid fa-rotate-left" style="font-size: 0.7rem;"></i> Devolução
                </span>
              <% } else if (m.tipo === 'TROCA') { %>
                <span class="status-pill" style="background: #EDE9FE; color: #6D28D9; border: 1px solid #DDD6FE;">
                  <i class="fa-solid fa-repeat" style="font-size: 0.7rem;"></i> Troca
                </span>
              <% } %>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;">
            <div class="movement-mobile-prod">
              <%= m.produto_nome %>
              <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim); font-weight: normal;"><%= m.produto_sku %></div>
            </div>
            <div class="movement-mobile-qty">
              <% if (m.tipo === 'ENTRADA' || m.tipo === 'DEVOLUCAO') { %>
                <span style="color: #059669;">+<%= m.quantidade %></span>
              <% } else if (m.tipo === 'SAIDA' || m.tipo === 'EMPRESTIMO') { %>
                <span style="color: #DC2626;">-<%= m.quantidade %></span>
              <% } else { %>
                <span><%= m.quantidade %></span>
              <% } %>
              <small style="font-size: 0.7rem; color: var(--text-muted); font-weight: normal;"><%= m.produto_unidade %></small>
            </div>
          </div>

          <div class="movement-mobile-footer">
            <span><i class="fa-solid fa-user"></i> <%= m.colaborador || m.responsavel %></span>
            <span><i class="fa-regular fa-clock"></i> <span class="data-hora-local" data-timestamp="<%= m.criado_em %>"><%= formatDate(m.criado_em) %></span></span>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: 0.85rem;">
        Nenhum atendimento registrado recentemente no balcão.
      </div>
    <% } %>
  </div>
      </tbody>
    </table>
  </div>
</div>

<style>
  /* Botões dos 5 Tipos de Operação */
  .btn-tipo-op {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.75rem 0.4rem;
    background: #ffffff;
    border: 1.5px solid var(--border-light);
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-tipo-op i {
    font-size: 1.15rem;
  }
  .btn-tipo-op:hover {
    background: var(--bg-main);
    color: var(--text-main);
    transform: translateY(-1px);
  }
  .btn-tipo-op.ativo {
    color: #ffffff !important;
    border-color: transparent !important;
    box-shadow: 0 4px 10px rgba(0,0,0,0.12);
  }
  .btn-tipo-op[data-tipo="SAIDA"].ativo { background: #EF4444 !important; }
  .btn-tipo-op[data-tipo="EMPRESTIMO"].ativo { background: #F59E0B !important; }
  .btn-tipo-op[data-tipo="DEVOLUCAO"].ativo { background: #06B6D4 !important; }
  .btn-tipo-op[data-tipo="ENTRADA"].ativo { background: #10B981 !important; }
  .btn-tipo-op[data-tipo="TROCA"].ativo { background: #8B5CF6 !important; }
</style>

<script>
  const LISTA_COLABORADORES_BALCAO = <%- JSON.stringify(colaboradores || []) %>;
  const configTipos = {
    'SAIDA': {
      bg: '#FEF2F2',
      color: '#991B1B',
      border: '#FECACA',
      icone: 'fa-arrow-up',
      texto: 'Saída de material do almoxarifado (consumo de equipe, requisição de obra ou descarte).',
      btnTexto: 'Confirmar Saída no Balcão',
      btnCor: '#EF4444',
      labelColab: 'Colaborador / Solicitante <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">(Opcional - Padrão: Balcão)</span>'
    },
    'EMPRESTIMO': {
      bg: '#FFFBEB',
      color: '#92400E',
      border: '#FDE68A',
      icone: 'fa-hand-holding-hand',
      texto: 'Empréstimo de ferramenta ou equipamento para colaborador. Ficará em aberto até a devolução.',
      btnTexto: 'Confirmar Empréstimo de Ferramenta',
      btnCor: '#F59E0B',
      labelColab: 'Colaborador que Retirou a Ferramenta <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">(Opcional - Padrão: Balcão)</span>'
    },
    'DEVOLUCAO': {
      bg: '#ECFEFF',
      color: '#0E7490',
      border: '#A5F3FC',
      icone: 'fa-rotate-left',
      texto: 'Retorno de ferramenta emprestada. O estoque do almoxarifado será reabastecido.',
      btnTexto: 'Confirmar Devolução ao Estoque',
      btnCor: '#06B6D4',
      labelColab: 'Colaborador que Devolveu <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">(Opcional - Padrão: Balcão)</span>'
    },
    'ENTRADA': {
      bg: '#ECFDF5',
      color: '#065F46',
      border: '#A7F3D0',
      icone: 'fa-arrow-down',
      texto: 'Entrada ou reposição de mercadoria no almoxarifado (compras, nota fiscal ou recebimento).',
      btnTexto: 'Confirmar Entrada / Reposição',
      btnCor: '#10B981',
      labelColab: 'Fornecedor / Responsável pela Entrega <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">(Opcional - Padrão: Balcão)</span>'
    },
    'TROCA': {
      bg: '#F5F3FF',
      color: '#5B21B6',
      border: '#DDD6FE',
      icone: 'fa-repeat',
      texto: 'Troca de material/EPI com baixa no estoque físico do novo item entregue ao colaborador.',
      btnTexto: 'Confirmar Troca no Balcão (Baixa de Estoque)',
      btnCor: '#8B5CF6',
      labelColab: 'Colaborador que Solicitou a Troca <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">(Digite para autocompletar e filtrar)</span>'
    }
  };

  function selecionarTipo(tipo, btn) {
    document.getElementById('input-tipo-operacao').value = tipo;
    
    // Atualiza botões
    document.querySelectorAll('.btn-tipo-op').forEach(b => b.classList.remove('ativo'));
    btn.classList.add('ativo');

    const cfg = configTipos[tipo] || configTipos['SAIDA'];

    // Atualiza Banner
    const banner = document.getElementById('banner-tipo-info');
    banner.style.background = cfg.bg;
    banner.style.color = cfg.color;
    banner.style.borderColor = cfg.border;
    document.getElementById('icone-banner-info').className = `fa-solid ${cfg.icone}`;
    document.getElementById('texto-banner-info').textContent = cfg.texto;

    // Atualiza Botão Submit
    const btnSubmit = document.getElementById('btn-submit-balcao');
    btnSubmit.style.background = cfg.btnCor;
    btnSubmit.style.borderColor = cfg.btnCor;
    document.getElementById('btn-submit-texto').textContent = cfg.btnTexto;

    // Atualiza Label Colaborador
    document.getElementById('label-colaborador').innerHTML = `${cfg.labelColab}`;

    // Exibe/Oculta caixa de atalho para devolução
    const boxDev = document.getElementById('box-atalho-devolucao');
    if (boxDev) {
      boxDev.style.display = (tipo === 'DEVOLUCAO') ? 'block' : 'none';
    }

    // Revalida permissão de estoque com base no novo tipo selecionado
    if (typeof validarEstoqueOperacao === 'function') {
      validarEstoqueOperacao();
    }
  }

  function ajustarQtd(delta) {
    const input = document.getElementById('balcao-quantidade-input');
    const atual = parseInt(input.value, 10) || 0;
    input.value = Math.max(1, atual + delta);
    if (typeof validarEstoqueOperacao === 'function') {
      validarEstoqueOperacao();
    }
  }

  function ajustarQtdRelativo(delta) {
    ajustarQtd(delta);
  }

  function alternarParaEntrada() {
    const btnEntrada = document.querySelector('.btn-tipo-op[data-tipo="ENTRADA"]');
    if (btnEntrada) {
      selecionarTipo('ENTRADA', btnEntrada);
    }
  }

  // =========================================================================
  // SELETOR DE PRODUTOS INTELIGENTE COM BUSCA / AUTOCOMPLETE (COMBOBOX)
  // =========================================================================
  const LISTA_PRODUTOS = <%- JSON.stringify(produtos) %>;
  window.LISTA_PRODUTOS_BALCAO = LISTA_PRODUTOS;
  let itemFocadoIndex = -1;
  let itensFiltradosAtuais = [];

  const inputBusca = document.getElementById('balcao-produto-busca');
  const dropdown = document.getElementById('balcao-produto-dropdown');
  const inputHiddenId = document.getElementById('balcao-produto-id');
  const btnLimpar = document.getElementById('btn-limpar-produto-busca');
  const boxDetalhe = document.getElementById('detalhe-produto-box');

  function renderizarDropdownProdutos(termo = '') {
    const q = termo.trim().toLowerCase();
    
    if (!q) {
      itensFiltradosAtuais = LISTA_PRODUTOS;
    } else {
      itensFiltradosAtuais = LISTA_PRODUTOS.filter(p => {
        const nome = (p.nome || '').toLowerCase();
        const sku = (p.sku || '').toLowerCase();
        const marca = (p.marca || '').toLowerCase();
        const cat = (p.categoria || '').toLowerCase();
        const loc = (p.localizacao || '').toLowerCase();
        const tag = (p.tag || '').toLowerCase();
        const pat = (p.patrimonio || '').toLowerCase();
        return nome.includes(q) || sku.includes(q) || marca.includes(q) || cat.includes(q) || loc.includes(q) || tag.includes(q) || pat.includes(q);
      });
    }

    itemFocadoIndex = -1;

    if (itensFiltradosAtuais.length === 0) {
      dropdown.innerHTML = `
        <div style="padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.82rem;">
          <i class="fa-solid fa-magnifying-glass" style="margin-bottom: 0.35rem; display: block; font-size: 1.2rem; color: var(--border-color);"></i>
          Nenhum produto encontrado para "<strong>${termo}</strong>"
        </div>
      `;
      dropdown.style.display = 'block';
      return;
    }

    const html = itensFiltradosAtuais.map((p, idx) => {
      const temEstoque = Number(p.quantidade) > 0;
      return `
        <div class="combobox-item" data-index="${idx}" data-id="${p.id}" onclick="selecionarProdutoCombobox(${p.id})" style="padding: 0.65rem 0.95rem; border-bottom: 1px solid var(--border-light); cursor: pointer; transition: background 0.12s ease;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem;">
            <div style="flex: 1;">
              <div style="font-weight: 700; color: var(--text-main); font-size: 0.9rem;">
                ${p.nome}
                ${p.marca ? `<span style="font-size: 0.72rem; font-weight: 600; color: var(--primary); background: var(--primary-light); padding: 1px 6px; border-radius: 4px; margin-left: 0.3rem;">${p.marca}</span>` : ''}
              </div>
              <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 3px; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;">
                <span style="font-family: var(--font-mono); font-weight: 700; color: var(--text-body); background: var(--bg-surface); padding: 1px 5px; border-radius: 3px; border: 1px solid var(--border-color);">${p.sku}</span>
                <span>• ${p.categoria}</span>
                ${p.localizacao ? `<span>• <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> ${p.localizacao}</span>` : ''}
              </div>
            </div>
            <div style="text-align: right; flex-shrink: 0;">
              <span class="badge" style="background: ${temEstoque ? '#D1FAE5' : '#FEE2E2'}; color: ${temEstoque ? '#065F46' : '#991B1B'}; font-weight: 700; font-size: 0.78rem;">
                ${temEstoque ? `${p.quantidade} ${p.unidade_medida || 'UN'}` : `ZERADO (0 ${p.unidade_medida || 'UN'})`}
              </span>
            </div>
          </div>
        </div>
      `;
    }).join('');

    dropdown.innerHTML = html;
    dropdown.style.display = 'block';
  }

  function selecionarProdutoCombobox(produtoId) {
    const prod = LISTA_PRODUTOS.find(p => p.id === produtoId);
    if (!prod) return;

    inputHiddenId.value = prod.id;
    inputBusca.value = `[${prod.sku}] ${prod.nome}${prod.marca ? ' (' + prod.marca + ')' : ''}`;
    btnLimpar.style.display = 'flex';
    dropdown.style.display = 'none';

    // Atualiza caixa de detalhes abaixo
    document.getElementById('detalhe-produto-sku').textContent = prod.sku;
    document.getElementById('detalhe-produto-cat').textContent = `${prod.categoria}${prod.marca ? ' • ' + prod.marca : ''}`;
    
    const locSpan = document.getElementById('detalhe-produto-loc');
    if (prod.localizacao) {
      locSpan.innerHTML = `<i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> ${prod.localizacao}`;
      locSpan.style.display = 'inline-flex';
    } else {
      locSpan.style.display = 'none';
    }

    const saldoEl = document.getElementById('detalhe-produto-saldo');
    const isZerado = Number(prod.quantidade) <= 0;
    saldoEl.textContent = `${prod.quantidade} ${prod.unidade_medida || 'UN'}${isZerado ? ' (ZERADO)' : ''}`;
    saldoEl.style.color = isZerado ? 'var(--danger)' : 'var(--primary)';

    boxDetalhe.style.display = 'flex';

    if (typeof validarEstoqueOperacao === 'function') {
      validarEstoqueOperacao();
    }
  }

  function limparProdutoSelecionado() {
    inputHiddenId.value = '';
    inputBusca.value = '';
    btnLimpar.style.display = 'none';
    boxDetalhe.style.display = 'none';
    inputBusca.focus();
    renderizarDropdownProdutos('');
    if (typeof validarEstoqueOperacao === 'function') {
      validarEstoqueOperacao();
    }
  }

  // Interatividade com o input de busca
  inputBusca?.addEventListener('focus', () => {
    renderizarDropdownProdutos(inputHiddenId.value ? '' : inputBusca.value);
  });

  inputBusca?.addEventListener('input', (e) => {
    if (inputHiddenId.value) {
      inputHiddenId.value = '';
      boxDetalhe.style.display = 'none';
    }
    btnLimpar.style.display = e.target.value.trim() ? 'flex' : 'none';
    renderizarDropdownProdutos(e.target.value);
  });

  inputBusca?.addEventListener('keydown', (e) => {
    if (dropdown.style.display === 'none') {
      if (e.key === 'ArrowDown') {
        renderizarDropdownProdutos(inputBusca.value);
      }
      return;
    }

    const items = dropdown.querySelectorAll('.combobox-item');
    if (items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      itemFocadoIndex = (itemFocadoIndex + 1) % items.length;
      atualizarFocoCombobox(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      itemFocadoIndex = (itemFocadoIndex - 1 + items.length) % items.length;
      atualizarFocoCombobox(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (itemFocadoIndex >= 0 && items[itemFocadoIndex]) {
        const id = parseInt(items[itemFocadoIndex].getAttribute('data-id'), 10);
        selecionarProdutoCombobox(id);
      } else if (itensFiltradosAtuais.length > 0) {
        selecionarProdutoCombobox(itensFiltradosAtuais[0].id);
      }
    } else if (e.key === 'Escape') {
      dropdown.style.display = 'none';
    }
  });

  function atualizarFocoCombobox(items) {
    items.forEach((it, idx) => {
      if (idx === itemFocadoIndex) {
        it.style.background = '#f1f5f9';
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.style.background = '#ffffff';
      }
    });
  }

  // Fecha dropdown ao clicar fora
  document.addEventListener('click', (e) => {
    const wrapper = document.getElementById('balcao-combobox-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
      dropdown.style.display = 'none';
    }
  });

  function preencherDevolucao(emprestimoId) {
    if (!emprestimoId) return;

    const select = document.getElementById('select-emprestimo-origem');
    const opt = select.options[select.selectedIndex];
    if (!opt) return;

    const prodId = opt.getAttribute('data-prodid');
    const qtd = opt.getAttribute('data-qtd');
    const colab = opt.getAttribute('data-colab');
    const doc = opt.getAttribute('data-doc');

    if (prodId) {
      selecionarProdutoCombobox(parseInt(prodId, 10));
    }

    if (qtd) {
      document.getElementById('balcao-quantidade-input').value = qtd;
    }

    if (colab) {
      document.getElementById('balcao-colaborador-input').value = colab;
    }

    if (doc) {
      document.getElementById('balcao-doc-input').value = doc;
    }

    document.getElementById('balcao-origem-id').value = emprestimoId;
    document.getElementById('balcao-motivo-input').value = `Devolução de ferramenta emprestada (Ref: MOV-${String(emprestimoId).padStart(4, '0')})`;
    if (typeof validarEstoqueOperacao === 'function') {
      validarEstoqueOperacao();
    }
  }

  // =========================================================================
  // VALIDAÇÃO EM TEMPO REAL DE ESTOQUE ZERADO E SALDO DISPONÍVEL
  // =========================================================================
  function validarEstoqueOperacao() {
    const produtoId = document.getElementById('balcao-produto-id')?.value;
    const tipo = document.getElementById('input-tipo-operacao')?.value || 'SAIDA';
    const inputQtd = document.getElementById('balcao-quantidade-input');
    const qtd = parseInt(inputQtd?.value, 10) || 1;

    const alertaZerado = document.getElementById('alerta-estoque-zerado');
    const alertaInsuficiente = document.getElementById('alerta-saldo-insuficiente');
    const btnSubmit = document.getElementById('btn-submit-balcao');
    const btnSubmitTexto = document.getElementById('btn-submit-texto');
    const cfg = configTipos[tipo] || configTipos['SAIDA'];

    if (!produtoId) {
      if (alertaZerado) alertaZerado.style.display = 'none';
      if (alertaInsuficiente) alertaInsuficiente.style.display = 'none';
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.style.background = cfg.btnCor;
        btnSubmit.style.borderColor = cfg.btnCor;
        btnSubmit.style.cursor = 'pointer';
        btnSubmit.style.opacity = '1';
        if (btnSubmitTexto) btnSubmitTexto.textContent = cfg.btnTexto;
      }
      return true;
    }

    const prod = LISTA_PRODUTOS.find(p => String(p.id) === String(produtoId));
    if (!prod) return true;

    const saldo = Number(prod.quantidade);
    const un = prod.unidade_medida || 'UN';
    const isOperacaoSaida = (tipo === 'SAIDA' || tipo === 'EMPRESTIMO' || tipo === 'TROCA');
    const nomeOp = tipo === 'EMPRESTIMO' ? 'Empréstimo' : (tipo === 'TROCA' ? 'Troca' : 'Saída');

    if (isOperacaoSaida) {
      // Caso 1: Estoque Zerado ou Negativo
      if (saldo <= 0) {
        if (alertaZerado) alertaZerado.style.display = 'block';
        if (alertaInsuficiente) alertaInsuficiente.style.display = 'none';

        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.style.background = '#94A3B8';
          btnSubmit.style.borderColor = '#94A3B8';
          btnSubmit.style.cursor = 'not-allowed';
          btnSubmit.style.opacity = '0.9';
          if (btnSubmitTexto) {
            btnSubmitTexto.innerHTML = `<i class="fa-solid fa-ban" style="margin-right: 5px;"></i> Item Zerado — ${nomeOp} Bloqueada`;
          }
        }
        return false;
      }

      // Caso 2: Quantidade maior que o saldo em estoque
      if (qtd > saldo) {
        if (alertaZerado) alertaZerado.style.display = 'none';
        if (alertaInsuficiente) {
          alertaInsuficiente.style.display = 'block';
          const txt = document.getElementById('texto-alerta-saldo-insuficiente');
          if (txt) {
            txt.innerHTML = `O item possui apenas <strong>${saldo} ${un}</strong> disponíveis em estoque, mas foi solicitada a ${tipo === 'EMPRESTIMO' ? 'saída por empréstimo' : (tipo === 'TROCA' ? 'troca com baixa' : 'baixa')} de <strong>${qtd} ${un}</strong>. Reduza a quantidade para continuar.`;
          }
        }

        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.style.background = '#F59E0B';
          btnSubmit.style.borderColor = '#F59E0B';
          btnSubmit.style.cursor = 'not-allowed';
          btnSubmit.style.opacity = '0.9';
          if (btnSubmitTexto) {
            btnSubmitTexto.innerHTML = `<i class="fa-solid fa-triangle-exclamation" style="margin-right: 5px;"></i> Saldo Insuficiente (${saldo} ${un} disponíveis)`;
          }
        }
        return false;
      }

      // Caso 3: Saldo OK para Saída/Empréstimo/Troca
      if (alertaZerado) alertaZerado.style.display = 'none';
      if (alertaInsuficiente) alertaInsuficiente.style.display = 'none';

      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.style.background = cfg.btnCor;
        btnSubmit.style.borderColor = cfg.btnCor;
        btnSubmit.style.cursor = 'pointer';
        btnSubmit.style.opacity = '1';
        if (btnSubmitTexto) btnSubmitTexto.textContent = cfg.btnTexto;
      }
      return true;
    } else {
      // Para Entrada ou Devolução (operações que abastecem o estoque)
      if (alertaZerado) alertaZerado.style.display = 'none';
      if (alertaInsuficiente) alertaInsuficiente.style.display = 'none';

      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.style.background = cfg.btnCor;
        btnSubmit.style.borderColor = cfg.btnCor;
        btnSubmit.style.cursor = 'pointer';
        btnSubmit.style.opacity = '1';
        if (btnSubmitTexto) btnSubmitTexto.textContent = cfg.btnTexto;
      }
      return true;
    }
  }

  // Ouve alterações no input numérico de quantidade
  document.getElementById('balcao-quantidade-input')?.addEventListener('input', () => {
    validarEstoqueOperacao();
  });

  // Intercepta envio do formulário para garantir que itens zerados não saiam
  document.getElementById('form-balcao')?.addEventListener('submit', (e) => {
    const produtoId = document.getElementById('balcao-produto-id')?.value;
    const tipo = document.getElementById('input-tipo-operacao')?.value;
    const inputQtd = document.getElementById('balcao-quantidade-input');
    const qtd = parseInt(inputQtd?.value, 10) || 1;

    if (!produtoId) {
      e.preventDefault();
      alert('Por favor, selecione um produto no campo de busca para continuar.');
      document.getElementById('balcao-produto-busca')?.focus();
      return false;
    }

    const prod = LISTA_PRODUTOS.find(p => String(p.id) === String(produtoId));
    if (prod && (tipo === 'SAIDA' || tipo === 'EMPRESTIMO' || tipo === 'TROCA')) {
      const saldo = Number(prod.quantidade);
      const un = prod.unidade_medida || 'UN';
      const op = tipo === 'EMPRESTIMO' ? 'empréstimo' : (tipo === 'TROCA' ? 'troca' : 'saída');

      if (saldo <= 0) {
        e.preventDefault();
        alert(`❌ Operação Não Permitida!\n\nO produto "${prod.nome}" está com estoque ZERADO (0 ${un}).\n\nNão é permitido realizar ${op} de itens zerados.\nCaso tenha recebido novas unidades, selecione a operação "Entrada" para reabastecer.`);
        return false;
      }

      if (qtd > saldo) {
        e.preventDefault();
        alert(`❌ Saldo Insuficiente!\n\nVocê solicitou ${qtd} ${un}, mas há apenas ${saldo} ${un} disponíveis em estoque.`);
        inputQtd?.focus();
        return false;
      }
    }
  });

  // =========================================================================
  // SELETOR DE COLABORADOR INTELIGENTE COM BUSCA / DROPDOWN (COMBOBOX)
  // =========================================================================
  let colabFocadoIndex = -1;
  let colabsFiltradosAtuais = [];

  const inputBuscaColab = document.getElementById('balcao-colaborador-busca');
  const dropdownColab = document.getElementById('balcao-colaborador-dropdown');
  const inputHiddenColabNome = document.getElementById('balcao-colaborador-input');
  const inputHiddenColabId = document.getElementById('balcao-colaborador-id');
  const btnLimparColab = document.getElementById('btn-limpar-colaborador-busca');
  const badgeFicha = document.getElementById('badge-ficha-vinculada');
  const nomeColabFicha = document.getElementById('nome-colaborador-ficha-badge');
  const linkFichaBalcao = document.getElementById('link-ver-ficha-balcao');

  function renderizarDropdownColaboradores(termo = '') {
    const q = termo.trim().toLowerCase();

    if (!q) {
      colabsFiltradosAtuais = LISTA_COLABORADORES_BALCAO;
    } else {
      colabsFiltradosAtuais = LISTA_COLABORADORES_BALCAO.filter(c => {
        const nome = (c.nome || '').toLowerCase();
        const mat = (c.matricula || '').toLowerCase();
        const cargo = (c.cargo || '').toLowerCase();
        const dep = (c.departamento || '').toLowerCase();
        return nome.includes(q) || mat.includes(q) || cargo.includes(q) || dep.includes(q);
      });
    }

    colabFocadoIndex = -1;

    let html = '';

    // Opção padrão para Balcão Geral
    if (!q || 'balcão balcao geral'.includes(q)) {
      html += `
        <div class="combobox-colab-item" data-index="-1" onclick="selecionarColaboradorCombobox(null)" style="padding: 0.65rem 0.95rem; border-bottom: 1px solid var(--border-light); cursor: pointer; transition: background 0.12s ease; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; background: #F8FAFC;">
          <div style="display: flex; align-items: center; gap: 0.65rem;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #E2E8F0; color: #475569; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">
              <i class="fa-solid fa-store"></i>
            </div>
            <div>
              <div style="font-weight: 700; color: var(--text-main); font-size: 0.88rem;">Balcão Geral (Sem Vínculo)</div>
              <div style="font-size: 0.74rem; color: var(--text-muted);">Atendimento direto sem debitar na ficha pessoal</div>
            </div>
          </div>
          <span class="badge" style="background: #F1F5F9; color: #64748B; font-size: 0.72rem;">PADRÃO</span>
        </div>
      `;
    }

    if (colabsFiltradosAtuais.length === 0 && (!q || !'balcão balcao geral'.includes(q))) {
      dropdownColab.innerHTML = `
        <div style="padding: 1rem; text-align: center; color: var(--text-muted); font-size: 0.82rem;">
          <i class="fa-solid fa-user-xmark" style="margin-bottom: 0.35rem; display: block; font-size: 1.2rem; color: var(--border-color);"></i>
          Nenhum colaborador encontrado para "<strong>${termo}</strong>"
        </div>
      `;
      dropdownColab.style.display = 'block';
      return;
    }

    html += colabsFiltradosAtuais.map((c, idx) => {
      const iniciais = (c.nome || 'C').split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
      const temPendencia = c.temPendencia || (c.ferramentasEmAberto && c.ferramentasEmAberto > 0);
      const qtdPend = c.ferramentasEmAberto || 0;
      const isSistema = c.tipo_perfil === 'SISTEMA';

      return `
        <div class="combobox-colab-item" data-index="${idx}" data-id="${c.id}" onclick="selecionarColaboradorCombobox(${c.id})" style="padding: 0.65rem 0.95rem; border-bottom: 1px solid var(--border-light); cursor: pointer; transition: background 0.12s ease;">
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
            <div style="display: flex; align-items: center; gap: 0.65rem;">
              <div style="width: 34px; height: 34px; border-radius: 50%; background: ${isSistema ? '#EDE9FE' : '#FEF3C7'}; color: ${isSistema ? '#6D28D9' : '#B45309'}; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.78rem; flex-shrink: 0;">
                ${iniciais}
              </div>
              <div>
                <div style="font-weight: 700; color: var(--text-main); font-size: 0.88rem;">
                  ${c.nome}
                </div>
                <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;">
                  <span style="font-family: var(--font-mono); font-weight: 700; color: var(--text-body); background: var(--bg-surface); padding: 1px 4px; border-radius: 3px; border: 1px solid var(--border-color);">${c.matricula || 'S/ MAT'}</span>
                  <span>• ${c.cargo || 'Função não inf.'}</span>
                  ${c.departamento ? `<span>(${c.departamento})</span>` : ''}
                </div>
              </div>
            </div>
            <div style="text-align: right; flex-shrink: 0;">
              <span class="badge" style="background: ${temPendencia ? '#FEF3C7' : '#D1FAE5'}; color: ${temPendencia ? '#92400E' : '#065F46'}; font-weight: 700; font-size: 0.72rem;">
                ${temPendencia ? `⚠️ ${qtdPend} com ele` : '✅ Regular'}
              </span>
            </div>
          </div>
        </div>
      `;
    }).join('');

    dropdownColab.innerHTML = html;
    dropdownColab.style.display = 'block';
  }

  function selecionarColaboradorCombobox(colabId) {
    if (colabId === null) {
      inputHiddenColabNome.value = 'Balcão';
      inputHiddenColabId.value = '';
      inputBuscaColab.value = 'Balcão Geral';
      btnLimparColab.style.display = 'flex';
      dropdownColab.style.display = 'none';
      if (badgeFicha) badgeFicha.style.display = 'none';
      return;
    }

    const colab = LISTA_COLABORADORES_BALCAO.find(c => c.id === colabId);
    if (!colab) return;

    inputHiddenColabNome.value = colab.nome;
    inputHiddenColabId.value = colab.id;
    inputBuscaColab.value = `${colab.nome}${colab.matricula ? ' (' + colab.matricula + ')' : ''}`;
    btnLimparColab.style.display = 'flex';
    dropdownColab.style.display = 'none';

    // Atualiza badge de ficha vinculada
    if (badgeFicha && nomeColabFicha && linkFichaBalcao) {
      nomeColabFicha.textContent = colab.nome;
      linkFichaBalcao.href = `/fichas?colaborador_id=${colab.id}`;
      badgeFicha.style.display = 'flex';
    }
  }

  function limparColaboradorSelecionado() {
    inputBuscaColab.value = '';
    inputHiddenColabNome.value = '';
    inputHiddenColabId.value = '';
    btnLimparColab.style.display = 'none';
    if (badgeFicha) badgeFicha.style.display = 'none';
    dropdownColab.style.display = 'none';
    inputBuscaColab.focus();
    renderizarDropdownColaboradores('');
  }

  // Eventos de teclado e clique para o campo de busca de colaborador
  if (inputBuscaColab) {
    inputBuscaColab.addEventListener('focus', () => {
      renderizarDropdownColaboradores(inputBuscaColab.value);
    });

    inputBuscaColab.addEventListener('input', (e) => {
      const val = e.target.value;
      btnLimparColab.style.display = val ? 'flex' : 'none';
      renderizarDropdownColaboradores(val);
      if (!val.trim()) {
        inputHiddenColabNome.value = '';
        inputHiddenColabId.value = '';
        if (badgeFicha) badgeFicha.style.display = 'none';
      } else {
        inputHiddenColabNome.value = val.trim();
      }
    });

    inputBuscaColab.addEventListener('keydown', (e) => {
      const items = dropdownColab.querySelectorAll('.combobox-colab-item');
      if (dropdownColab.style.display === 'none' && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
        renderizarDropdownColaboradores(inputBuscaColab.value);
        return;
      }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (items.length === 0) return;
        colabFocadoIndex = (colabFocadoIndex + 1) % items.length;
        atualizarFocoComboboxColab(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (items.length === 0) return;
        colabFocadoIndex = (colabFocadoIndex - 1 + items.length) % items.length;
        atualizarFocoComboboxColab(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (colabFocadoIndex >= 0 && items[colabFocadoIndex]) {
          const id = items[colabFocadoIndex].getAttribute('data-id');
          selecionarColaboradorCombobox(id ? parseInt(id, 10) : null);
        } else if (colabsFiltradosAtuais.length > 0) {
          selecionarColaboradorCombobox(colabsFiltradosAtuais[0].id);
        }
      } else if (e.key === 'Escape') {
        dropdownColab.style.display = 'none';
      }
    });
  }

  function atualizarFocoComboboxColab(items) {
    items.forEach((it, idx) => {
      if (idx === colabFocadoIndex) {
        it.style.background = '#f1f5f9';
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.style.background = '#ffffff';
      }
    });
  }

  // Fecha dropdown de colaborador ao clicar fora
  document.addEventListener('click', (e) => {
    const wrapper = document.getElementById('balcao-colaborador-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
      if (dropdownColab) dropdownColab.style.display = 'none';
    }
  });

  // Inicializa visual do tipo pré-selecionado
  window.addEventListener('DOMContentLoaded', () => {
    const tipoAtual = document.getElementById('input-tipo-operacao').value || 'SAIDA';
    const btnAtual = document.querySelector(`.btn-tipo-op[data-tipo="${tipoAtual}"]`);
    if (btnAtual) {
      selecionarTipo(tipoAtual, btnAtual);
    }
    // Valida imediatamente caso venha com produto pré-selecionado
    validarEstoqueOperacao();
  });
</script>

