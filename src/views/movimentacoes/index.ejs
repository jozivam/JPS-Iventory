<%- include('../layouts/header') %>

<% if (typeof sucesso !== 'undefined' && sucesso) { %>
  <div class="alert alert-success">
    <div><i class="fa-solid fa-circle-check"></i> <%= sucesso %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho Estilo Storaxe Timeline -->
<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Movimentações & Entregas</h2>
    <p>Histórico completo de entradas de fornecedores e baixas de consumo.</p>
  </div>

  <div class="page-actions-group">
    <a href="/movimentacoes/nova?tipo=SAIDA" class="btn btn-outline">
      <i class="fa-solid fa-arrow-up" style="color: var(--primary);"></i> Dar Baixa (Outbound)
    </a>
    <a href="/movimentacoes/nova?tipo=ENTRADA" class="btn btn-primary">
      <i class="fa-solid fa-arrow-down" style="color: #fff;"></i> Nova Entrada (Inbound)
    </a>
  </div>
</div>

<!-- Filtros de Linha do Tempo -->
<div class="fixoria-filter-bar">
  <form action="/movimentacoes" method="GET" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; width: 100%;">
    <div style="min-width: 220px; flex: 1;">
      <select name="produto_id" class="filter-select-pill" style="width: 100%;" onchange="this.form.submit()">
        <option value="">Todos os Materiais</option>
        <% produtos.forEach(p => { %>
          <option value="<%= p.id %>" <%= filtros.produto_id == p.id ? 'selected' : '' %>>
            [<%= p.sku %>] <%= p.nome %>
          </option>
        <% }) %>
      </select>
    </div>

    <div>
      <select name="tipo" class="filter-select-pill" onchange="this.form.submit()">
        <option value="">Todos os Tipos</option>
        <option value="ENTRADA" <%= filtros.tipo === 'ENTRADA' ? 'selected' : '' %>>Inbound (Entradas)</option>
        <option value="SAIDA" <%= filtros.tipo === 'SAIDA' ? 'selected' : '' %>>Outbound (Baixas)</option>
      </select>
    </div>

    <div style="display: flex; align-items: center; gap: 0.35rem;">
      <input type="date" name="data_inicio" class="filter-select-pill" value="<%= filtros.data_inicio || '' %>" title="Data Inicial">
      <span style="color: var(--text-dim); font-size: 0.8rem;">até</span>
      <input type="date" name="data_fim" class="filter-select-pill" value="<%= filtros.data_fim || '' %>" title="Data Final">
    </div>

    <button type="submit" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-filter"></i> Filtrar
    </button>

    <% if (filtros.produto_id || filtros.tipo || filtros.data_inicio || filtros.data_fim) { %>
      <a href="/movimentacoes" class="btn btn-outline btn-sm" title="Limpar Filtros">
        <i class="fa-solid fa-rotate-left"></i>
      </a>
    <% } %>
  </form>
</div>

<!-- Tabela de Movimentações Estilo Storaxe -->
<div class="table-card">
  <div class="table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>ID MOVIMENTAÇÃO</th>
          <th>TIPO</th>
          <th>MATERIAL / ITEM</th>
          <th>QUANTIDADE</th>
          <th>DATA & HORA</th>
          <th>RESPONSÁVEL</th>
          <th>DOC / NOTA</th>
        </tr>
      </thead>
      <tbody>
        <% if (movimentacoes && movimentacoes.length > 0) { %>
          <% movimentacoes.forEach(m => { %>
            <tr>
              <td>
                <div style="display: flex; align-items: center;">
                  <span class="direction-circle <%= m.tipo === 'ENTRADA' ? 'inbound' : 'outbound' %>">
                    <i class="fa-solid <%= m.tipo === 'ENTRADA' ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i>
                  </span>
                  <strong style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-main);">
                    MOV-<%= String(m.id).padStart(4, '0') %>
                  </strong>
                </div>
              </td>
              <td>
                <span class="status-pill <%= m.tipo === 'ENTRADA' ? 'in-stock' : 'low-stock' %>">
                  <span class="status-dot-sm"></span> <%= m.tipo === 'ENTRADA' ? 'Entrada' : 'Baixa' %>
                </span>
              </td>
              <td>
                <div style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;"><%= m.produto_nome %></div>
                <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);"><%= m.produto_sku %></div>
              </td>
              <td>
                <strong style="color: <%= m.tipo === 'ENTRADA' ? 'var(--teal)' : 'var(--text-main)' %>;">
                  <%= m.tipo === 'ENTRADA' ? '+' : '-' %><%= m.quantidade %>
                </strong> 
                <small style="color: var(--text-muted); font-size: 0.75rem;"><%= m.produto_unidade %></small>
              </td>
              <td>
                <span style="font-size: 0.82rem; color: var(--text-muted);"><%= formatDate(m.criado_em) %></span>
              </td>
              <td>
                <span style="font-size: 0.82rem; color: var(--text-body);"><%= m.responsavel %></span>
              </td>
              <td>
                <% if (m.documento_ref) { %>
                  <span style="font-family: var(--font-mono); font-size: 0.75rem; background: var(--bg-surface); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <%= m.documento_ref %>
                  </span>
                <% } else { %>
                  <span style="color: var(--text-dim);">-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);">
              Nenhuma movimentação registrada para os filtros selecionados.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>
