<%- include('../layouts/header') %>

<div style="max-width: 860px; margin: 0 auto;">
  <% if (typeof erro !== 'undefined' && erro) { %>
    <div class="alert alert-danger">
      <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
      <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% } %>

  <div class="page-header-flex">
    <div class="page-title-wrap">
      <h2>Registrar Movimentação</h2>
      <p>Lance entradas (Inbound) ou baixas de consumo (Outbound) de forma rastreável.</p>
    </div>
    <a href="/movimentacoes" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-arrow-left"></i> Histórico de Movimentações
    </a>
  </div>

  <div class="table-card" style="padding: 1.75rem;">
    <form action="/movimentacoes" method="POST" id="form-movimentacao">
      <!-- Seletor de Tipo Estilo Storaxe -->
      <label class="form-label" style="margin-bottom: 0.75rem; display: block;">
        Natureza da Operação <span class="required">*</span>
      </label>
      
      <div class="movement-type-selector">
        <!-- SAÍDA / BAIXA (Outbound) -->
        <label class="type-option-card <%= tipoPadrao === 'SAIDA' ? 'selected-out' : '' %>" id="card-tipo-saida">
          <input 
            type="radio" 
            name="tipo" 
            value="SAIDA" 
            id="tipo-mov-saida" 
            <%= tipoPadrao === 'SAIDA' ? 'checked' : '' %>
          >
          <div class="type-icon" style="color: var(--primary);">
            <i class="fa-solid fa-arrow-up-from-bracket"></i>
          </div>
          <div style="font-weight: 700; font-size: 1rem; color: var(--text-main);">Baixa de Estoque (Outbound)</div>
          <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
            Consumo interno, requisições de equipes, ordens de serviço ou perdas.
          </div>
        </label>

        <!-- ENTRADA / REPOSIÇÃO (Inbound) -->
        <label class="type-option-card <%= tipoPadrao === 'ENTRADA' ? 'selected-in' : '' %>" id="card-tipo-entrada">
          <input 
            type="radio" 
            name="tipo" 
            value="ENTRADA" 
            id="tipo-mov-entrada" 
            <%= tipoPadrao === 'ENTRADA' ? 'checked' : '' %>
          >
          <div class="type-icon" style="color: var(--teal);">
            <i class="fa-solid fa-arrow-down-to-bracket"></i>
          </div>
          <div style="font-weight: 700; font-size: 1rem; color: var(--text-main);">Entrada / Carga (Inbound)</div>
          <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
            Recebimento de Nota Fiscal, compra de suprimentos ou devolução.
          </div>
        </label>
      </div>

      <div class="form-grid">
        <!-- Seleção do Produto -->
        <div class="form-group full-width">
          <label class="form-label" for="mov-produto-select">
            Item a Movimentar <span class="required">*</span>
          </label>
          <select id="mov-produto-select" name="produto_id" class="form-select" required>
            <option value="">-- Selecione o material no catálogo --</option>
            <% produtos.forEach(p => { %>
              <option 
                value="<%= p.id %>" 
                data-estoque="<%= p.quantidade %>" 
                data-minimo="<%= p.estoque_minimo %>" 
                data-unidade="<%= p.unidade_medida %>"
                data-preco="<%= p.preco_unitario %>"
                <%= (produtoPreSelecionado && produtoPreSelecionado.id === p.id) ? 'selected' : '' %>
              >
                [<%= p.sku %>] <%= p.nome %> - Saldo: <%= p.quantidade %> <%= p.unidade_medida %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Caixa Informativa de Saldo Físico -->
        <div class="form-group full-width" id="mov-info-estoque" style="display: none;">
          <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; gap: 1rem;">
            <div>
              <span style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Estoque Físico Atual</span>
              <div style="font-size: 1.25rem; font-weight: 800; color: var(--text-main);">
                <span id="info-estoque-qtd">0</span> <span id="info-estoque-un" style="font-size: 0.85rem; color: var(--text-muted);">UN</span>
              </div>
            </div>
            <div style="width: 1px; height: 35px; background: var(--border-color);"></div>
            <div>
              <span style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Estoque Mínimo</span>
              <div style="font-size: 1.25rem; font-weight: 800; color: var(--warning);">
                <span id="info-estoque-min">0</span>
              </div>
            </div>
            <div style="width: 1px; height: 35px; background: var(--border-color);"></div>
            <div>
              <span style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Valor Médio Unitário</span>
              <div style="font-size: 1.15rem; font-weight: 700; color: var(--teal);" id="info-estoque-preco">
                R$ 0,00
              </div>
            </div>
          </div>
          <div id="aviso-saldo-insuficiente" style="display: none; color: var(--danger-text); font-size: 0.85rem; font-weight: 600; margin-top: 0.5rem; padding: 0.6rem; background: var(--danger-bg); border-radius: var(--radius-sm); border: 1px solid var(--danger-border);">
          </div>
        </div>

        <!-- Quantidade -->
        <div class="form-group">
          <label class="form-label" for="mov-quantidade-input">
            Quantidade <span class="required">*</span>
          </label>
          <input 
            type="number" 
            id="mov-quantidade-input" 
            name="quantidade" 
            class="form-control" 
            min="1" 
            value="<%= typeof dadosPreenchidos !== 'undefined' ? dadosPreenchidos.quantidade : '1' %>" 
            required
          >
        </div>

        <!-- Responsável -->
        <div class="form-group">
          <label class="form-label" for="mov-responsavel-input">
            Responsável / Solicitante <span class="required">*</span>
          </label>
          <input 
            type="text" 
            id="mov-responsavel-input" 
            name="responsavel" 
            class="form-control" 
            placeholder="Ex: João Pereira (Técnico)" 
            value="<%= typeof dadosPreenchidos !== 'undefined' ? dadosPreenchidos.responsavel : '' %>" 
            required
          >
        </div>

        <!-- Motivo -->
        <div class="form-group">
          <label class="form-label" for="mov-motivo-input">
            Motivo / Finalidade <span class="required">*</span>
          </label>
          <input 
            list="lista-motivos" 
            id="mov-motivo-input" 
            name="motivo" 
            class="form-control" 
            placeholder="Ex: Requisição de Setor, Compra NF..." 
            value="<%= typeof dadosPreenchidos !== 'undefined' ? dadosPreenchidos.motivo : '' %>" 
            required
          >
          <datalist id="lista-motivos">
            <option value="Compra / Reposição de Estoque">
            <option value="Requisição de Setor / Obras">
            <option value="Atendimento a Ordem de Serviço">
            <option value="Entrega de EPI a Colaborador">
            <option value="Devolução de Sobra de Material">
            <option value="Ajuste de Balanço / Inventário">
          </datalist>
        </div>

        <!-- Documento -->
        <div class="form-group">
          <label class="form-label" for="mov-documento-input">
            Documento / Nota Fiscal / O.S.
          </label>
          <input 
            type="text" 
            id="mov-documento-input" 
            name="documento_ref" 
            class="form-control" 
            placeholder="Ex: NF-10452 ou REQ-2026-88" 
            value="<%= typeof dadosPreenchidos !== 'undefined' ? dadosPreenchidos.documento_ref : '' %>"
          >
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border-light);">
        <a href="/movimentacoes" class="btn btn-outline">Cancelar</a>
        <button type="submit" class="btn btn-primary" id="btn-submeter-mov">
          <i class="fa-solid fa-check"></i> Confirmar Operação
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
