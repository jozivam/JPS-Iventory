<%- include('../layouts/header') %>

<div style="max-width: 800px; margin: 0 auto;">
  <% if (typeof erro !== 'undefined' && erro) { %>
    <div class="alert alert-danger">
      <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
      <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% } %>

  <div class="page-header-flex">
    <div class="page-title-wrap">
      <h2>Registrar Movimentação</h2>
      <p>Lance entradas de suprimentos ou baixas de consumo no estoque.</p>
    </div>
    <a href="/movimentacoes" class="btn btn-outline btn-sm">
      <i class="fa-solid fa-arrow-left"></i> Histórico de Movimentações
    </a>
  </div>

  <div class="table-card" style="padding: 1.75rem;">
    <form action="/movimentacoes" method="POST" id="form-movimentacao">
      <!-- Seletor de Tipo (Entrada ou Saída) -->
      <label class="form-label" style="margin-bottom: 0.75rem; display: block;">
        Natureza da Operação <span class="required">*</span>
      </label>
      
      <div class="movement-type-selector form-row-responsive" style="margin-bottom: 1.5rem;">
        <!-- SAÍDA / BAIXA -->
        <label class="type-option-card <%= tipoPadrao === 'SAIDA' ? 'selected-out' : '' %>" id="card-tipo-saida" style="cursor: pointer; border: 2px solid <%= tipoPadrao === 'SAIDA' ? 'var(--primary)' : 'var(--border-color)' %>; padding: 1rem; border-radius: var(--radius-md); display: block;">
          <input 
            type="radio" 
            name="tipo" 
            value="SAIDA" 
            id="tipo-mov-saida" 
            <%= tipoPadrao === 'SAIDA' ? 'checked' : '' %>
            style="display: none;"
          >
          <div class="type-icon" style="color: var(--danger); font-size: 1.5rem; margin-bottom: 0.5rem;">
            <i class="fa-solid fa-arrow-down"></i>
          </div>
          <div style="font-weight: 700; font-size: 1rem; color: var(--text-main);">Baixa de Estoque (Saída)</div>
          <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
            Consumo, requisição de equipe ou baixa de material.
          </div>
        </label>

        <!-- ENTRADA / REPOSIÇÃO -->
        <label class="type-option-card <%= tipoPadrao === 'ENTRADA' ? 'selected-in' : '' %>" id="card-tipo-entrada" style="cursor: pointer; border: 2px solid <%= tipoPadrao === 'ENTRADA' ? 'var(--teal)' : 'var(--border-color)' %>; padding: 1rem; border-radius: var(--radius-md); display: block;">
          <input 
            type="radio" 
            name="tipo" 
            value="ENTRADA" 
            id="tipo-mov-entrada" 
            <%= tipoPadrao === 'ENTRADA' ? 'checked' : '' %>
            style="display: none;"
          >
          <div class="type-icon" style="color: var(--teal); font-size: 1.5rem; margin-bottom: 0.5rem;">
            <i class="fa-solid fa-arrow-up"></i>
          </div>
          <div style="font-weight: 700; font-size: 1rem; color: var(--text-main);">Entrada / Reposição</div>
          <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
            Recebimento de Nota Fiscal, compras ou devoluções.
          </div>
        </label>
      </div>

      <div class="form-grid">
        <!-- Seleção do Produto -->
        <div class="form-group full-width">
          <label class="form-label" for="mov-produto-select">
            Produto a Movimentar <span class="required">*</span>
          </label>
          <select id="mov-produto-select" name="produto_id" class="form-select" required>
            <option value="">-- Selecione o item no inventário --</option>
            <% produtos.forEach(p => { %>
              <option 
                value="<%= p.id %>" 
                data-estoque="<%= p.quantidade %>" 
                data-unidade="<%= p.unidade_medida %>"
                data-preco="<%= p.preco_unitario %>"
                <%= (produtoPreSelecionado && produtoPreSelecionado.id === p.id) ? 'selected' : '' %>
              >
                [<%= p.sku %>] <%= p.nome %> (Saldo Atual: <%= p.quantidade %> <%= p.unidade_medida %>)
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Quantidade -->
        <div class="form-group">
          <label class="form-label" for="mov-quantidade-input">
            Quantidade a Movimentar <span class="required">*</span>
          </label>
          <input 
            type="number" 
            id="mov-quantidade-input" 
            name="quantidade" 
            class="form-control" 
            min="1" 
            placeholder="1"
            required
          >
          <span class="form-help" id="saldo-info-texto">Informe a quantia a ser debitada ou creditada.</span>
        </div>

        <!-- Responsável -->
        <div class="form-group">
          <label class="form-label" for="mov-responsavel-input">
            Responsável <span class="required">*</span>
          </label>
          <input 
            type="text" 
            id="mov-responsavel-input" 
            name="responsavel" 
            class="form-control" 
            placeholder="Nome de quem retirou ou recebeu" 
            value="Jozivam Silva"
            required
          >
        </div>

        <!-- Motivo / Justificativa -->
        <div class="form-group full-width">
          <label class="form-label" for="mov-motivo-input">
            Motivo / Justificativa
          </label>
          <input 
            type="text" 
            id="mov-motivo-input" 
            name="motivo" 
            class="form-control" 
            placeholder="Ex: Manutenção preventiva, consumo diário, entrega NF" 
          >
        </div>

        <!-- Documento / Nota Fiscal -->
        <div class="form-group full-width">
          <label class="form-label" for="mov-doc-input">
            Nº Documento / Nota Fiscal / O.S. (Opcional)
          </label>
          <input 
            type="text" 
            id="mov-doc-input" 
            name="documento_ref" 
            class="form-control" 
            placeholder="Ex: NF-40812 ou OS-109" 
          >
        </div>
      </div>

      <div class="page-actions-group" style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border-light);">
        <a href="/movimentacoes" class="btn btn-outline">Cancelar</a>
        <button type="submit" class="btn btn-primary" id="btn-confirmar-mov">
          <i class="fa-solid fa-check"></i> Confirmar Movimentação
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Alternância visual dos cards de tipo
  const cardSaida = document.getElementById('card-tipo-saida');
  const cardEntrada = document.getElementById('card-tipo-entrada');
  const radioSaida = document.getElementById('tipo-mov-saida');
  const radioEntrada = document.getElementById('tipo-mov-entrada');

  function atualizarBordasTipo() {
    if (radioSaida.checked) {
      cardSaida.style.borderColor = 'var(--danger)';
      cardSaida.style.background = 'var(--bg-surface)';
      cardEntrada.style.borderColor = 'var(--border-color)';
      cardEntrada.style.background = 'transparent';
    } else {
      cardEntrada.style.borderColor = 'var(--teal)';
      cardEntrada.style.background = 'var(--bg-surface)';
      cardSaida.style.borderColor = 'var(--border-color)';
      cardSaida.style.background = 'transparent';
    }
  }

  cardSaida.addEventListener('click', () => {
    radioSaida.checked = true;
    atualizarBordasTipo();
  });

  cardEntrada.addEventListener('click', () => {
    radioEntrada.checked = true;
    atualizarBordasTipo();
  });

  atualizarBordasTipo();
</script>

<%- include('../layouts/footer') %>
