<%- include('../layouts/header') %>

<div class="page-header-flex">
  <div class="page-title-wrap">
    <h2>Busca Geral no Sistema</h2>
    <p>
      <% if (q) { %>
        Exibindo resultados para a pesquisa global: <strong>"<%= q %>"</strong> (<%= totalResultados %> registro(s) encontrado(s))
      <% } else { %>
        Digite um termo na caixa de busca superior para pesquisar em todo o almoxarifado.
      <% } %>
    </p>
  </div>
  
  <a href="/produtos" class="btn btn-outline btn-sm">
    <i class="fa-solid fa-boxes-stacked"></i> Ir ao Inventário
  </a>
</div>

<% if (!q) { %>
  <div class="table-card" style="text-align: center; padding: 4rem 2rem; color: var(--text-muted);">
    <i class="fa-solid fa-magnifying-glass" style="font-size: 2.5rem; color: var(--text-dim); margin-bottom: 1rem; display: block;"></i>
    <h3>Pesquise em todo o sistema</h3>
    <p style="max-width: 480px; margin: 0.5rem auto 0; font-size: 0.9rem;">
      Use a barra superior para localizar itens, códigos SKU, plaquetas TAG, números de patrimônio, C.A, responsáveis ou notas fiscais.
    </p>
  </div>
<% } else { %>

  <!-- SEÇÃO 1: ITENS DO INVENTÁRIO ENCONTRADOS -->
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-boxes-stacked" style="color: var(--primary);"></i>
        Itens do Inventário (<%= produtos.length %>)
      </h3>
      <% if (produtos.length > 0) { %>
        <a href="/produtos?busca=<%= encodeURIComponent(q) %>" class="btn btn-outline btn-sm" style="font-size: 0.78rem;">
          Ver no Inventário Filtrado ➔
        </a>
      <% } %>
    </div>

    <div class="table-card">
      <div class="table-responsive">
        <table class="clean-table">
          <thead>
            <tr>
              <th>Item / Detalhes</th>
              <th>Categoria</th>
              <th>SKU</th>
              <th>Estoque Atual</th>
              <th>Status</th>
              <th style="text-align: right;">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (produtos && produtos.length > 0) { %>
              <% produtos.forEach(p => { %>
                <tr>
                  <td>
                    <div class="product-name-text" style="font-weight: 600; color: var(--text-main);">
                      <%= p.nome %>
                      <% if (p.marca) { %>
                        <span style="font-size: 0.72rem; color: var(--primary); background: var(--primary-light); padding: 1px 5px; border-radius: 4px; margin-left: 0.35rem;">
                          <%= p.marca %>
                        </span>
                      <% } %>
                    </div>
                    <div class="product-sku-text" style="font-size: 0.78rem; color: var(--text-muted); margin-top: 3px; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;">
                      <% if (p.localizacao) { %>
                        <span><i class="fa-solid fa-location-dot" style="font-size: 0.7rem;"></i> <%= p.localizacao %></span>
                      <% } %>
                      <% if (p.tag) { %>
                        <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 5px; border-radius: 4px; font-size: 0.7rem; font-family: var(--font-mono); color: var(--primary);">TAG: <%= p.tag %></span>
                      <% } %>
                      <% if (p.patrimonio) { %>
                        <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 5px; border-radius: 4px; font-size: 0.7rem; font-family: var(--font-mono);">PAT: <%= p.patrimonio %></span>
                      <% } %>
                      <% if (p.ca) { %>
                        <span style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1px 5px; border-radius: 4px; font-size: 0.7rem; color: var(--teal);">CA: <%= p.ca %></span>
                      <% } %>
                    </div>
                  </td>
                  <td><span style="color: var(--text-body);"><%= p.categoria %></span></td>
                  <td><span style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 600;"><%= p.sku %></span></td>
                  <td>
                    <strong style="color: var(--text-main);"><%= p.quantidade %></strong>
                    <span style="font-size: 0.75rem; color: var(--text-dim);"><%= p.unidade_medida %></span>
                  </td>
                  <td>
                    <% if (p.status_estoque === 'NORMAL') { %>
                      <span class="status-pill in-stock"><span class="status-dot-sm"></span> Em estoque</span>
                    <% } else if (p.status_estoque === 'BAIXO') { %>
                      <span class="status-pill low-stock"><span class="status-dot-sm"></span> Estoque baixo</span>
                    <% } else { %>
                      <span class="status-pill out-of-stock"><span class="status-dot-sm"></span> Sem estoque</span>
                    <% } %>
                  </td>
                  <td style="text-align: right; white-space: nowrap;">
                    <a href="/balcao?produto_id=<%= p.id %>&tipo=SAIDA" class="action-more-btn" title="Baixa no Balcão">
                      <i class="fa-solid fa-arrow-up" style="color: var(--danger);"></i>
                    </a>
                    <a href="/balcao?produto_id=<%= p.id %>&tipo=ENTRADA" class="action-more-btn" title="Entrada no Balcão">
                      <i class="fa-solid fa-arrow-down" style="color: var(--teal);"></i>
                    </a>
                    <a href="/produtos/<%= p.id %>/editar" class="action-more-btn" title="Editar">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                  Nenhum item de inventário encontrado para "<%= q %>".
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- SEÇÃO 2: MOVIMENTAÇÕES ENCONTRADAS -->
  <div>
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
        <i class="fa-solid fa-clock-rotate-left" style="color: var(--teal);"></i>
        Movimentações Relacionadas (<%= movimentacoes.length %>)
      </h3>
      <% if (movimentacoes.length > 0) { %>
        <a href="/movimentacoes" class="btn btn-outline btn-sm" style="font-size: 0.78rem;">
          Histórico Completo ➔
        </a>
      <% } %>
    </div>

    <div class="table-card">
      <div class="table-responsive">
        <table class="clean-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>TIPO</th>
              <th>ITEM / PRODUTO</th>
              <th>QUANTIDADE</th>
              <th>RESPONSÁVEL</th>
              <th>MOTIVO / DOCUMENTO</th>
              <th>DATA</th>
            </tr>
          </thead>
          <tbody>
            <% if (movimentacoes && movimentacoes.length > 0) { %>
              <% movimentacoes.forEach(m => { %>
                <tr>
                  <td>
                    <strong style="font-family: var(--font-mono); font-size: 0.8rem;">
                      MOV-<%= String(m.id).padStart(4, '0') %>
                    </strong>
                  </td>
                  <td>
                    <span class="status-pill <%= m.tipo === 'ENTRADA' ? 'in-stock' : 'low-stock' %>">
                      <span class="status-dot-sm"></span> <%= m.tipo === 'ENTRADA' ? 'Entrada' : 'Baixa' %>
                    </span>
                  </td>
                  <td>
                    <div style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;"><%= m.produto_nome %></div>
                    <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);"><%= m.produto_sku %></div>
                  </td>
                  <td>
                    <strong style="color: <%= m.tipo === 'ENTRADA' ? 'var(--teal)' : 'var(--text-main)' %>;">
                      <%= m.tipo === 'ENTRADA' ? '+' : '-' %><%= m.quantidade %>
                    </strong>
                    <small style="color: var(--text-muted);"><%= m.produto_unidade %></small>
                  </td>
                  <td>
                    <span style="font-size: 0.82rem;"><%= m.responsavel %></span>
                  </td>
                  <td>
                    <div style="font-size: 0.82rem; color: var(--text-body);"><%= m.motivo || '-' %></div>
                    <% if (m.documento_ref) { %>
                      <div style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;">
                        Doc: <%= m.documento_ref %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span style="font-size: 0.82rem; color: var(--text-muted);"><%= formatDate(m.criado_em) %></span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                  Nenhum registro de movimentação encontrado para "<%= q %>".
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

<% } %>

<%- include('../layouts/footer') %>
