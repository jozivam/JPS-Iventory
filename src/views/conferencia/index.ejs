<%- include('../layouts/header') %>

<style>
  /* Mesmo padrão visual de cards seletores da Central de Relatórios */
  .conf-type-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .conf-type-card {
    background: #ffffff;
    border: 1.5px solid var(--border-color);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    text-align: left;
    color: var(--text-main);
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    transition: var(--transition);
    cursor: pointer;
    font-family: inherit;
    width: 100%;
  }

  .conf-type-card:hover {
    border-color: var(--primary);
    background: #f8fafc;
    transform: translateY(-1px);
  }

  .conf-type-card.ativo {
    border-color: var(--primary);
    background: var(--primary-light);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.14);
  }

  .conf-type-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--bg-surface);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 0.95rem;
  }

  .conf-type-card.ativo .conf-type-icon {
    background: var(--primary);
    color: #ffffff;
  }

  .conf-type-title {
    font-size: 0.84rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .conf-type-sub {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 3px;
    line-height: 1.3;
  }

  .conf-upload-panel {
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .conf-upload-panel.dragover {
    border-color: var(--primary) !important;
    background: #eef2ff !important;
  }

  .conf-file-trigger {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    height: 38px;
    padding: 0 0.85rem;
    border: 1.5px solid var(--border-color);
    border-radius: 8px;
    background: #ffffff;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-body);
    overflow: hidden;
    transition: var(--transition);
  }

  .conf-file-trigger:hover {
    border-color: var(--primary);
    background: #f8fafc;
  }

  .conf-file-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .conf-print-header {
    display: none;
  }

  @media print {
    .app-sidebar, .topbar, .mobile-bottom-nav, .hide-on-print, #jps-offline-banner {
      display: none !important;
    }
    .app-main {
      margin-left: 0 !important;
      padding: 0 !important;
    }
    .page-content {
      padding: 0 !important;
      max-width: none !important;
    }
    .conf-print-header {
      display: flex !important;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #0f172a;
      padding-bottom: 10px;
      margin-bottom: 12px;
    }
    .table-card {
      box-shadow: none !important;
      border: 1px solid #cbd5e1 !important;
    }
    .clean-table th, .clean-table td {
      font-size: 0.72rem !important;
      padding: 5px 6px !important;
    }
  }
</style>

<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger hide-on-print">
    <div><i class="fa-solid fa-circle-exclamation"></i> <%= erro %></div>
    <button type="button" class="alert-close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<!-- Cabeçalho Oficial para Impressão / PDF -->
<% if (resultado) { %>
  <div class="conf-print-header">
    <div>
      <h2 style="font-size: 1.15rem; font-weight: 800; margin: 0;">JPS Almoxarifado — Conferência de Inventário</h2>
      <div style="font-size: 0.78rem; color: #475569;">Planilha analisada: <strong><%= resultado.nomeArquivo %></strong></div>
    </div>
    <div style="text-align: right; font-size: 0.75rem; color: #475569;">
      <div><strong>Emissão:</strong> <%= resultado.geradoEm %></div>
      <div><strong>Emitido por:</strong> <%= resultado.emitidoPor %></div>
    </div>
  </div>
<% } %>

<!-- Cabeçalho da Página (Mesmo padrão da Central de Relatórios) -->
<div class="page-header-flex hide-on-print">
  <div class="page-title-wrap">
    <h2>Conferência de Planilha de Inventário</h2>
    <p>Compare planilhas de remessa/inventário com os <strong><%= totalProdutosAlmox %></strong> itens do almoxarifado (por <strong>PTM, Patrimônio, SKU, C.A.</strong> e <strong>nomes parecidos</strong>) com exportação em <strong>PDF</strong> ou <strong>Excel (.xlsx)</strong>.</p>
  </div>

  <div class="page-actions-group" style="flex-wrap: wrap;">
    <% if (resultado) { %>
      <button type="button" class="btn btn-primary" style="background: #DC2626; border-color: #DC2626;" onclick="window.print()" title="Imprimir ou salvar conferência em PDF">
        <i class="fa-solid fa-file-pdf"></i> Exportar PDF
      </button>

      <button type="button" class="btn btn-primary" style="background: #059669; border-color: #059669;" onclick="exportarConferenciaExcel()" title="Baixar planilha Excel (.xlsx) com 5 abas organizadas">
        <i class="fa-solid fa-file-excel"></i> Exportar Excel (.xlsx)
      </button>

      <a href="/conferencia" class="btn btn-outline" title="Limpar conferência atual e enviar outra planilha">
        <i class="fa-solid fa-rotate-left"></i> Nova Conferência
      </a>
    <% } else { %>
      <button type="button" class="btn btn-primary" style="background: #DC2626; border-color: #DC2626; opacity: 0.45; cursor: not-allowed;" disabled title="Envie uma planilha primeiro para exportar em PDF">
        <i class="fa-solid fa-file-pdf"></i> Exportar PDF
      </button>

      <button type="button" class="btn btn-primary" style="background: #059669; border-color: #059669; opacity: 0.45; cursor: not-allowed;" disabled title="Envie uma planilha primeiro para exportar em Excel">
        <i class="fa-solid fa-file-excel"></i> Exportar Excel (.xlsx)
      </button>

      <button type="button" class="btn btn-outline" onclick="document.getElementById('input-planilha-conf').click()">
        <i class="fa-solid fa-file-arrow-up"></i> Selecionar Planilha
      </button>
    <% } %>
  </div>
</div>

<!-- Cards Seletores de Visão (Mesmo padrão de Relatórios) -->
<div class="conf-type-grid hide-on-print">
  <button type="button" class="conf-type-card ativo" data-status-card="" onclick="selecionarCardStatus('', this)">
    <div class="conf-type-icon">
      <i class="fa-solid fa-table-list"></i>
    </div>
    <div>
      <div class="conf-type-title">Todos os Itens</div>
      <div class="conf-type-sub">Lista completa de todas as abas lidas da planilha</div>
    </div>
  </button>

  <button type="button" class="conf-type-card" data-status-card="COM_SALDO" onclick="selecionarCardStatus('COM_SALDO', this)">
    <div class="conf-type-icon">
      <i class="fa-solid fa-circle-check"></i>
    </div>
    <div>
      <div class="conf-type-title">Ainda Temos (Em Obra)</div>
      <div class="conf-type-sub">Itens encontrados com saldo em estoque ou em campo</div>
    </div>
  </button>

  <button type="button" class="conf-type-card" data-status-card="PARECIDO" onclick="selecionarCardStatus('PARECIDO', this)">
    <div class="conf-type-icon">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
    </div>
    <div>
      <div class="conf-type-title">Parecidos (Revisar)</div>
      <div class="conf-type-sub">Sugestões por nome/C.A. para confirmar ou trocar</div>
    </div>
  </button>

  <button type="button" class="conf-type-card" data-status-card="ENCONTRADO_ZERADO" onclick="selecionarCardStatus('ENCONTRADO_ZERADO', this)">
    <div class="conf-type-icon">
      <i class="fa-solid fa-box-open"></i>
    </div>
    <div>
      <div class="conf-type-title">Cadastrados (Zerados)</div>
      <div class="conf-type-sub">Constam no sistema, mas com saldo físico igual a 0</div>
    </div>
  </button>

  <button type="button" class="conf-type-card" data-status-card="NAO_ENCONTRADO" onclick="selecionarCardStatus('NAO_ENCONTRADO', this)">
    <div class="conf-type-icon">
      <i class="fa-solid fa-circle-xmark"></i>
    </div>
    <div>
      <div class="conf-type-title">Não Encontrados</div>
      <div class="conf-type-sub">Itens da planilha sem correspondência no almoxarifado</div>
    </div>
  </button>
</div>

<!-- Painel de Envio da Planilha & Filtros Avançados (Mesmo estilo do Painel de Filtros de Relatórios) -->
<div class="table-card conf-upload-panel hide-on-print" id="conf-dropzone" style="padding: 1.15rem 1.25rem; margin-bottom: 1.25rem;">
  <form action="/conferencia/comparar" method="POST" enctype="multipart/form-data" id="form-upload-conferencia" style="display: flex; flex-direction: column; gap: 0.9rem; margin: 0;">

    <!-- Linha 1: Seleção da Planilha + Botão Comparar -->
    <div style="display: flex; flex-wrap: wrap; align-items: end; gap: 0.65rem; <%= resultado ? 'padding-bottom: 0.85rem; border-bottom: 1px solid var(--border-light);' : '' %>">
      <div style="flex: 2; min-width: 260px;">
        <label class="form-label" style="font-size: 0.75rem; margin-bottom: 0.25rem;">
          <i class="fa-solid fa-file-excel" style="color: #059669; margin-right: 4px;"></i>
          Planilha de Inventário (.xlsx, .xls ou .csv) — clique ou arraste o arquivo aqui
        </label>
        <input type="file" id="input-planilha-conf" name="planilha" accept=".xlsx,.xls,.csv" required style="display: none;">
        <label for="input-planilha-conf" class="conf-file-trigger">
          <i class="fa-solid fa-folder-open" style="color: var(--primary); flex-shrink: 0;"></i>
          <span class="conf-file-name" id="nome-arquivo-selecionado">
            <%= resultado ? resultado.nomeArquivo + ' (clique para trocar de planilha)' : 'Escolher arquivo no computador ou celular...' %>
          </span>
        </label>
      </div>

      <div style="display: flex; gap: 0.45rem; align-items: center;">
        <button type="submit" class="btn btn-primary" id="btn-comparar-planilha" style="height: 38px; padding: 0 1.2rem; white-space: nowrap;">
          <i class="fa-solid fa-magnifying-glass-chart"></i> Comparar Planilha
        </button>
      </div>

      <div style="margin-left: auto; font-size: 0.76rem; color: var(--text-muted); font-weight: 600; align-self: center;">
        <% if (resultado) { %>
          <i class="fa-regular fa-clock"></i> Conferido em: <strong style="color: var(--text-main);"><%= resultado.geradoEm %></strong>
        <% } else { %>
          <i class="fa-solid fa-circle-info" style="color: var(--primary);"></i> Lê todas as abas automaticamente (PTM, C.A., SKU e nomes parecidos)
        <% } %>
      </div>
    </div>

    <% if (resultado) { %>
      <!-- Linha 2: Atalhos Rápidos de Abas (idêntico aos botões de Período em Relatórios) -->
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.65rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-light);">
        <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
          <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); margin-right: 0.2rem;">
            <i class="fa-solid fa-layer-group"></i> Abas lidas:
          </span>
          <button type="button" class="btn btn-sm btn-primary conf-aba-btn" data-aba="" onclick="filtrarAbaConf('', this)">
            Todas (<%= resultado.resumo.totalPlanilha %>)
          </button>
          <% resultado.abasLidas.forEach(a => { %>
            <button type="button" class="btn btn-sm btn-outline conf-aba-btn" data-aba="<%= a.nome %>" onclick="filtrarAbaConf('<%= a.nome.replace(/'/g, "\\'") %>', this)">
              <%= a.nome %> (<%= a.total %>)
            </button>
          <% }) %>
        </div>

        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">
          <i class="fa-solid fa-lightbulb" style="color: #D97706;"></i> Confirme ou troque itens <strong>Parecidos</strong> antes de exportar
        </div>
      </div>

      <!-- Linha 3: Filtros Contextuais em Grid (idêntico à Linha 2 de Relatórios) -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.65rem; align-items: end;">
        <div>
          <label class="form-label" style="font-size: 0.75rem; margin-bottom: 0.25rem;">Situação do Cruzamento</label>
          <select id="conf-filtro-status" class="form-control" style="height: 38px;" onchange="sincronizarCardComSelect(this.value)">
            <option value="">Todas as Situações</option>
            <option value="COM_SALDO">Ainda Temos (OK + Parcial)</option>
            <option value="ENCONTRADO_OK">Somente Encontrados (OK)</option>
            <option value="ENCONTRADO_DIVERGENTE">Somente Qtd Menor (Parcial)</option>
            <option value="ENCONTRADO_ZERADO">Cadastrados mas Zerados</option>
            <option value="PARECIDO">Parecidos (Revisar Manualmente)</option>
            <option value="NAO_ENCONTRADO">Não Encontrados no Sistema</option>
          </select>
        </div>

        <div style="grid-column: span 2;">
          <label class="form-label" style="font-size: 0.75rem; margin-bottom: 0.25rem;">Busca Livre</label>
          <input type="text" id="conf-filtro-busca" class="form-control" style="height: 38px;" placeholder="Pesquisar por PTM, Patrimônio, C.A., NF, SKU ou nome do item..." oninput="renderizarTabelaConferencia()">
        </div>

        <div style="display: flex; gap: 0.4rem;">
          <button type="button" class="btn btn-outline" style="height: 38px; flex: 1;" onclick="limparFiltrosConferencia()">
            <i class="fa-solid fa-rotate-left"></i> Limpar Filtros
          </button>
        </div>
      </div>
    <% } %>
  </form>
</div>

<!-- KPIs Consolidados (Mesmo estilo exato da Central de Relatórios) -->
<div class="balcao-kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); margin-bottom: 1.25rem;">
  <div class="table-card" style="padding: 1rem 1.15rem; border-left: 4px solid var(--primary);">
    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Total na Planilha</div>
    <div style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin-top: 2px;">
      <span id="kpi-conf-total"><%= resultado ? resultado.resumo.totalPlanilha : 0 %></span>
      <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">itens</span>
    </div>
    <div style="font-size: 0.74rem; color: var(--text-dim);">
      <%= resultado ? `${resultado.abasLidas.length} aba(s) analisada(s)` : `${totalProdutosAlmox} itens no almoxarifado` %>
    </div>
  </div>

  <div class="table-card" style="padding: 1rem 1.15rem; border-left: 4px solid #10B981;">
    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Encontrados (OK)</div>
    <div style="font-size: 1.35rem; font-weight: 800; color: #047857; margin-top: 2px;">
      <span id="kpi-conf-ok"><%= resultado ? resultado.resumo.encontradosOk : 0 %></span>
      <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">itens</span>
    </div>
    <div style="font-size: 0.74rem; color: var(--text-dim);">Saldo na obra completo</div>
  </div>

  <div class="table-card" style="padding: 1rem 1.15rem; border-left: 4px solid #0EA5E9;">
    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Qtd Menor (Parcial)</div>
    <div style="font-size: 1.35rem; font-weight: 800; color: #0369A1; margin-top: 2px;">
      <span id="kpi-conf-div"><%= resultado ? resultado.resumo.encontradosDivergente : 0 %></span>
      <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">itens</span>
    </div>
    <div style="font-size: 0.74rem; color: var(--text-dim);">Estoque + campo &lt; enviado</div>
  </div>

  <div class="table-card" style="padding: 1rem 1.15rem; border-left: 4px solid #F59E0B;">
    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Parecidos (Revisar)</div>
    <div style="font-size: 1.35rem; font-weight: 800; color: #B45309; margin-top: 2px;">
      <span id="kpi-conf-par"><%= resultado ? resultado.resumo.parecidos : 0 %></span>
      <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">itens</span>
    </div>
    <div style="font-size: 0.74rem; color: var(--text-dim);">Aguardando confirmação manual</div>
  </div>

  <div class="table-card" style="padding: 1rem 1.15rem; border-left: 4px solid #EF4444;">
    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Zerados / Não Encontrados</div>
    <div style="font-size: 1.35rem; font-weight: 800; color: #B91C1C; margin-top: 2px;">
      <span id="kpi-conf-ausentes"><%= resultado ? (resultado.resumo.encontradosZerado + resultado.resumo.naoEncontrados) : 0 %></span>
      <span style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted);">itens</span>
    </div>
    <div style="font-size: 0.74rem; color: var(--text-dim);">
      <span id="kpi-conf-zer"><%= resultado ? resultado.resumo.encontradosZerado : 0 %></span> zerado(s) • <span id="kpi-conf-nao"><%= resultado ? resultado.resumo.naoEncontrados : 0 %></span> não encontrado(s)
    </div>
  </div>
</div>

<!-- Tabela Principal Full-Width (Mesmo padrão das tabelas da Central de Relatórios) -->
<div class="table-card" style="padding: 0; overflow: hidden;">
  <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
    <h3 style="font-size: 0.98rem; font-weight: 800; margin: 0; color: var(--text-main);">
      <i class="fa-solid fa-file-circle-check" style="color: var(--primary); margin-right: 6px;"></i>
      <%= resultado ? `Resultado da Conferência — ${resultado.nomeArquivo}` : 'Resultado do Cruzamento com o Almoxarifado' %>
    </h3>
    <span id="conf-contador-visiveis" style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted);">
      <%= resultado ? `Exibindo ${resultado.resumo.totalPlanilha} de ${resultado.resumo.totalPlanilha} item(ns)` : 'Aguardando envio de planilha' %>
    </span>
  </div>

  <div class="table-responsive">
    <table class="clean-table">
      <thead>
        <tr>
          <th>Planilha Enviada</th>
          <th style="text-align: center;">Qtd Planilha</th>
          <th>Situação / Match</th>
          <th>Correspondência no Almoxarifado</th>
          <th style="text-align: center;">Na Obra (Est + Campo)</th>
          <th class="hide-on-print" style="text-align: right;">Revisão</th>
        </tr>
      </thead>
      <tbody id="tbody-conferencia">
        <% if (!resultado) { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 3rem 1.5rem; color: var(--text-muted);">
              <i class="fa-solid fa-file-excel" style="font-size: 2rem; color: #059669; opacity: 0.75; margin-bottom: 0.65rem; display: block;"></i>
              <div style="font-weight: 700; color: var(--text-main); font-size: 0.92rem; margin-bottom: 0.3rem;">
                Nenhuma planilha carregada ainda
              </div>
              <div style="font-size: 0.8rem; max-width: 540px; margin: 0 auto 1rem; line-height: 1.45;">
                Selecione ou arraste a planilha <strong>.xlsx, .xls ou .csv</strong> no campo acima e clique em <strong>Comparar Planilha</strong>. O sistema cruza automaticamente por <code>PTM/PTMM/PMT</code>, <code>Patrimônio</code>, <code>SKU</code>, <code>C.A.</code> e nomes parecidos, somando <strong>Estoque + Em Campo</strong>.
              </div>
              <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('input-planilha-conf').click()">
                <i class="fa-solid fa-folder-open"></i> Escolher Planilha Agora
              </button>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Formulário oculto para Exportar Excel com os dados (incluindo confirmações manuais) -->
<form id="form-exportar-conf-excel" action="/conferencia/exportar/excel" method="POST" style="display: none;">
  <input type="hidden" name="dados_json" id="input-conf-dados-json">
</form>

<script>
  // Controle de Upload e Drag-and-Drop no painel superior
  (function () {
    const input = document.getElementById('input-planilha-conf');
    const dropzone = document.getElementById('conf-dropzone');
    const nomeEl = document.getElementById('nome-arquivo-selecionado');
    const form = document.getElementById('form-upload-conferencia');
    const btn = document.getElementById('btn-comparar-planilha');

    function mostrarArquivo(file) {
      if (!file || !nomeEl) return;
      nomeEl.innerHTML = `<strong style="color:#047857;">${file.name}</strong> <span style="color:var(--text-muted);">(${(file.size / 1024).toFixed(1)} KB)</span>`;
    }

    if (input) {
      input.addEventListener('change', () => {
        if (input.files && input.files[0]) mostrarArquivo(input.files[0]);
      });
    }

    if (dropzone) {
      ['dragenter', 'dragover'].forEach(ev => {
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.add('dragover');
        });
      });
      ['dragleave', 'drop'].forEach(ev => {
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.remove('dragover');
        });
      });
      dropzone.addEventListener('drop', (e) => {
        const files = e.dataTransfer?.files;
        if (files && files[0] && input) {
          input.files = files;
          mostrarArquivo(files[0]);
        }
      });
    }

    if (form && btn) {
      form.addEventListener('submit', () => {
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Comparando...';
      });
    }
  })();

  const DADOS_CONFERENCIA = <%- JSON.stringify(resultado || null) %>;
  let abaAtivaConf = '';

  function esc(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function selecionarCardStatus(statusVal, cardBtn) {
    document.querySelectorAll('.conf-type-card').forEach(c => c.classList.remove('ativo'));
    if (cardBtn) cardBtn.classList.add('ativo');

    const sel = document.getElementById('conf-filtro-status');
    if (sel) sel.value = statusVal;

    if (DADOS_CONFERENCIA) renderizarTabelaConferencia();
  }

  function sincronizarCardComSelect(statusVal) {
    document.querySelectorAll('.conf-type-card').forEach(c => {
      const cardStatus = c.getAttribute('data-status-card') || '';
      c.classList.toggle('ativo', cardStatus === statusVal);
    });
    if (DADOS_CONFERENCIA) renderizarTabelaConferencia();
  }

  function filtrarAbaConf(aba, btn) {
    abaAtivaConf = aba;
    document.querySelectorAll('.conf-aba-btn').forEach(b => {
      b.classList.remove('btn-primary');
      b.classList.add('btn-outline');
    });
    if (btn) {
      btn.classList.remove('btn-outline');
      btn.classList.add('btn-primary');
    }
    if (DADOS_CONFERENCIA) renderizarTabelaConferencia();
  }

  function limparFiltrosConferencia() {
    abaAtivaConf = '';
    document.querySelectorAll('.conf-aba-btn').forEach((b, idx) => {
      b.classList.toggle('btn-primary', idx === 0);
      b.classList.toggle('btn-outline', idx !== 0);
    });
    const sel = document.getElementById('conf-filtro-status');
    if (sel) sel.value = '';
    const busca = document.getElementById('conf-filtro-busca');
    if (busca) busca.value = '';
    document.querySelectorAll('.conf-type-card').forEach((c, idx) => c.classList.toggle('ativo', idx === 0));
    if (DADOS_CONFERENCIA) renderizarTabelaConferencia();
  }

  function recalcularKPIsConf() {
    if (!DADOS_CONFERENCIA) return;
    const lista = DADOS_CONFERENCIA.comparacoes || [];
    const zer = lista.filter(c => c.status === 'ENCONTRADO_ZERADO').length;
    const nao = lista.filter(c => c.status === 'NAO_ENCONTRADO').length;

    document.getElementById('kpi-conf-total').textContent = lista.length;
    document.getElementById('kpi-conf-ok').textContent = lista.filter(c => c.status === 'ENCONTRADO_OK').length;
    document.getElementById('kpi-conf-div').textContent = lista.filter(c => c.status === 'ENCONTRADO_DIVERGENTE').length;
    document.getElementById('kpi-conf-par').textContent = lista.filter(c => c.status === 'PARECIDO').length;
    document.getElementById('kpi-conf-zer').textContent = zer;
    document.getElementById('kpi-conf-nao').textContent = nao;
    document.getElementById('kpi-conf-ausentes').textContent = zer + nao;
  }

  function confirmarMatchManual(linhaIdx, altIndex) {
    if (!DADOS_CONFERENCIA) return;
    const item = DADOS_CONFERENCIA.comparacoes.find(c => c.linha_idx === linhaIdx);
    if (!item) return;
    const alt = (item.alternativas && item.alternativas[altIndex]) || null;
    const prod = alt ? alt.produto : item.produto_match;
    if (!prod) return;

    item.produto_match = prod;
    item.match_score = 100;
    item.match_criterio = 'Confirmado manualmente';
    const totalObra = Number(prod.quantidade || 0) + Number(prod.em_campo || 0);
    if (totalObra <= 0) item.status = 'ENCONTRADO_ZERADO';
    else if (item.qtd_esperada > 0 && totalObra < item.qtd_esperada) item.status = 'ENCONTRADO_DIVERGENTE';
    else item.status = 'ENCONTRADO_OK';

    recalcularKPIsConf();
    renderizarTabelaConferencia();
  }

  function descartarMatchManual(linhaIdx) {
    if (!DADOS_CONFERENCIA) return;
    const item = DADOS_CONFERENCIA.comparacoes.find(c => c.linha_idx === linhaIdx);
    if (!item) return;
    item.produto_match = null;
    item.match_score = 0;
    item.match_criterio = 'Descartado manualmente';
    item.status = 'NAO_ENCONTRADO';
    recalcularKPIsConf();
    renderizarTabelaConferencia();
  }

  function badgeStatusHtml(c) {
    if (c.status === 'ENCONTRADO_OK') {
      return '<span class="status-pill in-stock" style="font-size:0.71rem;"><i class="fa-solid fa-circle-check"></i> Encontrado (OK)</span>';
    }
    if (c.status === 'ENCONTRADO_DIVERGENTE') {
      return '<span class="status-pill" style="background:#E0F2FE;color:#0369A1;border:1px solid #BAE6FD;font-size:0.71rem;"><i class="fa-solid fa-scale-unbalanced"></i> Qtd Menor</span>';
    }
    if (c.status === 'ENCONTRADO_ZERADO') {
      return '<span class="status-pill" style="background:#F5F3FF;color:#6D28D9;border:1px solid #DDD6FE;font-size:0.71rem;"><i class="fa-solid fa-box-open"></i> Zerado (0)</span>';
    }
    if (c.status === 'PARECIDO') {
      return '<span class="status-pill low-stock" style="font-size:0.71rem;"><i class="fa-solid fa-circle-question"></i> Parecido (' + c.match_score + '%)</span>';
    }
    return '<span class="status-pill out-of-stock" style="font-size:0.71rem;"><i class="fa-solid fa-circle-xmark"></i> Não Encontrado</span>';
  }

  function renderizarTabelaConferencia() {
    if (!DADOS_CONFERENCIA) return;
    const statusFiltro = document.getElementById('conf-filtro-status')?.value || '';
    const busca = (document.getElementById('conf-filtro-busca')?.value || '').trim().toLowerCase();
    const tbody = document.getElementById('tbody-conferencia');
    const contador = document.getElementById('conf-contador-visiveis');
    if (!tbody) return;

    const filtrados = (DADOS_CONFERENCIA.comparacoes || []).filter(c => {
      if (abaAtivaConf && c.aba !== abaAtivaConf) return false;
      if (statusFiltro === 'COM_SALDO') {
        if (c.status !== 'ENCONTRADO_OK' && c.status !== 'ENCONTRADO_DIVERGENTE') return false;
      } else if (statusFiltro && c.status !== statusFiltro) {
        return false;
      }
      if (busca) {
        const p = c.produto_match;
        const texto = [
          c.aba, c.descricao, c.codigo_planilha, c.nf_envio,
          p ? p.nome : '', p ? p.sku : '', p ? p.tag : '', p ? p.patrimonio : '', p ? p.categoria : ''
        ].join(' ').toLowerCase();
        if (!texto.includes(busca)) return false;
      }
      return true;
    });

    if (contador) contador.textContent = `Exibindo ${filtrados.length} de ${DADOS_CONFERENCIA.comparacoes.length} item(ns)`;

    if (filtrados.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2.5rem;color:var(--text-muted);">Nenhum item encontrado com os filtros aplicados.</td></tr>';
      return;
    }

    tbody.innerHTML = filtrados.map(c => {
      const p = c.produto_match;
      const totalObra = p ? (Number(p.quantidade || 0) + Number(p.em_campo || 0)) : 0;
      const diff = p ? (totalObra - Number(c.qtd_esperada || 0)) : -Number(c.qtd_esperada || 0);

      let matchHtml = '<span style="color:var(--text-dim);font-size:0.8rem;">Não localizado no cadastro</span>';
      if (p) {
        matchHtml = `
          <div style="font-weight:700;font-size:0.84rem;color:var(--text-main);">${esc(p.nome)}</div>
          <div style="font-size:0.71rem;color:var(--text-muted);margin-top:2px;display:flex;gap:0.4rem;flex-wrap:wrap;">
            <span style="font-family:var(--font-mono);font-weight:700;color:var(--primary);">${esc(p.sku)}</span>
            ${p.tag ? `<span style="font-family:var(--font-mono);">• TAG:${esc(p.tag)}</span>` : ''}
            ${p.patrimonio ? `<span style="font-family:var(--font-mono);">• PAT:${esc(p.patrimonio)}</span>` : ''}
            <span>• ${esc(p.categoria)}</span>
            ${p.localizacao ? `<span>• ${esc(p.localizacao)}</span>` : ''}
          </div>
          ${p.em_campo > 0 ? `<div style="font-size:0.7rem;color:#B45309;font-weight:600;margin-top:2px;"><i class="fa-solid fa-hand-holding-hand"></i> ${p.em_campo} em campo (${esc(p.em_campo_com)})</div>` : ''}
        `;
      }

      let acoesHtml = '';
      if (c.status === 'PARECIDO' && c.alternativas && c.alternativas.length > 0) {
        const botoesAlt = c.alternativas.map((alt, idx) => `
          <button type="button" class="btn btn-outline btn-sm" style="font-size:0.69rem;padding:2px 6px;color:#047857;border-color:#A7F3D0;margin-bottom:3px;text-align:left;" onclick="confirmarMatchManual(${c.linha_idx}, ${idx})" title="Confirmar como este item">
            <i class="fa-solid fa-check"></i> ${idx === 0 ? 'Confirmar' : esc(alt.produto.sku)} (${alt.score}%)
          </button>
        `).join('');
        acoesHtml = `
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px;">
            ${botoesAlt}
            <button type="button" class="btn btn-outline btn-sm" style="font-size:0.69rem;padding:2px 6px;color:#B91C1C;border-color:#FECACA;" onclick="descartarMatchManual(${c.linha_idx})">
              <i class="fa-solid fa-xmark"></i> Não é esse
            </button>
          </div>
        `;
      } else if (p && c.status !== 'NAO_ENCONTRADO') {
        acoesHtml = `
          <button type="button" class="btn btn-outline btn-sm" style="font-size:0.7rem;padding:2px 6px;color:var(--text-muted);" onclick="descartarMatchManual(${c.linha_idx})" title="Desvincular correspondência">
            <i class="fa-solid fa-link-slash"></i>
          </button>
        `;
      }

      return `
        <tr>
          <td style="max-width: 310px;">
            <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;margin-bottom:2px;">
              <span style="font-size:0.67rem;font-weight:700;background:#F1F5F9;color:#475569;padding:1px 6px;border-radius:4px;">${esc(c.aba)} #${c.linha_excel}</span>
              ${c.codigo_planilha ? `<span style="font-family:var(--font-mono);font-size:0.7rem;font-weight:700;background:#EEF2FF;color:#4338CA;padding:1px 6px;border-radius:4px;">${esc(c.codigo_planilha)}</span>` : ''}
              ${c.nf_envio ? `<span style="font-size:0.69rem;color:var(--text-dim);">NF: ${esc(c.nf_envio)}</span>` : ''}
            </div>
            <div style="font-weight:700;font-size:0.83rem;color:var(--text-main);line-height:1.35;">${esc(c.descricao)}</div>
          </td>

          <td style="text-align:center;white-space:nowrap;">
            <div style="font-weight:800;font-size:0.9rem;">${c.qtd_esperada} <small style="color:var(--text-dim);">${esc(c.unidade)}</small></div>
            ${c.qtd_devolvida > 0 ? `<div style="font-size:0.68rem;color:#0369A1;">Env:${c.qtd_enviada} Dev:${c.qtd_devolvida}</div>` : ''}
          </td>

          <td>
            ${badgeStatusHtml(c)}
            <div style="font-size:0.69rem;color:var(--text-muted);margin-top:3px;">${esc(c.match_criterio)}</div>
          </td>

          <td style="max-width: 300px;">
            ${matchHtml}
          </td>

          <td style="text-align:center;white-space:nowrap;">
            ${p ? `
              <div style="font-weight:800;font-size:0.92rem;color:${totalObra > 0 ? '#047857' : '#6D28D9'};">${totalObra} <small style="color:var(--text-dim);">${esc(p.unidade_medida)}</small></div>
              <div style="font-size:0.68rem;color:var(--text-muted);">Est:${p.quantidade}${p.em_campo > 0 ? ` + Campo:${p.em_campo}` : ''}</div>
              ${diff !== 0 ? `<div style="font-size:0.69rem;font-weight:700;color:${diff < 0 ? '#B91C1C' : '#047857'};">Dif: ${diff > 0 ? '+' : ''}${diff}</div>` : ''}
            ` : '<span style="color:var(--text-dim);">-</span>'}
          </td>

          <td class="hide-on-print" style="text-align:right;white-space:nowrap;">
            ${acoesHtml}
          </td>
        </tr>
      `;
    }).join('');
  }

  function exportarConferenciaExcel() {
    if (!DADOS_CONFERENCIA) return;
    document.getElementById('input-conf-dados-json').value = JSON.stringify(DADOS_CONFERENCIA);
    document.getElementById('form-exportar-conf-excel').submit();
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (DADOS_CONFERENCIA) renderizarTabelaConferencia();
  });
</script>

<%- include('../layouts/footer') %>
